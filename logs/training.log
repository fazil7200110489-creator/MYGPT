el->get_projects();\n\t\t\t// echo"<pre>"; print_r($data[\'projects\']);exit;\n\t\t\t$data[\'to_do_list\']     =$this->admin_model->get_to_do_list_check($user_det[\'empdet_id\']);\n\t\t\t//$data[\'previous_day_det\'] = $this->admin_model->get_previous_list_det($user_det[\'empdet_id\']);\n\t\t\t$data[\'task_data\']     =$this->admin_model->get_task_list($user_det[\'department\']);\n\t\t\t$data[\'activity\']     =$this->admin_model->get_activity_list($user_det[\'department\']); \n\t\t\t$data[\'Taskdata\']     =$this->admin_model->get_employee_Task($user_det[\'empdet_id\']);\n \t\t\t$tasks    =$this->admin_model->checkAssignedTaskType($user_det[\'empdet_id\']);\n\t\t\t \n\n\t\t\t  $dailyTasks = [];\n\t\t\t  $weeklyTasks = [];\n\t\t\t  $monthlyTasks = [];\n\t\t\t  $quarterlyTasks = [];\n\n\t\t\t  // Loop through each task and categorize it\n\t\t\t\tforeach ($tasks as $task) {\n\t\t\t\t\t// Get current day of the month as a number (1, 2, 3, ..., 31)\n\t\t\t\t // Get the current full date (e.g., 2025-02-10)\n\t\t\t\t    if (!empty($task[\'daily\']) && $task[\'daily\'] != \'0\') {\n\t\t\t\t        $dailyTasks[] = $task;  // Add to daily tasks if \'daily\' is not empty or zero\n\t\t\t\t    } elseif (!empty($task[\'weekly\'])) {\n\t\t\t\t\t\t$dayMapping = [\n\t\t\t\t\t\t\t"1" => "Monday",\n\t\t\t\t\t\t\t"2" => "Tuesday",\n\t\t\t\t\t\t\t"3" => "Wednesday",\n\t\t\t\t\t\t\t"4" => "Thursday",\n\t\t\t\t\t\t\t"5" => "Friday",\n\t\t\t\t\t\t\t"6" => "Saturday",\n\t\t\t\t\t\t];\n\t\t\t\t\t\t\n\t\t\t\t\t\t$currentDay = date(\'l\'); // Get current day name\n\t\t\t\t\t\t\n\t\t\t\t\t\tforeach ($tasks as $task)\n\t\t\t\t\t\t {\n\t\t\t\t\t\t\tif (!empty($task[\'weekly\']))\n\t\t\t\t\t\t\t {\n\t\t\t\t\t\t\t\t$storedDay = $task[\'weekly\']; // Get stored day value (1,2,3,...)\n\t\t\t\t\t\t\t\t// echo "<pre>"; print_r($data[\'weeklyActivityDetails\']); exit;\n\t\t\t\t\t\t\t\tif (isset($dayMapping[$storedDay]) && $dayMapping[$storedDay] == $currentDay)\n\t\t\t\t\t\t\t\t {\n\t\t\t\t\t\t\t\t\t$weeklyTasks[] = $task; // Add to the weeklyTasks array\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t \t\n\t\t\t\t\t\t\t$weeklyTaskIds = array_column($weeklyTasks, \'task\');\n\t\t\t\t\t\t\t$data[\'weeklyTaskDetails\'] = $this->admin_model->get_task_list_by_id($weeklyTaskIds);\n\t\t\t\t\t\t// echo "<pre>"; print_r($data[\'weeklyTaskDetails\']); exit;\t\t\n\n\t\t\t\t    } elseif (!empty($task[\'monthly\'])) {\n\t\t\t\t\t\t$currentDay = date(\'j\'); \n\t\t\t\t\t\tif ($task[\'monthly\'] == $currentDay) { \n\t\t\t\t\t\t\t// Check if the current day matches the \'monthly\' value (1, 2, 3, etc.)\n\t\t\t\t\t\t\t$monthlyTasks[] = $task;  // Add to monthly tasks if condition is met\n\t\t\t\t\t\t}\n\t\t\t\t\t}elseif(!empty($task[\'quartely\'])) {\n\t\t\t\t\t\t$currentDate = date(\'Y-m-d\');\n\t\t\t\t\t\t$quarterlyTaskDate = $task[\'quartely\']; // Get the next quarterly task date from the task\n\t\t\t\t\t\n\t\t\t\t\t\tif ($currentDate === $quarterlyTaskDate) {\n\t\t\t\t\t\t\t// If today\'s date matches the quarterly task date, add it to quarterly tasks\n\t\t\t\t\t\t\t$quarterlyTasks[] = $task;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t$dailyTaskIds = array_column($dailyTasks, \'task\');\n\t\t\t\t$weeklyTaskIds = array_column($weeklyTasks, \'task\');\n\t\t\t    $monthlyTaskIds = array_column($monthlyTasks, \'task\');\n\t\t\t    $quarterlyTaskIds = array_column($quarterlyTasks, \'task\');\n\n\n\t\t\t \n\t\t\t  // Pass task IDs to the model to get task details\n\t\t\t  \n\t\t\t  $data[\'dailyTaskDetails\'] = $this->admin_model->get_task_list_by_id($dailyTaskIds);\n\t\t\t  $data[\'weeklyTaskDetails\'] = $this->admin_model->get_task_list_by_id($weeklyTaskIds);\n\t\t\t  $data[\'monthlyTaskDetails\'] = $this->admin_model->get_task_list_by_id($monthlyTaskIds);\n\t\t\t  $data[\'quarterlyTaskDetails\'] = $this->admin_model->get_task_list_by_id($quarterlyTaskIds);\n\t\t\t \n\n\t\t\t $dailyactivityIds = array_column($dailyTasks, \'activity\');\n\t\t\t $weeklyactivityIds = array_column($weeklyTasks, \'activity\');\n\t\t\t $monthlyactivityIds = array_column($monthlyTasks, \'activity\');\n\t\t\t $quarterlyactivityIds = array_column($quarterlyTasks, \'activity\'); \n\t\t\t \n\n\t\t\t  $data[\'dailyActivityDetails\'] = $this->admin_model->get_activity_list_by_id($dailyactivityIds);\n\t\t\t  $data[\'weeklyActivityDetails\'] = $this->admin_model->get_activity_list_by_id($weeklyactivityIds);\n\t\t\t  $data[\'monthlyActivityDetails\'] = $this->admin_model->get_activity_list_by_id($monthlyactivityIds);\n\t\t\t  $data[\'quarterlyActivityDetails\'] = $this->admin_model->get_activity_list_by_id($quarterlyactivityIds);\n\t\t\t \n\n\t\t\t$this->template->write_view(\'content\', \'admin/add_task_data\',$data);\n\t\t\t$this->template->render();\n\n\t\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t }\n\t public function org_hierarchy(){\n\n\t \t\t$this->load->model(\'admin/admin_model\');  \n\t \t\t//echo"<pre>"; print_r($data);exit;\n\t\t\t$this->template->write_view(\'content\', \'admin/org_chart\');\n\t\t\t$this->template->render();\n\t }\n\t public function get_employee_hierarchy()\n\t {\n\t \t$this->load->model(\'admin/admin_model\');  \n\t \t$inps = $this->input->post();\n\t \t$report_mgr = explode(\'~\', $inps[\'cid\']);\n\t   \t$r_id = $report_mgr[0];\n\t   \t$r_name = $report_mgr[1];\n \t \t// echo"<pre>report_mgr"; print_r($r_id);exit;\n\t\t$get_det = $this->admin_model->getemployees_hierarchy($r_id); \n\t\techo"<pre>Get Details"; print_r($get_det);exit;\n\t \tif(isset($get_det) && !empty($get_det))\n\t\t{\n\t\t\t$g_select=\'<select id="meet_location" name="meet_location"> <option value="">Select Meeting Location</option>\';\n\n\t\t\tforeach($get_det as $val)\n\t\t\t{\n\t\t\t\t$g_select=$g_select."<option value=\'".$val[\'id\']."\'>".$val[\'place_name\']."</option>";\n\t\t\t}\n\n\t\t\t$g_select=$g_select.\'</select><span id="meet_location_err" style="color:#F00; font-style:oblique;float:left; text-transform:capitalize"></span>\';\n\t\t\techo $g_select;\n\t\t}\n\t\telse\n\t\t{\n\t\t\techo 0;\n\t\t}\n\t }\n\t \npublic function add_task_details(){\n\n\t$user_det = $this->session->userdata(\'logged_in\');\n\n\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t \t\t$this->load->model(\'admin/admin_model\'); \n\t \t\t$inps = $this->input->post();\n\t \t    // echo"<pre>"; print_r($inps);//exit;\n\n\t\t\tif($this->input->post())\n\n\t\t\t\t{\n \t\t\t\t\t$current_day = $this->admin_model->check_to_do_list_today($user_det[\'empdet_id\']);\n \t\t\t\t\tif($current_day > 0){\n\n \t\t\t\t\t\t\t$this->session->set_flashdata(\'alr\',\'You have already Submitted the Form..!\');\n\t\t\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/task_data\');\n\n \t\t\t\t\t} else {\n\n \t\t\t\t\t\t  foreach($inps[\'inputTask\'] as $key => $inputTask)\n\t\t\t\t     \n\t\t\t\t\t\t        {\n\n\t\t\t\t\t\t        \t$dep_mgr = explode(\'~\', $inps[\'inputDependency\'][$key]);\n\t\t\t\t\t\t\t\t   \t$dep_id = $dep_mgr[0];\n\t\t\t\t\t\t\t\t   \t$dep_name = $dep_mgr[1];\n\t\t\t\t\t\t\t\t   \t$dep = $dep_mgr[2];\n\n\t\t\t\t\t\t\t\t\t$dataToSave = array(\n\t\t\t\t\t\t\t\t\t  \'task_type\' => $inputTask,\n\t\t\t\t\t\t\t\t\t  \'priority_type\' => $inps[\'inputPriority\'][$key],\n\t\t\t\t\t\t\t\t\t  \'project_name\'  => $inps[\'inputProject\'][$key],\n\t\t\t\t\t\t\t\t\t  \'inputActivity\'  => $inps[\'inputActivity\'][$key],\n\t\t\t\t\t\t\t\t\t  \'activityDesc\' => $inps[\'inputActivitydescription\'][$key],\n\t\t\t\t\t\t\t\t\t  \'EstimatedHours\' => $inps[\'inputEstimatedhours\'][$key],\n\t\t\t\t\t\t\t\t\t  \'depend_name\' => $dep_id,\n\t\t\t\t\t\t\t\t\t  \'remarks\'   => $inps[\'inputRemarks\'][$key], \n\t\t\t\t\t\t\t\t\t  \'s_no\'   => $inps[\'inputDaily\'][$key],  \n\t\t\t\t\t\t\t\t\t  \'task_flag\'   => 1, \n\n\t\t\t\t\t\t\t\t\t     );\n\n\t\t\t\t\t\t\t\t\t// echo"<pre>"; print_r($dataToSave);exit;\n\n\t\t\t\t\t\t\t\t\t$this->db->select(\'*\');\n\t\t\t\t\t\t\t\t\t$this->db->where(\'type_id\',\'1\');\n\t\t\t\t\t\t\t\t\t$query1=$this->db->get(\'increment_id\')->result_array();\n\t\t\t\t\t\t\t\t\t$new_cnt = $query1[0][\'auto_value\']+1;\n\t\t\t\t\t\t\t\t\t$tran_id = "TASK".sprintf("%06d",$new_cnt);\n\t\t\t\t\t\t\t\t\t$auto_value=sprintf("%06d",$new_cnt);\n\n\t\t\t\t\t\t\t\t\t$this->db->set(\'auto_value\',$auto_value);\n\t\t\t\t\t\t\t\t\t$this->db->where(\'type_id\',\'1\');\n\t\t\t\t\t\t\t\t\t$this->db->update(\'increment_id\');\n\n\n\t\t\t\t\t\t\t\t\t$s_no_val = (isset($inps[\'inputDaily\'][$key]) && $inps[\'inputDaily\'][$key] !== \'\') ? (int)$inps[\'inputDaily\'][$key] : null;\n\t\t\t\t\t\t\t\t\tif ($s_no_val !== null) {\n\t\t\t\t\t\t\t\t\t\t$this->db->where(\'s_no\', $s_no_val);\n\t\t\t\t\t\t\t\t\t\t$chk = $this->db->count_all_results(\'task_type\');\n\t\t\t\t\t\t\t\t\t\tif ($chk == 0) {\n\t\t\t\t\t\t\t\t\t\t\t$s_no_val = null;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\t//  echo"<pre>Input"; print_r($dataToSave); //exit;\n\t\t\t\t\t\t\t\t\t$data = array(\'task_id\' => $tran_id,\'e_id\' => $user_det[\'empdet_id\'],\'work_type\' => $inps[\'work_type\'],\'permission\' => $inps[\'permission\'],\'permission_time\' => $inps[\'work_time\'],\'session_type\' => $inps[\'work_session\'],\'dep_task_id\' => $inps[\'inputTask\'][$key],\'activity_id\' => $inps[\'inputActivity\'][$key],\'priority_type\' => $inps[\'inputPriority\'][$key],\'project_name\' => $inps[\'inputProject\'][$key],\'depend_name\' => $dep_id,\'activityDesc\' =>$inps[\'inputActivitydescription\'][$key],\'EstimatedHours\' =>$inps[\'inputEstimatedhours\'][$key],\'remarks\' => $inps[\'inputRemarks\'][$key],\'s_no\'   => $s_no_val,\'task_flag\'   => 1);  \n\t\t\t\t\t\t\t\t \t// echo"<pre>"; print_r($data); exit; \n\t\t\t\t\t\t\t\t\t$task_query=$this->db->insert(\'task_details\',$data);\n\t\t\t\t\t\t\t\t\t//$this->db->last_query();\n\t\t\t\t\t\t\t\t\t //echo"<pre>sql_query"; print_r($task_query); exit;\n \n\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t//echo"<pre>sql_query"; print_r($task_query); exit;\n\t\t\t\t\t\t\t\tif($task_query>0){ \n\n\t\t\t\t\t\t\t\t\t// $precurrent_day = $this->admin_model->check_to_do_list_preday($user_det[\'empdet_id\']);\n\n\t\t\t\t\t\t\t\t\t// if($precurrent_day > 0){\n\n\t\t\t\t\t\t\t\t\t// \tforeach($inps[\'inputPreID\'] as $pkey => $inputPreID) \n\t\t\t\t\t     \n\t\t\t\t\t\t\t\t\t// \t\t{\n\t\t\t\t\t\t\t\t\t// \t\t\t$predep_mgr = explode(\'~\', $inps[\'inputPreDependency\'][$key]);\n\t\t\t\t\t\t\t\t\t// \t\t\t$predep_id = $predep_mgr[0];\n\t\t\t\t\t\t\t\t\t// \t\t\t$predep_name = $predep_mgr[1];\n\t\t\t\t\t\t\t\t\t// \t\t\t$predep = $predep_mgr[2];\n\n\t\t\t\t\t\t\t\t\t// \t\t\tif($inps[\'inputPrestatus\'][$key]==\'1\')\n\t\t\t\t\t\t\t\t\t// \t\t\t{\n\n\t\t\t\t\t\t\t\t\t// \t\t\t\t$task_today = $current_day = date("Y-m-d");\n\n\t\t\t\t\t\t\t\t\t// \t\t\t} else {\n\n\t\t\t\t\t\t\t\t\t// \t\t\t\t$task_today = \'\';\n\t\t\t\t\t\t\t\t\t// \t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t// \t\t\t$predataToSave = array(\n\t\t\t\t\t\t\t\t\t// \t\t\t  \'prev_depend_name\' => $predep_id,\n\t\t\t\t\t\t\t\t\t// \t\t\t  //\'prev_pend_task_type\' => $inps[\'inputPreTask\'][$key],\n\t\t\t\t\t\t\t\t\t// \t\t\t  \'prev_reason\'  => $inps[\'inputPreRemarks\'][$key],\n\t\t\t\t\t\t\t\t\t// \t\t\t  \'status\' => $inps[\'inputPrestatus\'][$key], \n\t\t\t\t\t\t\t\t\t// \t\t\t  \'task_comp_dt\' => $task_today, \n\n\t\t\t\t\t\t\t\t\t// \t\t\t\t );\n\n\t\t\t\t\t\t\t\t\t// \t\t\t//echo"<pre>Input"; print_r($predataToSave); \n\t\t\t\t\t\t\t\t\t// \t\t\t//echo"<pre>Input"; print_r($predataToSave); exit;\n\t\t\t\t\t\t\t\t\t// \t\t\t$predata = array(\'prev_depend_name\' => $predep_id,\'prev_reason\' => $inps[\'inputPreRemarks\'][$key],\'status\' => $inps[\'inputPrestatus\'][$key],\'task_comp_dt\' => $task_today); \n\n\t\t\t\t\t\t\t\t\t// \t\t\t$this->db->where(\'id\',$inps[\'inputPreID\'][$key]);\n\t\t\t\t\t\t\t\t\t// \t\t\t$presql_query=$this->db->update(\'task_details\',$predata); \n\t\t\t\t\t\t\t\t\t// \t\t}\n\n\t\t\t\t\t\t\t\t\t// } else {\n\n\n\t\t\t\t\t\t\t\t\t// }\n\t\t\t\t\t\t\t       // die;\n\t\t\t\t\t\t\t   \t\t// Calculate daily work performance and notify manager\n\t\t\t\t\t\t\t   \t\t$perf = $this->admin_model->get_employee_daily_performance($user_det[\'empdet_id\']);\n\t\t\t\t\t\t\t   \t\t$manager = $this->admin_model->get_reporting_manager_info($user_det[\'empdet_id\']);\n\n\t\t\t\t\t\t\t   \t\tif (!empty($manager)) {\n\t\t\t\t\t\t\t   \t\t\t$mgr_receiver_id = !empty($manager[\'mid\']) ? $manager[\'mid\'] : $manager[\'report_mgr_id\'];\n\t\t\t\t\t\t\t   \t\t\t\n\t\t\t\t\t\t\t   \t\t\t// Check and insert/update verification record in notification_det (type = 10)\n\t\t\t\t\t\t\t   \t\t\t$this->db->where(\'type\', 10);\n\t\t\t\t\t\t\t   \t\t\t$this->db->where(\'initiator_id\', $user_det[\'empdet_id\']);\n\t\t\t\t\t\t\t   \t\t\t$this->db->where(\'receiver_id\', $mgr_receiver_id);\n\t\t\t\t\t\t\t   \t\t\t$this->db->where("DATE(creation_date) =", date(\'Y-m-d\'));\n\t\t\t\t\t\t\t   \t\t\t$exist_notif = $this->db->get(\'notification_det\')->row_array();\n\n\t\t\t\t\t\t\t   \t\t\tif (empty($exist_notif)) {\n\t\t\t\t\t\t\t   \t\t\t\t$this->db->insert(\'notification_det\', [\n\t\t\t\t\t\t\t   \t\t\t\t\t\'type\' => 10,\n\t\t\t\t\t\t\t   \t\t\t\t\t\'initiator_id\' => $user_det[\'empdet_id\'],\n\t\t\t\t\t\t\t   \t\t\t\t\t\'receiver_id\' => $mgr_receiver_id,\n\t\t\t\t\t\t\t   \t\t\t\t\t\'is_acknownledge\' => 0,\n\t\t\t\t\t\t\t   \t\t\t\t\t\'from_date\' => date(\'Y-m-d\'),\n\t\t\t\t\t\t\t   \t\t\t\t\t\'creation_date\' => date(\'Y-m-d H:i:s\')\n\t\t\t\t\t\t\t   \t\t\t\t]);\n\t\t\t\t\t\t\t   \t\t\t}\n\n\t\t\t\t\t\t\t   \t\t\t// Dispatch Manager Work Summary Email\n\t\t\t\t\t\t\t   \t\t\tif (!empty($manager[\'manager_email\'])) {\n\t\t\t\t\t\t\t   \t\t\t\t$emp_name = !empty($user_det[\'emp_name\']) ? $user_det[\'emp_name\'] : \'Employee\';\n\t\t\t\t\t\t\t   \t\t\t\t$today_str = date(\'d F Y\');\n\t\t\t\t\t\t\t   \t\t\t\t$login_url = $this->config->item(\'base_url\') . \'admin/index\';\n\n\t\t\t\t\t\t\t   \t\t\t\t$completed_list_html = \'\';\n\t\t\t\t\t\t\t   \t\t\t\t$inprogress_list_html = \'\';\n\t\t\t\t\t\t\t   \t\t\t\t$pending_list_html = \'\';\n\n\t\t\t\t\t\t\t   \t\t\t\tforeach ($perf[\'tasks\'] as $pt) {\n\t\t\t\t\t\t\t   \t\t\t\t\tif ($pt[\'calculated_status\'] === \'Completed\') {\n\t\t\t\t\t\t\t   \t\t\t\t\t\t$completed_list_html .= \'<li>\' . htmlspecialchars($pt[\'calculated_name\']) . \' (\' . htmlspecialchars($pt[\'calculated_project\']) . \')</li>\';\n\t\t\t\t\t\t\t   \t\t\t\t\t} elseif ($pt[\'calculated_status\'] === \'In Progress\') {\n\t\t\t\t\t\t\t   \t\t\t\t\t\t$inprogress_list_html .= \'<li>\' . htmlspecialchars($pt[\'calculated_name\']) . \' (\' . htmlspecialchars($pt[\'calculated_project\']) . \')</li>\';\n\t\t\t\t\t\t\t   \t\t\t\t\t} else {\n\t\t\t\t\t\t\t   \t\t\t\t\t\t$pending_list_html .= \'<li>\' . htmlspecialchars($pt[\'calculated_name\']) . \' (\' . htmlspecialchars($pt[\'calculated_project\']) . \')</li>\';\n\t\t\t\t\t\t\t   \t\t\t\t\t}\n\t\t\t\t\t\t\t   \t\t\t\t}\n\n\t\t\t\t\t\t\t   \t\t\t\tif (empty($completed_list_html)) $completed_list_html = \'<li>None</li>\';\n\t\t\t\t\t\t\t   \t\t\t\tif (empty($inprogress_list_html)) $inprogress_list_html = \'<li>None</li>\';\n\t\t\t\t\t\t\t   \t\t\t\tif (empty($pending_list_html)) $pending_list_html = \'<li>None</li>\';\n\n\t\t\t\t\t\t\t   \t\t\t\t$email_body = "\n\t\t\t\t\t\t\t   \t\t\t\t<div style=\'font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px;\'>\n\t\t\t\t\t\t\t   \t\t\t\t\t<h2 style=\'color: #012970; border-bottom: 2px solid #4154f1; padding-bottom: 8px;\'>Today\\\'s Team Work Summary</h2>\n\t\t\t\t\t\t\t   \t\t\t\t\t<p><strong>Date:</strong> {$today_str}</p>\n\t\t\t\t\t\t\t   \t\t\t\t\t<p><strong>Employee:</strong> {$emp_name}</p>\n\t\t\t\t\t\t\t   \t\t\t\t\t<div style=\'background-color: #f6f9ff; padding: 15px; border-radius: 6px; margin: 15px 0;\'>\n\t\t\t\t\t\t\t   \t\t\t\t\t\t<p style=\'margin: 4px 0;\'><strong>Total Tasks:</strong> {$perf[\'total\']}</p>\n\t\t\t\t\t\t\t   \t\t\t\t\t\t<p style=\'margin: 4px 0; color: #198754;\'><strong>Completed:</strong> {$perf[\'completed\']}</p>\n\t\t\t\t\t\t\t   \t\t\t\t\t\t<p style=\'margin: 4px 0; color: #ffc107;\'><strong>In Progress:</strong> {$perf[\'inprogress\']}</p>\n\t\t\t\t\t\t\t   \t\t\t\t\t\t<p style=\'margin: 4px 0; color: #dc3545;\'><strong>Pending:</strong> {$perf[\'pending\']}</p>\n\t\t\t\t\t\t\t   \t\t\t\t\t\t<p style=\'margin: 8px 0 0 0; font-size: 16px;\'><strong>Overall Completion:</strong> <span style=\'color: #4154f1; font-weight: bold;\'>{$perf[\'overall_percentage\']}%</span></p>\n\t\t\t\t\t\t\t   \t\t\t\t\t</div>\n\t\t\t\t\t\t\t   \t\t\t\t\t<h3 style=\'color: #198754; font-size: 15px;\'>Completed Tasks:</h3>\n\t\t\t\t\t\t\t   \t\t\t\t\t<ul>{$completed_list_html}</ul>\n\t\t\t\t\t\t\t   \t\t\t\t\t<h3 style=\'color: #e67e22; font-size: 15px;\'>In Progress:</h3>\n\t\t\t\t\t\t\t   \t\t\t\t\t<ul>{$inprogress_list_html}</ul>\n\t\t\t\t\t\t\t   \t\t\t\t\t<h3 style=\'color: #dc3545; font-size: 15px;\'>Pending:</h3>\n\t\t\t\t\t\t\t   \t\t\t\t\t<ul>{$pending_list_html}</ul>\n\t\t\t\t\t\t\t   \t\t\t\t\t<div style=\'margin-top: 25px; text-align: center;\'>\n\t\t\t\t\t\t\t   \t\t\t\t\t\t<a href=\'{$login_url}\' style=\'background-color: #4154f1; color: #ffffff; padding: 10px 22px; text-decoration: none; border-radius: 4px; display: inline-block; font-weight: bold;\'>Review Team Work</a>\n\t\t\t\t\t\t\t   \t\t\t\t\t</div>\n\t\t\t\t\t\t\t   \t\t\t\t</div>";\n\n\t\t\t\t\t\t\t   \t\t\t\t$this->email->from(\'inet@inetcsc.com\', \'iWork HRMS\');\n\t\t\t\t\t\t\t   \t\t\t\t$this->email->to($manager[\'manager_email\']);\n\t\t\t\t\t\t\t   \t\t\t\t$this->email->set_mailtype("html");\n\t\t\t\t\t\t\t   \t\t\t\t$this->email->subject("Daily Work Summary: {$emp_name} - {$today_str}");\n\t\t\t\t\t\t\t   \t\t\t\t$this->email->message($email_body);\n\t\t\t\t\t\t\t   \t\t\t\t@$this->email->send();\n\t\t\t\t\t\t\t   \t\t\t}\n\t\t\t\t\t\t\t   \t\t}\n\n\t\t\t\t\t\t\t   \t\t$this->session->set_flashdata(\'succ\', \'To Do List Successfully Inserted\');\n\t\t\t\t\t\t\t   \t\tredirect($this->config->item(\'base_url\').\'admin/task_data\');\n\t\t\t\t\t\t\t   \t\t //echo"success";exit;\n\t\t\t\t\t\t\t   \t\t}\n\t\t\t\t\t\t\t   \t\telse{\n\t\t\t\t\t\t\t   \t\t\t\n\t\t\t\t\t\t\t   \t\t\t$this->session->set_flashdata(\'err\',\'something went wrong.Error!!\');\n\t\t\t\t\t\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/task_data\');\n\t\t\t\t\t\t\t   \t\t\t//echo"Failed";exit;\n\t\t\t\t\t\t\t   \t\t}\n \t\t\t\t\t\t\t}\n\t\t\t\t  \n\t\t\t\t} else {\n\t\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t\t}\n\n\t\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\n\t }\n\t// user_reports() is defined at line 1219\n\n\t/**\n\t * AJAX: Returns project performance data (completed tasks per project) for a given month/year.\n\t * POST params: month (1-12), year (YYYY)\n\t */\n\tpublic function get_project_chart_data()\n\t{\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif (empty($user_det)) {\n\t\t\t$this->output->set_content_type(\'application/json\')->set_output(json_encode([]));\n\t\t\treturn;\n\t\t}\n\t\t$month = (int)$this->input->post(\'month\');\n\t\t$year  = (int)$this->input->post(\'year\');\n\t\t$filters = [\n\t\t\t\'from_date\'  => $this->input->post(\'from_date\'),\n\t\t\t\'to_date\'    => $this->input->post(\'to_date\'),\n\t\t\t\'project_id\' => $this->input->post(\'project_id\'),\n\t\t\t\'status\'     => $this->input->post(\'status\')\n\t\t];\n\t\t$data  = $this->admin_model->get_project_performance_by_month($user_det[\'empdet_id\'], $month, $year, $filters);\n\t\t$this->output->set_content_type(\'application/json\')->set_output(json_encode($data));\n\t}\n\n\t/**\n\t * AJAX: Returns hourly productivity data for a given date.\n\t * POST params: date (YYYY-MM-DD)\n\t */\n\tpublic function get_daily_hours_data()\n\t{\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif (empty($user_det)) {\n\t\t\t$this->output->set_content_type(\'application/json\')->set_output(json_encode([\'hasData\' => false]));\n\t\t\treturn;\n\t\t}\n\t\t$date = $this->input->post(\'date\');\n\t\t$filters = [\n\t\t\t\'from_date\'  => $this->input->post(\'from_date\'),\n\t\t\t\'to_date\'    => $this->input->post(\'to_date\'),\n\t\t\t\'project_id\' => $this->input->post(\'project_id\'),\n\t\t\t\'status\'     => $this->input->post(\'status\')\n\t\t];\n\n\t\t// [DEBUG] Log the received filters (visible in application/logs/log-YYYY-MM-DD.php)\n\t\tlog_message(\'error\', \'[DailyHours] filters_received=\' . json_encode($filters) . \'  empdet_id=\' . $user_det[\'empdet_id\']);\n\n\t\t$data = $this->admin_model->get_hourly_productivity($user_det[\'empdet_id\'], $date, $filters);\n\n\t\t// Remove internal _debug key before sending to client\n\t\tunset($data[\'_debug\']);\n\n\t\t$this->output->set_content_type(\'application/json\')->set_output(json_encode($data));\n\t}\n\n\t/**\n\t * AJAX: Returns priority vs status matrix data for a given date.\n\t * POST params: date (YYYY-MM-DD)\n\t */\n\tpublic function get_priority_matrix_data()\n\t{\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif (empty($user_det)) {\n\t\t\t$this->output->set_content_type(\'application/json\')->set_output(json_encode([]));\n\t\t\treturn;\n\t\t}\n\t\t$date = $this->input->post(\'date\');\n\t\t$filters = [\n\t\t\t\'from_date\'  => $this->input->post(\'from_date\'),\n\t\t\t\'to_date\'    => $this->input->post(\'to_date\'),\n\t\t\t\'project_id\' => $this->input->post(\'project_id\'),\n\t\t\t\'status\'     => $this->input->post(\'status\')\n\t\t];\n\t\t$data = $this->admin_model->get_priority_matrix($user_det[\'empdet_id\'], $date, $filters);\n\t\t$this->output->set_content_type(\'application/json\')->set_output(json_encode($data));\n\t}\n\t/**\n\t * AJAX: Returns user reports json data for DataTable.\n\t */\n\tpublic function get_user_reports_json()\n\t{\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif (empty($user_det)) {\n\t\t\t$this->output->set_content_type(\'application/json\')->set_output(json_encode([\'data\' => []]));\n\t\t\treturn;\n\t\t}\n\n\t\t$inputs = $this->input->post();\n\t\t\n\t\t// If dates are empty, default to First day of current month and Today\n\t\tif (empty($inputs[\'from_date\']) && empty($inputs[\'to_date\'])) {\n\t\t\t$inputs[\'from_date\'] = date(\'Y-m-01\');\n\t\t\t$inputs[\'to_date\']   = date(\'Y-m-d\');\n\t\t}\n\n\t\t$user_rep_list = $this->admin_model->get_user_reports($user_det[\'empdet_id\'], $inputs);\n\n\t\t$data = [];\n\t\t$i = 1;\n\t\tforeach ($user_rep_list as $ukey) {\n\t\t\tif ($ukey[\'priority_type\'] == \'1\') { $priority = "High"; }\n\t\t\telse if ($ukey[\'priority_type\'] == \'2\') { $priority = "Medium"; }\n\t\t\telse { $priority = "Low"; }\n\n\t\t\tif ($ukey[\'work_type\'] == \'1\') { $worktype = "Office"; }\n\t\t\telse if ($ukey[\'work_type\'] == \'2\') { $worktype = "Work From Home"; }\n\t\t\telse { $worktype = "On-Duty"; }\n\n\t\t\tif ($ukey[\'session_type\'] == \'1\') { $sessiontype = "Morning"; }\n\t\t\telse if ($ukey[\'session_type\'] == \'2\') { $sessiontype = "After-Noon"; }\n\t\t\telse { $sessiontype = "Full-Day"; }\n\n\t\t\tif ($ukey[\'status\'] == \'1\') {\n\t\t\t\t$sts_badge = \'<span class="badge rounded-pill bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>\';\n\t\t\t} else {\n\t\t\t\t$sts_badge = \'<span class="badge rounded-pill bg-warning"><i class="bi bi-exclamation-octagon me-1"></i>Pending</span>\';\n\t\t\t}\n\n\t\t\t$is_ticket = !empty($ukey[\'ticket_id\']);\n\t\t\tif ($is_ticket) {\n\t\t\t\t$display_task_name   = "Ticket";\n\t\t\t\t$display_activity    = "Ticket: " . $ukey[\'t_ticket_id\'] . " - " . $ukey[\'ticket_title\'];\n\t\t\t\t$display_project     = !empty($ukey[\'pname\']) ? $ukey[\'pname\'] : \'N/A\';\n\t\t\t\t$display_description = $ukey[\'ticket_desc\'];\n\t\t\t\t$display_est_time    = !empty($ukey[\'EstimatedHours\']) ? $ukey[\'EstimatedHours\'] : \'N/A\';\n\t\t\t\tif (empty($ukey[\'priority_type\'])) {\n\t\t\t\t\t$tk_pri = $ukey[\'ticket_priority\'];\n\t\t\t\t\tif ($tk_pri == \'1\') { $priority = "High"; }\n\t\t\t\t\telseif ($tk_pri == \'2\') { $priority = "Medium"; }\n\t\t\t\t\telse { $priority = "Low"; }\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\t$display_task_name   = $ukey[\'task_list\'];\n\t\t\t\t$display_activity    = $ukey[\'activity_list\'];\n\t\t\t\t$display_project     = $ukey[\'pname\'];\n\t\t\t\t$display_description = $ukey[\'activityDesc\'];\n\t\t\t\t$display_est_time    = $ukey[\'EstimatedHours\'];\n\t\t\t}\n\n\t\t\t$data[] = [\n\t\t\t\t\'sr_no\' => $i++,\n\t\t\t\t\'task_id\' => \'<span class="badge border-secondary border-1 text-secondary" style="font-size: 14px;">\' . $ukey[\'task_id\'] . \'</span>\',\n\t\t\t\t\'work_type\' => $worktype,\n\t\t\t\t\'session_type\' => $sessiontype,\n\t\t\t\t\'task_name\' => $display_task_name,\n\t\t\t\t\'activity_name\' => $display_activity,\n\t\t\t\t\'priority\' => $priority,\n\t\t\t\t\'project_name\' => $display_project,\n\t\t\t\t\'description\' => $display_description,\n\t\t\t\t\'estimated_time\' => $display_est_time,\n\t\t\t\t\'completed_time\' => $ukey[\'task_comp_time\'],\n\t\t\t\t\'remarks\' => $ukey[\'remarks\'],\n\t\t\t\t\'status_badge\' => $sts_badge,\n\t\t\t\t\'start_date\' => $ukey[\'created_date\'],\n\t\t\t\t\'end_date\' => $ukey[\'task_comp_dt\']\n\t\t\t];\n\t\t}\n\n\t\t$this->output->set_content_type(\'application/json\')->set_output(json_encode([\n\t\t\t\'data\' => $data,\n\t\t\t\'rawTasks\' => $user_rep_list\n\t\t]));\n\t}\n\n\t public function employee_reports(){\n\