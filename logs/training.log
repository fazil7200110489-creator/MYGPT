)->setCellValue(\'G1\', \'Designation\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'G1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H1\', \'DOJ\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'H1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I1\', \'Work Location\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'I1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J1\', \'Reporting Manager\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'J1\')->getFont()->setBold(true);\n\t \t\t\n\t \t\t $i=2;\n\t\tforeach($data[\'logsub\'] as $val)\n\t\t{\n\t\t\t$sn = $i - 1;\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'A\'.$i,$sn);\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B\'.$i,$val[\'emp_id\']);\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'C\'.$i,$val[\'emp_name\']);\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D\'.$i,$val[\'mob-no\'] );\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E\'.$i,$val[\'email_id\']);\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F\'.$i,$val[\'department\']); \n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G\'.$i,$val[\'designation\']); \n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H\'.$i,$val[\'join_dt\']); \n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I\'.$i,$val[\'work_loc\']); \n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J\'.$i,$val[\'reprt_mger_name\']); \n\n\t\t\t$i++;\n\n\t\t} \n\n\t\t$filename="Employee Submitted List Export_".date("Y-m-d").".xls";\n\t\theader(\'Content-Type: application/vnd.ms-excel\');\n\t\theader(\'Content-Disposition: attachment;filename="\'.$filename.\'"\');\n\t\theader(\'Cache-Control: max-age=0\');\n\t\t$objWriter = PHPExcel_IOFactory::createWriter($this->excel, \'Excel2007\');\n\t\t$objWriter->save(\'php://output\'); exit;\n\n\t\t  } else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\n\t }\n\n\t public function on_duty_export($sub_type){\n\t \t\t$usersess_det=$this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t \t\t$data[\'onsub\'] = $this->admin_model->get_on_duty_export($sub_type);\n\t\t\t$this->load->library(\'excel\');\n \t\t \n\t\t\t$this->excel->setActiveSheetIndex(0);\n\t\t\t$this->excel->getActiveSheet()->setTitle("Employee Submitted List");\n\t\t\t\n\t \t\t$this->excel->getActiveSheet()->setCellValue(\'A1\', \'S.No\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'A1\')->getFont()->setBold(true);\n\t\t\t\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B1\', \'Employee Id\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'B1\')->getFont()->setBold(true);\n\t \n\t   \t\t$this->excel->getActiveSheet()->setCellValue(\'C1\', \'Name\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'C1\')->getFont()->setBold(true);\n\t\t\t\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D1\', \'Phone No\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'D1\')->getFont()->setBold(true);\n\t\t\t\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E1\', \'E-mail ID\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'E1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F1\', \'Department\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'F1\')->getFont()->setBold(true); \n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G1\', \'Designation\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'G1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H1\', \'DOJ\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'H1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I1\', \'Work Location\');\n\