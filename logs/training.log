escription\'] = "User ".$employee_det[\'emp_id\']." Logged Out on ".date("Y M d H i s");\n\t\t\t\t $data[\'location\'] = $employee_det[\'work_loc\'];\n\t\t\t\t $data[\'login_time\'] =\'0\';\n\t\t\t\t $curr_time=time();\n                 $data[\'logout_time\'] = date("Y-m-d H:i:s",$curr_time);\n\t\t\t\t $data[\'status\'] =\'0\';\n\t\t\t\t$this->db->insert(\'login_log\', $data);\n\n\t\t\t\t$this->session->unset_userdata(\'logged_in\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t} else {\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t} \n\npublic function get_team_members()\n {\n\t$employee_det = $this->session->userdata(\'logged_in\');  \n\n\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{  \n        \t$emp_id=$employee_det[\'emp_id\']; \n\t         $this->load->model(\'admin/admin_model\');  \n\t\t \t//echo"<pre>"; print_r($data);exit;\n\t         $data[\'lists\'] = $this->admin_model->get_members_list($emp_id);\n\t\t\t$this->template->write_view(\'content\', \'admin/members_list\',$data);\n\t\t\t$this->template->render();\n\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n  }\n\npublic function get_team_reports()\n\t\t {\n\n\t\t \t$user_det = $this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\t\tif(isset($user_det) && !empty($user_det))\n\t\t\t{\n\t \t\t \t\n\t\t\t \t $inputs = $this->input->post();\n\n\t\t\t \t if (isset($inputs) && !empty($inputs)) {\n\t\t\t\t\t$data[\'filters\'] = $inputs;\n\t\t\t\t\t// echo "<pre>"; print_r($data[\'filters\']); exit;\t \t\n\t\t\t\t\t$data[\'projects\'] = $this->admin_model->get_projects_export();\n\t\t\t\t\t$data[\'lists\'] = $this->admin_model->get_members_list($user_det[\'emp_id\']);\n\t\t\t\t\t$data[\'reports\'] = $this->admin_model->get_all_team_reports($user_det[\'emp_id\'], $inputs);\n\n\t\t\t\t\t// Fetch and merge Project Request records into the same report\n\t\t\t\t\t$project_requests = $this->admin_model->get_project_requests_for_team_report($user_det[\'emp_id\'], $inputs);\n\t\t\t\t\tif (!empty($project_requests)) {\n\t\t\t\t\t\t$data[\'reports\'] = array_merge((array)$data[\'reports\'], $project_requests);\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t} else {\n\t\t\t\t\t$inputs = "";\n\t\t\t\t\t$data[\'projects\'] = $this->admin_model->get_projects_export();\n\t\t\t\t\t$data[\'lists\'] = $this->admin_model->get_members_list($user_det[\'emp_id\']);\n\t\t\t\t\t$data[\'reports\'] = $this->admin_model->get_all_team_reports($user_det[\'emp_id\'], $inputs); \n\t\t\t\t\t// echo"<pre>array";print_r($data[\'reports\']);exit;\n\n\t\t\t\t\t// Fetch and merge Project Request records (default: today\'s date scope)\n\t\t\t\t\t$project_requests = $this->admin_model->get_project_requests_for_team_report($user_det[\'emp_id\'], []);\n\t\t\t\t\tif (!empty($project_requests)) {\n\t\t\t\t\t\t$data[\'reports\'] = array_merge((array)$data[\'reports\'], $project_requests);\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t}\n\t\t\t\t$this->template->write_view(\'content\', \'admin/team_reports\', $data);\n\t\t\t\t$this->template->render();\n\n\t\t \t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t\t }\n\n\npublic  function check_empid()\n{\n\t$this->load->model(\'admin/admin_model\');\n\t$inps = $this->input->post();\n\t$emp_id = $inps[\'emp_id\'];\n\n\t$this->db->select(\'emp.*\');\n\t$this->db->where(\'emp.emp_id\',$emp_id);\n\t$query = $this->db->get(\'employee_det as emp\');\n\t$count_id = $query->num_rows();\n\n\tif ($count_id > 0) {\n\t\t$row = $query->row_array();\n\t\tif ($row[\'status\'] != 1) {\n\t\t\t// Account exists but is INACTIVE\n\t\t\techo 2;\n\t\t} else {\n\t\t\t// Account exists and is ACTIVE\n\t\t\techo 1;\n\t\t}\n\t} else {\n\t\t// Account does not exist\n\t\techo 0;\n\t}\n}\n\n\n\npublic function add_project()\n\t {\n\n\t \t$usersess_det=$this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t \t$this->load->model(\'admin/admin_model\');\n\t\t \t$data[\'man\'] = $this->admin_model->get_management_users();\n\t\t \t$data[\'states\'] = $this->admin_model->get_states_list();\n\t\t \t$this->template->write_view(\'content\',\'admin/add_project\',$data);\n\t\t \t$this->template->render();\n\n\t \t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t }\n\n\n\t\n\n\n\t\t\t\t\t   \t\n\t\n\n\npublic function add_projects()\n{\n    $usersess_det=$this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n        $inps = $this->input->post();\n          \n        if($this->input->post())\n        {\n            $this->db->select(\'*\');\n            $this->db->where(\'project_irc_id\',$inps[\'pro_code\']); \n            $pro_details = $this->db->get(\'project_det\')->num_rows();\n\n            if($pro_details>0){\n                $this->session->set_flashdata(\'err\', \'Project Code Already Exists..!\');\n                redirect($this->config->item(\'base_url\').\'admin/add_project\');\n            } else {\n\n                $data=array(\n                    \'sid\'                 => $inps[\'state\'],\n                    \'project_name\'        => $inps[\'pro_name\'],\n                    \'project_irc_id\'      => $inps[\'pro_code\'],\n                    \'start_date\'          => $inps[\'start_date\'],\n                    \'end_date\'            => $inps[\'end_date\'],\n                    \'project_description\' => $inps[\'projectDescription\'],\n                    \'approver_id\'         => $inps[\'Approver_name\'],\n                    \'CreationBy\'          => $usersess_det[\'empdet_id\'],\n                    \'status\'              => 0\n                );\n\n                $sql_query = $this->db->insert(\'project_det\', $data);\n                $id = $this->db->insert_id();\n\n                if($sql_query > 0){\n\n                    // =============================================\n                    // SEND NOTIFICATION TO APPROVER\n                    // =============================================\n\n                    // Get approver\'s emp_id and role_type from employee_det\n                    $this->db->select(\'emp.emp_id, emp.role_type\');\n                    $this->db->where(\'emp.id\', $inps[\'Approver_name\']);\n                    $approver_emp = $this->db->get(\'employee_det as emp\')->row_array();\n\n                    // Default receiver_id to employee_det.id (for regular employees)\n                    $approver_receiver_id = $inps[\'Approver_name\'];\n\n                    // If approver is Management (role_type 1) or Manager (role_type 2),\n                    // use managers.mid so dashboard notification lookup works\n                    if (!empty($approver_emp) && in_array($approver_emp[\'role_type\'], [\'1\', \'2\'])) {\n                        $this->db->select(\'mid\');\n                        $this->db->where(\'emp_id\', $approver_emp[\'emp_id\']);\n                        $manager_row = $this->db->get(\'managers\')->row_array();\n                        if (!empty($manager_row)) {\n                            $approver_receiver_id = $manager_row[\'mid\'];\n                        }\n                    }\n\n                    // Insert notification type 3 = Project Approval Request\n                    $notification_data = array(\n                        \'type\'             => 3,\n                        \'initiator_id\'     => $usersess_det[\'empdet_id\'],\n                        \'receiver_id\'      => $approver_receiver_id,\n                        \'project_id\'       => $id,\n                        \'is_acknownledge\'  => 0\n                    );\n                    $this->db->insert(\'notification_det\', $notification_data);\n\n                    $this->session->set_flashdata(\'true\', \'Project Added Successfully! Approval notification sent to Approver.\');\n                    redirect($this->config->item(\'base_url\').\'admin/add_project\');\n\n                } else {\n                    $this->session->set_flashdata(\'err\',\'Something went wrong. Error!!\');\n                    redirect($this->config->item(\'base_url\').\'admin/add_project\');\n                }\n            } \n\n        } else {\n            $this->template->set_master_template(\'../../themes/\'.$this->config->item("active_template").\'/landing_template_login.php\');\n            $this->template->write_view(\'content\', \'admin/add_project\');\n            $this->template->render();\n        }\n\n    } else {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n\n\tpublic function approve_project($pid, $nid)\n\t{\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t\t$this->load->model(\'admin/admin_model\');\n\t\t\t\n\t\t\t// Mark notification as read\n\t\t\t$this->admin_model->update_notification_as_read($nid);\n\n\t\t\t// Update project status to approved (1)\n\t\t\t$this->admin_model->approve_project_db($pid);\n\n\t\t\t// Get Project Details to find initiator\n\t\t\t$this->db->where(\'pid\', $pid);\n\t\t\t$project = $this->db->get(\'project_det\')->row_array();\n\n\t\t\tif ($project) {\n\t\t\t\t// Look up the managers.mid for the project creator\n\t\t\t\t$this->db->select(\'emp.emp_id, emp.role_type\');\n\t\t\t\t$this->db->where(\'emp.id\', $project[\'CreationBy\']);\n\t\t\t\t$creator_emp = $this->db->get(\'employee_det as emp\')->row_array();\n\n\t\t\t\t$creator_receiver_id = $project[\'CreationBy\']; // fallback to employee_det.id\n\t\t\t\tif (!empty($creator_emp) && in_array($creator_emp[\'role_type\'], [\'1\', \'2\'])) {\n\t\t\t\t\t// Management or Manager — they use managers.mid on their dashboard\n\t\t\t\t\t$this->db->select(\'mid\');\n\t\t\t\t\t$this->db->where(\'emp_id\', $creator_emp[\'emp_id\']);\n\t\t\t\t\t$mgr_row = $this->db->get(\'managers\')->row_array();\n\t\t\t\t\tif (!empty($mgr_row)) {\n\t\t\t\t\t\t$creator_receiver_id = $mgr_row[\'mid\'];\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t// Insert Notification back to initiator (use project_id column to avoid FK constraint)\n\t\t\t\t$notification_data = array(\n\t\t\t\t\t\'type\' => 4, // Project Approved\n\t\t\t\t\t\'initiator_id\' => $usersess_det[\'empdet_id\'], // Approver\n\t\t\t\t\t\'receiver_id\' => $creator_receiver_id, // Use managers.mid for mgmt/mgr users\n\t\t\t\t\t\'project_id\' => $pid, // Project ID stored in dedicated project_id column\n\t\t\t\t\t\'is_acknownledge\' => 0\n\t\t\t\t);\n\t\t\t\t$this->db->insert(\'notification_det\', $notification_data);\n\t\t\t}\n\n\t\t\t$this->session->set_flashdata(\'true\', \'Project Approved Successfully!\');\n\t\t\t// Redirect to correct dashboard based on role\n\t\t\tif ($usersess_det[\'role_type\'] == \'1\') {\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/dashboard\');\n\t\t\t} else if ($usersess_det[\'role_type\'] == \'2\') {\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/mc_dashboard\');\n\t\t\t} else {\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/emp_dashboard\');\n\t\t\t}\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function decline_project($pid, $nid)\n\t{\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t\t$this->load->model(\'admin/admin_model\');\n\t\t\t\n\t\t\t// Mark notification as read\n\t\t\t$this->admin_model->update_notification_as_read($nid);\n\n\t\t\t// Update project status to declined (2)\n\t\t\t$this->admin_model->decline_project_db($pid);\n\n\t\t\t// Get Project Details to find initiator\n\t\t\t$this->db->where(\'pid\', $pid);\n\t\t\t$project = $this->db->get(\'project_det\')->row_array();\n\n\t\t\tif ($project) {\n\t\t\t\t// Look up the managers.mid for the project creator\n\t\t\t\t$this->db->select(\'emp.emp_id, emp.role_type\');\n\t\t\t\t$this->db->where(\'emp.id\', $project[\'CreationBy\']);\n\t\t\t\t$creator_emp = $this->db->get(\'employee_det as emp\')->row_array();\n\n\t\t\t\t$creator_receiver_id = $project[\'CreationBy\']; // fallback to employee_det.id\n\t\t\t\tif (!empty($creator_emp) && in_array($creator_emp[\'role_type\'], [\'1\', \'2\'])) {\n\t\t\t\t\t$this->db->select(\'mid\');\n\t\t\t\t\t$this->db->where(\'emp_id\', $creator_emp[\'emp_id\']);\n\t\t\t\t\t$mgr_row = $this->db->get(\'managers\')->row_array();\n\t\t\t\t\tif (!empty($mgr_row)) {\n\t\t\t\t\t\t$creator_receiver_id = $mgr_row[\'mid\'];\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t// Insert Notification back to initiator - type 5 = Project Declined\n\t\t\t\t$notification_data = array(\n\t\t\t\t\t\'type\' => 5, // Project Declined\n\t\t\t\t\t\'initiator_id\' => $usersess_det[\'empdet_id\'], // Decliner\n\t\t\t\t\t\'receiver_id\' => $creator_receiver_id,\n\t\t\t\t\t\'project_id\' => $pid,\n\t\t\t\t\t\'is_acknownledge\' => 0\n\t\t\t\t);\n\t\t\t\t$this->db->insert(\'notification_det\', $notification_data);\n\t\t\t}\n\n\t\t\t$this->session->set_flashdata(\'true\', \'Project Declined Successfully!\');\n\t\t\t// Redirect to correct dashboard based on role\n\t\t\tif ($usersess_det[\'role_type\'] == \'1\') {\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/dashboard\');\n\t\t\t} else if ($usersess_det[\'role_type\'] == \'2\') {\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/mc_dashboard\');\n\t\t\t} else {\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/emp_dashboard\');\n\t\t\t}\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\t public function project_reports(){\n\t \t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t \t\tif(isset($user_det) && !empty($user_det))\n\t\t\t{\n\t\t \t\t //echo"<pre>";  print_r($user_det); exit;\n\t\t \t\tif($user_det[\'department\']=="21" || $user_det[\'role_type\']=="1"){\n\n\t\t \t\t\t$this->load->model(\'admin/admin_model\'); \n\t\t\t\t\t$data[\'projects\'] = $this->admin_model->get_project_reports(); \n\t\t\t\t\t$this->template->write_view(\'content\', \'admin/project_reports\',$data);\n\t\t\t\t\t$this->template->render();\n\n\t\t \t\t} else {\n\n\t\t \t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\n\t\t \t\t}\n\t\t \t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n}\npublic function add_task_list(){\n\n\t \t$usersess_det=$this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t \t$this->template->write_view(\'content\',\'admin/add_list_details\');\n\t\t \t$this->template->render();\n\n\t \t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t }\n\n\t public function insert_task_list(){\n\t \t$user_det = $this->session->userdata(\'logged_in\');\n\t \tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t \t$inps = $this->input->post();\n\t\t  \n\t\t    if($this->input->post())\n\t    \t{\n\t    \t // echo"<pre>"; print_r($user_det); \n\t    \t // echo"<pre>"; print_r($inps);exit;\n\n\t\t   \t$this->db->select(\'*\');\n\t\t\t$this->db->where(\'department\',$user_det[\'department\']); \n\t\t\t$this->db->where(\'task_list\',$inps[\'task_list_name\']); \n\t\t\t$task_details = $this->db->get(\'dep_task\')->num_rows();\n\t\t\t//echo"<pre>"; print_r($emp_details); exit;\t\n\t\t   \tif($task_details>0){\n\n\t\t   \t\t\t$this->session->set_flashdata(\'err\', \'Task Name Already Exists..!\');\n\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/add_task_list\');\n\t\t   \t\t \n\t\t   \t\t\t\n\t\t   \t} else {\n\n\t\t   \t\t\t$data=array(\'department\'=>$user_det[\'department\'],\'task_list\'=>$inps[\'task_list_name\'],\'created_by\'=>$user_det[\'empdet_id\'],\'status\'=>1);\n\t\t   \t   \t\t//$this->db->last_query();\n\n\t\t\t\t   \t $sql_query=$this->db->insert(\'dep_task\',$data);\n\t\t\t\t   \t  $id = $this->db->insert_id();\n\t\t\t\t   \t  // echo"<pre>id";print_r($id);exit;\n\t\t\t\t   \tif($sql_query>0){\n\n\t\t\t\t   \t\n\t\t\t\t   \t\t $this->session->set_flashdata(\'true\', \'Task Name Added Successfully...!\');\n\t\t\t\t   \t\t redirect($this->config->item(\'base_url\').\'admin/add_task_list\');\n\t\t\t\t   \t\t //echo"success";exit;\n\t\t\t\t   \t\t}\n\t\t\t\t   \t\telse{\n\t\t\t\t   \t\t\t\n\t\t\t\t   \t\t\t$this->session->set_flashdata(\'err\',\'something went wrong.Error!!\');\n\t\t\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/add_task_list\');\n\t\t\t\t   \t\t\t//echo"Failed";exit;\n\t\t\t\t   \t\t}\n\t\t\t\t  \t } \n\t\t   \t} else {\n\n\t\t   \t\t $this->template->set_master_template(\'../../themes/\'.$this->config->item("active_template").\'/landing_template_login.php\');\n\t\t\t\t$this->template->write_view(\'content\', \'admin/add_task_list\');\n\t\t\t\t$this->template->render();\n\t\t   \t}\n\n\t   \t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t }\n\n\n\n\tpublic function additonal_task()\n\t {\n\n\t \t$usersess_det=$this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t\t$data[\'department\'] = $this->admin_model->getdepartments(); \n\t\t\t$data[\'groupedItems\']     =$this->admin_model->get_projects();\n\t \t\t$data[\'task_data\']     =$this->admin_model->get_all_task_list();\n\t \t\t//$data[\'activity\']     =$this->admin_model->get_activity_list();\n\t \t\t // echo"<pre>task_data"; print_r($data[\'department\']);exit; \n\t\t \t$this->template->write_view(\'content\',\'admin/add_additonal_task\',$data);\n\t\t \t$this->template->render();\n\n\t \t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t }\n\n\tpublic function get_emp_data(){\n\t\t\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$department=$this->input->post(\'department\');\n\t\t$emp_array = $this->admin_model->get_emp_details($department); \n\t\t$emp_select=\'<option value="0">Select Assignee</option>\';\n\n\t\t    if(isset($emp_array) && !empty($emp_array))\n\t\t    {\n\t\t      foreach($emp_array as $val)\n\t\t      {\n\t\t        $emp_select=$emp_select."<option value=\'".$val[\'id\']."~".$val[\'emp_name\']."\'>".$val[\'emp_name\']."</option>";\n\t\t      }\n\t\t        \n\t\t    }\n\n\t\t   // $man_select=$man_select.\'</select><span id="report_mgr_err"></span>\';\n\t\t    echo $emp_select;\n\t}\n\n\n\tpublic function gettask_list(){\n\t\t\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$department=$this->input->post(\'department\');\n\t\t$tas_array = $this->admin_model->get_task_list($department); \n\t\t$tas_select=\'<option value="0">Select Task</option>\';\n\n\t\t    if(isset($tas_array) && !empty($tas_array))\n\t\t    {\n\t\t      foreach($tas_array