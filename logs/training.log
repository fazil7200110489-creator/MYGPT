message='<?php if ( ! defined(\'BASEPATH\')) exit(\'No direct script access allowed\');\n\nclass Admin extends MX_Controller\n{\n\tfunction __construct()\n\t{\n\t\tparent::__construct();\n\t\t$this->check_probation_access();\n\t\t$this->load->helper(\'form\');\n\t\t$this->load->helper(\'url\');\n\t\t$this->load->library(\'session\');\n\t\t$this->load->library(\'email\');\n    \t$this->load->database();\n\t\t$this->load->library(\'form_validation\');\n\t\t$this->load->library(\'pagination\');\n\t\t// $this->load->library(\'pdf\');\n\t\t$check_session = $this->session->userdata(\'logged_in\');\n\t\t$this->load->helper(\'cookie\');\n\t\t$this->load->helper(\'string\');\n\t\t$this->load->library(\'encrypt\');\n\t\t$this->load->library(\'user_agent\');\n\t\tdate_default_timezone_set("Asia/Kolkata");\n\t \t$this->load->model(\'admin/admin_model\');\n\t}\n\n\n\tpublic function index()\n\t{\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t\n\t\t$this->template->set_master_template(\'../../themes/\'.$this->config->item("active_template").\'/landing_template_login.php\');\n\t\t$this->template->write_view(\'content\', \'admin/index\');\n\t\t$this->template->render();\n\t}\n\n\n\t\tpublic function verify_login()\n\t{\n\n\t\t   $inps = $this->input->post();\n\t\t   $username = $inps[\'username\'];\n\t\t    $yourpassword = $inps[\'yourpassword\'];\n\t\t     //echo "<pre>HELLO"; print_r($yourpassword);  exit;\n\t\t   // echo "<pre>HELLO"; print_r(md5($yourpassword)); \n\t\t  if($username!="")\n\t\t\t{ \n\n\t\t\t// Step 1: Check if credentials (emp_id + password) are correct, ignoring status\n\t\t\t$this->db->select(\'emp.*\');\n\t\t\t$this->db->where(\'emp.emp_id\', $username);\n\t\t\t$this->db->where(\'emp.passwd\', md5($yourpassword));\n\t\t\t$credquery = $this->db->get(\'employee_det as emp\')->result_array();\n\n\t\t\tif (!empty($credquery)) {\n\t\t\t\t// Credentials are correct — Step 2: Check if account is active\n\t\t\t\tif ($credquery[0][\'status\'] != 1) {\n\t\t\t\t\t// Account exists but is INACTIVE — show specific message\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Your account has been deactivated. Please contact HR / Admin.\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t\t}\n\n\t\t\t\t// Account is ACTIVE — proceed with login\n\t\t\t\t$userquery = $credquery;\n\n\t\t\t\t$this->db->select(\'dept.id,dept.department_name\');  \n\t \t \t   \t$this->db->where(\'dept.id\', $userquery[0][\'department\']);\n     \t \t    $query = $this->db->get(\'department_det as dept\')->result_array();\n\t\t\t    //echo $this->db->last_query(); exit;\n\n\t\t\t\t$sess_array = array(\'empdet_id\'=>$userquery[0][\'id\'],\'emp_id\'=>$userquery[0][\'emp_id\'],\'emp_name\'=>$userquery[0][\'emp_name\'],\'email_id\'=>$userquery[0][\'email_id\'],\'department\'=>$userquery[0][\'department\'],\'department_name\'=>$query[0][\'department_name\'],\'designation\'=>$userquery[0][\'designation\'],\'report_mgr_id\'=>$userquery[0][\'report_mgr_id\'],\'join_dt\'=>$userquery[0][\'join_dt\'],\'work_loc\'=>$userquery[0][\'work_loc\'],\'role_type\'=>$userquery[0][\'role_type\'],\'first_login_completed\'=>$userquery[0][\'first_login_completed\']);\n                    //echo "<pre>HELLO"; print_r($sess_array);\n                    $this->session->set_userdata(\'logged_in\', $sess_array);\n                    $employee_det = $this->session->userdata(\'logged_in\');\n                    //echo"<pre>sess";print_r($employee_det);\n                    $data[\'description\'] = "User ".$employee_det[\'emp_id\']." Logged in Successfully on ".date("Y M d H i s");\n                   \n                    $data[\'e_id\'] = $employee_det[\'empdet_id\'];\n                    $data[\'location\'] = $employee_det[\'work_loc\'];\n                    $curr_time = time();\n                    $login_time = date("Y-m-d H:i:s", $curr_time);\n                    //echo"<pre> Login Time";print_r($login_time);\n                    $data[\'login_time\'] = $login_time;\n                    $logout_time = strtotime("+15 minutes", strtotime($login_time));\n                    //echo"<pre> Logout Time";print_r($logout_time);\n                    $data[\'logout_time\'] = date("Y-m-d H:i:s", $logout_time);\n                    $data[\'status\'] = \'1\';\n                    $this->db->insert(\'login_log\', $data);\n\n                    if ($employee_det[\'role_type\'] == \'1\') {\n                    \tredirect($this->config->item(\'base_url\').\'admin/dashboard\');\n                    } else if ($employee_det[\'role_type\'] == \'2\') {\n                    \tredirect($this->config->item(\'base_url\').\'admin/mc_dashboard\');\n                    } else {\n                    \tredirect($this->config->item(\'base_url\').\'admin/emp_dashboard\');\n                    }\n\n\t\t\t} else {\n\t\t\t\t// Credentials are wrong (wrong emp_id or password)\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Login Credentials..!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t\t\t\t\n\t\t\t}\n\t\t  \t$this->template->set_master_template(\'../../themes/\'.$this->config->item("active_template").\'/landing_template_login.php\');\n\t\t\t$this->template->write_view(\'content\', \'admin/index\');\n\t\t\t$this->template->render();\n\t\t  \n\t\t   }\n\t\n\tpublic function dashboard()\n\t{\n    \t$this->load->model(\'admin/admin_model\');\n\t\t//  echo "<pre>HI";  \n\t\t$employee_det=$this->session->userdata(\'logged_in\');\n\n\t\t// echo "<pre>HELLO"; print_r($user_det); exit;\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{\n\t\t \t$data[\'sliders\'] = $this->admin_model->getsliders();\n\t\t \t$data[\'employees\'] = $this->admin_model->getemployees_count();\n\t\t \t$data[\'department\'] = $this->admin_model->getdepartments_count();\n\t\t\t$data[\'location\'] = $this->admin_model->getlocation_count();\n\t\t\t$data[\'projects\']     =$this->admin_model->getprojects_count();\n\t\t\t$data[\'work\']     =$this->admin_model->get_work_count();\n\t\t\t$data[\'login\']     =$this->admin_model->get_login_count(); \n\t\t\t$data[\'notsubmitted\']     =$this->admin_model->get_notsubmitted_count();\n\n\t\t\t//Code Added by Hariharan\n\n\t\t\t$data[\'leave_count\'] = $this->admin_model->get_leave_count();\n\t\t\t$data[\'project_count\'] = $this->admin_model->get_project_count();\n\t\t\t$data[\'onduty_count\'] = $this->admin_model->get_onduty_count();\n\t\t\t// Active / Inactive employee split for the KPI card\n\t\t\t$data[\'emp_status_counts\'] = $this->admin_model->get_employee_status_counts();\n\t\t\t// echo "<pre>Leave"; print_r($data[\'leave_count\']); exit;\n\t\t\t// echo "<pre>onduty_count"; print_r($data[\'onduty_count\']); exit;\n\t\t\t$data[\'notifications\'] = [];\n\n\t\t\t$this->db->select(\'man.*\');  \n \t\t   \t$this->db->where(\'man.emp_id\',$employee_det[\'emp_id\']);\n\t\t \t$query = $this->db->get(\'managers as man\')->result_array();\n\n\n\t\t\t// Get all unacknowledged notifications\n\t\t\t$notifications = $this->admin_model->get_notifications_id($query[0][\'mid\']);\n\n\t\t\t\tif (!empty($notifications)) {\n\t\t\t\t$notifications_array = [];\n\n\t\t\t\tforeach ($notifications as $notification) {\n\t\t\t\t\t// Basic notification info\n\t\t\t\t\t$notification_item =\n\t\t\t\t\t[\n\t\t\t\t\t\t\'notification_id\' => $notification[\'nid\'],\n\t\t\t\t\t\t\'type\' => $notification[\'type\'],\n\t\t\t\t\t\t\'task_id\' => $notification[\'task_id\'],\n\t\t\t\t\t\t\'initiator_id\' => $notification[\'initiator_id\'],\n\t\t\t\t\t\t\'timestamp\' => $this->format_notification_date($notification[\'creation_date\']),\n\t\t\t\t\t\t\'is_acknowledged\' => (bool) $notification[\'is_acknownledge\'],\n\t\t\t\t\t\t\'initiator_name\' => \'\',\n\t\t\t\t\t\t\'header\' => \'Notification\',\n\t\t\t\t\t\t\'body\' => \'\',\n\t\t\t\t\t\t\'project\' => \'\',\n\t\t\t\t\t\t\'priority\' => \'\',\n\t\t\t\t\t\t\'due_date\' => \'\',\n\t\t\t\t\t\t\'priority_label\' => \'\' // We\'ll add this below\n\t\t\t\t\t];\n\n\t\t\t\t\t// Get initiator name\n\t\t\t\t\t$employeeName = $this->admin_model->get_employee_name_by_id($notification[\'initiator_id\']);\n\t\t\t\t\t$notification_item[\'initiator_name\'] = $employeeName ?? \'Unknown\';\n\n\n\t\t\t\t\t// Handle different notification types\n\t\t\t\t\tswitch ($notification[\'type\']) {\n\t\t\t\t\t\tcase 1: // Additional task notification\n\t\t\t\t\t\t$additional_task = $this->admin_model->get_additional_tasks_notifier($notification[\'additional_id\']);\n\n\t\t\t\t\t\tif (!empty($additional_task)) {\n\t\t\t\t\t\t\t$task = $additional_task[0];\n\t\t\t\t\t\t\t$notification_item[\'header\'] = \'New Additional Task\';\n\t\t\t\t\t\t\t$notification_item[\'body\'] = $task[\'activityDesc\'] ?? \'No description\';\n\t\t\t\t\t\t\t$notification_item[\'project\'] = $task[\'project_name\'] ?? \'N/A\';\n\t\t\t\t\t\t\t$notification_item[\'priority\'] = $task[\'priority_type\'] ?? 0;\n\t\t\t\t\t\t\t$notification_item[\'due_date\'] = $this->format_due_date($task[\'due_date\']);\n\n\t\t\t\t\t\t\t// Add human-readable priority label\n\t\t\t\t\t\t\t// $notification_item[\'priority_label\'] = $this->get_priority_label($task[\'priority_type\'] ?? 0);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 2: // Leave form notification\n\t\t\t\t\t\t\t$leaveproject_task = $this->admin_model->get_leaveproject_tasks_notifier($notification[\'slpno\']);\n\t\t\t\t\t\t\t// echo "<pre>HELLO"; print_r($leaveproject_task); exit;\n\t\t\t\t\t\t\tif (!empty($leaveproject_task)) {\n\t\t\t\t\t\t\t\t$Task = $leaveproject_task[0];\n\n\t\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($Task[\'project_name\']);\n\t\t\t\t\t\t\t\t// echo "<pre>Task"; print_r($projectName); exit;\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $projectName[0][\'project_name\'] ?? \'N/A\';\n\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'New Project/Leave Task\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = $projectName[0][\'project_name\'] ?? \'No description\';\n\t\t\t\t\t\t\t\t$notification_item[\'project_name\'] = $Task[\'project_name\'] ?? \'N/A\';\n\t\t\t\t\t\t\t\t$notification_item[\'priority\'] = $Task[\'initiator_id\'] ?? 0;\n\t\t\t\t\t\t\t\t$notification_item[\'due_date\'] = $this->format_due_date($Task[\'to_date\']);\n\t\t\t\t\t\t\t\t// echo "<pre>HELLO"; print_r($notification_item); exit;\n\t\t\t\t\t\t\t\t// Add human-readable priority label\n\t\t\t\t\t\t\t\t// $notification_item[\'priority_label\'] = $this->get_priority_label($task[\'priority_type\'] ?? 0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\t// Add more cases as needed\n\t\t\t\t\t\tcase 3: // Project Approval Request\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Approval Required\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Please approve the project: <strong>\' . $project[\'project_name\'] . \'</strong>\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t$approve_url = $this->config->item(\'base_url\') . \'admin/approve_project/\' . $project[\'pid\'] . \'/\' . $notification[\'nid\'];\n\t\t\t\t\t\t\t\t$decline_url = $this->config->item(\'base_url\') . \'admin/decline_project/\' . $project[\'pid\'] . \'/\' . $notification[\'nid\'];\n\t\t\t\t\t\t\t\t// $notification_item[\'body\'] .= \'<br><a href="\'.$approve_url.\'" class="btn btn-sm btn-success mt-2" style="color:white; padding: 2px 10px; margin-right: 5px;">Approve Project</a>\';\n\t\t\t\t\t\t\t\t// $notification_item[\'body\'] .= \'<a href="\'.$decline_url.\'" class="btn btn-sm btn-danger mt-2" style="color:white; padding: 2px 10px;">Decline Project</a>\';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 4: // Project Approved\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Approved\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> was approved.\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 5: // Project Declined\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Declined\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> was declined.\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\t\tcase 6: // Project On Hold\n    $projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n    if (!empty($projectName)) {\n        $project = $projectName[0];\n        $notification_item[\'header\'] = \'Project On Hold\';\n        $notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> has been put on hold.\';\n        $notification_item[\'project\'] = $project[\'project_name\'];\n    }\n    break;\n\t\t\t\t\tcase 7:\n\n    $notification_item[\'header\'] =\n        \'Probation Assessment Submitted\';\n\n    $notification_item[\'body\'] =\n        $notification_item[\'initiator_name\'] .\n        \' has submitted a probation assessment.\';\n\n    break;\n\t\t\t\t\t}\n\n\t\t\t\t\t$notifications_array[] = $notification_item;\n\t\t\t\t}\n\n\t\t\t\t// Sort by timestamp (newest first)\n\t\t\t\tusort($notifications_array, function ($a, $b) {\n\t\t\t\t\treturn strtotime($b[\'timestamp\']) - strtotime($a[\'timestamp\']);\n\t\t\t\t});\n\n\t\t\t\t$data[\'notifications\'] = $notifications_array;\n\t\t\t\t// echo "<pre>notifications"; print_r($data[\'notifications\']); exit;\n\n\t\t\t}\n\n\t\t\t$managerId = $this->admin_model->get_manager_id_by_emp_id($employee_det[\'emp_id\']);\n\t\t\t// Get all team members for the manager\n\t\t\t$teamMembers = $this->admin_model->get_team_members($managerId);\n\t\t\t$teamMemberIds = array_column($teamMembers, \'id\');\n\n\t\t\t// Add the current user\'s ID to the array\n\t\t\t$currentUserId = $employee_det[\'empdet_id\'];\n\t\t\t$teamMemberIds[] = $currentUserId;\n\t\t\t// // Extract employee IDs into an array\n\t\t\t$data[\'open_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 1);         \n\t\t\t$data[\'in_progress_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 2);\n\t\t\t$data[\'closed_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 3);      \n\t\t\t$data[\'canceled_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 4);   \n\t\t\t$data[\'tdy_open_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 1,true);         \n\t\t\t$data[\'tdy_in_progress_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 2,true);\n\t\t\t$data[\'tdy_closed_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 3,true);      \n\t\t\t$data[\'tdy_canceled_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 4,true);   \n\n\t\t\t// // Count tickets for the team based on their statuses\n\t\t\t$data[\'team_open_ticket_count\'] = $this->admin_model->get_team_ticket_count($teamMemberIds, 1);         \n\t\t\t$data[\'team_in_progress_ticket_count\'] = $this->admin_model->get_team_ticket_count($teamMemberIds, 2);\n\t\t\t$data[\'team_closed_ticket_count\'] = $this->admin_model->get_team_ticket_count($teamMemberIds, 3);      \n\t\t\t$data[\'team_canceled_ticket_count\'] = $this->admin_model->get_team_ticket_count($teamMemberIds, 4);   \n\t\t\t$data[\'tdy_team_open_ticket_count\'] = $this->admin_model->get_team_ticket_count($teamMemberIds, 1,true);         \n\t\t\t$data[\'tdy_team_in_progress_ticket_count\'] = $this->admin_model->get_team_ticket_count($teamMemberIds, 2,true);\n\t\t\t$data[\'tdy_team_closed_ticket_count\'] = $this->admin_model->get_team_ticket_count($teamMemberIds, 3,true);      \n\t\t\t$data[\'tdy_team_canceled_ticket_count\'] = $this->admin_model->get_team_ticket_count($teamMemberIds, 4,true);   \n\n\t\t\t// // Count tickets for the Received "System Admin" based on their statuses\n\t\t\t$data[\'emp_open_ticket_count\'] = $this->admin_model->get_employees_ticket_count($employee_det[\'empdet_id\'], 1);         \n\t\t\t$data[\'emp_in_progress_ticket_count\'] = $this->admin_model->get_employees_ticket_count($employee_det[\'empdet_id\'], 2);\n\t\t\t$data[\'emp_closed_ticket_count\'] = $this->admin_model->get_employees_ticket_count($employee_det[\'empdet_id\'], 3);      \n\t\t\t$data[\'emp_canceled_ticket_count\'] = $this->admin_model->get_employees_ticket_count($employee_det[\'empdet_id\'], 4);   \n\t\t\t$data[\'tdy_emp_open_ticket_count\'] = $this->admin_model->get_employees_ticket_count($employee_det[\'empdet_id\'], 1,true);         \n\t\t\t$data[\'tdy_emp_in_progress_ticket_count\'] = $this->admin_model->get_employees_ticket_count($employee_det[\'empdet_id\'], 2,true);\n\t\t\t$data[\'tdy_emp_closed_ticket_count\'] = $this->admin_model->get_employees_ticket_count($employee_det[\'empdet_id\'], 3,true);      \n\t\t\t$data[\'tdy_emp_canceled_ticket_count\'] = $this->admin_model->get_employees_ticket_count($employee_det[\'empdet_id\'], 4,true);   \n\n\n\t\t\t // ADD THIS FLASH MESSAGE CODE HERE\n        $today = date(\'Y-m-d\');\n        $this->db->where(\'expiry_date >=\', $today);\n        $this->db->where(\'status\', 1);\n        $data[\'flash_messages\'] = $this->db->get(\'flash_messages\')->result_array();\n\n// LOGIN CHART DATA - LAST 30 DAYS\n// LOGIN CHART DATA - LAST 7 DAYS\n$this->db->select("DATE(login_time) as log_date, COUNT(*) as total");\n$this->db->from("login_log");\n$this->db->where("login_time >=", date(\'Y-m-d\', strtotime(\'-7 days\')));\n$this->db->group_by("DATE(login_time)");\n$this->db->order_by("DATE(login_time)", "ASC");\n$query = $this->db->get();\n$data[\'login_chart\'] = $query->result_array();\n\n// ==========================================\n// ADDITIONAL DATA FOR EXECUTIVE ANALYTICS\n// ==========================================\n\n// 1. Employee Attendance Trend (Area Chart) - Default to Last 7 Days\n$this->db->select("a.Date as att_date, \n                  SUM(CASE WHEN a.Status LIKE \'P%\' OR a.Status = \'OD\' OR a.Status = \'WFH\' OR a.Status = \'PN:P\' THEN 1 ELSE 0 END) as present_count,\n                  COUNT(*) as total_count");\n$this->db->from("EmployeeAttendance a");\n$this->db->join("employee_det ea", "ea.emp_id = a.EmployeeNo");\n$this->db->where("ea.status", 1); // Only active employees\n$this->admin_model->apply_date_filter("a.Date", "last7days");\n$this->db->group_by("a.Date");\n$this->db->order_by("a.Date", "ASC");\n$data[\'attendance_trend\'] = $this->db->get()->result_array();\n\n// 2. Ticket Status Distribution (Donut Chart) - Default to Last 7 Days\n$this->db->select("t.status, COUNT(*) as count");\n$this->db->from("tickets t");\n$this->db->join("employee_det e", "e.id = t.raised_by");\n$this->db->where("e.status", 1); // Only tickets from active employees\n$this->admin_model->apply_date_filter("t.created_at", "last7days");\n$this->db->group_by("t.status");\n$data[\'ticket_status_dist\'] = $this->db->get()->result_array();\n\n// 3. Project Progress (ApexCharts Brush Line Chart Series)\n// Find top 10 projects by task count in current month (active employees only)\n$this->db->select("td.project_name, COUNT(*) as count");\n$this->db->from("task_details td");\n$this->db->join("employee_det eact", "eact.id = td.e_id");\n$this->db->where("eact.status", 1); // Only active employees\n$this->admin_model->apply_date_filter("td.created_date", "currentmonth");\n$this->db->group_by("td.project_name");\n$this->db->order_by("count", "DESC");\n$this->db->limit(10);\n$top_proj_res = $this->db->get()->result_array();\n$top_proj_ids = array_column($top_proj_res, \'project_name\');\n\n$initial_series = [];\nif (!empty($top_proj_ids)) {\n\t$this->db->select("t.project_name, p.project_name as proj_title, DATE(t.created_date) as task_date, t.status");\n\t$this->db->from("task_details t");\n\t$this->db->join("project_det p", "p.pid = t.project_name");\n\t$this->db->join("employee_det eact2", "eact2.id = t.e_id");\n\t$this->db->where("eact2.status", 1); // Only active employees\n\t$this->db->where_in(\'t.project_name\', $top_proj_ids);\n\t$this->admin_model->apply_date_filter("t.created_date", "currentmonth");\n\t$this->db->order_by(\'DATE(t.created_date)\', \'ASC\');\n\t$tasks = $this->db->get()->result_array();\n\n\t$project_data = [];\n\t$project_titles = [];\n\tforeach ($tasks as $t) {\n\t\t$pid = $t[\'project_name\'];\n\t\t$project_titles[$pid] = $t[\'proj_title\'];\n\t\t$date = $t[\'task_date\'];\n\t\tif (empty($date)) continue;\n\n\t\tif (!isset($project_data[$pid])) {\n\t\t\t$project_data[$pid] = [];\n\t\t}\n\t\tif (!isset($project_data[$pid][$date])) {\n\t\t\t$project_data[$pid][$date] = [\'completed\' => 0, \'total\' => 0];\n\t\t}\n\t\tif ($t[\'status\'] == 1) {\n\t\t\t$project_data[$pid][$date][\'completed\']++;\n\t\t}\n\t\t$project_data[$pid][$date][\'total\']++;\n\t}\n\n\tforeach ($project_data as $pid => $dates) {\n\t\tksort($dates);\n\t\t$cum_completed = 0;\n\t\t$cum_total = 0;\n\t\t$data_points = [];\n\t\tforeach ($dates as $date => $counts) {\n\t\t\t$cum_completed += $counts[\'completed\'];\n\t\t\t$cum_total += $counts[\'total\'];\n\t\t\t$progress_pct = $cum_total > 0 ? round(($cum_completed / $cum_total) * 100, 1) : 0;\n\t\t\t$data_points[] = [\n\t\t\t\t\'x\' => $date,\n\t\t\t\t\'y\' => $progress_pct\n\t\t\t];\n\t\t}\n\t\t$initial_series[] = [\n\t\t\t\'name\' => $project_titles[$pid],\n\t\t\t\'data\' => $data_points\n\t\t];\n\t}\n}\n$data[\'project_progress_series\'] = $initial_series;\n\n// Also fetch active projects list for dropdown filter\n$this->db->select(\'pid, project_name\');\n$this->db->from(\'project_det\');\n$this->db->where(\'status\', 1);\n$this->db->order_by(\'project_name\', \'ASC\');\n$data[\'projects_list\'] = $this->db->get()->result_array();\n\n// 4. Department Workload (Treemap Chart) - active employees only\n$this->db->select("d.id as department_id, d.department_name, COUNT(t.id) as task_count");\n$this->db->from("task_details t");\n$this->db->join("employee_det e", "e.id = t.e_id");\n$this->db->join("department_det d", "d.id = e.department");\n$this->db->where("e.status", 1); // Only active employees\n$this->db->group_by("d.id, d.department_name");\n$this->db->order_by("task_count", "DESC");\n$data[\'department_workload\'] = $this->db->get()->result_array();\n\n// 5. Employee Performance Ranking (ApexCharts Mixed Line + Column Chart)\n$this->db->select("e.emp_name, e.emp_id as employee_id, e.id as emp_db_id");\n$this->db->from("employee_det e");\n$this->db->where("e.status", 1);\n$active_emps = $this->db->get()->result_array();\n\n// Also fetch active employees list for searchable filter dropdown\n$this->db->select(\'id, emp_name\');\n$this->db->from(\'employee_det\');\n$this->db->where(\'status\', 1);\n$this->db->order_by(\'emp_name\', \'ASC\');\n$data[\'active_employees_list\'] = $this->db->get()->result_array();\n\n$employees_performance_initial = [];\nforeach ($active_emps as $emp) {\n\t$emp_id = $emp[\'emp_db_id\'];\n\t$this->db->select("\n\t\tSUM(CASE WHEN status = 1 THEN 1 ELSE 0 END) as completed,\n\t\tCOUNT(id) as total\n\t");\n\t$this->db->from(\'task_details\');\n\t$this->db->where(\'e_id\', $emp_id);\n\t$this->admin_model->apply_date_filter("created_date", "currentmonth");\n\t$counts = $this->db->get()->row_array();\n\n\t$total = (int)$counts[\'total\'];\n\t$completed = (int)$counts[\'completed\'];\n\t$perf_pct = $total > 0 ? round(($completed / $total) * 100, 1) : 0;\n\n\t$employees_performance_initial[] = [\n\t\t\'emp_name\' => $emp[\'emp_name\'],\n\t\t\'employee_id\' => $emp[\'employee_id\'],\n\t\t\'emp_db_id\' => $emp_id,\n\t\t\'completed_tasks\' => $completed,\n\t\t\'perf_pct\' => $perf_pct\n\t];\n}\n\n\nusort($employees_performance_initial, function($a, $b) {\n\tif ($a[\'completed_tasks\'] != $b[\'completed_tasks\']) {\n\t\treturn $b[\'completed_tasks\'] <=> $a[\'completed_tasks\'];\n\t}\n\treturn $b[\'perf_pct\'] <=> $a[\'perf_pct\'];\n});\n\n$data[\'employees_performance_initial\'] = $employees_performance_initial;\n\n// 6. Monthly Productivity Trend (Line Chart) - active employees only\n$this->db->select("DATE_FORMAT(td.created_date, \'%Y-%m\') as month_name,\n                  SUM(CASE WHEN td.status = 1 THEN 1 ELSE 0 END) as completed_count,\n                  SUM(CASE WHEN td.status = 0 THEN 1 ELSE 0 END) as pending_count,\n                  SUM(CASE WHEN td.status = 2 THEN 1 ELSE 0 END) as called_off_count");\n$this->db->from("task_details td");\n$this->db->join("employee_det eprod", "eprod.id = td.e_id");\n$this->db->where("eprod.status", 1); // Only active employees\n$this->db->where("td.created_date IS NOT NULL");\n$this->db->group_by("DATE_FORMAT(td.created_date, \'%Y-%m\')");\n$this->db->order_by("month_name", "ASC");\n$this->db->limit(12);\n$data[\'monthly_productivity\'] = $this->db->get()->result_array();\n\n// 7. Recent Activities\n// Latest Tickets\n// $this->db->select("t.*, e.emp_name as raised_by_name");\n// $this->db->from("tickets t");\n// $this->db->join("employee_det e", "e.emp_id = t.raised_by", "left");\n$this->db->select("t.*, e.emp_name as raised_by_name");\n$this->db->from("tickets t");\n$this->db->join("employee_det e", "e.id = t.raised_by");\n$this->db->where("e.status", 1); // Only from active employees\n$this->db->order_by("t.created_at", "DESC");\n$this->db->limit(5);\n$data[\'recent_tickets\'] = $this->db->get()->result_array();\n\n// Latest Leave Requests - active employees only\n$this->db->select("l.*, e.emp_name");\n$this->db->from("LeaveProjectRequest_Form l");\n$this->db->join("employee_det e", "e.id = l.emp_id");\n$this->db->where("l.entry_type", 3);\n$this->db->where("e.status", 1); // Only active employees\n$this->db->order_by("l.CreationDate", "DESC");\n$this->db->limit(5);\n$data[\'recent_leaves\'] = $this->db->get()->result_array();\n\n// Latest Project Requests - active employees only\n$this->db->select("l.*, e.emp_name, p.project_name as pname");\n$this->db->from("LeaveProjectRequest_Form l");\n$this->db->join("employee_det e", "e.id = l.emp_id");\n$this->db->join("project_det p", "p.pid = l.project_name", "left");\n$this->db->where("l.entry_type", 1);\n$this->db->where("e.status", 1); // Only active employees\n$this->db->order_by("l.CreationDate", "DESC");\n$this->db->limit(5);\n$data[\'recent_projects\'] = $this->db->get()->result_array();\n\n// Latest Additional Tasks - active employees only\n$this->db->select("a.*, e.emp_name");\n$this->db->from("additional_task_details a");\n$this->db->join("employee_det e", "e.id = a.e_id");\n$this->db->where("e.status", 1); // Only active employees\n$this->db->order_by("a.created_date", "DESC");\n$this->db->limit(5);\n$data[\'recent_additional_tasks\'] = $this->db->get()->result_array();\n\n// Latest Employee Logins - active employees only\n$this->db->select("l.*, e.emp_name");\n$this->db->from("login_log l");\n$this->db->join("employee_det e", "e.id = CAST(l.e_id AS UNSIGNED)");\n$this->db->where("e.status", 1); // Only active employees\n$this->db->order_by("l.login_time", "DESC");\n$this->db->limit(5);\n// Employee Performance Analytics data\n$data[\'hr_performance\'] = $this->admin_model->get_hr_performance_summary(\'currentmonth\');\n$data[\'hr_departments\'] = $this->admin_model->getdepartments();\n$data[\'hr_managers\'] = $this->admin_model->get_managers();\n$data[\'hr_employees\'] = $this->admin_model->getemployees();\n\n\t\t\t$this->template->write_view(\'content\', \'admin/dashboard\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function mc_dashboard()\n\t{\n    \t$this->load->model(\'admin/admin_model\');\n\t\t//  echo "<pre>HI";  \n\t\t$employee_det=$this->session->userdata(\'logged_in\');\n\n\t\t // echo "<pre>HELLO"; print_r($employee_det); exit;\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{ \n\n\t\t\t$this->db->select(\'man.*\');  \n \t\t   \t$this->db->where(\'man.emp_id\',$employee_det[\'emp_id\']);\n\t\t \t$query = $this->db->get(\'managers as man\')->result_array();\n\n\n\t\t\t$data[\'sliders\'] = $this->admin_model->getsliders();\n\t\t\t $data[\'emp_task\']     =$this->admin_model->get_empwork_count($employee_det[\'empdet_id\']);\n\t\t\t $data[\'calledoff_count\'] = $this->admin_model->get_calledoff_count();\n\t\t\t $data[\'notifications\'] = [];\n\n\n\t\t\t// Get all unacknowledged notifications\n\t\t\t$notifications = $this->admin_model->get_notifications_id($query[0][\'mid\']);\n\n\t\t\tif (!empty($notifications)) {\n\t\t\t\t$notifications_array = [];\n\n\t\t\t\tforeach ($notifications as $notification) {\n\t\t\t\t\t// Basic notification info\n\t\t\t\t\t$notification_item =\n\t\t\t\t\t[\n\t\t\t\t\t\t\'notification_id\' => $notification[\'nid\'],\n\t\t\t\t\t\t\'type\' => $notification[\'type\'],\n\t\t\t\t\t\t\'task_id\' => $notification[\'task_id\'],\n\t\t\t\t\t\t\'initiator_id\' => $notification[\'initiator_id\'],\n\t\t\t\t\t\t\'timestamp\' => $this->format_notification_date($notification[\'creation_date\']),\n\t\t\t\t\t\t\'is_acknowledged\' => (bool) $notification[\'is_acknownledge\'],\n\t\t\t\t\t\t\'initiator_name\' => \'\',\n\t\t\t\t\t\t\'header\' => \'Notification\',\n\t\t\t\t\t\t\'body\' => \'\',\n\t\t\t\t\t\t\'project\' => \'\',\n\t\t\t\t\t\t\'priority\' => \'\',\n\t\t\t\t\t\t\'due_date\' => \'\',\n\t\t\t\t\t\t\'priority_label\' => \'\' // We\'ll add this below\n\t\t\t\t\t];\n\n\t\t\t\t\t// Get initiator name\n\t\t\t\t\t$employeeName = $this->admin_model->get_employee_name_by_id($notification[\'initiator_id\']);\n\t\t\t\t\t$notification_item[\'initiator_name\'] = $employeeName ?? \'Unknown\';\n\t\t\t\t\t//echo "<pre>"; print_r($additional_task);\n\n\t\t\t\t\t// Handle different notification types\n\t\t\t\t\tswitch ($notification[\'type\']) {\n\t\t\t\t\t\tcase 1: // Additional task notification\n\t\t\t\t\t\t$additional_task = $this->admin_model->get_additional_tasks_notifier($notification[\'additional_id\']);\n\n\t\t\t\t\t\t//echo "<pre>"; print_r($additional_task); exit;\n\t\t\t\t\t\tif (!empty($additional_task)) {\n\t\t\t\t\t\t\t$task = $additional_task[0];\n\t\t\t\t\t\t\t$notification_item[\'header\'] = \'New Additional Task\';\n\t\t\t\t\t\t\t$notification_item[\'body\'] = $task[\'activityDesc\'] ?? \'No description\';\n\t\t\t\t\t\t\t$notification_item[\'project\'] = $task[\'project_name\'] ?? \'N/A\';\n\t\t\t\t\t\t\t$notification_item[\'priority\'] = $task[\'priority_type\'] ?? 0;\n\t\t\t\t\t\t\t$notification_item[\'due_date\'] = $this->format_due_date($task[\'due_date\']);\n\n\t\t\t\t\t\t\t// Add human-readable priority label\n\t\t\t\t\t\t\t// $notification_item[\'priority_label\'] = $this->get_priority_label($task[\'priority_type\'] ?? 0);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 2: // Leave form notification\n\t\t\t\t\t\t\t$leaveproject_task = $this->admin_model->get_leaveproject_tasks_notifier($notification[\'slpno\']);\n\t\t\t\t\t\t\t// echo "<pre>HELLO"; print_r($leaveproject_task); exit;\n\t\t\t\t\t\t\tif (!empty($leaveproject_task)) {\n\t\t\t\t\t\t\t\t$Task = $leaveproject_task[0];\n\n\t\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($Task[\'project_name\']);\n\t\t\t\t\t\t\t\t// echo "<pre>Task"; print_r($projectName); exit;\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $projectName[0][\'project_name\'] ?? \'N/A\';\n\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'New Project/Leave Task\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = $projectName[0][\'project_name\'] ?? \'No description\';\n\t\t\t\t\t\t\t\t$notification_item[\'project_name\'] = $Task[\'project_name\'] ?? \'N/A\';\n\t\t\t\t\t\t\t\t$notification_item[\'priority\'] = $Task[\'initiator_id\'] ?? 0;\n\t\t\t\t\t\t\t\t$notification_item[\'due_date\'] = $this->format_due_date($Task[\'to_date\']);\n\t\t\t\t\t\t\t\t// echo "<pre>HELLO"; print_r($notification_item); exit;\n\t\t\t\t\t\t\t\t// Add human-readable priority label\n\t\t\t\t\t\t\t\t// $notification_item[\'priority_label\'] = $this->get_priority_label($task[\'priority_type\'] ?? 0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\t// Add more cases as needed\n\t\t\t\t\t\tcase 3: // Project Approval Request\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Approval Required\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Please approve the project: <strong>\' . $project[\'project_name\'] . \'</strong>\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t$approve_url = $this->config->item(\'base_url\') . \'admin/approve_project/\' . $project[\'pid\'] . \'/\' . $notification[\'nid\'];\n\t\t\t\t\t\t\t\t$decline_url = $this->config->item(\'base_url\') . \'admin/decline_project/\' . $project[\'pid\'] . \'/\' . $notification[\'nid\'];\n\t\t\t\t\t\t\t\t// $notification_item[\'body\'] .= \'<br><a href="\'.$approve_url.\'" class="btn btn-sm btn-success mt-2" style="color:white; padding: 2px 10px; margin-right: 5px;">Approve Project</a>\';\n\t\t\t\t\t\t\t\t// $notification_item[\'body\'] .= \'<a href="\'.$decline_url.\'" class="btn btn-sm btn-danger mt-2" style="color:white; padding: 2px 10px;">Decline Project</a>\';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 4: // Project Approved\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Approved\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> was approved.\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 5: // Project Declined\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Declined\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> was declined.\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\t\tcase 6: // Project On Hold\n    $projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n    if (!empty($projectName)) {\n        $project = $projectName[0];\n        $notification_item[\'header\'] = \'Project On Hold\';\n        $notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> has been put on hold.\';\n        $notification_item[\'project\'] = $project[\'project_name\'];\n    }\n    break;\n\t\t\t\t\tcase 7:\n\n    $notification_item[\'header\'] =\n        \'Probation Assessment Submitted\';\n\n    $notification_item[\'body\'] =\n        $notification_item[\'initiator_name\'] .\n        \' has submitted a probation assessment.\';\n\n    break;\n\t\t\t\t\t}\n\n\t\t\t\t\t$notifications_array[] = $notification_item;\n\t\t\t\t}\n\n\t\t\t\t// Sort by timestamp (newest first)\n\t\t\t\tusort($notifications_array, function ($a, $b) {\n\t\t\t\t\treturn strtotime($b[\'timestamp\']) - strtotime($a[\'timestamp\']);\n\t\t\t\t});\n\n\t\t\t\t$data[\'notifications\'] = $notifications_array;\n\t\t\t\t// echo "<pre>notifications"; print_r($data[\'notifications\']); exit;\n\n\t\t\t}\n\n\t\t\t $managerId = $this->admin_model->get_manager_id_by_emp_id($employee_det[\'emp_id\']);\n\t\t\t// Get all team members for the manager\n\t\t\t$teamMembers = $this->admin_model->get_team_members($managerId);\n\t\t\t// // Extract employee IDs into an array\n\t\t\t$onlyTeamIds = array_column($teamMembers, \'id\');\n\t\t\t$currentUserId = $employee_det[\'empdet_id\'];\n\t\t\t$teamMemberIds[] = $currentUserId;\n\t\t\t$data[\'open_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 1);          // Open status\n\t\t\t$data[\'in_progress_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 2);  // In Progress status\n\t\t\t$data[\'closed_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 3);       // Closed status\n\t\t\t$data[\'canceled_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 4);     // Canceled status\n\t\t\t$data[\'tdy_open_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 1,true);         \n\t\t\t$data[\'tdy_in_progress_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 2,true);\n\t\t\t$data[\'tdy_closed_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 3,true);      \n\t\t\t$data[\'tdy_canceled_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 4,true);   \n\n\t\t\t// // Count tickets for the team based on their statuses (excluding manager\'s own tickets)\n\t\t\t$data[\'team_open_ticket_count\'] = $this->admin_model->get_team_ticket_count($onlyTeamIds, 1);          // Open status\n\t\t\t$data[\'team_in_progress_ticket_count\'] = $this->admin_model->get_team_ticket_count($onlyTeamIds, 2);  // In Progress status\n\t\t\t$data[\'team_closed_ticket_count\'] = $this->admin_model->get_team_ticket_count($onlyTeamIds, 3);       // Closed status\n\t\t\t$data[\'team_canceled_ticket_count\'] = $this->admin_model->get_team_ticket_count($onlyTeamIds, 4);     // Canceled status\n\t\t\t$data[\'tdy_team_open_ticket_count\'] = $this->admin_model->get_team_ticket_count($onlyTeamIds, 1,true);         \n\t\t\t$data[\'tdy_team_in_progress_ticket_count\'] = $this->admin_model->get_team_ticket_count($onlyTeamIds, 2,true);\n\t\t\t$data[\'tdy_team_closed_ticket_count\'] = $this->admin_model->get_team_ticket_count($onlyTeamIds, 3,true);      \n\t\t\t$data[\'tdy_team_canceled_ticket_count\'] = $this->admin_model->get_team_ticket_count($onlyTeamIds, 4,true);   \n\n\t\t\t// // Count tickets for the Received "System Admin" based on their statuses\n\t\t\t$data[\'rec_open_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 1);          // Open status\n\t\t\t$data[\'rec_in_progress_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 2);  // In Progress status\n\t\t\t$data[\'rec_closed_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 3);       // Closed status\n\t\t\t$data[\'rec_canceled_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 4);     // Canceled status\n\t\t\t$data[\'tdy_rec_open_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 1,true);          // Open status\n\t\t\t$data[\'tdy_rec_in_progress_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 2,true);  // In Progress status\n\t\t\t$data[\'tdy_rec_closed_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 3,true);       // Closed status\n\t\t\t$data[\'tdy_rec_canceled_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 4,true);     // Canceled status\n\n\t\t\t$today = date(\'Y-m-d\');\n\t\t\t$this->db->where(\'expiry_date >=\', $today);\n\t\t\t$this->db->where(\'status\', 1);\n\t\t\t$data[\'flash_messages\'] = $this->db->get(\'flash_messages\')->result_array();\n\n\t\t\t// Added detailed lists for charts and modal drill-downs (no raw DB queries in view)\n\t\t\t// Apply default Month filters to initial chart queries using apply_date_filter helper\n\t\t\t$this->admin_model->apply_date_filter(\'task.created_date\', \'currentmonth\');\n\t\t\t$data[\'team_tasks_list\'] = $this->admin_model->get_task_details_list($teamMemberIds);\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', \'currentmonth\');\n\t\t\t$data[\'my_tickets_list\'] = $this->admin_model->get_tickets($employee_det[\'empdet_id\']);\n\n\t\t\tif (!empty($onlyTeamIds)) {\n\t\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', \'currentmonth\');\n\t\t\t\t$data[\'team_tickets_list\'] = $this->admin_model->get_tickets($onlyTeamIds);\n\t\t\t} else {\n\t\t\t\t$data[\'team_tickets_list\'] = [];\n\t\t\t}\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', \'currentmonth\');\n\t\t\t$data[\'rec_tickets_list\'] = $this->admin_model->get_tickets($employee_det[\'empdet_id\'], null, true);\n\n\t\t\t// Fetch team task performance data and team member tasks list\n\t\t\tif (!empty($onlyTeamIds)) {\n\t\t\t\t$this->admin_model->apply_date_filter(\'created_date\', \'currentmonth\');\n\t\t\t\t$data[\'team_task_performance\'] = $this->admin_model->get_team_task_performance($onlyTeamIds);\n\n\t\t\t\t$this->admin_model->apply_date_filter(\'task.created_date\', \'currentmonth\');\n\t\t\t\t$data[\'team_member_tasks_list\'] = $this->admin_model->get_task_details_list($onlyTeamIds);\n\t\t\t} else {\n\t\t\t\t$data[\'team_task_performance\'] = [\'completed\' => 0, \'pending\' => 0, \'calledoff\' => 0, \'total\' => 0];\n\t\t\t\t$data[\'team_member_tasks_list\'] = [];\n\t\t\t}\n\t\t\t$data[\'team_members\'] = $teamMembers;\n\t\t\t$data[\'team_daily_verification\'] = $this->admin_model->get_manager_team_daily_work($query[0][\'mid\']);\n\n\t\t\t$this->template->write_view(\'content\', \'admin/mc_dashboard\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function ajax_mc_chart_data()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$emp_id = $employee_det[\'empdet_id\'];\n\t\t$chart_type = $this->input->get(\'chart_type\');\n\t\t$time_filter = $this->input->get(\'time_filter\');\n\t\t$from_date = $this->input->get(\'from_date\');\n\t\t$to_date = $this->input->get(\'to_date\');\n\t\t$employee_id = $this->input->get(\'employee_id\');\n\n\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t$managerId = $this->admin_model->get_manager_id_by_emp_id($employee_det[\'emp_id\']);\n\t\t$teamMembers = $this->admin_model->get_team_members($managerId);\n\t\t$onlyTeamIds = array_column($teamMembers, \'id\');\n\n\t\tif ($chart_type === \'task_status\') {\n\t\t\t$this->db->select(\'task.*\');\n\t\t\t$this->db->select(\'employee_det.emp_id, employee_det.emp_name, employee_det.department, employee_det.designation\');\n\t\t\t$this->db->select(\'department_det.department_name\');\n\t\t\t$this->db->select(\'dep_task.task_list\');\n\t\t\t$this->db->select(\'activity_det.activity_list\');\n\t\t\t$this->db->select(\'project_det.project_name as pname\');\n\t\t\t$this->db->select(\'tickets.ticket_id as t_ticket_id, tickets.title as ticket_title\');\n\n\t\t\t$this->db->join(\'tickets\', \'tickets.id = task.ticket_id\', \'left\');\n\t\t\t$this->db->join(\'project_det\', \'project_det.pid = task.project_name\', \'left\');\n\t\t\t$this->db->join(\'employee_det\', \'employee_det.id = task.e_id\', \'left\');\n\t\t\t$this->db->join(\'department_det\', \'department_det.id = employee_det.department\', \'left\');\n\t\t\t$this->db->join(\'dep_task\', \'dep_task.id = task.dep_task_id\', \'left\');\n\t\t\t$this->db->join(\'activity_det\', \'activity_det.aid = task.activity_id\', \'left\');\n\n\t\t\t$this->db->where(\'task.e_id\', $emp_id);\n\n\t\t\t$this->admin_model->apply_date_filter(\'task.created_date\', $time_filter, $from_date, $to_date);\n\n\t\t\t$this->db->order_by(\'task.created_date\', \'DESC\');\n\t\t\t$tasks = $this->db->get(\'task_details as task\')->result_array();\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $tasks]);\n\t\t\treturn;\n\n\t\t} else if ($chart_type === \'team_tasks\') {\n\t\t\t// Query counts\n\t\t\t$this->db->select("SUM(CASE WHEN status = \'1\' THEN 1 ELSE 0 END) AS completed");\n\t\t\t$this->db->select("SUM(CASE WHEN status = \'0\' THEN 1 ELSE 0 END) AS pending");\n\t\t\t$this->db->select("SUM(CASE WHEN status = \'2\' THEN 1 ELSE 0 END) AS calledoff");\n\t\t\t\n\t\t\t$this->admin_model->apply_date_filter(\'created_date\', $time_filter, $from_date, $to_date);\n\n\t\t\tif (!empty($employee_id) && $employee_id !== \'0\') {\n\t\t\t\t$this->db->where(\'e_id\', $employee_id);\n\t\t\t} else {\n\t\t\t\tif (!empty($onlyTeamIds)) {\n\t\t\t\t\t$this->db->where_in(\'e_id\', $onlyTeamIds);\n\t\t\t\t} else {\n\t\t\t\t\t$this->db->where(\'e_id\', 0);\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t$perf = $this->db->get(\'task_details\')->row_array();\n\t\t\t$perf_data = [\n\t\t\t\t\'completed\' => (int)($perf[\'completed\'] ?? 0),\n\t\t\t\t\'pending\' => (int)($perf[\'pending\'] ?? 0),\n\t\t\t\t\'calledoff\' => (int)($perf[\'calledoff\'] ?? 0),\n\t\t\t];\n\t\t\t$perf_data[\'total\'] = $perf_data[\'completed\'] + $perf_data[\'pending\'] + $perf_data[\'calledoff\'];\n\n\t\t\t// Query lists\n\t\t\t$this->db->select(\'task.*\');\n\t\t\t$this->db->select(\'employee_det.emp_id, employee_det.emp_name, employee_det.department, employee_det.designation\');\n\t\t\t$this->db->select(\'department_det.department_name\');\n\t\t\t$this->db->select(\'dep_task.task_list\');\n\t\t\t$this->db->select(\'activity_det.activity_list\');\n\t\t\t$this->db->select(\'project_det.project_name as pname\');\n\t\t\t$this->db->select(\'tickets.ticket_id as t_ticket_id, tickets.title as ticket_title\');\n\n\t\t\t$this->db->join(\'tickets\', \'tickets.id = task.ticket_id\', \'left\');\n\t\t\t$this->db->join(\'project_det\', \'project_det.pid = task.project_name\', \'left\');\n\t\t\t$this->db->join(\'employee_det\', \'employee_det.id = task.e_id\', \'left\');\n\t\t\t$this->db->join(\'department_det\', \'department_det.id = employee_det.department\', \'left\');\n\t\t\t$this->db->join(\'dep_task\', \'dep_task.id = task.dep_task_id\', \'left\');\n\t\t\t$this->db->join(\'activity_det\', \'activity_det.aid = task.activity_id\', \'left\');\n\n\t\t\tif (!empty($employee_id) && $employee_id !== \'0\') {\n\t\t\t\t$this->db->where(\'task.e_id\', $employee_id);\n\t\t\t} else {\n\t\t\t\tif (!empty($onlyTeamIds)) {\n\t\t\t\t\t$this->db->where_in(\'task.e_id\', $onlyTeamIds);\n\t\t\t\t} else {\n\t\t\t\t\t$this->db->where(\'task.e_id\', 0);\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t$this->admin_model->apply_date_filter(\'task.created_date\', $time_filter, $from_date, $to_date);\n\n\t\t\t$this->db->order_by(\'task.created_date\', \'DESC\');\n\t\t\t$list = $this->db->get(\'task_details as task\')->result_array();\n\n\t\t\techo json_encode([\n\t\t\t\t\'status\' => \'success\',\n\t\t\t\t\'performance\' => $perf_data,\n\t\t\t\t\'list\' => $list\n\t\t\t]);\n\t\t\treturn;\n\n\t\t} else if ($chart_type === \'my_tickets\') {\n\t\t\t$this->db->select(\'tickets.*\');\n\t\t\t$this->db->select(\'emp.emp_name as raised_by_name\');\n\t\t\t$this->db->join(\'employee_det as emp\', \'emp.id = tickets.raised_by\', \'left\');\n\t\t\t$this->db->where(\'tickets.raised_by\', $employee_det[\'empdet_id\']);\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', $time_filter, $from_date, $to_date);\n\n\t\t\t$this->db->order_by(\'tickets.created_at\', \'DESC\');\n\t\t\t$tickets = $this->db->get(\'tickets as tickets\')->result_array();\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $tickets]);\n\t\t\treturn;\n\n\t\t} else if ($chart_type === \'team_tickets\') {\n\t\t\t$this->db->select(\'tickets.*\');\n\t\t\t$this->db->select(\'emp.emp_name as raised_by_name\');\n\t\t\t$this->db->join(\'employee_det as emp\', \'emp.id = tickets.raised_by\', \'left\');\n\t\t\t\n\t\t\tif (!empty($onlyTeamIds)) {\n\t\t\t\t$this->db->where_in(\'tickets.raised_by\', $onlyTeamIds);\n\t\t\t} else {\n\t\t\t\t$this->db->where(\'tickets.raised_by\', 0);\n\t\t\t}\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', $time_filter, $from_date, $to_date);\n\n\t\t\t$this->db->order_by(\'tickets.created_at\', \'DESC\');\n\t\t\t$tickets = $this->db->get(\'tickets as tickets\')->result_array();\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $tickets]);\n\t\t\treturn;\n\n\t\t} else if ($chart_type === \'received_tickets\') {\n\t\t\t$this->db->select(\'tickets.*\');\n\t\t\t$this->db->select(\'emp.emp_name as raised_by_name\');\n\t\t\t$this->db->join(\'employee_det as emp\', \'emp.id = tickets.raised_by\', \'left\');\n\t\t\t$this->db->where(\'tickets.raised_to\', $employee_det[\'empdet_id\']);\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', $time_filter, $from_date, $to_date);\n\n\t\t\t$this->db->order_by(\'tickets.created_at\', \'DESC\');\n\t\t\t$tickets = $this->db->get(\'tickets as tickets\')->result_array();\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $tickets]);\n\t\t\treturn;\n\t\t}\n\n\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Invalid chart type\']);\n\t}\n\n\tpublic function get_team_member_task_performance()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode(array(\'status\' => \'error\', \'message\' => \'Unauthorized\'));\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$managerId = $this->admin_model->get_manager_id_by_emp_id($employee_det[\'emp_id\']);\n\t\t$teamMembers = $this->admin_model->get_team_members($managerId);\n\t\t$onlyTeamIds = array();\n\t\tif (!empty($teamMembers)) {\n\t\t\tforeach ($teamMembers as $tm) {\n\t\t\t\t$onlyTeamIds[] = $tm[\'id\'];\n\t\t\t}\n\t\t}\n\n\t\t$employeeId = $this->input->post(\'employee_id\');\n\t\t$perf = $this->admin_model->get_team_task_performance($onlyTeamIds, $employeeId);\n\n\t\techo json_encode($perf);\n\t}\n\n\tpublic function verify_team_daily_work()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode(array(\'status\' => \'error\', \'message\' => \'Unauthorized\'));\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$emp_id = $this->input->post(\'emp_id\');\n\t\t$action = $this->input->post(\'action\'); // \'approve\' or \'return\'\n\t\t$remarks = $this->input->post(\'remarks\');\n\t\t$date = $this->input->post(\'date\') ? $this->input->post(\'date\') : date(\'Y-m-d\');\n\n\t\t$managerId = $this->admin_model->get_manager_id_by_emp_id($employee_det[\'emp_id\']);\n\t\tif (empty($managerId)) {\n\t\t\t$managerId = $employee_det[\'empdet_id\'];\n\t\t}\n\n\t\t$res = $this->admin_model->save_manager_work_verification($managerId, $emp_id, $action, $remarks, $date);\n\n\t\techo json_encode(array(\n\t\t\t\'status\' => \'success\',\n\t\t\t\'message\' => \'Work \' . ($action === \'approve\' ? \'Approved\' : \'Returned\') . \' successfully!\',\n\t\t\t\'action\' => $action\n\t\t));\n\t}\n\n\tpublic function ajax_get_team_member_daily_tasks()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode(array(\'status\' => \'error\', \'message\' => \'Unauthorized\'));\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$emp_id = $this->input->post(\'emp_id\');\n\t\t$date = $this->input->post(\'date\') ? $this->input->post(\'date\') : date(\'Y-m-d\');\n\n\t\t$perf = $this->admin_model->get_employee_daily_performance($emp_id, $date);\n\t\techo json_encode($perf);\n\t}\n\n\tpublic function ajax_hr_performance_analytics()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode(array(\'status\' => \'error\', \'message\' => \'Unauthorized\'));\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$period_type = $this->input->post(\'period_type\') ? $this->input->post(\'period_type\') : \'currentmonth\';\n\t\t$year = $this->input->post(\'year\') ? $this->input->post(\'year\') : date(\'Y\');\n\t\t$month = $this->input->post(\'month\') ? $this->input->post(\'month\') : date(\'n\');\n\t\t$dept_id = $this->input->post(\'department_id\');\n\t\t$emp_id = $this->input->post(\'employee_id\');\n\t\t$mgr_id = $this->input->post(\'manager_id\');\n\n\t\t$data = $this->admin_model->get_hr_performance_summary($period_type, $year, $month, $dept_id, $emp_id, $mgr_id);\n\t\techo json_encode($data);\n\t}\n\n\tpublic function ajax_hr_employee_drilldown()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode(array(\'status\' => \'error\', \'message\' => \'Unauthorized\'));\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$emp_id = $this->input->post(\'emp_id\');\n\t\t$start_date = $this->input->post(\'start_date\');\n\t\t$end_date = $this->input->post(\'end_date\');\n\n\t\tif (empty($start_date) || empty($end_date)) {\n\t\t\t$start_date = date(\'Y-m-01\');\n\t\t\t$end_date = date(\'Y-m-t\');\n\t\t}\n\n\t\t$drilldown = $this->admin_model->get_hr_employee_drilldown($emp_id, $start_date, $end_date);\n\t\techo json_encode($drilldown);\n\t}\n\n\n\n\n\tpublic function emp_dashboard()\n\t{\n    \t$this->load->model(\'admin/admin_model\');\n\t\t//  echo "<pre>HI";  \n\t\t$employee_det=$this->session->userdata(\'logged_in\');\n\n// $data[\'show_probation_popup\'] = false;\n\n// $join_date = new DateTime($employee_det[\'join_dt\']);\n// $today = new DateTime();\n// $days_completed = $today->diff($join_date)->days;\n\n// $this->db->select(\'probation_status\');\n// $this->db->where(\'emp_id\', $employee_det[\'emp_id\']);\n// $emp = $this->db->get(\'employee_det\')->row_array();\n\n// if(\n//     $days_completed >= 90 &&\n//     $emp[\'probation_status\'] == 0\n// )\n// {\n//     $data[\'show_probation_popup\'] = true;\n\n// }\n\n$data[\'show_probation_popup\'] = false;\n\n$this->db->select(\'probation_date, probation_status\');\n$this->db->where(\'emp_id\', $employee_det[\'emp_id\']);\n$emp = $this->db->get(\'employee_det\')->row_array();\n\n$today = date(\'Y-m-d\');\n\nif(\n    !empty($emp[\'probation_date\']) &&\n    $emp[\'probation_date\'] <= $today &&\n    $emp[\'probation_status\'] == 0\n)\n{\n    $data[\'show_probation_popup\'] = true;\n}\n\n\n\t\t// echo "<pre>HELLO"; print_r($user_det); exit;\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{\t\n\t\t\t$data[\'sliders\'] = $this->admin_model->getsliders();\n\t\t \t $data[\'emp_task\']     =$this->admin_model->get_empwork_count($employee_det[\'empdet_id\']);\n\t\t \t  $data[\'calledoff_count\'] = $this->admin_model->get_calledoff_count();\n\n\t\t \t $data[\'notifications\'] = [];\n\n\n\t\t\t// Get all unacknowledged notifications\n\t\t\t$notifications = $this->admin_model->get_notifications_id($employee_det[\'empdet_id\']);\n\n\t\t\tif (!empty($notifications)) {\n\t\t\t\t$notifications_array = [];\n\n\t\t\t\tforeach ($notifications as $notification) {\n\t\t\t\t\t// Basic notification info\n\t\t\t\t\t$notification_item =\n\t\t\t\t\t[\n\t\t\t\t\t\t\'notification_id\' => $notification[\'nid\'],\n\t\t\t\t\t\t\'type\' => $notification[\'type\'],\n\t\t\t\t\t\t\'task_id\' => $notification[\'task_id\'],\n\t\t\t\t\t\t\'initiator_id\' => $notification[\'initiator_id\'],\n\t\t\t\t\t\t\'timestamp\' => $this->format_notification_date($notification[\'creation_date\']),\n\t\t\t\t\t\t\'is_acknowledged\' => (bool) $notification[\'is_acknownledge\'],\n\t\t\t\t\t\t\'initiator_name\' => \'\',\n\t\t\t\t\t\t\'header\' => \'Notification\',\n\t\t\t\t\t\t\'body\' => \'\',\n\t\t\t\t\t\t\'project\' => \'\',\n\t\t\t\t\t\t\'priority\' => \'\',\n\t\t\t\t\t\t\'due_date\' => \'\',\n\t\t\t\t\t\t\'priority_label\' => \'\' // We\'ll add this below\n\t\t\t\t\t];\n\n\t\t\t\t\t// Get initiator name\n\t\t\t\t\t$employeeName = $this->admin_model->get_employee_name_by_id($notification[\'initiator_id\']);\n\t\t\t\t\t$notification_item[\'initiator_name\'] = $employeeName ?? \'Unknown\';\n\n\n\t\t\t\t\t// Handle different notification types\n\t\t\t\t\tswitch ($notification[\'type\']) {\n\t\t\t\t\t\tcase 1: // Additional task notification\n\t\t\t\t\t\t$additional_task = $this->admin_model->get_additional_tasks_notifier($notification[\'additional_id\']);\n\n\t\t\t\t\t\tif (!empty($additional_task)) {\n\t\t\t\t\t\t\t$task = $additional_task[0];\n\t\t\t\t\t\t\t$notification_item[\'header\'] = \'New Additional Task\';\n\t\t\t\t\t\t\t$notification_item[\'body\'] = $task[\'activityDesc\'] ?? \'No description\';\n\t\t\t\t\t\t\t$notification_item[\'project\'] = $task[\'project_name\'] ?? \'N/A\';\n\t\t\t\t\t\t\t$notification_item[\'priority\'] = $task[\'priority_type\'] ?? 0;\n\t\t\t\t\t\t\t$notification_item[\'due_date\'] = $this->format_due_date($task[\'due_date\']);\n\n\t\t\t\t\t\t\t// Add human-readable priority label\n\t\t\t\t\t\t\t// $notification_item[\'priority_label\'] = $this->get_priority_label($task[\'priority_type\'] ?? 0);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 2: // Leave form notification\n\t\t\t\t\t\t\t$leaveproject_task = $this->admin_model->get_leaveproject_tasks_notifier($notification[\'slpno\']);\n\t\t\t\t\t\t\t// echo "<pre>HELLO"; print_r($leaveproject_task); exit;\n\t\t\t\t\t\t\tif (!empty($leaveproject_task)) {\n\t\t\t\t\t\t\t\t$Task = $leaveproject_task[0];\n\n\t\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($Task[\'project_name\']);\n\t\t\t\t\t\t\t\t// echo "<pre>Task"; print_r($projectName); exit;\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $projectName[0][\'project_name\'] ?? \'N/A\';\n\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'New Project/Leave Task\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = $projectName[0][\'project_name\'] ?? \'No description\';\n\t\t\t\t\t\t\t\t$notification_item[\'project_name\'] = $Task[\'project_name\'] ?? \'N/A\';\n\t\t\t\t\t\t\t\t$notification_item[\'priority\'] = $Task[\'initiator_id\'] ?? 0;\n\t\t\t\t\t\t\t\t$notification_item[\'due_date\'] = $this->format_due_date($Task[\'to_date\']);\n\t\t\t\t\t\t\t\t// echo "<pre>HELLO"; print_r($notification_item); exit;\n\t\t\t\t\t\t\t\t// Add human-readable priority label\n\t\t\t\t\t\t\t\t// $notification_item[\'priority_label\'] = $this->get_priority_label($task[\'priority_type\'] ?? 0);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\t// Add more cases as needed\n\t\t\t\t\t\tcase 3: // Project Approval Request\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Approval Required\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Please approve the project: <strong>\' . $project[\'project_name\'] . \'</strong>\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t$approve_url = $this->config->item(\'base_url\') . \'admin/approve_project/\' . $project[\'pid\'] . \'/\' . $notification[\'nid\'];\n\t\t\t\t\t\t\t\t$decline_url = $this->config->item(\'base_url\') . \'admin/decline_project/\' . $project[\'pid\'] . \'/\' . $notification[\'nid\'];\n\t\t\t\t\t\t\t\t// $notification_item[\'body\'] .= \'<br><a href="\'.$approve_url.\'" class="btn btn-sm btn-success mt-2" style="color:white; padding: 2px 10px; margin-right: 5px;">Approve Project</a>\';\n\t\t\t\t\t\t\t\t// $notification_item[\'body\'] .= \'<a href="\'.$decline_url.\'" class="btn btn-sm btn-danger mt-2" style="color:white; padding: 2px 10px;">Decline Project</a>\';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 4: // Project Approved\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Approved\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> was approved.\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\n\t\t\t\t\t\tcase 5: // Project Declined\n\t\t\t\t\t\t\t$projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\t\t\t\t\t\t\tif (!empty($projectName)) {\n\t\t\t\t\t\t\t\t$project = $projectName[0];\n\t\t\t\t\t\t\t\t$notification_item[\'header\'] = \'Project Declined\';\n\t\t\t\t\t\t\t\t$notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> was declined.\';\n\t\t\t\t\t\t\t\t$notification_item[\'project\'] = $project[\'project_name\'];\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t\tcase 6: // Project On Hold\n    $projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n    if (!empty($projectName)) {\n        $project = $projectName[0];\n        $notification_item[\'header\'] = \'Project On Hold\';\n        $notification_item[\'body\'] = \'Your project <strong>\' . $project[\'project_name\'] . \'</strong> has been put on hold.\';\n        $notification_item[\'project\'] = $project[\'project_name\'];\n    }\n    break;\n\t\t\t\t\tcase 7:\n\n    $notification_item[\'header\'] =\n        \'Probation Assessment Submitted\';\n\n    $notification_item[\'body\'] =\n        $notification_item[\'initiator_name\'] .\n        \' has submitted a probation assessment.\';\n\n    break;\n\t\t\t\t\t}\n\n\t\t\t\t\t$notifications_array[] = $notification_item;\n\t\t\t\t}\n\n\t\t\t\t// Sort by timestamp (newest first)\n\t\t\t\tusort($notifications_array, function ($a, $b) {\n\t\t\t\t\treturn strtotime($b[\'timestamp\']) - strtotime($a[\'timestamp\']);\n\t\t\t\t});\n\n\t\t\t\t$data[\'notifications\'] = $notifications_array;\n\t\t\t\t// echo "<pre>notifications"; print_r($data[\'notifications\']); exit;\n\n\t\t\t}\n\n\t\t\t// Retrieve ticket counts by specific statuses\n\t\t\t$data[\'open_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 1);          // Open status\n\t\t\t$data[\'in_progress_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 2);  // In Progress status\n\t\t\t$data[\'closed_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 3);       // Closed status\n\t\t\t$data[\'canceled_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 4);     // Canceled status\n\t\t\t$data[\'tdy_open_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 1,true);         \n\t\t\t$data[\'tdy_in_progress_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 2,true);\n\t\t\t$data[\'tdy_closed_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 3,true);      \n\t\t\t$data[\'tdy_canceled_ticket_count\'] = $this->admin_model->get_my_ticket_count($employee_det[\'empdet_id\'], 4,true);   \n\n\t\t\t// // Count tickets for the Received "System Admin" based on their statuses\n\t\t\t$data[\'rec_open_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 1);          // Open status\n\t\t\t$data[\'rec_in_progress_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 2);  // In Progress status\n\t\t\t$data[\'rec_closed_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 3);       // Closed status\n\t\t\t$data[\'rec_canceled_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 4);     // Canceled status\n\t\t\t$data[\'tdy_rec_open_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 1,true);          // Open status\n\t\t\t$data[\'tdy_rec_in_progress_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 2,true);  // In Progress status\n\t\t\t$data[\'tdy_rec_closed_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 3,true);       // Closed status\n\t\t\t$data[\'tdy_rec_canceled_ticket_count\'] = $this->admin_model->get_received_ticket_count($employee_det[\'empdet_id\'], 4,true);     // Canceled status\n\n          // ADD THIS FLASH MESSAGE CODE HERE\n        $today = date(\'Y-m-d\');\n        $this->db->where(\'expiry_date >=\', $today);\n        $this->db->where(\'status\', 1);\n        $data[\'flash_messages\'] = $this->db->get(\'flash_messages\')->result_array();\n\n\t\t\t// Added detailed lists for charts and modal drill-downs (no raw DB queries in view)\n\t\t\t// Apply default Month filters to initial chart queries using apply_date_filter helper\n\t\t\t$this->admin_model->apply_date_filter(\'task.created_date\', \'currentmonth\');\n\t\t\t$data[\'my_tasks_list\'] = $this->admin_model->get_task_details_list($employee_det[\'empdet_id\']);\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', \'currentmonth\');\n\t\t\t$data[\'my_tickets_list\'] = $this->admin_model->get_tickets($employee_det[\'empdet_id\']);\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', \'currentmonth\');\n\t\t\t$data[\'rec_tickets_list\'] = $this->admin_model->get_tickets($employee_det[\'empdet_id\'], null, true);\n\n\t\t\t// Fetch flat projects for Task Progress Trend project filter\n\t\t\t$data[\'projects\'] = $this->admin_model->get_all_projects_flat();\n\n\t\t\t// Today\'s Task Performance\n\t\t\t$data[\'today_performance\'] = $this->admin_model->get_employee_daily_performance($employee_det[\'empdet_id\']);\n\n\t\t\t$this->template->write_view(\'content\', \'admin/emp_dashboard\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function ajax_chart_data()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$emp_id = $employee_det[\'empdet_id\'];\n\t\t$chart_type = $this->input->get(\'chart_type\');\n\t\t$time_filter = $this->input->get(\'time_filter\');\n\t\t$from_date = $this->input->get(\'from_date\');\n\t\t$to_date = $this->input->get(\'to_date\');\n\t\t$project_id = $this->input->get(\'project_id\');\n\n\t\t$this->load->model(\'admin/admin_model\');\n\n\t\tif ($chart_type === \'task_status\' || $chart_type === \'task_priority\' || $chart_type === \'task_progress\') {\n\t\t\t$this->db->select(\'task.*\');\n\t\t\t$this->db->select(\'employee_det.emp_id, employee_det.emp_name, employee_det.department, employee_det.designation\');\n\t\t\t$this->db->select(\'department_det.department_name\');\n\t\t\t$this->db->select(\'dep_task.task_list\');\n\t\t\t$this->db->select(\'activity_det.activity_list\');\n\t\t\t$this->db->select(\'project_det.project_name as pname\');\n\t\t\t$this->db->select(\'tickets.ticket_id as t_ticket_id, tickets.title as ticket_title\');\n\n\t\t\t$this->db->join(\'tickets\', \'tickets.id = task.ticket_id\', \'left\');\n\t\t\t$this->db->join(\'project_det\', \'project_det.pid = task.project_name\', \'left\');\n\t\t\t$this->db->join(\'employee_det\', \'employee_det.id = task.e_id\', \'left\');\n\t\t\t$this->db->join(\'department_det\', \'department_det.id = employee_det.department\', \'left\');\n\t\t\t$this->db->join(\'dep_task\', \'dep_task.id = task.dep_task_id\', \'left\');\n\t\t\t$this->db->join(\'activity_det\', \'activity_det.aid = task.activity_id\', \'left\');\n\n\t\t\t$this->db->where(\'task.e_id\', $emp_id);\n\n\t\t\t$this->admin_model->apply_date_filter(\'task.created_date\', $time_filter, $from_date, $to_date);\n\n\t\t\tif ($chart_type === \'task_progress\' && !empty($project_id) && $project_id !== \'all\') {\n\t\t\t\t$this->db->where(\'task.project_name\', $project_id);\n\t\t\t}\n\n\t\t\t$this->db->order_by(\'task.created_date\', \'DESC\');\n\t\t\t$tasks = $this->db->get(\'task_details as task\')->result_array();\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $tasks]);\n\t\t\treturn;\n\t\t} else if ($chart_type === \'my_tickets\') {\n\t\t\t$this->db->select(\'tickets.*\');\n\t\t\t$this->db->select(\'emp.emp_name as raised_by_name\');\n\t\t\t$this->db->join(\'employee_det as emp\', \'emp.id = tickets.raised_by\', \'left\');\n\t\t\t$this->db->where(\'tickets.raised_by\', $emp_id);\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', $time_filter, $from_date, $to_date);\n\n\t\t\t$this->db->order_by(\'tickets.created_at\', \'DESC\');\n\t\t\t$tickets = $this->db->get(\'tickets as tickets\')->result_array();\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $tickets]);\n\t\t\treturn;\n\t\t} else if ($chart_type === \'received_tickets\') {\n\t\t\t$this->db->select(\'tickets.*\');\n\t\t\t$this->db->select(\'emp.emp_name as raised_by_name\');\n\t\t\t$this->db->join(\'employee_det as emp\', \'emp.id = tickets.raised_by\', \'left\');\n\t\t\t$this->db->where(\'tickets.raised_to\', $emp_id);\n\n\t\t\t$this->admin_model->apply_date_filter(\'tickets.created_at\', $time_filter, $from_date, $to_date);\n\n\t\t\t$this->db->order_by(\'tickets.created_at\', \'DESC\');\n\t\t\t$tickets = $this->db->get(\'tickets as tickets\')->result_array();\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $tickets]);\n\t\t\treturn;\n\t\t}\n\n\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Invalid chart type\']);\n\t}\n\n\tpublic function employees()\n\t{\n    \t$this->load->model(\'admin/admin_model\');\n\t\t$employee_det=$this->session->userdata(\'logged_in\');\n\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{\n\t\t\t// Load only Active employees by default for the list\n\t\t\t$data[\'peop\']             = $this->admin_model->get_employee_det_by_status(1);\n\t\t\t$data[\'emp_status_counts\']= $this->admin_model->get_employee_status_counts();\n\t\t \t$this->template->write_view(\'content\', \'admin/employees\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\n\tpublic function view_sliders()\n\t{\n    \t$this->load->model(\'admin/admin_model\');\n\t\t//  echo "<pre>HI";  \n\t\t$employee_det=$this->session->userdata(\'logged_in\');\n\n\t\t// echo "<pre>HELLO"; print_r($user_det); exit;\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{\n\t\t\t $data[\'slid\']     =$this->admin_model->get_view_sliders_det();\n\t\t \t$this->template->write_view(\'content\', \'admin/view_sliders\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function view_proj_data()\n\t{\n    \t$this->load->model(\'admin/admin_model\');\n\t\t//  echo "<pre>HI";  \n\t\t$employee_det=$this->session->userdata(\'logged_in\');\n\n\t\t// echo "<pre>HELLO"; print_r($user_det); exit;\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{\n\t\t\t $data[\'projects\']     =$this->admin_model->get_project_reports();\n\t\t\t //$data[\'projdata\']     =$this->admin_model->get_project_data();\n\t\t \t$this->template->write_view(\'content\', \'admin/view_proj_data\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function get_employee_details()\n\t{\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$inps = $this->input->post();\n\t\tif($this->input->post())\n\t\t{\n\t\t\t$org_id =  $inps[\'cid\']; \n\t\t\t$data[\'org_emp\'] = $this->admin_model->getemployees_org_details($org_id); \n\t\t\t$data[\'emp_data\'] = $data[\'org_emp\'];\n\t\t\t$data[\'skills\'] = $this->admin_model->get_employee_skills($org_id);\n\t\t\t$data[\'read_only\'] = TRUE;\n\t\t\t\n\t\t\t$html = $this->load->view(\'admin/profile_content\', $data, TRUE);\n\t\t\techo $html;\n\t\t} else {\n\t\t\tredirect($this->config->item(\'base_url\')."admin/index");\n\t\t}\n\t}\n\n\t/**\n\t * AJAX: Returns a JSON list of employees filtered by status (1=Active, 0=Inactive).\n\t * Also returns updated counts for both tabs.\n\t * Used by the Active/Inactive filter on the People\'s page.\n\t */\n\tpublic function ajax_get_employee_list()\n\t{\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif (!$user_det) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Session expired.\']);\n\t\t\treturn;\n\t\t}\n\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t$filter = (int)$this->input->post(\'filter\'); // 1=Active, 0=Inactive\n\t\t$employees = $this->admin_model->get_employee_det_by_status($filter);\n\t\t$counts    = $this->admin_model->get_employee_status_counts();\n\n\t\techo json_encode([\n\t\t\t\'status\'    => \'success\',\n\t\t\t\'employees\' => $employees,\n\t\t\t\'counts\'    => $counts,\n\t\t]);\n\t}\n\n\t  \n\tpublic function forgot_pass()\n\t{\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t\n\t\t$this->template->set_master_template(\'../../themes/\'.$this->config->item("active_template").\'/landing_template_login.php\');\n\t\t$this->template->write_view(\'content\', \'admin/forgot_password\');\n\t\t$this->template->render();\n\t}\n\n\tpublic function forgot_passw()\n   { \n\t    $this->load->model(\'admin/admin_model\');\n\t    $inps = $this->input->post();\n\t    //echo "<pre>HELLO"; print_r($inps); exit;\n\t    //$employee_id = $inps[\'employee_id\'];\n\t\t //$email_id = $inps[\'email_id\'];\n\t     $this->db->select(\'emp.emp_id,emp.email_id,emp.status\');\n    \t $this->db->where(\'emp.emp_id\',$inps[\'employeeID\']); \n    \t $this->db->where(\'emp.email_id\',$inps[\'emailID\']); \n\t\t $emp_query=$this->db->get(\'employee_det as emp\');\n\t\t $query = $emp_query->num_rows();\n\t        //echo "<pre>"; print_r($query); exit;\n\t        //echo $this->db->last_query(); exit;\t\n\t\t\tif($query>0)\n\t        {\n\t\t\t\t$emp_data = $emp_query->row_array();\n\t\t\t\tif ($emp_data[\'status\'] != 1) {\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Your account has been deactivated. Please contact HR / Admin.\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/forgot_pass\');\n\t\t\t\t}\n\n\t        \t$this->db->select(\'*\');\n\t\t    \t $this->db->where(\'emp.emp_id\',$inps[\'employeeID\']); \n\t\t    \t $this->db->where(\'emp.email_id\',$inps[\'emailID\']); \n\t\t\t\t $data[\'email\']=$this->db->get(\'employee_det as emp\')->result_array();\n\t\t\t\t //echo "<pre>"; print_r( $data[\'email\']); exit;\n\t\t        try {\n\t\t            // otp to mail\n\t\t          \t\t$to = $inps[\'emailID\'];\n    \t   \n\t\t\t            $subject="Reset Password Link - ".$inps[\'employeeID\']." - Performance Tracker.";\n\t\t\t             \n\t\t\t            require(APPPATH.\'libraries/InetMailer.php\');\n\t\t\t            $objs = new InetMailer();\n\t\t\t            $mail = $objs->load(); \n\t\t\t            $mail->setFrom(\'info@inetcsc.com\', \'I-NET CSC\');\n\t\t\t            $mail->addAddress(trim($to)); // Add a recipient FCPATH.\'sign_board/\' \n\t\t\t \t\t\t\t \n\t\t\t            $mail->addCC(\'prasannakumari@inetcsc.com\');\n\n\t\t\t            $mail->isHTML(true); // Set email format to HTML\n\t\t\t            $mail->Subject = $subject; \n\t\t\t            $mail->Body = $this->load->view(\'admin/forgot_password_email\',$data,TRUE);\n\t\t\t            //$mail->send();\n\n\t\t\t           // $this->email->to($to_email);\n\t\t\t           // $this->email->set_header(\'Content-Type\', \'text/html\');\n\t\t\t           // $this->email->subject(\'CyRAACS invites you to join us at Umagine Chennai – 2023\'); \n\t\t\t           // $this->email->message($this->load->view(\'html_mail\',$data,true));   \n\t\t\t           if($mail->send()){            \n\t\t\t           \n\t           \t\t\t\t$this->session->set_flashdata(\'succ\', \'Email Sent Successfully..! Please check your email for Password Reset.\');\n\t\t\t    \t\t\tredirect($this->config->item(\'base_url\').\'admin/forgot_pass\');\n\n\t\t\t           }else{ \n\t\t\t            \n\t\t\t            \t$this->session->set_flashdata(\'err\', \'Failed to Send Email..! Please Try Again.\');\n\t\t\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/forgot_pass\');\n\n\t\t\t          }\n\t\t          } catch (\\Exception $e) {\n\t\t            //Simply leave, if nay email errors\n\t\t          }\n\t        \t//echo"H";\n\t        \t//$this->session->set_flashdata(\'true\', \'Send link through mail\');\n\n\n\t        }\n\n\t        else\n\t        {\n                //echo"M";\n                $this->session->set_flashdata(\'err\', \'No Details Found...! \');\n\t   \t\t\t    redirect($this->config->item(\'base_url\').\'admin/forgot_pass\'); \n\n\t        }\n    }\n   \n\n\n    public function change_pass($emp_id)\n    //public function change_pass()\n    { \n\n    \t//$emp_id_1 = \'INET0002\';\n    \t$data[\'emp_id\'] = base64_decode(base64_decode(base64_decode(base64_decode(urldecode($emp_id)))));\n\n\n \t\t$this->template->set_master_template(\'../../themes/\'.$this->config->item("active_template").\'/landing_template_login.php\');\n    \t$this->template->write_view(\'content\', \'admin/change_password\', $data);\n\t\t$this->template->render();\n    }\n\n    public function update_passwd($emp_id)\n    {   \n    \t$this->load->model(\'admin/admin_model\');\n\n    \t$emp_id = base64_decode(base64_decode(base64_decode(base64_decode(urldecode($emp_id)))));\n    \t//echo"<pre>"; print_r($emp_id);//exit;\n\t\t$ups = $this->input->post();\n\t\t//echo"<pre>"; print_r($ups); //exit;\n\t\t//echo"<pre>"; print_r(md5($ups[\'newpassword\']));exit;\n\t\t$this->db->select(\'emp.*\');\n\t \t$this->db->where(\'emp.emp_id\',$emp_id);\n\t \t$update_id=$this->db->get(\'employee_det as emp\')->num_rows();\n\t \t//echo"<pre>"; print_r($update_id);exit;\n\t \t//echo $this->db->last_query(); exit;\n\t \tif($update_id>0)\n\t \t{\n          $data=array(\'passwd\' =>md5($ups[\'newpassword\']));\n          $this->db->where(\'emp_id\',$emp_id);\n\t \t\t$sql_query=$this->db->update(\'employee_det\',$data); \n\t \t\t if($sql_query>0){\n\n\t\t   \t\t\n\t\t   \t\t $this->session->set_flashdata(\'true\', \'Successfully Updated Your Password\');\n\t\t   \t\t redirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t   \t\t //echo"success";exit;\n\t\t   \t\t}\n\t\t   \t\telse{\n\t\t   \t\t\t\n\t\t   \t\t\t$this->session->set_flashdata(\'cerr\',\'Failed to Updated Password.Please try Again..!!\');\n\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t   \t\t\t//echo"Failed";exit;\n\t\t   \t\t}\n\t \t}\n\n    }\n\n\n\n\tpublic function get_profile($emp_id)\n\t{\n\t\t$usersess_det=$this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\n\t\t\t\t$emp_id = base64_decode(base64_decode(base64_decode(base64_decode(urldecode($emp_id)))));\n\t\t\t\t$this->load->model(\'admin/admin_model\');\n\t\t\t\t$this->db->select(\'emp.*, emp.avatar as avatar\');\n\t\t\t\t$this->db->select(\'department_det.id as dept_id,department_det.department_name as department\'); \n\t\t\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t\t\t\t$this->db->where(\'emp.emp_id\',$emp_id); \n\t\t\t\t$data[\'emp_data\'] = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t\t\tif (!empty($data[\'emp_data\'])) {\n\t\t\t\t\t$data[\'skills\'] = $this->admin_model->get_employee_skills($data[\'emp_data\'][0][\'id\']);\n\t\t\t\t} else {\n\t\t\t\t\t$data[\'skills\'] = array();\n\t\t\t\t}\n\t\t\t\t//echo "<pre>HELLO"; print_r($userquery); exit;\n\t\t\t\t$this->template->write_view(\'content\', \'admin/user_profile\', $data);\n\t\t\t\t$this->template->render();\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\t\n\n \tpublic function user_reports(){\n\n \t\t\t$user_det = $this->session->userdata(\'logged_in\');\n \t\t\tif(isset($user_det) && !empty($user_det)){  \n\n \t\t\t\t$inputs = $this->input->post() ?: [];\n\n\t\t\t\t// Always pass filters (so view can safely read $filters[\'status\'] etc.)\n \t\t\t\t$data[\'filters\']      = $inputs;\n \t\t\t\t$data[\'from_date\']    = !empty($inputs[\'from_date\']) ? $inputs[\'from_date\'] : date(\'Y-m-01\');\n \t\t\t\t$data[\'to_date\']      = !empty($inputs[\'to_date\'])   ? $inputs[\'to_date\']   : date(\'Y-m-d\');\n \t\t\t\t$data[\'user_rep_list\'] = [];  // Table is now rendered via AJAX — keep empty for window._rawTasks\n \t\t\t\t$data[\'projects\']     = $this->admin_model->get_projects_export();\n\n \t\t\t\t$this->template->write_view(\'content\', \'admin/user_reports\', $data);\n \t\t\t\t$this->template->render();\n\n \t\t} else {\n \t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n \t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n \t\t\t}\n\n\t }\n\n\tpublic function add_employee()\n\t{\n\t\t$usersess_det=$this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\n\t\t\t$this->load->model(\'admin/admin_model\');\n\t\t\t\n\t\t\t$data[\'department\'] = $this->admin_model->getdepartments();\n\t\t\t$data[\'location\'] = $this->admin_model->getlocation();\n\t\t\t$data[\'roletype\']     =$this->admin_model->getroletype();\n\t\t\t//echo"<pre><br/><br/>";print_r($data);\n\t\t\t$data[\'notifications\'] = $this->get_global_notifications();\n\t\t\t$this->template->write_view(\'content\', \'admin/add_employee\', $data);\n\t\t\t$this->template->render(); \n\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t}\n\n\n\tpublic function get_manager(){\n\t\t\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$department=$this->input->post(\'department\');\n\t\t$man_array = $this->admin_model->get_report_manager($department);\n\t\t // echo "<pre>"; print_r($man_array); exit;\n\t\t//$man_select=\'<select name="report_mgr_id" id="report_mgr_id" class="form-control" required><option value="0">Select Option</option>\';\n\t\t$man_select=\'<option value="0">Select Option</option>\';\n\n\t\t    if(isset($man_array) && !empty($man_array))\n\t\t    {\n\t\t      foreach($man_array as $val)\n\t\t      {\n\t\t        $man_select=$man_select."<option value=\'".$val[\'mid\']."~".$val[\'emp_name\']."\'>".$val[\'emp_name\']."</option>";\n\t\t      }\n\t\t        \n\t\t    }\n\n\t\t   // $man_select=$man_select.\'</select><span id="report_mgr_err"></span>\';\n\t\t    echo $man_select;\n\t}\n\npublic function get_management(){\n\t\t\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$department=$this->input->post(\'department\');\n\t\t$man_array = $this->admin_model->get_report_manager($department);\n\t\t//echo "<pre>"; print_r($man_array);\n\t\t//$man_select=\'<select name="report_mgr_id" id="report_mgr_id" class="form-control" required><option value="0">Select Option</option>\';\n\t\t$man_select=\'<option value="0">Select Option</option>\';\n\n\t\t    if(isset($man_array) && !empty($man_array))\n\t\t    {\n\t\t      foreach($man_array as $val)\n\t\t      {\n\t\t        $man_select=$man_select."<option value=\'".$val[\'mid\']."~".$val[\'emp_name\']."\'>".$val[\'emp_name\']."</option>";\n\t\t      }\n\t\t        \n\t\t    }\n\n\t\t   // $man_select=$man_select.\'</select><span id="report_mgr_err"></span>\';\n\t\t    echo $man_select;\n\t}\n\n\t\n\tpublic function insert_employee()\n\t   {\n\t   \t$usersess_det=$this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\n\t\t   \t$inps = $this->input->post();\n\t\t  \n\t\t    if($this->input->post())\n\t    \t{\n\t    \t//echo"<pre>"; print_r($inps);exit;\n\t    \t$email = $inps[\'email_id\'];\n\t\t   \t$report_mgr = explode(\'~\', $inps[\'report_mgr\']);\n\t\t   \t$r_id = $report_mgr[0];\n\t\t   \t$r_name = $report_mgr[1];\n\t\t   \t// echo"<pre>"; print_r($r_id);\n\t\t   \t// echo"<pre>"; print_r($r_name); exit;\n\t\t   \t$this->db->select(\'emp.*\');\n\t\t\t$this->db->where(\'emp.emp_id\',$inps[\'employee_id\']); \n\t\t\t$emp_details = $this->db->get(\'employee_det as emp\')->num_rows();\n\t\t\t//echo"<pre>"; print_r($emp_details); exit;\t\n\t\t   \tif($emp_details>0){\n\n\t\t   \t\t\t$this->session->set_flashdata(\'err\', \'Employee Already Exists..!\');\n\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/add_employee\');\n\t\t   \t\t \t// $this->template->write_view(\'content\', \'admin/add_employee\');\n\t\t\t\t\t// $this->template->render();\n\t\t   \t\t\t\n\t\t   \t} else {\n\n\t\t   \t\t\t$data=array(\'emp_id\'=>$inps[\'employee_id\'],\'emp_name\'=>$inps[\'employee_name\'],\'mob_no\' =>$inps[\'mobile_no\'],\'email_id\' =>$inps[\'email\'],\'department\' =>$inps[\'department\'],\'designation\' =>$inps[\'designation\'],\'report_mgr_id\' =>$r_id,\'join_dt\' =>$inps[\'date\'],\'dob\' =>$inps[\'dob\'],\'probation_date\'=>$inps[\'probation_date\'],\'work_loc\' =>$inps[\'work_loc\'],\'role_type\' =>3,\'status\' =>1);\n\t\t   \t   \t\t//$this->db->last_query();\n\n\t\t\t\t   \t $sql_query=$this->db->insert(\'employee_det\',$data);\n\t\t\t\t   \t  $id = $this->db->insert_id();\n\t\t\t\t   \t  // echo"<pre>id";print_r($id);exit;\n\t\t\t\t   \tif($sql_query>0){\n\n\t\t\t\t   \t $this->db->select(\'*\');\n\t \t\t    \t $this->db->where(\'emp.id\', $id); \n\t\t\t\t\t $data[\'reg_email\']=$this->db->get(\'employee_det as emp\')->result_array();\n\t\t\t\t\t // echo $this->db->last_query();\n\t\t\t\t\t // echo "<pre>"; print_r( $data[\'email\']); exit;\n\t\t\t\t\t        try {\n\t\t\t\t\t            // otp to mail\n\t\t\t\t\t          \t\t//$to = $inps[\'email\'];\n\t\t\t\t\t\t\t\t$to = $data[\'reg_email\'][0][\'email_id\'];\n\t\t\t    \t   \n\t\t\t\t\t\t            $subject="Employee Details - ".$inps[\'employee_id\']." - Performance Tracker.";\n\t\t\t\t\t\t             \n\t\t\t\t\t\t            require(APPPATH.\'libraries/InetMailer.php\');\n\t\t\t\t\t\t            $objs = new InetMailer();\n\t\t\t\t\t\t            $mail = $objs->load(); \n\t\t\t\t\t\t            $mail->setFrom(\'info@inetcsc.com\', \'I-NET CSC\');\n\t\t\t\t\t\t            $mail->addAddress(trim($to)); // Add a recipient FCPATH.\'sign_board/\' \n\t\t\t\t\t\t \t\t\t\t \n\t\t\t\t\t\t            $mail->addCC(\'prasannakumari@inetcsc.com\');\n\n\t\t\t\t\t\t            $mail->isHTML(true); // Set email format to HTML\n\t\t\t\t\t\t            $mail->Subject = $subject; \n\t\t\t\t\t\t            $mail->AddEmbeddedImage(\'./images/inet_logo.png\', \'I-NET\');\n\t\t\t\t\t\t            $mail->Body = $this->load->view(\'admin/employee_email\',$data,TRUE);\n\t\t\t\t\t\t            $mail->send();            \n\t\t\t\t           \n\t\t\t\t\t           \t\t\t\t\n\t\t\t\t\t          } catch (\\Exception $e) {\n\t\t\t\t\t            //Simply leave, if nay email errors\n\t\t\t\t\t          }\n\t\t\t\t   \t\t $this->session->set_flashdata(\'true\', \'Employee Added Successfully...!\');\n\t\t\t\t   \t\t redirect($this->config->item(\'base_url\').\'admin/add_employee\');\n\t\t\t\t   \t\t //echo"success";exit;\n\t\t\t\t   \t\t}\n\t\t\t\t   \t\telse{\n\t\t\t\t   \t\t\t\n\t\t\t\t   \t\t\t$this->session->set_flashdata(\'err\',\'something went wrong.Error!!\');\n\t\t\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/add_employee\');\n\t\t\t\t   \t\t\t//echo"Failed";exit;\n\t\t\t\t   \t\t}\n\t\t\t\t  \t } \n\t\t   \t} else {\n\n\t\t   \t\t $this->template->set_master_template(\'../../them