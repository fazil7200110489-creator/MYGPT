n\t\t\t$this->load->model(\'admin/admin_model\'); \n\t \t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t \t\tif(isset($user_det) && !empty($user_det)){  \n\t \t\t//echo "<pre>"; print_r($user_det); exit;\n\t \t\t$tid = base64_decode(base64_decode(base64_decode(base64_decode(urldecode($id)))));\n \t\t\t  //echo "<pre>tid"; print_r($tid);  \n\t\t\t$inps = $this->input->post();\n\t \t    // echo "<pre>id"; print_r($inps); exit;\n\t\t\tif($this->input->post())\n\n\t\t\t\t{\n\n\t\t\t\t\tif($inps[\'inputPreDependency\']!=""){\n\n\t\t\t\t\t$pen_mgr = explode(\'~\', $inps[\'inputPreDependency\']);\n\t\t\t\t   \t$p_id = $pen_mgr[0];\n\t\t\t\t   \t$p_name = $pen_mgr[1];\n\n\t\t\t\t\t} else {\n\n\t\t\t\t\t\t$p_id ="0";\n\t\t\t\t\t}\n\t\t\t\t\t//$current_day = date("Y-m-d");\n\t\t\t\t\tif($inps[\'inputPrestatus\']==\'1\')\n\t\t\t\t\t{\n\n\t\t\t\t\t\t$task_today = date("Y-m-d H:i:s");\n\t\t\t\t\t\t$current_day = date("Y-m-d H:i:s");\n\n\t\t\t\t\t} else {\n\n\t\t\t\t\t\t$task_today = \'\';\n\t\t\t\t\t}\n\t\t\t\t\t$this->db->select(\'tas.*\');\n\t\t\t\t \t$this->db->where(\'tas.id\',$tid);\n\t\t\t\t \t$task_res=$this->db->get(\'task_details as tas\')->result_array();\n\t\t\t\t \t$task_id = count($task_res);\n\t\t\t\t \t//echo $this->db->last_query();\n\t\t\t\t \t //echo"<pre>"; print_r($task_res);exit;\n\n\n\t\t\t\t \tif($task_id>0){\n\n\t\t\t\t \t\t\tif($inps[\'inputPrestatus\']=="1"){\n\n\t\t\t\t \t\t\t\t\t$data=array(\'prev_reason\'=>$inps[\'inputPreRemarks\'],\'status\'=>$inps[\'inputPrestatus\'],\'task_comp_time\'=>$inps[\'inputEstTime\'],\'task_comp_dt\'=>$current_day); //0-inactive\n\t\t\t\t \t\t\t\t\n\t\t\t\t \t\t\t}  else {\n\n\t\t\t\t \t\t\t\t\n\t\t\t\t \t\t\t\t$data=array(\'depend_name\' =>$r_id,\'prev_reason\'=>$inps[\'inputPreRemarks\'],\'status\'=>$inps[\'inputPrestatus\']); //0-inactive\n\t\t\t\t \t\t\t}\n\n\t\t\t\t \t\t\t$this->db->where(\'id\',$tid);\n\t\t\t\t \t\t\t$sql_query=$this->db->update(\'task_details\',$data); \n\n\t\t\t\t \t\t\tif($sql_query>0){\n\t\t\t\t\t\t\t\t// Auto sync pending task completion back to ticket\n\t\t\t\t\t\t\t\t$this->admin_model->sync_pending_task_to_ticket($tid);\n\n\t\t\t\t \t\t\t\t$today = $current_day = date("Y-m-d");\n\t\t\t\t \t\t\t\t// $add_task_data = array(\'status\' => $inps[\'inputPrestatus\'],\'comp_date\'=>$today,\'approved_status\'=>\'1\');\n\t\t\t\t\t\t\t\t$add_task_data = array(\n    \'status\' => $inps[\'inputPrestatus\'],\n    \'comp_date\' => date("Y-m-d"), \n    \'approved_status\' => \'1\'\n);\n\t\t\t\t\t\t\t\t$completed_datetime = date("Y-m-d H:i:s");\n\n\n\t\t\t\t\t\t\t\t\t$this->db->where(\'task_id\', $tid);\n\t\t\t\t\t\t\t\t\t$this->db->update(\'additional_task_details\', $add_task_data);\n\t\n\n\t\t\t\t\t\t\t\t\t$data = array(\'e_id\' => $user_det[\'empdet_id\'],\'task_id\' => $tid,\'task_type\' => $task_res[0][\'dep_task_id\'],\'priority_type\' => $task_res[0][\'priority_type\'],\'activity_type\' => $task_res[0][\'activity_id\'],\'description\' => $task_res[0][\'remarks\'],\'dependency\' => $p_id,\'comments\' => $inps[\'inputPreRemarks\'],\'status\'=>$inps[\'inputPrestatus\'],\'task_comp_dt\'=>$task_today);  \n\t\t\t\t\t\t\t\t\t//echo"<pre>"; print_r($data); exit;*/\n\t\t\t\t\t\t\t\t\t$task_query=$this->db->insert(\'task_track_details\',$data);\n\n\n\t\t\t\t\t\t   \t\t $this->session->set_flashdata(\'succ\', \'Task Details Updated Successfully\');\n\t\t\t\t\t\t   \t\t redirect($this->config->item(\'base_url\').\'admin/pending_task_details\');\n\t\t\t\t\t\t   \t\t //echo"success";exit;\n\t\t\t\t\t\t   \t\t}\n\t\t\t\t\t\t   \t\telse{\n\t\t\t\t\t\t   \t\t\t\n\t\t\t\t\t\t   \t\t\t$this->session->set_flashdata(\'uperr\',\'something went wrong.Error!!\');\n\t\t\t\t\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/pending_task_details\');\n\t\t\t\t\t\t   \t\t\t//echo"Failed";exit;\n\t\t\t\t\t\t   \t\t}\n\t\t\t\t \t\t\t//echo"<pre>"; print_r($ups);exit;\n\n\t\t\t\t \t} else {\n\n\t\t\t\t \t\t$this->session->set_flashdata(\'uperr\', \'No Details Found..!\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/pending_task_details\');\n\t\t\t\t\t}\n\t\t\t\t} else {\n\n\n\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/pending_task_details\');\n\t\t\t\t}\n\n\t\t} else {\n\t\t\t\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\n\t }\n\n\n\tpublic function update_projectdata($id){\n    $this->load->model(\'admin/admin_model\'); \n    $user_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($user_det) && !empty($user_det)){  \n\n        $tid = base64_decode(base64_decode(base64_decode(base64_decode(urldecode($id)))));\n        $inps = $this->input->post();\n\n        if($this->input->post())\n        {\n            $this->db->select(\'pd.*\');\n            $this->db->where(\'pd.pid\',$tid);\n            $task_res=$this->db->get(\'project_det as pd\')->result_array();\n            $task_id = count($task_res);\n\n            if($task_id>0){\n\n                // approver_status: 1=Approved, 2=Hold, 3=Rejected\n                $data=array(\'approver_status\'=>$inps[\'inputPrestatus\']);\n\n                $this->db->where(\'pid\',$tid);\n                $sql_query=$this->db->update(\'project_det\',$data); \n\n                if($sql_query>0){\n\n                    // =============================================\n                    // SEND NOTIFICATION BACK TO PROJECT CREATOR\n                    // =============================================\n\n                    // Get project creator details\n                    $this->db->select(\'emp.emp_id, emp.role_type\');\n                    $this->db->where(\'emp.id\', $task_res[0][\'CreationBy\']);\n                    $creator_emp = $this->db->get(\'employee_det as emp\')->row_array();\n\n                    // Default receiver_id to employee_det.id\n                    $creator_receiver_id = $task_res[0][\'CreationBy\'];\n\n                    // If creator is Management or Manager, use managers.mid\n                    if (!empty($creator_emp) && in_array($creator_emp[\'role_type\'], [\'1\', \'2\'])) {\n                        $this->db->select(\'mid\');\n                        $this->db->where(\'emp_id\', $creator_emp[\'emp_id\']);\n                        $mgr_row = $this->db->get(\'managers\')->row_array();\n                        if (!empty($mgr_row)) {\n                            $creator_receiver_id = $mgr_row[\'mid\'];\n                        }\n                    }\n\n                    // Notification type based on approver action\n                    // 1=Approved -> type 4, 2=Hold -> type 6, 3=Rejected -> type 5\n                    if($inps[\'inputPrestatus\'] == \'1\') {\n                        $notif_type = 4; // Project Approved\n                    } else if($inps[\'inputPrestatus\'] == \'3\') {\n                        $notif_type = 5; // Project Declined/Rejected\n                    } else {\n                        $notif_type = 6; // Project On Hold\n                    }\n\n                    $notification_data = array(\n                        \'type\'            => $notif_type,\n                        \'initiator_id\'    => $user_det[\'empdet_id\'],\n                        \'receiver_id\'     => $creator_receiver_id,\n                        \'project_id\'      => $tid,\n                        \'is_acknownledge\' => 0\n                    );\n                    $this->db->insert(\'notification_det\', $notification_data);\n\n                    $this->session->set_flashdata(\'succ\', \'Project Status Updated Successfully\');\n                    redirect($this->config->item(\'base_url\').\'admin/view_proj_data\');\n\n                } else {\n                    $this->session->set_flashdata(\'uperr\',\'Something went wrong. Error!!\');\n                    redirect($this->config->item(\'base_url\').\'admin/view_proj_data\');\n                }\n\n            } else {\n                $this->session->set_flashdata(\'uperr\', \'No Details Found..!\');\n                redirect($this->config->item(\'base_url\').\'admin/view_proj_data\');\n            }\n\n        } else {\n            $this->session->set_flashdata(\'uperr\', \'No Inputs Received..!\');\n            redirect($this->config->item(\'base_url\').\'admin/view_proj_data\');\n        }\n\n    } else {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n\n\t\n\t public function update_project_status($id){\n\t\t\t$this->load->model(\'admin/admin_model\'); \n\t \t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t \t\tif(isset($user_det) && !empty($user_det)){  \n\t \t\t//echo "<pre>"; print_r($user_det); exit;\n\t \t\t$tid = base64_decode(base64_decode(base64_decode(base64_decode(urldecode($id)))));\n \t\t\t  //echo "<pre>tid"; print_r($tid);  \n\t\t\t$inps = $this->input->post();\n\t \t    // echo "<pre>id"; print_r($inps); exit;\n\t\t\tif($this->input->post())\n\n\t\t\t\t{\n\n\t\t\t\t\t\n\t\t\t\t\t$this->db->select(\'pd.*\');\n\t\t\t\t \t$this->db->where(\'pd.pid\',$tid);\n\t\t\t\t \t$task_res=$this->db->get(\'project_det as pd\')->result_array();\n\t\t\t\t \t$task_id = count($task_res);\n\t\t\t\t \t//echo $this->db->last_query();\n\t\t\t\t \t // /echo"<pre>"; print_r($task_res);exit; \n\t\t\t\t \tif($task_id>0){\n \t\t\t\t\t\t\t\tif($inps[\'inputPrestatus\']=="1"){\n\n \t\t\t\t\t\t\t\t\t$data=array(\'status\'=>$inps[\'inputPrestatus\'],\'project_id\'=>$inps[\'inputPreProjectID\']); //0-inactive \n \t\t\t\t\t\t\t\t} else {\n\n\n \t\t\t\t\t\t\t\t\t$data=array(\'status\'=>$inps[\'inputPrestatus\']); //0-inactive \n \t\t\t\t\t\t\t\t}\n\n\t\t\t\t \t\t\t\t\t\n\t\t\t\t \t\t   \n\t\t\t\t\t\t \t\t\t$this->db->where(\'pid\',$tid);\n\t\t\t\t\t\t \t\t\t$sql_query=$this->db->update(\'project_det\',$data); \n\n\t\t\t\t \t\t\tif($sql_query>0){\n  \n\t\t\t\t\t\t   \t\t $this->session->set_flashdata(\'succ\', \'Project Approved Successfully\');\n\t\t\t\t\t\t   \t\t redirect($this->config->item(\'base_url\').\'admin/project_reports\');\n\t\t\t\t\t\t   \t\t //echo"success";exit;\n\t\t\t\t\t\t   \t\t}\n\t\t\t\t\t\t   \t\telse{\n\t\t\t\t\t\t   \t\t\t\n\t\t\t\t\t\t   \t\t\t$this->session->set_flashdata(\'uperr\',\'something went wrong.Error!!\');\n\t\t\t\t\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/project_reports\');\n\t\t\t\t\t\t   \t\t\t//echo"Failed";exit;\n\t\t\t\t\t\t   \t\t}\n\t\t\t\t \t\t\t//echo"<pre>"; print_r($ups);exit;\n\n\t\t\t\t \t} else {\n\n\t\t\t\t \t\t$this->session->set_flashdata(\'uperr\', \'No Details Found..!\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/project_reports\');\n\t\t\t\t\t}\n\t\t\t\t} else {\n\n\t\t\t\t\t$this->session->set_flashdata(\'uperr\', \'No Inputs Received..!\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/project_reports\');\n\t\t\t\t}\n\n\t\t} else {\n\t\t\t\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\n\t }\n\t public function employees_export(){\n\t \t$usersess_det=$this->session->userdata(\'logged_in\');\n\n\t \t // echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t \t\t$this->load->model(\'admin/admin_model\'); \n\t \t\t$data[\'emps\'] = $this->admin_model->get_employees_export();\n\t \t\t// echo "<pre>"; print_r($data[\'emps\']); exit;\n\t\t\t$this->load->library(\'excel\');\n \t\t \n\t\t\t$this->excel->setActiveSheetIndex(0);\n\t\t\t$this->excel->getActiveSheet()->setTitle("Employee List");\n\t\t\t\n\t \t\t$this->excel->getActiveSheet()->setCellValue(\'A1\', \'S.No\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'A1\')->getFont()->setBold(true);\n\t\t\t\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B1\', \'Employee Id\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'B1\')->getFont()->setBold(true);\n\t \n\t   \t\t$this->excel->getActiveSheet()->setCellValue(\'C1\', \'Name\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'C1\')->getFont()->setBold(true);\n\t\t\t\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D1\', \'Phone No\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'D1\')->getFont()->setBold(true);\n\t\t\t\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E1\', \'E-mail ID\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'E1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F1\', \'Department\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'F1\')->getFont()->setBold(true); \n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G1\', \'Designation\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'G1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H1\', \'DOJ\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'H1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I1\', \'Work Location\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'I1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J1\', \'Reporting Manager\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'J1\')->getFont()->setBold(true);\n\t \t\t\n\t \t\t $i=2;\n\t\tforeach($data[\'emps\'] as $val)\n\t\t{\n\t\t\t$sn = $i - 1;\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'A\'.$i,$sn);\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B\'.$i,$val[\'emp_id\']);\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'C\'.$i,$val[\'emp_name\']);\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D\'.$i,$val[\'mob-no\'] );\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E\'.$i,$val[\'email_id\']);\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F\'.$i,$val[\'department\']); \n\t\t\t$t