t\'\n//             );\n\n//             if(!empty($biller)) {\n\n//                 $this->db->join(\n//                     \'stationery_bill sb\',\n//                     \'ss.biller_id = sb.id\',\n//                     \'left\'\n//                 );\n\n//                 $this->db->where(\n//                     \'sb.company_name\',\n//                     $biller\n//                 );\n//             }\n\n//             if(!empty($from_date)) {\n\n//                 $this->db->where(\n//                     \'DATE(ss.summary_date) >=\',\n//                     $from_date\n//                 );\n//             }\n\n//             if(!empty($to_date)) {\n\n//                 $this->db->where(\n//                     \'DATE(ss.summary_date) <=\',\n//                     $to_date\n//                 );\n//             }\n\n//             $this->db->group_by(\'ss.category\');\n\n//             $this->db->order_by(\n//                 \'c.category_name\',\n//                 \'ASC\'\n//             );\n\n//             $group_mode = \'category\';\n//         }\n\n//         $group_data = $this->db->get()->result_array();\n\n//         // =========================\n//         // BUILD TABLE\n//         // =========================\n\n//         $stock_table = [];\n\n//         foreach($group_data as $row)\n//         {\n//             $row_purchased = $row[\'purchased\'];\n//             $row_consumed  = $row[\'consumed\'];\n\n//             $row_closing = $opening\n//                          + $row_purchased\n//                          - $row_consumed;\n\n//             $stock_table[] = [\n\n//                 \'category_name\' =>\n//                     $row[\'category_name\'] ?? \'-\',\n\n//                 \'subcategory_name\' =>\n//                     $row[\'subcategory_name\'] ?? \'-\',\n\n//                 \'opening\' =>\n//                     $opening,\n\n//                 \'purchased\' =>\n//                     $row_purchased,\n\n//                 \'consumed\' =>\n//                     $row_consumed,\n\n//                 \'closing\' =>\n//                     $row_closing\n//             ];\n//         }\n\n//         // =========================\n//         // PASS DATA\n//         // =========================\n\n//         $data[\'opening\']     = $opening;\n//         $data[\'purchased\']   = $purchased;\n//         $data[\'consumed\']    = $consumed;\n//         $data[\'closing\']     = $closing;\n//         $data[\'stock_table\'] = $stock_table;\n//         $data[\'group_mode\']  = $group_mode;\n\n//         $this->template->write_view(\n//             \'content\',\n//             \'admin/stationery_summary\',\n//             $data\n//         );\n\n//         $this->template->render();\n//     }\n//     else\n//     {\n//         $this->session->set_flashdata(\n//             \'err\',\n//             \'Invalid Session.Please Login Again..!!\'\n//         );\n\n//         redirect(\n//             $this->config->item(\'base_url\').\'admin/index\'\n//         );\n//     }\n// }\npublic function add_subcategory()\n{\n\t$employee_det = $this->session->userdata(\'logged_in\');\n\n        if(isset($employee_det) && !empty($employee_det))\n        {\n\t\t$category_id = $this->input->post(\'category\');\n\t\t$subcategory = $this->input->post(\'subcategory\');\n\n\t\tif(!empty($category_id) && !empty($subcategory))\n\t\t{\n\t\t\t// Check for duplicate subcategory in same category\n\t\t\t$this->db->where(\'category_id\', $category_id);\n\t\t\t$this->db->where(\'subcategory_name\', $subcategory);\n\t\t\t$exists = $this->db->get(\'stat_subcategory\')->row();\n\n\t\t\tif(!$exists)\n\t\t\t{\n\t\t\t\t$data = array(\n\t\t\t\t\t\'category_id\'      => $category_id,\n\t\t\t\t\t\'subcategory_name\' => $subcategory,\n\t\t\t\t\t\'created_by\'    => $employee_det[\'empdet_id\'],\n\t\t\t\t\t\'created_at\'       => date(\'Y-m-d H:i:s\')\n\t\t\t\t);\n\n\t\t\t\t$this->db->insert(\'stat_subcategory\', $data);\n\t\t\t\t$this->session->set_flashdata(\'true\', \'Subcategory Added Successfully\');\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Subcategory already exists in this category!\');\n\t\t\t}\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$this->session->set_flashdata(\'err\', \'Category and Subcategory name are mandatory!\');\n\t\t}\n\n   \t\t redirect($this->config->item(\'base_url\').\'admin/stationery_request\');\n\t}\n\telse\n\t{\n\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t}\n}\n\npublic function stationery_summary()\n{\n    $employee_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($employee_det) && !empty($employee_det))\n    {\n        // =========================\n        // FILTERS\n        // =========================\n\n        $from_date = $this->input->post(\'from_date\') !== NULL ? $this->input->post(\'from_date\') : $this->input->get(\'from_date\');\n        $to_date   = $this->input->post(\'to_date\') !== NULL ? $this->input->post(\'to_date\') : $this->input->get(\'to_date\');\n        $biller    = $this->input->post(\'biller\') !== NULL ? $this->input->post(\'biller\') : $this->input->get(\'biller\');\n        $cat       = $this->input->post(\'category\') !== NULL ? $this->input->post(\'category\') : $this->input->get(\'category\');\n        $subcat    = $this->input->post(\'subcategory\') !== NULL ? $this->input->post(\'subcategory\') : $this->input->get(\'subcategory\');\n\n        $data[\'selected_from_date\']   = $from_date;\n        $data[\'selected_to_date\']     = $to_date;\n        $data[\'selected_biller\']      = $biller;\n        $data[\'selected_category\']    = $cat;\n        $data[\'selected_subcategory\'] = $subcat;\n\n        // =========================\n        // FILTER DROPDOWNS\n        // =========================\n\n        $data[\'billers\'] = $this->db\n            ->select(\'company_name\')\n            ->distinct()\n            ->get(\'stationery_bill\')\n            ->result_array();\n\n        $data[\'categories\'] = $this->db\n            ->select(\'id, category_name as category\')\n            ->get(\'stat_category\')\n            ->result_array();\n\n        $data[\'subcategories\'] = $this->db\n            ->select(\'id, category_id, subcategory_name as subcategory\')\n            ->get(\'stat_subcategory\')\n            ->result_array();\n\n        // =========================\n        // BASE OPENING STOCK\n        // =========================\n\n        $et_sql = "\n            SELECT COALESCE(SUM(quantity),0) as total\n            FROM existing_table\n            WHERE 1=1\n        ";\n\n        if(!empty($cat)) {\n            $et_sql .= " AND category = ".(int)$cat;\n        }\n\n        if(!empty($subcat)) {\n            $et_sql .= " AND subcategory = ".(int)$subcat;\n        }\n\n        $base_stock = $this->db->query($et_sql)->row()->total;\n        $base_stock = $base_stock ? $base_stock : 0;\n\n        // =========================\n        // TOTAL PURCHASED & CONSUMED\n        // =========================\n\n        $this->db->select("\n            COALESCE(SUM(ss.purchased_stock),0) as purchased,\n            COALESCE(SUM(ss.consumed_stock),0) as consumed\n        ");\n\n        $this->db->from(\'stationery_summary ss\');\n\n        if(!empty($biller)) {\n\n            $this->db->join(\n                \'stationery_bill sb\',\n                \'ss.biller_id = sb.id\',\n                \'left\'\n            );\n\n            $this->db->where(\n                \'sb.company_name\',\n                $biller\n            );\n        }\n\n        if(!empty($from_date)) {\n\n            $this->db->where(\n                \'DATE(ss.summary_date) >=\',\n                $from_date\n            );\n        }\n\n        if(!empty($to_date)) {\n\n            $this->db->where(\n                \'DATE(ss.summary_date) <=\',\n                $to_date\n            );\n        }\n\n        if(!empty($cat)) {\n\n            $this->db->where(\n                \'ss.category\',\n                $cat\n            );\n        }\n\n        if(!empty($subcat)) {\n\n            $this->db->where(\n                \'ss.subcategory\',\n                $subcat\n            );\n        }\n\n        $summary = $this->db->get()->row();\n\n        $total_purchased = $summary->purchased ?? 0;\n        $total_consumed  = $summary->consumed ?? 0;\n\n        // =========================\n        // OPENING STOCK\n        // =========================\n\n        $opening = $base_stock;\n\n        // =========================\n        // FINAL TOTALS\n        // =========================\n\n        $purchased = $total_purchased;\n        $consumed  = $total_consumed;\n        $closing   = $opening + $purchased - $consumed;\n\n        // =========================\n        // TABLE DATA\n        // =========================\n\n        /*\n        NO FILTER\n            -> CATEGORY WISE\n\n        CATEGORY FILTER\n            -> SUBCATEGORY WISE\n\n        SUBCATEGORY FILTER\n            -> ONLY THAT SUBCATEGORY\n        */\n\n        // ==================================\n        // SUBCATEGORY FILTER MODE\n        // ==================================\n\n        if(!empty($subcat))\n        {\n            $this->db->select("\n                ss.category,\n                ss.subcategory,\n                c.category_name,\n                s.subcategory_name,\n                COALESCE(SUM(ss.purchased_stock),0) as purchased,\n                COALESCE(SUM(ss.consumed_stock),0) as consumed\n            ");\n\n            $this->db->from(\'stationery_summary ss\');\n\n            $this->db->join(\n                \'stat_category c\',\n                \'ss.category = c.id\',\n                \'left\'\n            );\n\n            $this->db->join(\n                \'stat_subcategory s\',\n                \'ss.subcategory = s.id\',\n                \'left\'\n            );\n\n            if(!empty($biller)) {\n\n                $this->db->join(\n                    \'stationery_bill sb\',\n                    \'ss.biller_id = sb.id\',\n                    \'left\'\n                );\n\n                $this->db->where(\n                    \'sb.company_name\',\n                    $biller\n                );\n            }\n\n            if(!empty($from_date)) {\n\n                $this->db->where(\n                    \'DATE(ss.summary_date) >=\',\n                    $from_date\n                );\n            }\n\n            if(!empty($to_date)) {\n\n                $this->db->where(\n                    \'DATE(ss.summary_date) <=\',\n                    $to_date\n                );\n            }\n\n            // OPTIONAL CATEGORY FILTER\n\n            if(!empty($cat)) {\n\n                $this->db->where(\n                    \'ss.category\',\n                    $cat\n                );\n            }\n\n            $this->db->where(\n                \'ss.subcategory\',\n                $subcat\n            );\n\n            $this->db->group_by(\'ss.subcategory\');\n\n            $this->db->order_by(\n                \'s.subcategory_name\',\n                \'ASC\'\n            );\n\n            $group_mode = \'subcategory\';\n        }\n\n        // ==================================\n        // CATEGORY FILTER MODE\n        // ==================================\n\n        else if(!empty($cat))\n        {\n            $this->db->select("\n                ss.category,\n                ss.subcategory,\n                c.category_name,\n                s.subcategory_name,\n                COALESCE(SUM(ss.purchased_stock),0) as purchased,\n                COALESCE(SUM(ss.consumed_stock),0) as consumed\n            ");\n\n            $this->db->from(\'stationery_summary ss\');\n\n            $this->db->join(\n                \'stat_category c\',\n                \'ss.category = c.id\',\n                \'left\'\n            );\n\n            $this->db->join(\n                \'stat_subcategory s\',\n                \'ss.subcategory = s.id\',\n                \'left\'\n            );\n\n            if(!empty($biller)) {\n\n                $this->db->join(\n                    \'stationery_bill sb\',\n                    \'ss.biller_id = sb.id\',\n                    \'left\'\n                );\n\n                $this->db->where(\n                    \'sb.company_name\',\n                    $biller\n                );\n            }\n\n            if(!empty($from_date)) {\n\n                $this->db->where(\n                    \'DATE(ss.summary_date) >=\',\n                    $from_date\n                );\n            }\n\n            if(!empty($to_date)) {\n\n                $this->db->where(\n                    \'DATE(ss.summary_date) <=\',\n                    $to_date\n                );\n            }\n\n            $this->db->where(\n                \'ss.category\',\n                $cat\n            );\n\n            $this->db->group_by(\'ss.subcategory\');\n\n            $this->db->order_by(\n                \'s.subcategory_name\',\n                \'ASC\'\n            );\n\n            $group_mode = \'subcategory\';\n        }\n\n        // ==================================\n        // DEFAULT CATEGORY MODE\n        // ==================================\n\n        else\n        {\n            $this->db->select("\n                ss.category,\n                c.category_name,\n                COALESCE(SUM(ss.purchased_stock),0) as purchased,\n                COALESCE(SUM(ss.consumed_stock),0) as consumed\n            ");\n\n            $this->db->from(\'stationery_summary ss\');\n\n            $this->db->join(\n                \'stat_category c\',\n                \'ss.category = c.id\',\n                \'left\'\n            );\n\n            if(!empty($biller)) {\n\n                $this->db->join(\n                    \'stationery_bill sb\',\n                    \'ss.biller_id = sb.id\',\n                    \'left\'\n                );\n\n                $this->db->where(\n                    \'sb.company_name\',\n                    $biller\n                );\n            }\n\n            if(!empty($from_date)) {\n\n                $this->db->where(\n                    \'DATE(ss.summary_date) >=\',\n                    $from_date\n                );\n            }\n\n            if(!empty($to_date)) {\n\n                $this->db->where(\n                    \'DATE(ss.summary_date) <=\',\n                    $to_date\n                );\n            }\n\n            $this->db->group_by(\'ss.category\');\n\n            $this->db->order_by(\n                \'c.category_name\',\n                \'ASC\'\n            );\n\n            $group_mode = \'category\';\n        }\n\n        $group_data = $this->db->get()->result_array();\n\n        // =========================\n        // BUILD TABLE\n        // =========================\n\n        $stock_table = [];\n\n        foreach($group_data as $row)\n        {\n            $row_purchased = $row[\'purchased\'];\n            $row_consumed  = $row[\'consumed\'];\n\n            $row_closing = $opening\n                         + $row_purchased\n                         - $row_consumed;\n\n            $stock_table[] = [\n\n                \'category_name\' =>\n                    $row[\'category_name\'] ?? \'-\',\n\n                \'subcategory_name\' =>\n                    $row[\'subcategory_name\'] ?? \'-\',\n\n                \'opening\' =>\n                    $opening,\n\n                \'purchased\' =>\n                    $row_purchased,\n\n                \'consumed\' =>\n                    $row_consumed,\n\n                \'closing\' =>\n                    $row_closing\n            ];\n        }\n\n        // =========================\n        // PASS DATA\n        // =========================\n\n        $data[\'opening\']     = $opening;\n        $data[\'purchased\']   = $purchased;\n        $data[\'consumed\']    = $consumed;\n        $data[\'closing\']     = $closing;\n        $data[\'stock_table\'] = $stock_table;\n        $data[\'group_mode\']  = $group_mode;\n\n        $this->template->write_view(\n            \'content\',\n            \'admin/stationery_summary\',\n            $data\n        );\n\n        $this->template->render();\n    }\n    else\n    {\n        $this->session->set_flashdata(\n            \'err\',\n            \'Invalid Session.Please Login Again..!!\'\n        );\n\n        redirect(\n            $this->config->item(\'base_url\').\'admin/index\'\n        );\n    }\n}\npublic function save_purchase()\n{\n\t$employee_det = $this->session->userdata(\'logged_in\');\n\n        if(isset($employee_det) && !empty($employee_det))\n        {\n\t\t\t$category     = $this->input->post(\'category\');\n\t\t\t$subcategory  = $this->input->post(\'subcategory\');\n\t\t\t$quantity     = $this->input->post(\'quantity\');\n\t\t\t$price        = $this->input->post(\'price\'); // Unit Price excluding GST\n\t\t\t$gst_p        = $this->input->post(\'gst_percent\');\n\t\t\t$gst_a        = $this->input->post(\'gst_amount\');\n\t\t\t$cgst_a       = $this->input->post(\'cgst_amount\');\n\t\t\t$sgst_a       = $this->input->post(\'sgst_amount\');\n\t\t\t$taxable_a    = $this->input->post(\'taxable_amount\');\n\t\t\t$total        = $this->input->post(\'total\'); // Grand Total for item\n\t\t\t$description  = $this->input->post(\'description\');\n\t\t\t$hsn_codes    = $this->input->post(\'hsn_code\');\n\t\t\t$company_name = $this->input->post(\'company_name\');\n\t\t\t$bill_number  = $this->input->post(\'bill_number\');\n\t\t\t$bill_date    = $this->input->post(\'bill_date\');\n\t\t\t$state        = $this->input->post(\'state\');\n\n\t\t\t$total_taxable_amount = $this->input->post(\'total_taxable_amount\');\n\t\t\t$total_gst_amount     = $this->input->post(\'total_gst_amount\');\n\t\t\t$total_cgst_amount    = $this->input->post(\'total_cgst_amount\');\n\t\t\t$total_sgst_amount    = $this->input->post(\'total_sgst_amount\');\n\t\t\t$grand_total          = $this->input->post(\'grand_total\');\n\n\t\t\tif(empty($company_name) || empty($bill_number) || empty($bill_date) || empty($category))\n\t\t\t{\n\t\t\t\t$this->session->set_flashdata(\'err\', \'All fields are mandatory!\');\n\t\t\t\tredirect(\'admin/purchase_form\');\n\t\t\t}\n\n\t\t\t$photo = \'\';\n\n\t\t\tif(!empty($_FILES[\'bill_photo\'][\'name\']))\n\t\t\t{\n\t\t\t\t$config[\'upload_path\'] = \'./bills/\';\n\t\t\t\t$config[\'allowed_types\'] = \'*\';\n\t\t\t\t$config[\'encrypt_name\'] = TRUE;\n\n\t\t\t\t$this->load->library(\'upload\', $config);\n\n\t\t\t\tif($this->upload->do_upload(\'bill_photo\'))\n\t\t\t\t{\n\t\t\t\t\t$uploadData = $this->upload->data();\n\t\t\t\t\t$photo = \'bills/\'.$uploadData[\'file_name\'];\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Insert into stationery_bill\n\t\t\t$bill_data = array(\n\t\t\t\t\'company_name\'             => $company_name,\n\t\t\t\t\'bill_number\'              => $bill_number,\n\t\t\t\t\'bill_date\'                => $bill_date,\n\t\t\t\t\'state\'                    => $state,\n\t\t\t\t\'bill_photo\'               => $photo,\n\t\t\t\t\'total_bill_taxable_amount\' => $total_taxable_amount,\n\t\t\t\t\'igst\'                     => 0, // Always store 0 as requested\n\t\t\t\t\'cgst_amount\'              => $total_cgst_amount,\n\t\t\t\t\'sgst_amount\'              => $total_sgst_amount,\n\t\t\t\t\'grand_total\'              => $grand_total,\n\t\t\t\t\'created_by\'               => $employee_det[\'empdet_id\']\n\t\t\t);\n\t\t\t$this->db->insert(\'stationery_bill\', $bill_data);\n\t\t\t$bill_id = $this->db->insert_id();\n\n\t\t\tfor($i=0; $i<count($category); $i++)\n\t\t\t{\n\t\t\t\t// Check for existing pending request for this item\n\t\t\t\t$this->db->where(\'category\', $category[$i]);\n\t\t\t\t$this->db->where(\'subcategory\', $subcategory[$i]);\n\t\t\t\t$this->db->where(\'requested_flag\', 0);\n\t\t\t\t$this->db->order_by(\'creation_date\', \'ASC\');\n\t\t\t\t$this->db->limit(1);\n\t\t\t\t$existing_request = $this->db->get(\'req_purchase_form\')->row();\n\n\t\t\t\t$data = array(\n\t\t\t\t\t\'status\'              => 0, // 0 for requested/purchased, 1 for consumed\n\t\t\t\t\t\'requested_flag\'      => 1, // Purchased\n\t\t\t\t\t\'biller_id\'           => $bill_id,\n\t\t\t\t\t\'total_price\'         => $total[$i],\n\t\t\t\t\t\'price\'               => $price[$i],\n\t\t\t\t\t\'gst\'                 => $gst_a[$i],\n\t\t\t\t\t\'description\'         => $description[$i],\n\t\t\t\t\t\'updation_date\'       => date(\'Y-m-d H:i:s\')\n\t\t\t\t);\n\n\t\t\t\tif($existing_request)\n\t\t\t\t{\n\t\t\t\t\t// Update purchased quantity\n\t\t\t\t\t$data[\'purchased_quantity\'] = $quantity[$i];\n\t\t\t\t\t$this->db->where(\'id\', $existing_request->id);\n\t\t\t\t\t$this->db->update(\'req_purchase_form\', $data);\n\t\t\t\t\t\n\t\t\t\t\t// Update stationery_summary table\n\t\t\t\t\t$this->admin_model->update_stationery_summary(\n\t\t\t\t\t\t$category[$i],\n\t\t\t\t\t\t$subcategory[$i],\n\t\t\t\t\t\t$quantity[$i],\n\t\t\t\t\t\t\'purchase\',\n\t\t\t\t\t\tdate(\'Y-m-d\'),\n\t\t\t\t\t\t$bill_id\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t// Insert new record if it was a direct purchase without a request\n\t\t\t\t\t$data[\'category\']           = $category[$i];\n\t\t\t\t\t$data[\'subcategory\']        = $subcategory[$i];\n\t\t\t\t\t$data[\'purchased_quantity\'] = $quantity[$i];\n\t\t\t\t\t$data[\'requested_quantity\'] = 0; // No request\n\t\t\t\t\t$data[\'creation_date\']      = date(\'Y-m-d H:i:s\');\n\t\t\t\t\t$data[\'purchased_by\']         = $employee_det[\'empdet_id\'];\n\t\t\t\t\t$this->db->insert(\'req_purchase_form\', $data);\n\t\t\t\t\t\n\t\t\t\t\t// Update stationery_summary table\n\t\t\t\t\t$this->admin_model->update_stationery_summary(\n\t\t\t\t\t\t$category[$i],\n\t\t\t\t\t\t$subcategory[$i],\n\t\t\t\t\t\t$quantity[$i],\n\t\t\t\t\t\t\'purchase\',\n\t\t\t\t\t\tdate(\'Y-m-d\'),\n\t\t\t\t\t\t$bill_id\n\t\t\t\t\t);\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t$this->session->set_flashdata(\'succ\',\'Purchase Saved Successfully\');\n\t\t\tredirect(\'admin/purchase_form\');\n\t}\n\telse\n\t{\n\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t}\n}\npublic function purchase_form()\n{\n\t$employee_det = $this->session->userdata(\'logged_in\');\n\n        if(isset($employee_det) && !empty($employee_det))\n        {\n\t\t$data[\'categories\'] = $this->admin_model->get_categories();\n\t\t$data[\'all_items\'] = $this->admin_model->get_all_items();\n\t\t$data[\'billers\'] = $this->db->select(\'company_name\')->distinct()->get(\'stationery_bill\')->result_array();\n\n\t\t$this->template->write_view(\'content\', \'admin/purchase_form\', $data);\n\t\t$this->template->render();\n\t}\n\telse\n\t{\n\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t}\n}\npublic function existing_stock()\n{\n    $employee_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($employee_det) && !empty($employee_det))\n    {\n\n        $from_date = $this->input->get(\'from_date\');\n        $to_date   = $this->input->get(\'to_date\');\n\n        $this->db->select(\'\n            category,\n            subcategory,\n            SUM(quantity) as total_qty\n        \');\n\n        $this->db->from(\'req_purchase_form\');\n        $this->db->where(\'requested_flag\', 1); // Only purchased items count towards stock\n\n        // FILTER\n        if($from_date != \'\' && $to_date != \'\')\n        {\n            $this->db->where(\'DATE(creation_date) >=\', $from_date);\n            $this->db->where(\'DATE(creation_date) <=\', $to_date);\n        }\n\n        $this->db->group_by(\'category\');\n        $this->db->group_by(\'subcategory\');\n\n        $data[\'stock\'] = $this->db->get()->result_array();\n\n        $this->template->write_view(\'content\', \'admin/existing_stock\', $data);\n        $this->template->render();\n\n    }\n    else\n    {\n        $this->session->set_flashdata(\n            \'err\',\n            \'Invalid Session.Please Login Again..!!\'\n        );\n\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n    public function purchase_history()\n    {\n        $employee_det = $this->session->userdata(\'logged_in\');\n\n        if(isset($employee_det) && !empty($employee_det))\n        {\n            $month = $this->input->post(\'month\') !== NULL ? $this->input->post(\'month\') : $this->input->get(\'month\');\n            $biller = $this->input->post(\'biller\') !== NULL ? $this->input->post(\'biller\') : $this->input->get(\'biller\');\n\n            $data[\'selected_month\'] = $month;\n            $data[\'selected_biller\'] = $biller;\n\n            $where = " WHERE 1=1 ";\n            if($month){\n                $where .= " AND DATE_FORMAT(sb.bill_date, \'%Y-%m\') = \'$month\' ";\n            }\n            if($biller){\n                $where .= " AND sb.company_name = \'$biller\' ";\n            }\n\n            $raw_purchases = $this->db->query("\n                SELECT \n                    sp.*, \n                    c.hsn_code, \n                    c.gst_percent, \n                    c.category_name as category, \n                    s.subcategory_name as subcategory, \n                    sp.total_price as total, \n                    sb.company_name, \n                    sb.bill_number, \n                    sb.bill_date, \n                    sb.bill_photo, \n                    sb.total_bill_taxable_amount,\n                    sb.igst as total_gst,\n                    sb.cgst_amount as total_cgst,\n                    sb.sgst_amount as total_sgst,\n                    sb.state,\n                    sb.grand_total,\n                    sb.created_at as bill_created_at\n                FROM req_purchase_form sp\n                LEFT JOIN stationery_bill sb ON sp.biller_id = sb.id\n                LEFT JOIN stat_category c ON sp.category = c.id\n                LEFT JOIN stat_subcategory s ON sp.subcategory = s.id\n                $where AND sp.requested_flag = 1\n                ORDER BY sb.bill_date DESC, sb.id DESC, sp.id ASC\n            ")->result_array();\n\n            $grouped = [];\n            foreach ($raw_purchases as $p) {\n                $biller_id = $p[\'biller_id\'];\n                if (!isset($grouped[$biller_id])) {\n                    $grouped[$biller_id] = [\n                        \'biller_id\' => $biller_id,\n                        \'company_name\' => $p[\'company_name\'],\n                        \'bill_number\' => $p[\'bill_number\'],\n                        \'bill_date\' => $p[\'bill_date\'],\n                        \'bill_photo\' => $p[\'bill_photo\'],\n                        \'created_at\' => $p[\'bill_created_at\'],\n                        \'total_taxable\' => $p[\'total_bill_taxable_amount\'],\n                        \'total_gst\' => $p[\'total_gst\'],\n                        \'total_cgst\' => $p[\'total_cgst\'],\n                        \'total_sgst\' => $p[\'total_sgst\'],\n                        \'total_amount\' => $p[\'grand_total\'],\n                        \'items\' => []\n                    ];\n                }\n                $grouped[$biller_id][\'items\'][] = $p;\n            }\n            $data[\'purchases\'] = array_values($grouped);\n\n            // Fetch unique billers for filter dropdown (excluding \'Unknown\' historical entries)\n            $this->db->select(\'DISTINCT(company_name)\');\n            $this->db->where(\'company_name IS NOT NULL\');\n            $this->db->where(\'company_name !=\', \'Unknown\');\n            $data[\'billers\'] = $this->db->get(\'stationery_bill\')->result_array();\n\n            $this->template->write_view(\'content\', \'admin/purchase_history\', $data);\n            $this->template->render();\n        }\n        else\n        {\n            $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n            redirect($this->config->item(\'base_url\').\'admin/index\');\n        }\n    }\n    public function get_subcategories_by_cat()\n    {\n\t\t $employee_det = $this->session->userdata(\'logged_in\');\n\n        if(isset($employee_det) && !empty($employee_det))\n        {\n\t\t\t$cat_id = $this->input->get(\'cat_id\');\n\t\t\tif(!empty($cat_id)) {\n\t\t\t\t$this->db->where(\'category_id\', $cat_id);\n\t\t\t\t$subs = $this->db->get(\'stat_subcategory\')->result_array();\n\t\t\t\techo json_encode($subs);\n\t\t\t} else {\n\t\t\t\techo json_encode([]);\n\t\t\t}\n\n\t\t}\n        else\n        {\n            $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n            redirect($this->config->item(\'base_url\').\'admin/index\');\n        }\n    }\n\n\tpublic function get_global_notifications()\n{\n    $this->load->model(\'admin/admin_model\');\n\n    $employee_det = $this->session->userdata(\'logged_in\');\n\n    if (empty($employee_det)) {\n        return [];\n    }\n\n    $notifications_array = [];\n\n    // Get receiver ID\n    if ($employee_det[\'role_type\'] == \'1\' || $employee_det[\'role_type\'] == \'2\')\n    {\n        $this->db->select(\'mid\');\n        $this->db->where(\'emp_id\', $employee_det[\'emp_id\']);\n        $query = $this->db->get(\'managers\')->row_array();\n\n        if (empty($query)) {\n            return [];\n        }\n\n        $receiver_id = $query[\'mid\'];\n    }\n    else\n    {\n        $receiver_id = $employee_det[\'empdet_id\'];\n    }\n\n    // Get notifications\n    $notifications = $this->admin_model->get_notifications_id($receiver_id);\n\n    if (!empty($notifications))\n    {\n        foreach ($notifications as $notification)\n        {\n            $notification_item = [\n                \'notification_id\' => $notification[\'nid\'],\n                \'type\' => $notification[\'type\'],\n                \'task_id\' => $notification[\'task_id\'],\n                \'initiator_id\' => $notification[\'initiator_id\'],\n                \'timestamp\' => $this->format_notification_date($notification[\'creation_date\']),\n                \'is_acknowledged\' => (bool)$notification[\'is_acknownledge\'],\n                \'initiator_name\' => \'\',\n                \'header\' => \'Notification\',\n                \'body\' => \'\',\n                \'project\' => \'\',\n                \'priority\' => \'\',\n                \'due_date\' => \'\',\n                \'priority_label\' => \'\'\n            ];\n\n            // Employee Name\n            $employeeName = $this->admin_model->get_employee_name_by_id($notification[\'initiator_id\']);\n            $notification_item[\'initiator_name\'] = $employeeName ?? \'Unknown\';\n\n            switch ($notification[\'type\'])\n            {\n                case 1:\n\n                    $additional_task = $this->admin_model->get_additional_tasks_notifier($notification[\'additional_id\']);\n\n                    if (!empty($additional_task))\n                    {\n                        $task = $additional_task[0];\n\n                        $notification_item[\'header\'] = \'New Additional Task\';\n                        $notification_item[\'body\'] = $task[\'activityDesc\'] ?? \'No description\';\n                        $notification_item[\'project\'] = $task[\'project_name\'] ?? \'N/A\';\n                        $notification_item[\'priority\'] = $task[\'priority_type\'] ?? 0;\n                        $notification_item[\'due_date\'] = $this->format_due_date($task[\'due_date\']);\n                    }\n\n                    break;\n\n                case 2:\n\n                    $leaveproject_task = $this->admin_model->get_leaveproject_tasks_notifier($notification[\'slpno\']);\n\n                    if (!empty($leaveproject_task))\n                    {\n                        $Task = $leaveproject_task[0];\n\n                        $projectName = $this->admin_model->get_project_name_by_id($Task[\'project_name\']);\n\n                        $notification_item[\'project\'] = $projectName[0][\'project_name\'] ?? \'N/A\';\n                        $notification_item[\'header\'] = \'New Project/Leave Task\';\n                        $notification_item[\'body\'] = $projectName[0][\'project_name\'] ?? \'No description\';\n                        $notification_item[\'project_name\'] = $Task[\'project_name\'] ?? \'N/A\';\n                        $notification_item[\'priority\'] = $Task[\'initiator_id\'] ?? 0;\n                        $notification_item[\'due_date\'] = $this->format_due_date($Task[\'to_date\']);\n                    }\n\n                    break;\n\n                case 3:\n\n                    $projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\n                    if (!empty($projectName))\n                    {\n                        $project = $projectName[0];\n\n                        $notification_item[\'header\'] = \'Project Approval Required\';\n                        $notification_item[\'body\'] = \'Please approve the project: <strong>\'.$project[\'project_name\'].\'</strong>\';\n                        $notification_item[\'project\'] = $project[\'project_name\'];\n\n                        $approve_url = $this->config->item(\'base_url\').\'admin/approve_project/\'.$project[\'pid\'].\'/\'.$notification[\'nid\'];\n                        $decline_url = $this->config->item(\'base_url\').\'admin/decline_project/\'.$project[\'pid\'].\'/\'.$notification[\'nid\'];\n\n                        // $notification_item[\'body\'] .= \'<br><a href="\'.$approve_url.\'" class="btn btn-sm btn-success mt-2" style="color:white;padding:2px 10px;margin-right:5px;">Approve Project</a>\';\n                        // $notification_item[\'body\'] .= \'<a href="\'.$decline_url.\'" class="btn btn-sm btn-danger mt-2" style="color:white;padding:2px 10px;">Decline Project</a>\';\n                    }\n\n                    break;\n\n                case 4:\n\n                    $projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\n                    if (!empty($projectName))\n                    {\n                        $project = $projectName[0];\n\n                        $notification_item[\'header\'] = \'Project Approved\';\n                        $notification_item[\'body\'] = \'Your project <strong>\'.$project[\'project_name\'].\'</strong> was approved.\';\n                        $notification_item[\'project\'] = $project[\'project_name\'];\n                    }\n\n                    break;\n\n                case 5:\n\n                    $projectName = $this->admin_model->get_project_name_by_id($notification[\'project_id\']);\n\n                    if (!empty($projectName))\n                    {\n                        $project = $projectName[0];\n\n                        $notification_item[\'header\'] = \'Project Declined\';\n                        $notification_item[\'body\'] = \'Your project <strong>\'.$project[\'project_name\'].\'</strong> was declined.\';\n                        $notification_item[\'project\'] = $project[\'project_name\'];\n                    }\n\n                    break;\n\t\t\t\t\t\t\t\t\tcase 7:\n\n    $notification_item[\'header\'] =\n        \'Probation Assessment Submitted\';\n\n    $notification_item[\'body\'] =\n        $notification_item[\'initiator_name\'] .\n        \' has submitted a probation assessment.\';\n\n    break;\n            }\n\n            $notifications_array[] = $notification_item;\n        }\n\n        usort($notifications_array, function ($a, $b) {\n            return strtotime($b[\'timestamp\']) - strtotime($a[\'timestamp\']);\n        });\n    }\n\n    return $notifications_array;\n}\npublic function update_project_status_ajax()\n{\n    $user_det = $this->session->userdata(\'logged_in\');\n    if(isset($user_det) && !empty($user_det))\n    {\n        $pid       = $this->input->post(\'pid\');\n        $status    = $this->input->post(\'status\');\n        $project_id = $this->input->post(\'project_id\');\n\n        if(empty($pid) || empty($status)) {\n            echo json_encode([\'status\' => \'error\', \'message\' => \'Invalid input.\']);\n            return;\n        }\n\n        $data = array(\'status\' => $status);\n\n        // If Ongoing, also update project_id\n        if($status == \'1\' && !empty($project_id)) {\n            $data[\'project_id\'] = $project_id;\n        }\n\n        $this->db->where(\'pid\', $pid);\n        $result = $this->db->update(\'project_det\', $data);\n\n        if($result) {\n            echo json_encode([\'status\' => \'success\']);\n        } else {\n            echo json_encode([\'status\' => \'error\']);\n        }\n    }\n    else\n    {\n        echo json_encode([\'status\' => \'error\', \'message\' => \'Invalid session.\']);\n    }\n}\npublic function update_approver_status_ajax()\n{\n    $user_det = $this->session->userdata(\'logged_in\');\n    if(isset($user_det) && !empty($user_det))\n    {\n        $pid             = $this->input->post(\'pid\');\n        $approver_status = $this->input->post(\'approver_status\');\n\n        if(empty($pid) || empty($approver_status)) {\n            echo json_encode([\'status\' => \'error\', \'message\' => \'Invalid input.\']);\n            return;\n        }\n\n        $this->db->where(\'pid\', $pid);\n        $result = $this->db->update(\'project_det\', [\'approver_status\' => $approver_status]);\n\n        if($result) {\n            // Send notification back to project creator\n            $this->db->where(\'pid\', $pid);\n            $project = $this->db->get(\'project_det\')->row_array();\n\n            if(!empty($project)) {\n                $this->db->select(\'emp.emp_id, emp.role_type\');\n                $this->db->where(\'emp.id\', $project[\'CreationBy\']);\n                $creator_emp = $this->db->get(\'employee_det as emp\')->row_array();\n\n                $creator_receiver_id = $project[\'CreationBy\'];\n                if(!empty($creator_emp) && in_array($creator_emp[\'role_type\'], [\'1\',\'2\'])) {\n                    $this->db->select(\'mid\');\n                    $this->db->where(\'emp_id\', $creator_emp[\'emp_id\']);\n                    $mgr_row = $this->db->get(\'managers\')->row_array();\n                    if(!empty($mgr_row)) {\n                        $creator_receiver_id = $mgr_row[\'mid\'];\n                    }\n                }\n\n                // 1=Approved -> notif type 4, 3=Rejected -> notif type 5\n                $notif_type = ($approver_status == \'1\') ? 4 : 5;\n\n                $notification_data = array(\n                    \'type\'            => $notif_type,\n                    \'initiator_id\'    => $user_det[\'empdet_id\'],\n                    \'receiver_id\'     => $creator_receiver_id,\n                    \'project_id\'      => $pid,\n                    \'is_acknownledge\' => 0\n                );\n                $this->db->insert(\'notification_det\', $notification_data);\n            }\n\n            echo json_encode([\'status\' => \'success\']);\n        } else {\n            echo json_encode([\'status\' => \'error\']);\n        }\n    }\n    else\n    {\n        echo json_encode([\'status\' => \'error\', \'message\' => \'Invalid session.\']);\n    }\n}\npublic function update_project_id_ajax()\n{\n    $pid = $this->input->post(\'pid\');\n    $project_id = $this->input->post(\'project_id\');\n\n    if(empty($pid) || empty($project_id))\n    {\n        echo json_encode([\n            \'status\' => \'error\',\n            \'message\' => \'Invalid input.\'\n        ]);\n        return;\n    }\n\n    $this->db->where(\'pid\', $pid);\n\n    $result = $this->db->update(\'project_det\', [\n        \'project_id\' => $project_id\n    ]);\n\n    echo json_encode([\n        \'status\' => $result ? \'success\' : \'error\'\n    ]);\n}\n\n\n\n\n\npublic function save_probation_assessment()\n{\n    $employee_det = $this->session->userdata(\'logged_in\');\n\n    $data = array(\n\n        \'emp_id\' => $employee_det[\'emp_id\'],\n\n        \'q1\' => $this->input->post(\'q1\'),\n        \'q2\' => $this->input->post(\'q2\'),\n        \'q3\' => $this->input->post(\'q3\'),\n        \'q4\' => $this->input->post(\'q4\'),\n        \'q5\' => $this->input->post(\'q5\'),\n        \'q6\' => $this->input->post(\'q6\'),\n        \'q7\' => $this->input->post(\'q7\'),\n        \'q8\' => $this->input->post(\'q8\'),\n        \'q9\' => $this->input->post(\'q9\'),\n        \'q10\' => $this->input->post(\'q10\'),\n\n        \'qa\' => $this->input->post(\'qa\'),\n        \'qb\' => $this->input->post(\'qb\'),\n        \'qc\' => $this->input->post(\'qc\'),\n        \'qd\' => $this->input->post(\'qd\'),\n        \'qe\' => $this->input->post(\'qe\'),\n        \'qf\' => $this->input->post(\'qf\'),\n        \'qg\' => $this->input->post(\'qg\'),\n        \'qh\' => $this->input->post(\'qh\'),\n        \'qi\' => $this->input->post(\'qi\'),\n        \'qj\' => $this->input->post(\'qj\'),\n        \'qk\' => $this->input->post(\'qk\'),\n\t\t\'ql\' => $this->input->post(\'ql\'),\n\t\t\'qm\' => $this->input->post(\'qm\'),\n\t\t\'qn\' => $this->input->post(\'qn\'),\n\t\t\'qo\' => $this->input->post(\'qo\'),\n\t\t\'qp\' => $this->input->post(\'qp\'),\n\t\t\'qq\' => $this->input->post(\'qq\'),\n\t\t\'qr\' => $this->input->post(\'qr\'),\n\t\t\'qs\' => $this->input->post(\'qs\'),\n\t\t\'qt\' => $this->input->post(\'qt\'),\n        \'company_suggestion\' => $this->input->post(\'company_suggestion\'),\n        \'department_suggestion\' => $this->input->post(\'department_suggestion\'),\n\n        // table column name\n        \'other_comments\' => $this->input->post(\'others\'),\n\n        \'submitted_at\' => date(\'Y-m-d H:i:s\'),\n        \'status\' => 1\n    );\n\t$this->db->insert(\'probation_assessment\', $data);\n$this->db->where(\'emp_id\', $employee_det[\'emp_id\']);\n$this->db->update(\'employee_det\', array(\n    \'probation_status\' => 1\n));\n\n$hr_receiver_id = INETMASTER; \n\n$notification = array(\n    \'slpno\'            => NULL,\n    \'additional_id\'    => NULL,\n    \'project_id\'       => NULL,\n    \'type\'             => 7,\n    \'initiator_id\'     => $employee_det[\'empdet_id\'],\n    \'receiver_id\'      => INETMASTER,\n    \'creation_date\'    => date(\'Y-m-d H:i:s\'),\n    \'from_date\'        => date(\'Y-m-d\'),\n    \'to_date\'          => date(\'Y-m-d\'),\n    \'is_acknownledge\'  => 0\n);\n\n$this->db->insert(\'notification_det\', $notification);\ntry\n{\n    $mail_data[\'employee\'] = $employee_det;\n\n    require(APPPATH.\'libraries/InetMailer.php\');\n\n    $objs = new InetMailer();\n    $mail = $objs->load();\n\n    $mail->setFrom(\n        \'info@inetcsc.com\',\n        \'Performance Tracker\'\n    );\n\n    // HR Email\n    $mail->addAddress(\'reka@inetcsc.com\');\n\n    $mail->isHTML(true);\n\n   $mail->Subject =\n    \'Self Assessment Probation Completed - \'\n    .$employee_det[\'emp_id\']\n    .\' - \'\n    .$employee_det[\'emp_name\'];\n\n    $mail->Body =\n        $this->load->view(\n            \'admin/probation_assessment_email\',\n            $mail_data,\n            TRUE\n        );\nrequire_once APPPATH.\'libraries/mpdf/mpdf.php\';\n\n// $pdf_data[\'employee\'] = $employee_det;\n// $pdf_data[\'assessment\'] = $data;\n\n// $html = $this->load->view(\n//     \'admin/probation_assessment_pdf\',\n//     $pdf_data,\n//     TRUE\n// );\n$this->db->select(\'emp_name\');\n$this->db->where(\'mid\', $employee_det[\'report_mgr_id\']);\n$lead = $this->db->get(\'managers\')->row_array();\n\n$this->db->where(\'emp_id\', $employee_det[\'emp_id\']);\n$emp_info = $this->db->get(\'employee_det\')->row_array();\n\n$join_date = new DateTime($employee_det[\'join_dt\']);\n$probation_date = new DateTime($emp_info[\'probation_date\']);\n\n$probation_days = $join_date->diff($probation_date)->days;\n\n$pdf_data[\'employee\'] = $employee_det;\n$pdf_data[\'employee\'][\'team_lead\'] = $lead[\'emp_name\'];\n$pdf_data[\'employee\'][\'probation_date\'] = $emp_info[\'probation_date\'];\n$pdf_data[\'employee\'][\'probation_days\'] = $probation_days;\n\n$pdf_data[\'assessment\'] = $data;\n\n$html = $this->load->view(\n    \'admin/probation_assessment_pdf\',\n    $pdf_data,\n    TRUE\n);\n\n$mpdf = new mPDF();\n\n$mpdf->SetHTMLFooter(\'\n<div style="text-align:center;font-size:10px;">\nI-NET Secure Labs Pvt Ltd | Page {PAGENO} of {nbpg}\n</div>\n\');\n\n$mpdf->WriteHTML($html);\n\n$pdf_file =\n    FCPATH.\'uploads/probation_\'\n    .$employee_det[\'emp_id\']\n    .\'.pdf\';\n\n$mpdf->Output($pdf_file,\'F\');\n$mail->addAttachment($pdf_file);\n    $mail->send();\n}\ncatch(Exception $e)\n{\n}\n$this->session->set_flashdata(\n    \'true\',\n    \'Probation Assessment Submitted Successfully.\'\n);\n\n\n    redirect(\'admin/emp_dashboard\');\n}\npublic function probation_assessment()\n{\n    $employee_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($employee_det) && !empty($employee_det))\n    {\n        $data[\'employee_det\'] = $employee_det;\n\n        $this->template->write_view(\n            \'content\',\n            \'admin/probation_assessment\',\n            $data\n        );\n\n        $this->template->render();\n    }\n    else\n    {\n        $this->session->set_flashdata(\n            \'err\',\n            \'Invalid Session.Please Login Again..!!\'\n        );\n\n        redirect(\n            $this->config->item(\'base_url\').\'admin/index\'\n        );\n    }\n}\nprivate function check_probation_access()\n{\n    $employee_det = $this->session->userdata(\'logged_in\');\n\n    if(empty($employee_det))\n    {\n        return;\n    }\n\n    // skip admin and manager\n    if($employee_det[\'role_type\'] == 1 || $employee_det[\'role_type\'] == 2)\n    {\n        return;\n    }\n\n    // $this->db->select(\'probation_status\');\n\t$this->db->select(\'probation_status, probation_date\');\n    $this->db->where(\'emp_id\', $employee_det[\'emp_id\']);\n    $emp = $this->db->get(\'employee_det\')->row_array();\n\n    // if($emp[\'probation_status\'] == 0)\n\tif(\n    $emp[\'probation_status\'] == 0\n    &&\n    !empty($emp[\'probation_date\'])\n    &&\n    date(\'Y-m-d\') >= $emp[\'probation_date\']\n)\n    {\n        $allowed = array(\n            \'emp_dashboard\',\n            \'probation_assessment\',\n            \'save_probation_assessment\',\n            \'logout\'\n        );\n\n        if(!in_array($this->router->fetch_method(), $allowed))\n        {\n            $this->session->set_flashdata(\n                \'err\',\n                \'Please complete your Probation Assessment first.\'\n            );\n\n            redirect(\'admin/emp_dashboard\');\n        }\n    }\n}\npublic function test_pdf()\n{\n    require_once APPPATH.\'libraries/mpdf/mpdf.php\';\n\n    $mpdf = new mPDF();\n\n    $mpdf->WriteHTML(\'<h1>Hello Rekha</h1>\');\n\n    $mpdf->Output();\n}\npublic function send_probation_reminders()\n{\n    $today = date(\'Y-m-d\');\n\n    $employees = $this->db\n       ->where(\'probation_date <=\', $today)\n        ->where(\'probation_status\', 0)\n        ->where(\'probation_mail_sent\', 0)\n        ->get(\'employee_det\')\n        ->result_array();\n\n    foreach($employees as $employee)\n    {\n        try\n        {\n            require(APPPATH.\'libraries/InetMailer.php\');\n\n            $objs = new InetMailer();\n            $mail = $objs->load();\n\n            $mail->setFrom(\n                \'info@inetcsc.com\',\n                \'Performance Tracker\'\n            );\n\n            $mail->addAddress($employee[\'email_id\']);\n\n            $mail->isHTML(true);\n\n            $mail->Subject =\n                \'Congratulations! Your Probation Period Has Been Completed\';\n\n            $mail->Body = \'\n                Dear \'.$employee[\'emp_name\'].\'<br><br>\n\n                Congratulations on successfully completing your probation period.<br><br>\n\n                Please login to IWORK and complete your Self Assessment Form.<br><br>\n\n                Employee ID : \'.$employee[\'emp_id\'].\'<br><br>\n\n                Regards,<br>\n                HR Team\n            \';\n\n            $mail->send();\n\n            $this->db->where(\'id\', $employee[\'id\']);\n            $this->db->update(\n                \'employee_det\',\n                array(\'probation_mail_sent\' => 1)\n            );\n        }\n        catch(Exception $e)\n        {\n        }\n    }\n\n    echo "Completed";\n}\n\n\tpublic function engage()\n\t{\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t\t$this->load->model(\'admin/admin_model\');\n\t\t\t// 1. Separate post generation\n\t\t\t$this->admin_model->generateTodayCelebrationPosts();\n\n\t\t\t// 2. Fetch timeline\n\t\t\t$current_employee_id = $usersess_det[\'empdet_id\'];\n\t\t\t$data[\'timeline\'] = $this->admin_model->getEngageTimeline($current_employee_id);\n\t\t\t\n\t\t\t$this->template->write_view(\'content\', \'admin/engage\', $data);\n\t\t\t$this->template->render();\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function toggle_like($post_id)\n\t{\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t\t$this->load->model(\'admin/admin_model\');\n\t\t\t$employee_id = $usersess_det[\'empdet_id\'];\n\t\t\t$this->admin_model->toggleLike($post_id, $employee_id);\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/engage\');\n\t\t} else {\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function add_comment($post_id)\n\t{\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t\t$comment = $this->input->post(\'comment\');\n\t\t\tif (!empty(trim($comment))) {\n\t\t\t\t$this->load->model(\'admin/admin_model\');\n\t\t\t\t$employee_id = $usersess_det[\'empdet_id\'];\n\t\t\t\t$this->admin_model->addComment($post_id, $employee_id, $comment);\n\t\t\t}\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/engage\');\n\t\t} else {\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function delete_comment($comment_id)\n\t{\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($usersess_det) && !empty($usersess_det))\n\t\t{\n\t\t\t$this->load->model(\'admin/admin_model\');\n\t\t\t$employee_id = $usersess_det[\'empdet_id\'];\n\t\t\t$this->admin_model->softDeleteComment($comment_id, $employee_id);\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/engage\');\n\t\t} else {\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\tpublic function get_drilldown_data() {\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(empty($user_det)) {\n\t\t\techo json_encode([\'error\' => \'Not logged in\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$chart_type = $this->input->post(\'chart_type\');\n\t\t$response = [\'columns\' => [], \'data\' => []];\n\n\t\tif ($chart_type == \'attendance\') {\n\t\t\t$date = $this->input->post(\'date\');\n\t\t\t$data = $this->admin_model->get_drilldown_attendance($date);\n\t\t\t$response[\'columns\'] = [\n\t\t\t\t[\'title\' => \'Employee ID\', \'data\' => \'emp_id\'],\n\t\t\t\t[\'title\' => \'Name\', \'data\' => \'emp_name\'],\n\t\t\t\t[\'title\' => \'Department\', \'data\' => \'department_name\'],\n\t\t\t\t[\'title\' => \'Login Time\', \'data\' => \'created_date\']\n\t\t\t];\n\t\t\t$response[\'data\'] = $data;\n\t\t} \n\t\telse if ($chart_type == \'tickets\') {\n\t\t\t$status = $this->input->post(\'status\');\n\t\t\t$time_filter = $this->input->post(\'time_filter\');\n\t\t\t$from_date = $this->input->post(\'from_date\');\n\t\t\t$to_date = $this->input->post(\'to_date\');\n\n\t\t\t$data = $this->admin_model->get_drilldown_tickets($status, $time_filter, $from_date, $to_date);\n\t\t\t$response[\'columns\'] = [\n\t\t\t\t[\'title\' => \'Ticket No\', \'data\' => \'ticket_no\'],\n\t\t\t\t[\'title\' => \'Subject\', \'data\' => \'subject\'],\n\t\t\t\t[\'title\' => \'Raised By\', \'data\' => \'raised_by_name\'],\n\t\t\t\t[\'title\' => \'Priority\', \'data\' => \'priority_name\'],\n\t\t\t\t[\'title\' => \'Created Date\', \'data\' => \'created_date\']\n\t\t\t];\n\t\t\t$response[\'data\'] = $data;\n\t\t}\n\t\telse if ($chart_type == \'projects\') {\n\t\t\t$project_name = $this->input->post(\'project_name\');\n\t\t\t$data = $this->admin_model->get_drilldown_project_tasks($project_name);\n\t\t\t$response[\'columns\'] = [\n\t\t\t\t[\'title\' => \'Task Title\', \'data\' => \'title\'],\n\t\t\t\t[\'title\' => \'Assigned To\', \'data\' => \'emp_name\'],\n\t\t\t\t[\'title\' => \'Status\', \'data\' => \'status_name\'],\n\t\t\t\t[\'title\' => \'Due Date\', \'data\' => \'due_date\']\n\t\t\t];\n\t\t\t$response[\'data\'] = $data;\n\t\t}\n\t\telse if ($chart_type == \'department\') {\n\t\t\t$dept_id = $this->input->post(\'dept_id\');\n\t\t\t$data = $this->admin_model->get_drilldown_department($dept_id);\n\t\t\t$response[\'columns\'] = [\n\t\t\t\t[\'title\' => \'Employee ID\', \'data\' => \'emp_id\'],\n\t\t\t\t[\'title\' => \'Employee Name\', \'data\' => \'emp_name\'],\n\t\t\t\t[\'title\' => \'Department\', \'data\' => \'department_name\'],\n\t\t\t\t[\'title\' => \'Designation\', \'data\' => \'designation_name\'],\n\t\t\t\t[\'title\' => \'Total Assigned Tasks\', \'data\' => \'assigned\'],\n\t\t\t\t[\'title\' => \'Completed Tasks\', \'data\' => \'completed\'],\n\t\t\t\t[\'title\' => \'Pending Tasks\', \'data\' => \'pending\'],\n\t\t\t\t[\'title\' => \'Overdue Tasks\', \'data\' => \'overdue\'],\n\t\t\t\t[\'title\' => \'Completion Percentage\', \'data\' => \'perf_pct\'],\n\t\t\t\t[\'title\' => \'Active Projects\', \'data\' => \'projects\']\n\t\t\t];\n\t\t\t$response[\'data\'] = $data;\n\t\t}\n\t\telse if ($chart_type == \'employee\') {\n\t\t\t$emp_id = $this->input->post(\'emp_id\');\n\t\t\t$data = $this->admin_model->get_drilldown_employee($emp_id);\n\t\t\t$response[\'columns\'] = [\n\t\t\t\t[\'title\' => \'Employee\', \'data\' => \'emp_name\'],\n\t\t\t\t[\'title\' => \'Completed Tasks\', \'data\' => \'completed\'],\n\t\t\t\t[\'title\' => \'Pending Tasks\', \'data\' => \'pending\'],\n\t\t\t\t[\'title\' => \'Working Hours\', \'data\' => \'working_hours\'],\n\t\t\t\t[\'title\' => \'Projects\', \'data\' => \'projects\']\n\t\t\t];\n\t\t\t$response[\'data\'] = $data;\n\t\t}\n\t\telse if ($chart_type == \'month\') {\n\t\t\t$month = $this->input->post(\'month\');\n\t\t\t$data = $this->admin_model->get_drilldown_month($month);\n\t\t\t$response[\'columns\'] = [\n\t\t\t\t[\'title\' => \'Task Title\', \'data\' => \'title\'],\n\t\t\t\t[\'title\' => \'Project\', \'data\' => \'project_name\'],\n\t\t\t\t[\'title\' => \'Assigned To\', \'data\' => \'emp_name\'],\n\t\t\t\t[\'title\' => \'Status\', \'data\' => \'status_name\'],\n\t\t\t\t[\'title\' => \'Completed Date\', \'data\' => \'completed_date\']\n\t\t\t];\n\t\t\t$response[\'data\'] = $data;\n\t\t}\n\n\t\techo json_encode($response);\n\t}\n\n\tpublic function ajax_project_progress()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$action = $this->input->get(\'action\');\n\t\tif ($action === \'drilldown\') {\n\t\t\t$project_name = $this->input->get(\'project_name\');\n\t\t\t$date = $this->input->get(\'date\');\n\n\t\t\t$this->db->select(\'t.activityDesc as title, emp.emp_name, p.project_name, t.status, t.created_date as due_date\');\n\t\t\t$this->db->from(\'task_details t\');\n\t\t\t$this->db->join(\'project_det p\', \'p.pid = t.project_name\', \'left\');\n\t\t\t$this->db->join(\'employee_det emp\', \'emp.id = t.e_id\', \'left\');\n\t\t\t$this->db->where(\'emp.status\', 1); // Only active employees\n\t\t\t$this->db->where(\'p.project_name\', $project_name);\n\t\t\t$this->db->where(\'DATE(t.created_date)\', $date);\n\t\t\t$tasks = $this->db->get()->result_array();\n\n\t\t\t$data = [];\n\t\t\tforeach ($tasks as $t) {\n\t\t\t\t$status = (int)$t[\'status\'];\n\t\t\t\t$planned_pct = ($status === 2) ? 0 : 100;\n\t\t\t\t$completed_pct = ($status === 1) ? 100 : 0;\n\t\t\t\t$pending_pct = ($status === 0) ? 100 : 0;\n\n\t\t\t\t$status_name = \'Pending\';\n\t\t\t\tif ($status === 1) {\n\t\t\t\t\t$status_name = \'Completed\';\n\t\t\t\t} else if ($status === 2) {\n\t\t\t\t\t$status_name = \'Called Off\';\n\t\t\t\t}\n\n\t\t\t\t$data[] = [\n\t\t\t\t\t\'title\' => $t[\'title\'] ? $t[\'title\'] : \'Task\',\n\t\t\t\t\t\'emp_name\' => $t[\'emp_name\'] ? $t[\'emp_name\'] : \'Unassigned\',\n\t\t\t\t\t\'project_name\' => $t[\'project_name\'],\n\t\t\t\t\t\'planned_pct\' => $planned_pct,\n\t\t\t\t\t\'completed_pct\' => $completed_pct,\n\t\t\t\t\t\'pending_pct\' => $pending_pct,\n\t\t\t\t\t\'status\' => $status,\n\t\t\t\t\t\'status_name\' => $status_name,\n\t\t\t\t\t\'due_date\' => $t[\'due_date\'] ? date(\'Y-m-d\', strtotime($t[\'due_date\'])) : null\n\t\t\t\t];\n\t\t\t}\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $data]);\n\t\t\treturn;\n\t\t}\n\n\t\t$time_filter = $this->input->get(\'time_filter\');\n\t\t$from_date = $this->input->get(\'from_date\');\n\t\t$to_date = $this->input->get(\'to_date\');\n\t\t$project_id = $this->input->get(\'project_id\');\n\n\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t$top_proj_ids = [];\n\t\tif ($project_id === \'all\') {\n\t\t\t$this->db->select("td2.project_name, COUNT(*) as count");\n\t\t\t$this->db->from("task_details td2");\n\t\t\t$this->db->join("employee_det epp", "epp.id = td2.e_id");\n\t\t\t$this->db->where("epp.status", 1); // Only active employees\n\t\t\t$this->admin_model->apply_date_filter("td2.created_date", $time_filter, $from_date, $to_date);\n\t\t\t$this->db->group_by("td2.project_name");\n\t\t\t$this->db->order_by("count", "DESC");\n\t\t\t$this->db->limit(10);\n\t\t\t$top_proj_res = $this->db->get()->result_array();\n\t\t\t$top_proj_ids = array_column($top_proj_res, \'project_name\');\n\t\t} else {\n\t\t\t$top_proj_ids = [$project_id];\n\t\t}\n\n\t\t$series = [];\n\t\tif (!empty($top_proj_ids)) {\n\t\t\t$this->db->select("t.project_name, p.project_name as proj_title, DATE(t.created_date) as task_date, t.status");\n\t\t\t$this->db->from("task_details t");\n\t\t\t$this->db->join("project_det p", "p.pid = t.project_name");\n\t\t\t$this->db->join("employee_det epp2", "epp2.id = t.e_id");\n\t\t\t$this->db->where("epp2.status", 1); // Only active employees\n\t\t\t$this->db->where_in(\'t.project_name\', $top_proj_ids);\n\t\t\t$this->admin_model->apply_date_filter("t.created_date", $time_filter, $from_date, $to_date);\n\t\t\t$this->db->order_by(\'DATE(t.created_date)\', \'ASC\');\n\t\t\t$tasks = $this->db->get()->result_array();\n\n\t\t\t$project_data = [];\n\t\t\t$project_titles = [];\n\t\t\tforeach ($tasks as $t) {\n\t\t\t\t$pid = $t[\'project_name\'];\n\t\t\t\t$project_titles[$pid] = $t[\'proj_title\'];\n\t\t\t\t$date = $t[\'task_date\'];\n\t\t\t\tif (empty($date)) continue;\n\n\t\t\t\tif (!isset($project_data[$pid])) {\n\t\t\t\t\t$project_data[$pid] = [];\n\t\t\t\t}\n\t\t\t\tif (!isset($project_data[$pid][$date])) {\n\t\t\t\t\t$project_data[$pid][$date] = [\'completed\' => 0, \'total\' => 0];\n\t\t\t\t}\n\t\t\t\tif ($t[\'status\'] == 1) {\n\t\t\t\t\t$project_data[$pid][$date][\'completed\']++;\n\t\t\t\t}\n\t\t\t\t$project_data[$pid][$date][\'total\']++;\n\t\t\t}\n\n\t\t\tforeach ($project_data as $pid => $dates) {\n\t\t\t\tksort($dates);\n\t\t\t\t$cum_completed = 0;\n\t\t\t\t$cum_total = 0;\n\t\t\t\t$data_points = [];\n\t\t\t\tforeach ($dates as $date => $counts) {\n\t\t\t\t\t$cum_completed += $counts[\'completed\'];\n\t\t\t\t\t$cum_total += $counts[\'total\'];\n\t\t\t\t\t$progress_pct = $cum_total > 0 ? round(($cum_completed / $cum_total) * 100, 1) : 0;\n\t\t\t\t\t$data_points[] = [\n\t\t\t\t\t\t\'x\' => $date,\n\t\t\t\t\t\t\'y\' => $progress_pct\n\t\t\t\t\t];\n\t\t\t\t}\n\t\t\t\t$series[] = [\n\t\t\t\t\t\'name\' => $project_titles[$pid],\n\t\t\t\t\t\'data\' => $data_points\n\t\t\t\t];\n\t\t\t}\n\t\t}\n\n\t\techo json_encode([\'status\' => \'success\', \'series\' => $series]);\n\t}\n\n\tpublic function ajax_employee_performance()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$action = $this->input->get(\'action\');\n\t\t$time_filter = $this->input->get(\'time_filter\');\n\t\t$from_date = $this->input->get(\'from_date\');\n\t\t$to_date = $this->input->get(\'to_date\');\n\n\t\tif ($action === \'profile\') {\n\t\t\t$emp_id = $this->input->get(\'emp_id\');\n\n\t\t\t// Get employee basic details\n\t\t\t$this->db->select(\'e.emp_name, e.emp_id, d.department_name\');\n\t\t\t$this->db->from(\'employee_det e\');\n\t\t\t$this->db->join(\'department_det d\', \'d.id = e.department\', \'left\');\n\t\t\t$this->db->where(\'e.id\', $emp_id);\n\t\t\t$emp_profile = $this->db->get()->row_array();\n\n\t\t\tif (empty($emp_profile)) {\n\t\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Employee not found\']);\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t// Query tasks counts matching time frame\n\t\t\t$this->db->select("\n\t\t\t\tCOUNT(t.id) as assigned,\n\t\t\t\tSUM(CASE WHEN t.status = 1 THEN 1 ELSE 0 END) as completed,\n\t\t\t\tSUM(CASE WHEN t.status = 0 THEN 1 ELSE 0 END) as pending,\n\t\t\t\tSUM(CASE WHEN t.status = 2 THEN 1 ELSE 0 END) as calledoff,\n\t\t\t\tSUM(CASE WHEN t.status = 0 AND DATE(t.created_date) < CURDATE() THEN 1 ELSE 0 END) as overdue\n\t\t\t");\n\t\t\t$this->db->from(\'task_details t\');\n\t\t\t$this->db->where(\'t.e_id\', $emp_id);\n\t\t\t$this->admin_model->apply_date_filter(\'t.created_date\', $time_filter, $from_date, $to_date);\n\t\t\t$stats = $this->db->get()->row_array();\n\n\t\t\t// Compute average completion time in hours\n\t\t\t$this->db->select("AVG(TIMESTAMPDIFF(HOUR, t.created_date, t.task_comp_dt)) as avg_hours");\n\t\t\t$this->db->from(\'task_details t\');\n\t\t\t$this->db->where(\'t.e_id\', $emp_id);\n\t\t\t$this->db->where(\'t.status\', 1);\n\t\t\t$this->db->where(\'t.task_comp_dt IS NOT NULL\');\n\t\t\t$this->admin_model->apply_date_filter(\'t.created_date\', $time_filter, $from_date, $to_date);\n\t\t\t$avg_time_res = $this->db->get()->row_array();\n\t\t\t$avg_hours = $avg_time_res ? round($avg_time_res[\'avg_hours\'], 1) : null;\n\n\t\t\t// Format Average Completion Time nicely\n\t\t\tif ($avg_hours === null || $avg_hours <= 0) {\n\t\t\t\t$avg_time_str = \'N/A\';\n\t\t\t} else if ($avg_hours < 24) {\n\t\t\t\t$avg_time_str = $avg_hours . \' hrs\';\n\t\t\t} else {\n\t\t\t\t$avg_time_str = round($avg_hours / 24, 1) . \' days\';\n\t\t\t}\n\n\t\t\t// Active Projects\n\t\t\t$this->db->select(\'DISTINCT(p.project_name)\');\n\t\t\t$this->db->from(\'task_details t\');\n\t\t\t$this->db->join(\'project_det p\', \'p.pid = t.project_name\');\n\t\t\t$this->db->where(\'t.e_id\', $emp_id);\n\t\t\t$this->db->where(\'t.status\', 0); // active/pending tasks\n\t\t\t$proj_res = $this->db->get()->result_array();\n\t\t\t$active_projects = array_column($proj_res, \'project_name\');\n\n\t\t\t$total_assigned = (int)$stats[\'assigned\'];\n\t\t\t$perf_pct = $total_assigned > 0 ? round(((int)$stats[\'completed\'] / $total_assigned) * 100, 1) : 0;\n\n\t\t\t$profile_data = [\n\t\t\t\t\'emp_name\' => $emp_profile[\'emp_name\'],\n\t\t\t\t\'employee_id\' => $emp_profile[\'emp_id\'],\n\t\t\t\t\'department\' => $emp_profile[\'department_name\'] ? $emp_profile[\'department_name\'] : \'N/A\',\n\t\t\t\t\'assigned\' => $total_assigned,\n\t\t\t\t\'completed\' => (int)$stats[\'completed\'],\n\t\t\t\t\'pending\' => (int)$stats[\'pending\'],\n\t\t\t\t\'calledoff\' => (int)$stats[\'calledoff\'],\n\t\t\t\t\'overdue\' => (int)$stats[\'overdue\'],\n\t\t\t\t\'perf_pct\' => $perf_pct,\n\t\t\t\t\'avg_time\' => $avg_time_str,\n\t\t\t\t\'active_projects\' => !empty($active_projects) ? implode(\', \', $active_projects) : \'None\'\n\t\t\t];\n\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $profile_data]);\n\t\t\treturn;\n\t\t}\n\n\t\t$filter_emp_id = $this->input->get(\'filter_emp_id\');\n\n\t\t// Default Action: ranked employee list for the chart\n\t\t$this->db->select("e.emp_name, e.emp_id as employee_id, e.id as emp_db_id");\n\t\t$this->db->from("employee_det e");\n\t\t$this->db->where("e.status", 1);\n\t\tif ($filter_emp_id !== \'all\' && !empty($filter_emp_id)) {\n\t\t\t$this->db->where("e.id", $filter_emp_id);\n\t\t}\n\t\t$active_emps = $this->db->get()->result_array();\n\n\t\t$chart_data = [];\n\t\tforeach ($active_emps as $emp) {\n\t\t\t$emp_id = $emp[\'emp_db_id\'];\n\t\t\t$this->db->select("\n\t\t\t\tSUM(CASE WHEN status = 1 THEN 1 ELSE 0 END) as completed,\n\t\t\t\tCOUNT(id) as total\n\t\t\t");\n\t\t\t$this->db->from(\'task_details\');\n\t\t\t$this->db->where(\'e_id\', $emp_id);\n\t\t\t$this->admin_model->apply_date_filter(\'created_date\', $time_filter, $from_date, $to_date);\n\t\t\t$counts = $this->db->get()->row_array();\n\n\t\t\t$total = (int)$counts[\'total\'];\n\t\t\t$completed = (int)$counts[\'completed\'];\n\t\t\t$perf_pct = $total > 0 ? round(($completed / $total) * 100, 1) : 0;\n\n\t\t\t$chart_data[] = [\n\t\t\t\t\'emp_name\' => $emp[\'emp_name\'],\n\t\t\t\t\'employee_id\' => $emp[\'employee_id\'],\n\t\t\t\t\'emp_db_id\' => $emp_id,\n\t\t\t\t\'completed_tasks\' => $completed,\n\t\t\t\t\'perf_pct\' => $perf_pct\n\t\t\t];\n\t\t}\n\n\t\t// Sort by completed tasks DESC, performance DESC\n\t\tusort($chart_data, function($a, $b) {\n\t\t\tif ($a[\'completed_tasks\'] != $b[\'completed_tasks\']) {\n\t\t\t\treturn $b[\'completed_tasks\'] <=> $a[\'completed_tasks\'];\n\t\t\t}\n\t\t\treturn $b[\'perf_pct\'] <=> $a[\'perf_pct\'];\n\t\t});\n\n\t\techo json_encode([\'status\' => \'success\', \'data\' => $chart_data]);\n\t}\n\n\tpublic function ajax_monthly_productivity()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$month_filter = $this->input->get(\'month_filter\');\n\t\t$emp_filter = $this->input->get(\'emp_filter\');\n\n\t\t$this->db->from("task_details");\n\t\t$this->db->join("employee_det epm", "epm.id = task_details.e_id");\n\t\t$this->db->where("epm.status", 1); // Only active employees\n\t\t$this->db->where("created_date IS NOT NULL");\n\n\t\tif ($emp_filter !== \'all\' && !empty($emp_filter)) {\n\t\t\t$this->db->where("task_details.e_id", $emp_filter);\n\t\t}\n\n\t\tif ($month_filter !== \'all\' && !empty($month_filter)) {\n\t\t\t// Specific Month\n\t\t\t$this->db->select("DATE_FORMAT(created_date, \'%Y-%m-%d\') as month_name,\n\t\t\t                  SUM(CASE WHEN status = 1 THEN 1 ELSE 0 END) as completed_count,\n\t\t\t                  SUM(CASE WHEN status = 0 THEN 1 ELSE 0 END) as pending_count,\n\t\t\t                  SUM(CASE WHEN status = 2 THEN 1 ELSE 0 END) as called_off_count");\n\t\t\t$this->db->where("MONTH(created_date)", $month_filter);\n\t\t\t$this->db->where("YEAR(created_date)", date(\'Y\'));\n\t\t\t$this->db->group_by("DATE(created_date)");\n\t\t} else {\n\t\t\t// Last 12 Months\n\t\t\t$this->db->select("DATE_FORMAT(created_date, \'%Y-%m\') as month_name,\n\t\t\t                  SUM(CASE WHEN status = 1 THEN 1 ELSE 0 END) as completed_count,\n\t\t\t                  SUM(CASE WHEN status = 0 THEN 1 ELSE 0 END) as pending_count,\n\t\t\t                  SUM(CASE WHEN status = 2 THEN 1 ELSE 0 END) as called_off_count");\n\t\t\t$this->db->group_by("DATE_FORMAT(created_date, \'%Y-%m\')");\n\t\t\t$this->db->limit(12);\n\t\t}\n\n\t\t$this->db->order_by("month_name", "ASC");\n\t\t$rows = $this->db->get()->result_array();\n\n\t\t$months = [];\n\t\t$completed = [];\n\t\t$pending = [];\n\t\t$called_off = [];\n\n\t\tforeach ($rows as $row) {\n\t\t\t$months[] = $row[\'month_name\'];\n\t\t\t$completed[] = (int)$row[\'completed_count\'];\n\t\t\t$pending[] = (int)$row[\'pending_count\'];\n\t\t\t$called_off[] = (int)$row[\'called_off_count\'];\n\t\t}\n\n\t\techo json_encode([\n\t\t\t\'status\' => \'success\',\n\t\t\t\'months\' => $months,\n\t\t\t\'completed\' => $completed,\n\t\t\t\'pending\' => $pending,\n\t\t\t\'called_off\' => $called_off\n\t\t]);\n\t}\n\n\tpublic function ajax_attendance_trend()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$emp_filter = $this->input->get(\'emp_filter\');\n\t\t$time_filter = $this->input->get(\'time_filter\');\n\t\t$from_date = $this->input->get(\'from_date\');\n\t\t$to_date = $this->input->get(\'to_date\');\n\n\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t$this->db->select("a.Date as att_date, \n\t\t                  SUM(CASE WHEN a.Status LIKE \'P%\' OR a.Status = \'OD\' OR a.Status = \'WFH\' OR a.Status = \'PN:P\' THEN 1 ELSE 0 END) as present_count,\n\t\t                  COUNT(*) as total_count");\n\t\t$this->db->from("EmployeeAttendance a");\n\n\t\tif ($emp_filter !== \'all\' && !empty($emp_filter)) {\n\t\t\t$this->db->join("employee_det e", "e.emp_id = a.EmployeeNo");\n\t\t\t$this->db->where("e.id", $emp_filter);\n\t\t\t$this->db->where("e.status", 1); // Only active employees\n\t\t} else {\n\t\t\t// For \'all\' filter, still restrict to active employees\n\t\t\t$this->db->join("employee_det e", "e.emp_id = a.EmployeeNo");\n\t\t\t$this->db->where("e.status", 1); // Only active employees\n\t\t}\n\n\t\t$this->admin_model->apply_date_filter("a.Date", $time_filter, $from_date, $to_date);\n\n\t\t$this->db->group_by("a.Date");\n\t\t$this->db->order_by("a.Date", "ASC");\n\t\t$rows = $this->db->get()->result_array();\n\n\t\t$dates = [];\n\t\t$present = [];\n\t\t$total = [];\n\n\t\tforeach ($rows as $row) {\n\t\t\t$dates[] = $row[\'att_date\'];\n\t\t\t$present[] = (int)$row[\'present_count\'];\n\t\t\t$total[] = (int)$row[\'total_count\'];\n\t\t}\n\n\t\techo json_encode([\n\t\t\t\'status\' => \'success\',\n\t\t\t\'dates\' => $dates,\n\t\t\t\'present\' => $present,\n\t\t\t\'total\' => $total\n\t\t]);\n\t}\n\n\tpublic function ajax_ticket_status()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!isset($employee_det) || empty($employee_det)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$time_filter = $this->input->get(\'time_filter\');\n\t\t$from_date = $this->input->get(\'from_date\');\n\t\t$to_date = $this->input->get(\'to_date\');\n\n\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t$this->db->select("t.status, COUNT(*) as count");\n\t\t$this->db->from("tickets t");\n\t\t$this->db->join("employee_det et", "et.id = t.raised_by");\n\t\t$this->db->where("et.status", 1); // Only tickets from active employees\n\n\t\t$this->admin_model->apply_date_filter("t.created_at", $time_filter, $from_date, $to_date);\n\n\t\t$this->db->group_by("t.status");\n\t\t$rows = $this->db->get()->result_array();\n\n\t\t$status_counts = [\n\t\t\t1 => 0,\n\t\t\t2 => 0,\n\t\t\t3 => 0,\n\t\t\t4 => 0\n\t\t];\n\n\t\tforeach ($rows as $row) {\n\t\t\t$s = (int)$row[\'status\'];\n\t\t\tif (isset($status_counts[$s])) {\n\t\t\t\t$status_counts[$s] = (int)$row[\'count\'];\n\t\t\t}\n\t\t}\n\n\t\techo json_encode([\n\t\t\t\'status\' => \'success\',\n\t\t\t\'open\' => $status_counts[1],\n\t\t\t\'progress\' => $status_counts[2],\n\t\t\t\'closed\' => $status_counts[3],\n\t\t\t\'cancelled\' => $status_counts[4],\n\t\t\t\'total\' => array_sum($status_counts)\n\t\t]);\n\t}\n\n\tpublic function change_user_password()\n\t{\n\t\t$this->output->set_content_type(\'application/json\');\n\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif (!$user_det || empty($user_det[\'emp_id\'])) {\n\t\t\techo json_encode([\'success\' => false, \'error\' => \'Session expired. Please log in again.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$current_password = $this->input->post(\'current_password\');\n\t\t$new_password = $this->input->post(\'new_password\');\n\t\t$confirm_password = $this->input->post(\'confirm_password\');\n\n\t\tif (empty($current_password)) {\n\t\t\techo json_encode([\'success\' => false, \'error\' => \'Current password is required.\']);\n\t\t\treturn;\n\t\t}\n\t\tif (empty($new_password)) {\n\t\t\techo json_encode([\'success\' => false, \'error\' => \'New password is required.\']);\n\t\t\treturn;\n\t\t}\n\t\tif (empty($confirm_password)) {\n\t\t\techo json_encode([\'success\' => false, \'error\' => \'Confirm password is required.\']);\n\t\t\treturn;\n\t\t}\n\t\tif ($new_password !== $confirm_password) {\n\t\t\techo json_encode([\'success\' => false, \'error\' => \'Confirm password does not match.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$emp_id = $user_det[\'emp_id\'];\n\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t$user = $this->admin_model->get_employee_by_id($emp_id);\n\t\tif (!$user || $user->passwd !== md5($current_password)) {\n\t\t\techo json_encode([\'success\' => false, \'error\' => \'Current password is incorrect.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$updated = $this->admin_model->update_user_password($emp_id, md5($new_password));\n\t\tif ($updated) {\n\t\t\techo json_encode([\'success\' => true, \'message\' => \'Password updated successfully.\']);\n\t\t} else {\n\t\t\techo json_encode([\'success\' => false, \'error\' => \'Failed to update password. Please try again.\']);\n\t\t}\n\t}\n\n\tpublic function ajax_get_skills()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!$employee_det) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Session expired. Please log in again.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$employee_id = $this->input->get(\'employee_id\');\n\t\tif (empty($employee_id)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Employee ID is required.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$skills = $this->admin_model->get_employee_skills($employee_id);\n\t\techo json_encode([\'status\' => \'success\', \'skills\' => $skills]);\n\t}\n\n\tpublic function ajax_save_skill()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!$employee_det) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Session expired. Please log in again.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$id = $this->input->post(\'id\');\n\t\t$employee_id = $this->input->post(\'employee_id\');\n\t\t$skill_name = trim($this->input->post(\'skill_name\') ?? \'\');\n\n\t\tif (empty($employee_id)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Employee ID is required.\']);\n\t\t\treturn;\n\t\t}\n\t\tif (empty($skill_name)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Skill Name is required.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t// Permissions check\n\t\t$is_own_profile = ($employee_det[\'empdet_id\'] == $employee_id);\n\t\t$is_hr = (isset($employee_det[\'department_name\']) && (strpos(strtolower($employee_det[\'department_name\']), \'hr\') !== false || strpos(strtolower($employee_det[\'department_name\']), \'human resource\') !== false));\n\t\t$is_admin = ($employee_det[\'role_type\'] == \'1\');\n\n\t\tif (!$is_own_profile && !$is_admin && !$is_hr) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized operation. You cannot modify skills for this employee.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t$skill_data = array(\n\t\t\t\'employee_id\' => $employee_id,\n\t\t\t\'skill_name\' => $skill_name,\n\t\t\t\'updated_date\' => date(\'Y-m-d H:i:s\')\n\t\t);\n\n\t\tif (!empty($id)) {\n\t\t\t// Update\n\t\t\t// Verify if the skill belongs to this employee\n\t\t\t$existing = $this->admin_model->get_employee_skill_by_id($id);\n\t\t\tif (!$existing || $existing[\'employee_id\'] != $employee_id) {\n\t\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Skill not found or belongs to a different employee.\']);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t$success = $this->admin_model->update_employee_skill($id, $skill_data);\n\t\t} else {\n\t\t\t// Insert\n\t\t\t$skill_data[\'created_by\'] = $employee_det[\'empdet_id\'];\n\t\t\t$skill_data[\'created_date\'] = date(\'Y-m-d H:i:s\');\n\t\t\t$skill_data[\'status\'] = 1;\n\t\t\t$success = $this->admin_model->save_employee_skill($skill_data);\n\t\t}\n\n\t\tif ($success) {\n\t\t\techo json_encode([\'status\' => \'success\']);\n\t\t} else {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Database operation failed.\']);\n\t\t}\n\t}\n\n\tpublic function ajax_delete_skill()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!$employee_det) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Session expired. Please log in again.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$id = $this->input->post(\'id\');\n\t\tif (empty($id)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Skill ID is required.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$existing = $this->admin_model->get_employee_skill_by_id($id);\n\t\tif (!$existing) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Skill not found.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$employee_id = $existing[\'employee_id\'];\n\n\t\t// Permissions check\n\t\t$is_own_profile = ($employee_det[\'empdet_id\'] == $employee_id);\n\t\t$is_hr = (isset($employee_det[\'department_name\']) && (strpos(strtolower($employee_det[\'department_name\']), \'hr\') !== false || strpos(strtolower($employee_det[\'department_name\']), \'human resource\') !== false));\n\t\t$is_admin = ($employee_det[\'role_type\'] == \'1\');\n\n\t\tif (!$is_own_profile && !$is_admin && !$is_hr) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized operation. You cannot modify skills for this employee.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$success = $this->admin_model->delete_employee_skill($id);\n\t\tif ($success) {\n\t\t\techo json_encode([\'status\' => \'success\']);\n\t\t} else {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Database operation failed.\']);\n\t\t}\n\t}\n\n\tpublic function ajax_upload_avatar()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (!$employee_det) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Session expired. Please log in again.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$emp_db_id = (int) $employee_det[\'empdet_id\'];\n\n\t\t// Only own profile upload is allowed\n\t\tif (empty($emp_db_id)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Unauthorized.\']);\n\t\t\treturn;\n\t\t}\n\n\t\tif (empty($_FILES[\'avatar_file\'][\'name\'])) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'No file uploaded.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$file = $_FILES[\'avatar_file\'];\n\t\t$allowed_types = [\'image/jpeg\', \'image/jpg\', \'image/png\', \'image/webp\'];\n\t\t$max_size = 5 * 1024 * 1024; // 5MB\n\n\t\t// Validate MIME type\n\t\t$finfo = new finfo(FILEINFO_MIME_TYPE);\n\t\t$mime = $finfo->file($file[\'tmp_name\']);\n\t\tif (!in_array($mime, $allowed_types)) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Invalid file type. Only JPG, PNG, and WEBP are allowed.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t// Validate file size\n\t\tif ($file[\'size\'] > $max_size) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'File size exceeds 5MB limit.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$upload_dir = FCPATH . \'uploads/avatars/\';\n\t\tif (!is_dir($upload_dir)) {\n\t\t\tmkdir($upload_dir, 0755, true);\n\t\t}\n\n\t\t$dest_filename = $emp_db_id . \'.jpg\';\n\t\t$dest_path = $upload_dir . $dest_filename;\n\t\t$avatar_rel = \'uploads/avatars/\' . $dest_filename;\n\n\t\t// Resize and crop to square using GD\n\t\t$src_img = null;\n\t\tif ($mime === \'image/jpeg\' || $mime === \'image/jpg\') {\n\t\t\t$src_img = imagecreatefromjpeg($file[\'tmp_name\']);\n\t\t} elseif ($mime === \'image/png\') {\n\t\t\t$src_img = imagecreatefrompng($file[\'tmp_name\']);\n\t\t} elseif ($mime === \'image/webp\') {\n\t\t\t$src_img = imagecreatefromwebp($file[\'tmp_name\']);\n\t\t}\n\n\t\tif (!$src_img) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Could not process the image.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t$src_w = imagesx($src_img);\n\t\t$src_h = imagesy($src_img);\n\t\t$square_size = min($src_w, $src_h);\n\t\t$src_x = (int)(($src_w - $square_size) / 2);\n\t\t$src_y = (int)(($src_h - $square_size) / 2);\n\n\t\t$target_size = 400;\n\t\t$dst_img = imagecreatetruecolor($target_size, $target_size);\n\n\t\t// Handle PNG transparency\n\t\timagealphablending($dst_img, false);\n\t\timagesavealpha($dst_img, true);\n\t\t$white = imagecolorallocate($dst_img, 255, 255, 255);\n\t\timagefill($dst_img, 0, 0, $white);\n\n\t\timagecopyresampled($dst_img, $src_img, 0, 0, $src_x, $src_y, $target_size, $target_size, $square_size, $square_size);\n\n\t\t// Save as JPEG at 90% quality\n\t\t$save_result = imagejpeg($dst_img, $dest_path, 90);\n\t\timagedestroy($src_img);\n\t\timagedestroy($dst_img);\n\n\t\tif (!$save_result) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Failed to save the avatar image.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t// Update DB\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$this->admin_model->update_employee_avatar($emp_db_id, $avatar_rel);\n\n\t\t// Update session with new avatar\n\t\t$sess = $this->session->userdata(\'logged_in\');\n\t\t$sess[\'avatar\'] = $avatar_rel;\n\t\t$this->session->set_userdata(\'logged_in\', $sess);\n\n\t\t$avatar_url = base_url($avatar_rel) . \'?v=\' . time();\n\t\techo json_encode([\'status\' => \'success\', \'avatar_url\' => $avatar_url]);\n\t}\n\n\tpublic function complete_first_login()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\tif (isset($employee_det) && !empty($employee_det)) {\n\t\t\t// Update database\n\t\t\t$this->db->where(\'id\', $employee_det[\'empdet_id\']);\n\t\t\t$this->db->update(\'employee_det\', array(\'first_login_completed\' => 1));\n\n\t\t\t// Update current session array\n\t\t\t$employee_det[\'first_login_completed\'] = 1;\n\t\t\t$this->session->set_userdata(\'logged_in\', $employee_det);\n\n\t\t\techo json_encode(array(\'status\' => \'success\'));\n\t\t} else {\n\t\t\techo json_encode(array(\'status\' => \'error\', \'message\' => \'Unauthorized session\'));\n\t\t}\n\t}\n\n\tpublic function reset_welcome_note()\n\t{\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\t\tif (isset($usersess_det) && !empty($usersess_det) && $usersess_det[\'role_type\'] == \'1\') {\n\t\t\t$emp_id = $this->input->post(\'emp_id\');\n\t\t\tif ($emp_id) {\n\t\t\t\t// Update database\n\t\t\t\t$this->db->where(\'id\', $emp_id);\n\t\t\t\t$this->db->update(\'employee_det\', array(\'first_login_completed\' => 0));\n\n\t\t\t\t// Update current session if admin resets their own (unlikely, but just in case)\n\t\t\t\tif ($usersess_det[\'empdet_id\'] == $emp_id) {\n\t\t\t\t\t$usersess_det[\'first_login_completed\'] = 0;\n\t\t\t\t\t$this->session->set_userdata(\'logged_in\', $usersess_det);\n\t\t\t\t}\n\n\t\t\t\techo json_encode(array(\'status\' => \'success\', \'message\' => \'First login welcome note reset successfully.\'));\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\t\techo json_encode(array(\'status\' => \'error\', \'message\' => \'Unauthorized or invalid request.\'));\n\t}\n\t///////\n\tpublic function send_daily_dashboard_mail()\n{\n \n    $data[\'employees\']     = $this->admin_model->getemployees_count();\n    $data[\'login\']         = $this->admin_model->get_login_count();\n    $data[\'work\']          = $this->admin_model->get_work_count();\n    $data[\'onduty\']        = $this->admin_model->get_onduty_count();\n    $data[\'notsubmitted\']  = $this->admin_model->get_notsubmitted_count();\n\n    // Load email template\n    $message = $this->load->view(\n        \'admin/daily_dashboard_mail\',\n        $data,\n        TRUE\n    );\n\n\t\n    $this->db->select(\'email_id\');\n    $this->db->from(\'employee_det\');\n    $this->db->where_in(\'role_type\', array(1, 2));\n    $this->db->where(\'status\', 1);\n\n    $result = $this->db->get()->result_array();\n\n    $emails = array();\n\n    foreach ($result as $row) {\n        if (!empty($row[\'email_id\'])) {\n            $emails[] = $row[\'email_id\'];\n        }\n    }\n\n    // Send email\n    $this->email->from(\'inet@inetcsc.com\', \'iWork HRMS\');\n    $this->email->to($emails);\n    $this->email->subject(\'Daily Dashboard Summary - \' . date(\'d-M-Y\'));\n    $this->email->message($message);\n\n    if ($this->email->send()) {\n        echo "Daily dashboard email sent successfully.";\n    } else {\n        echo $this->email->print_debugger();\n    }\n}\npublic function send_daily_not_submitted_report()\n{\n    date_default_timezone_set("Asia/Kolkata");\n\n    // ==========================================\n    // 1. TODAY\'S DATE\n    // ==========================================\n\n    $today = date(\'Y-m-d\');\n\n\n    // ==========================================\n    // 2. GET ALL EMPLOYEES WHO DID NOT SUBMIT\n    // ==========================================\n\n    $not_submitted = $this->admin_model->get_not_submitted_export(\n        $today,\n        $today\n    );\n\n\n    // ==========================================\n    // 3. IF NO ONE IS PENDING\n    // ==========================================\n\n    if (empty($not_submitted)) {\n\n        echo "All employees have submitted today\'s work.";\n\n        return;\n    }\n\n\n    // ==========================================\n    // 4. LOAD EXCEL LIBRARY\n    // ==========================================\n\n    $this->load->library(\'excel\');\n\n    $this->excel->setActiveSheetIndex(0);\n\n    $sheet = $this->excel->getActiveSheet();\n\n    $sheet->setTitle(\'Not Submitted\');\n\n\n    // ==========================================\n    // 5. EXCEL HEADERS\n    // ==========================================\n\n    $sheet->setCellValue(\'A1\', \'S.No\');\n    $sheet->setCellValue(\'B1\', \'Employee ID\');\n    $sheet->setCellValue(\'C1\', \'Employee Name\');\n    $sheet->setCellValue(\'D1\', \'Email\');\n    $sheet->setCellValue(\'E1\', \'Department\');\n    $sheet->setCellValue(\'F1\', \'Designation\');\n    $sheet->setCellValue(\'G1\', \'DOJ\');\n    $sheet->setCellValue(\'H1\', \'Work Location\');\n    $sheet->setCellValue(\'I1\', \'Reporting Manager\');\n\n    $sheet->getStyle(\'A1:I1\')\n          ->getFont()\n          ->setBold(true);\n\n\n    // ==========================================\n    // 6. PUT ALL NON-SUBMITTED EMPLOYEES\n    //    INTO EXCEL\n    // ==========================================\n\n    $row = 2;\n\n    foreach ($not_submitted as $index => $employee) {\n\n        $sheet->setCellValue(\n            \'A\' . $row,\n            $index + 1\n        );\n\n        $sheet->setCellValue(\n            \'B\' . $row,\n            $employee[\'emp_id\']\n        );\n\n        $sheet->setCellValue(\n            \'C\' . $row,\n            $employee[\'emp_name\']\n        );\n\n        $sheet->setCellValue(\n            \'D\' . $row,\n            $employee[\'email_id\']\n        );\n\n        $sheet->setCellValue(\n            \'E\' . $row,\n            $employee[\'department\']\n        );\n\n        $sheet->setCellValue(\n            \'F\' . $row,\n            $employee[\'designation\']\n        );\n\n        $sheet->setCellValue(\n            \'G\' . $row,\n            $employee[\'join_dt\']\n        );\n\n        $sheet->setCellValue(\n            \'H\' . $row,\n            $employee[\'work_loc\']\n        );\n\n        $sheet->setCellValue(\n            \'I\' . $row,\n            $employee[\'reprt_mger_name\']\n        );\n\n        $row++;\n    }\n\n\n    // ==========================================\n    // 7. AUTO-SIZE EXCEL COLUMNS\n    // ==========================================\n\n    foreach (range(\'A\', \'I\') as $column) {\n\n        $sheet->getColumnDimension($column)\n              ->setAutoSize(true);\n    }\n\n\n    // ==========================================\n    // 8. CREATE EXCEL FILE\n    // ==========================================\n\n    $filename =\n        \'Employees_Not_Submitted_\' .\n        $today .\n        \'.xlsx\';\n\n    $file_path =\n        FCPATH .\n        \'uploads/\' .\n        $filename;\n\n\n    $writer = PHPExcel_IOFactory::createWriter(\n        $this->excel,\n        \'Excel2007\'\n    );\n\n    $writer->save($file_path);\n\n\n    // ==========================================\n    // 9. GET MEENAKSHI\'S EMAIL\n    //    USING EMPLOYEE ID INET0199\n    // ==========================================\n\n    $this->db->select(\'emp_id, emp_name, email_id\');\n\n    $this->db->from(\'employee_det\');\n\n    $this->db->where(\n        \'emp_id\',\n        \'INET0199\'\n    );\n\n    $this->db->where(\n        \'status\',\n        1\n    );\n\n    $recipient = $this->db->get()->row_array();\n\n\n    // ==========================================\n    // 10. CHECK RECIPIENT\n    // ==========================================\n\n    if (empty($recipient)) {\n\n        if (file_exists($file_path)) {\n            unlink($file_path);\n        }\n\n        echo "Recipient INET0199 not found.";\n\n        return;\n    }\n\n\n    if (empty($recipient[\'email_id\'])) {\n\n        if (file_exists($file_path)) {\n            unlink($file_path);\n        }\n\n        echo "Email address not found for INET0199.";\n\n        return;\n    }\n\n\n    // ==========================================\n    // 11. SEND EMAIL TO INET0199\n    // ==========================================\n\n    $this->email->clear(TRUE);\n\n    $this->email->from(\n        \'inet@inetcsc.com\',\n        \'iWork HRMS\'\n    );\n\n    // ONLY MEENAKSHI / INET0199\n    $this->email->to(\n        $recipient[\'email_id\']\n    );\n\n    $this->email->subject(\n        \'Daily Non-Submitted Employee Report - \' .\n        date(\'d-M-Y\')\n    );\n\n\n    // ==========================================\n    // 12. EMAIL BODY\n    // ==========================================\n\n    $message = \'\n        <p>Dear \' . $recipient[\'emp_name\'] . \',</p>\n\n        <p>\n            Please find attached the Excel report\n            containing the list of employees who have\n            not submitted their daily work for\n            <strong>\' . date(\'d-M-Y\') . \'</strong>.\n        </p>\n\n        <p>\n            <strong>Total employees not submitted:</strong>\n            \' . count($not_submitted) . \'\n        </p>\n\n        <p>\n            This report was automatically generated\n            by iWork HRMS.\n        </p>\n\n        <p>\n            Regards,<br>\n            iWork HRMS\n        </p>\n    \';\n\n\n    $this->email->set_mailtype(\'html\');\n\n    $this->email->message($message);\n\n\n    // ==========================================\n    // 13. ATTACH EXCEL\n    // ==========================================\n\n    $this->email->attach($file_path);\n\n\n    // ==========================================\n    // 14. SEND EMAIL\n    // ==========================================\n\n    if ($this->email->send()) {\n\n        echo\n            \'Daily non-submitted report sent successfully to \'\n            . $recipient[\'email_id\'];\n\n    } else {\n\n        echo $this->email->print_debugger();\n    }\n\n\n    // ==========================================\n    // 15. DELETE TEMPORARY EXCEL\n    // ==========================================\n\n    if (file_exists($file_path)) {\n\n        unlink($file_path);\n    }\n}\n\n} //MAIN this is my controller and <?php if ( ! defined(\'BASEPATH\')) exit(\'No direct script access allowed\');\n\nclass Admin_model extends CI_Model\n{\n   private $table_name\t= \'employee_det\';\n\t private $table_name1\t= \'bo_detials\';\n\t private $table_name2\t= \'login_log\';\n\n\tfunction __construct()\n\t{\n\t\tparent::__construct();\n\t}\n  function getdepartments(){\n\t \n\t$this->db->select(\'man.id, man.department_name as dept_name\'); \n\t//$this->db->select(\'man.id,man.dept_name\');\n\t$this->db->order_by(\'man.department_name ASC\');\n\t$query = $this->db->get(\'department_det as man\')->result_array();\n\t// print_r($this->db->last_query()); exit;\n\treturn $query;\n\n}\nfunction get_report_manager($department){\n\t \n\t$this->db->select(\'*\'); \n\t//$this->db->select(\'man.id,man.dept_name\');\n\t$this->db->where(\'man.dept_name\',$department);\n\t$this->db->order_by(\'man.dept_name ASC\');\n\t$query = $this->db->get(\'managers as man\')->result_array();\n\t  //print_r($this->db->last_query()); exit;\n\treturn $query;\n\n}\n \n \n function getlocation(){\n\n\n\t\t$this->db->select(\'distinct(loc.work_loc)as work_loc\');\n\t\t$this->db->order_by(\'loc.work_loc ASC\');\n\t\t$query = $this->db->get(\'location_det as loc\')->result_array();\n\t\t//print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t \n }\n function getroletype(){\n\n\n\t\t$this->db->select(\'*\');\n\t\t$this->db->order_by(\'rol.role ASC\');\n\t\t$query = $this->db->get(\'role_type as rol\')->result_array();\n\t\t//print_r($this->db->last_query()); exit; \n\t\t// echo $this->db->last_query();\n\t\treturn $query; \n\t \n }\n\n//  function getsliders(){\n \t\t\n//  \t\t $current_day = date("Y-m-d");\n//  \t\t $today = strtotime(date(\'d-m-Y\'));\n//  \t\t $start_date = date(\'Y-m-d\', strtotime(\'-2 day\', $today));\n \t\t\n// \t\t$this->db->select(\'*\');\n// \t\t$this->db->where("DATE_FORMAT(sl.slide_date, (\'%Y-%m-%d \')) >=",$start_date);\n// \t\t$this->db->where("DATE_FORMAT(sl.slide_date, (\'%Y-%m-%d \')) <=",$current_day);\n// \t \t$this->db->order_by(\'sl.slide_date DESC\');\n// \t\t$query = $this->db->get(\'sliders as sl\')->result_array();\n// \t\t // print_r($this->db->last_query()); exit; \n// \t\t// echo $this->db->last_query();\n// \t\treturn $query; \n\t \n//  }\n\n \n function getsliders(){\n       \n         $current_day = date("Y-m-d");\n       \n        $this->db->select(\'*\');\n        $this->db->where("DATE(sl.slide_date) >=", $current_day);\n        $this->db->where(\'sl.status\', 1);\n        $this->db->order_by(\'sl.slide_date DESC\');\n        $query = $this->db->get(\'sliders as sl\')->result_array();\n        return $query;\n }\n \n \n function get_view_sliders_det(){\n \t\t\n \t\t \n\t\t$this->db->select(\'*\');\n\t\t $this->db->order_by(\'sl.slide_date DESC\');\n\t\t$query = $this->db->get(\'sliders as sl\')->result_array();\n\t\t // print_r($this->db->last_query()); exit; \n\t\t// echo $this->db->last_query();\n\t\treturn $query; \n\t \n }\n\n function get_employees(){\n\n\n\t\t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.dob,emp.work_loc\');/*emp.desg_date\');*/ \n\t\t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t\t$this->db->select(\'department_det.id as depid,department_det.department_name as department\');  \n\t\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\n\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t\t$this->db->where(\'emp.role_type\',3);\n\t\t$this->db->where(\'emp.status\',1);\n\t\t$this->db->order_by(\'emp.emp_id\',\'ASC\');\n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t \t //echo $this->db->last_query(); exit;\n\t\treturn $query; \n\n }\n\n \n function get_managers(){\n\n\t\t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.dob,emp.work_loc\'); \n\t\t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\');\n\t\t$this->db->select(\'department_det.id as depid,department_det.department_name as department\');  \n\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\'); \n\t\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\n\t\t$this->db->where(\'emp.role_type\',2);\n\t\t$this->db->where(\'emp.status\',1);\n\t\t$this->db->order_by(\'emp.emp_name\',\'ASC\');\n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n \t\t//echo $this->db->last_query(); exit;\n \t\treturn $query; \n }\n\n\n//  function get_projects(){\n\n// \t\t$this->db->select(\'pro.pid,pro.project_name,pro.status\');\n// \t\t\t$this->db->where(\'pro.df\',0);\n// \t\t$this->db->order_by(\'pro.project_name ASC\');\n// \t\t//$this->db->order_by(\'pro.CreationDate ASC\');\n// \t\t$this->db->order_by(\'pro.status ASC\');\n\n// \t\t// $this->db->group_by(\'pro.status\');\n// \t\t$query = $this->db->get(\'project_det as pro\')->result_array();\n// \t\t// print_r($this->db->last_query()); exit; \n// \t\t $groupedItems = [];\n// \t\t if (!empty($query)) {\n//             foreach ($query as $row) {\n//                 $groupedItems[$row[\'status\']][] = $row[\'pid\'].\'~\'.$row[\'project_name\'];\n//             }\n//         }\n\n//         // echo "<pre>Itema"; print_r($groupedItems); exit;\n// \t\treturn $groupedItems; \n\t \n//  }\n function get_projects(){\n\n\t\t$this->db->select(\'pro.pid,pro.project_name,pro.status\');\n\t\t\t$this->db->where(\'pro.df\',0);\n\t\t$this->db->order_by(\'pro.project_name ASC\');\n\t\t//$this->db->order_by(\'pro.CreationDate ASC\');\n\t\t$this->db->order_by(\'pro.status ASC\');\n\n\t\t// $this->db->group_by(\'pro.status\');\n\t\t$query = $this->db->get(\'project_det as pro\')->result_array();\n\t\t// print_r($this->db->last_query()); exit; \n\t\t $groupedItems = [];\n\t\t if (!empty($query)) {\n            foreach ($query as $row) {\n                $groupedItems[$row[\'status\']][] = $row[\'pid\'].\'~\'.$row[\'project_name\'];\n            }\n        }\n\n        // echo "<pre>Itema"; print_r($groupedItems); exit;\n\t\treturn $groupedItems; \n\t \n }\n\n public function get_all_projects_flat() {\n     $this->db->select(\'pid, project_name\');\n     $this->db->where(\'df\', 0);\n     $this->db->order_by(\'project_name\', \'ASC\');\n     return $this->db->get(\'project_det\')->result_array();\n }\n\n function get_project_data($pid){\n\n\t\t$this->db->select(\'distinct(pro.approver_id)as approver_id\');\n\t\t$this->db->order_by(\'pro.project_name ASC\');\n\t\t$this->db->where(\'pro.pid\',$pid);\n\t\t$query = $this->db->get(\'project_det as pro\')->result_array();\n\t\t // print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t \n }\n function getemployees(){\n \t\t\n\t\t\t$mas = array(\'INETMASTER\');\n\t\t$this->db->select(\'distinct(emp.emp_name)as emp_name,emp.department,emp.id as e_id,emp.emp_id\');\n\t\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\'); \n\t\t$this->db->where_not_in(\'emp.emp_id\',$mas);\n\t\t$this->db->where(\'emp.status\', 1); // Only active employees\n\t\t$this->db->order_by(\'emp.emp_name ASC\');\n\t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t //print_r($this->db->last_query()); exit; \n\t\treturn $query; \t \n\n\t \n }\n\n function get_organization_data(){\n\n\t\t$this->db->select(\'*\');\n\t\t$this->db->where(\'emp.status\',1);\n \t\t$this->db->group_by(\'emp.report_mgr_id\');\n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t//print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t \n }\n function get_to_do_list_check($e_id){\n\n\t\t$this->db->select(\'count(*) as cnt\');\n\t\t$this->db->where(\'task.e_id\',$e_id);\n  \t\t$query = $this->db->get(\'task_details as task\')->result_array();\n\t\t// print_r($this->db->last_query()); exit; \n\t\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query[0][\'cnt\'];\n\t    }\n\t \n }\n \n function get_task_list($dep){\n\n\t\t$this->db->select(\'*\');\n\t\t$this->db->where(\'tas.department\',$dep);\n\t\t$this->db->where(\'tas.status\',1);\n  \t\t$query = $this->db->get(\'dep_task as tas\')->result_array();\n\t\t  // print_r($this->db->last_query()); exit; \n\t\t \n\t      return $query;\n\t    \n\t \n }\n \n function get_activity_list($dep){\n\n\t\t$this->db->select(\'*\');\n\t\t$this->db->where(\'act.department\',$dep);\n\t\t$this->db->where(\'act.status\',1);\n\t\t$this->db->order_by(\'act.activity_list\',\'ASC\');\n  \t\t$query = $this->db->get(\'activity_det as act\')->result_array();\n\t\t// print_r($this->db->last_query()); exit; \n\t\t \n\t      return $query;\n\t    \n\t \n }\n function check_to_do_list_today($e_id){\n\n \t\t$today = $current_day = date("Y-m-d");\n\t\t$this->db->select(\'count(*) as cnt\');\n\t\t$this->db->where(\'task.e_id\',$e_id);\n\t\t$this->db->where(\'task.task_flag\',1);\n\t\t$this->db->where(\'date(task.created_date)\',$today);\n  \t\t$query = $this->db->get(\'task_details as task\')->result_array();\n\t\t//print_r($this->db->last_query()); exit; \n\t\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query[0][\'cnt\'];\n\t    }\n\t \n }\n\n function get_previous_list_det($e_id){\n\n \t\t$today = $current_day = date("Y-m-d");\n\t\t$this->db->select(\'*\');\n\t\t$this->db->where(\'task.e_id\',$e_id);\n\t\t$this->db->where(\'task.status\',0);\n \t\t//$this->db->where_not_in(\'date(task.created_date)\',$today);\n \t\t$this->db->order_by(\'date(task.created_date)\',\'DESC\');\n \t\t$query = $this->db->get(\'task_details as task\')->result_array();\n\t\t//print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t \n }\n function check_to_do_list_preday($e_id){\n\n \t\t$today = $current_day = date("Y-m-d");\n\t\t$this->db->select(\'count(*) as precnt\');\n\t\t$this->db->where(\'task.e_id\',$e_id);\n\t\t$this->db->where(\'task.status\',0);\n \t\t$this->db->where_not_in(\'date(task.created_date)\',$today);\n \t\t$this->db->order_by(\'date(task.created_date)\',\'DESC\');\n \t\t$query = $this->db->get(\'task_details as task\')->result_array();\n\t\t//print_r($this->db->last_query()); exit; \n\t\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query[0][\'precnt\'];\n\t    }\n\t \n }\n\n function get_user_reports($e_id, $inps) {\n\n \t// Initialize filters\n \t$has_from    = false;\n \t$has_to      = false;\n \t$has_project = false;\n \t$has_status  = false;\n\n \t$parse_date = function($date_str) {\n \t\tif (empty($date_str)) return null;\n \t\t$date_str = trim($date_str);\n \t\tif (preg_match(\'/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})$/\', $date_str, $matches)) {\n \t\t\treturn $matches[3] . \'-\' . sprintf(\'%02d\', $matches[2]) . \'-\' . sprintf(\'%02d\', $matches[1]);\n \t\t}\n \t\tif (preg_match(\'/^(\\d{4})[\\/\\-](\\d{1,2})[\\/\\-](\\d{1,2})$/\', $date_str, $matches)) {\n \t\t\treturn $matches[1] . \'-\' . sprintf(\'%02d\', $matches[2]) . \'-\' . sprintf(\'%02d\', $matches[3]);\n \t\t}\n \t\t$t = strtotime($date_str);\n \t\treturn $t ? date(\'Y-m-d\', $t) : null;\n \t};\n\n  \tif (isset($inps) && !empty($inps)) {\n  \t\t// NOTE: PHP empty(\'0\') === true, so status=\'0\' (Pending) must be tested with isset+strlen,\n  \t\t// not empty(), otherwise Pending is wrongly treated as "no filter selected".\n  \t\t$has_from     = !empty($inps[\'from_date\']);\n  \t\t$has_to       = !empty($inps[\'to_date\']);\n  \t\t$proj         = isset($inps[\'project_id\']) ? $inps[\'project_id\'] : (isset($inps[\'project_name\']) ? $inps[\'project_name\'] : \'\');\n  \t\t$has_project  = $proj !== \'0\' && $proj !== \'\' && $proj !== \'all\';\n  \t\t$has_status   = isset($inps[\'status\'])       && $inps[\'status\']       !== \'all\' && $inps[\'status\'] !== \'\';\n\n  \t\t// Date range filter\n  \t\tif ($has_from && $has_to) {\n  \t\t\t$from_date = $parse_date($inps[\'from_date\']);\n  \t\t\t$to_date   = $parse_date($inps[\'to_date\']);\n  \t\t\tif ($from_date && $to_date) {\n  \t\t\t\tlog_message(\'debug\', \'[get_user_reports] Selected From Date: \' . $from_date . \' | Selected To Date: \' . $to_date);\n  \t\t\t\t$this->db->where("DATE(task.created_date) BETWEEN " . $this->db->escape($from_date) . " AND " . $this->db->escape($to_date));\n  \t\t\t}\n  \t\t}\n\n  \t\t// Project name filter\n  \t\tif ($has_project) {\n  \t\t\t$this->db->where(\'task.project_name\', $proj);\n  \t\t}\n\n  \t\t// Status filter — cast to int so \'0\' (Pending) and \'1\' (Completed) both work correctly\n  \t\tif ($has_status) {\n  \t\t\t$this->db->where(\'task.status\', (int)$inps[\'status\']);\n  \t\t}\n  \t}\n\n \t// If ALL filters are blank/default, restrict to Current Month\n \tif (!$has_from && !$has_to && !$has_project && !$has_status) {\n \t\t$first_day = date(\'Y-m-01\');\n \t\t$last_day  = date(\'Y-m-t\');\n \t\tlog_message(\'debug\', \'[get_user_reports] Defaulting to Current Month: \' . $first_day . \' to \' . $last_day);\n \t\t$this->db->where("DATE(task.created_date) BETWEEN " . $this->db->escape($first_day) . " AND " . $this->db->escape($last_day));\n \t}\n\n \t$this->db->select(\'task.*\');\n \t$this->db->select(\'employee_det.id,employee_det.emp_id,employee_det.emp_name,employee_det.mob_no,employee_det.email_id,employee_det.department,employee_det.designation,employee_det.report_mgr_id,employee_det.join_dt,employee_det.work_loc\');\n \t$this->db->select(\'department_det.id,department_det.department_name as department\');\n \t$this->db->select(\'dep_task.id as taskid,dep_task.department,dep_task.task_list\');\n \t$this->db->select(\'activity_det.aid,activity_det.activity_list\');\n \t$this->db->select(\'project_det.pid,project_det.project_name as pname\');\n \t$this->db->select(\'tickets.ticket_id as t_ticket_id, tickets.ticket_id as ticket_number, tickets.title as ticket_title, tickets.title as ticket_subject, tickets.description as ticket_desc, tickets.user_priority as ticket_priority\');\n \t$this->db->join(\'tickets\',      \'tickets.id=task.ticket_id\',          \'left\');\n \t$this->db->join(\'employee_det\', \'employee_det.id=task.e_id\',          \'left\');\n \t$this->db->join(\'dep_task\',     \'dep_task.id = task.dep_task_id\',     \'left\');\n \t$this->db->join(\'activity_det\', \'activity_det.aid=task.activity_id\',  \'left\');\n \t$this->db->join(\'department_det\',\'department_det.id=employee_det.department\',\'left\');\n \t$this->db->join(\'project_det\',  \'project_det.pid=task.project_name\',  \'left\');\n \t$this->db->where(\'task.e_id\', $e_id);\n \t$this->db->order_by(\'date(task.created_date)\', \'DESC\');\n \t$query = $this->db->get(\'task_details as task\')->result_array();\n \t\n \tlog_message(\'debug\', \'[get_user_reports] Generated SQL Query: \' . $this->db->last_query());\n \tlog_message(\'debug\', \'[get_user_reports] Returned Row Count: \' . count($query));\n \t\n \treturn $query;\n }\n\n /**\n  * Returns completed task count per project for the given month/year.\n  * Used by the Project Performance Ranking AJAX chart.\n  */\n public function get_project_performance_by_month($e_id, $month = null, $year = null, $filters = [])\n  {\n      $this->db->select(\'project_det.project_name as pname, COUNT(task.id) as cnt\');\n      $this->db->from(\'task_details as task\');\n      $this->db->join(\'project_det\', \'project_det.pid = task.project_name\', \'left\');\n      $this->db->where(\'task.e_id\', $e_id);\n\n      $has_range = false;\n      if (!empty($filters)) {\n          $has_from = !empty($filters[\'from_date\']);\n          $has_to   = !empty($filters[\'to_date\']);\n          if ($has_from && $has_to) {\n              $has_range = true;\n              $from_date = date(\'Y-m-d\', strtotime($filters[\'from_date\']));\n              $to_date   = date(\'Y-m-d\', strtotime($filters[\'to_date\']));\n              $this->db->where("DATE(task.task_comp_dt) BETWEEN " . $this->db->escape($from_date) . " AND " . $this->db->escape($to_date));\n          }\n      }\n\n      if (!$has_range) {\n          $month = (int)$month ?: (int)date(\'m\');\n          $year  = (int)$year ?: (int)date(\'Y\');\n          $this->db->where("MONTH(task.task_comp_dt)", $month);\n          $this->db->where("YEAR(task.task_comp_dt)", $year);\n      }\n\n      $proj = isset($filters[\'project_id\']) ? $filters[\'project_id\'] : (isset($filters[\'project_name\']) ? $filters[\'project_name\'] : \'\');\n      if ($proj !== \'0\' && $proj !== \'\' && $proj !== \'all\') {\n          $this->db->where(\'task.project_name\', $proj);\n      }\n\n      $status = isset($filters[\'status\']) ? $filters[\'status\'] : \'all\';\n      if ($status !== \'all\' && $status !== \'\') {\n          $this->db->where(\'task.status\', (int)$status);\n      } else {\n          $this->db->where(\'task.status\', 1);\n      }\n\n      $this->db->group_by(\'task.project_name\');\n      $this->db->order_by(\'cnt\', \'DESC\');\n      $this->db->limit(11);\n      $results = $this->db->get()->result_array();\n\n      $out = [];\n      foreach ($results as $row) {\n          $out[] = [\'name\' => ($row[\'pname\'] ?: \'No Project\'), \'count\' => (int)$row[\'cnt\']];\n      }\n      return $out;\n  }\n\n /**\n  * Returns hourly aggregated task hours for a given date.\n  * Used by the Daily Hours Productivity AJAX chart.\n  *\n  * FIX: EstimatedHours and task_comp_time are free-text VARCHARs containing\n  * values like "3h", "30m", "2.5h", "45m", "1 1/2", etc.\n  * We fetch the raw strings and parse them in PHP to decimal hours.\n  */\n public function get_hourly_productivity($e_id, $date = null, $filters = [])\n  {\n      // ── Helpers ──────────────────────────────────────────────────────────────\n      // Parse a free-text time string into decimal hours.\n      // Supports: "3h", "3 h", "3hrs", "3.5h", "30m", "45m", "30min", "2.5", "1 1/2", ""\n      $parseHours = function($raw) {\n          if ($raw === null || trim($raw) === \'\') return 0.0;\n          $raw = strtolower(trim($raw));\n\n          // Contains minutes indicator only (e.g. "30m", "45 min")\n          if (preg_match(\'/^([\\d.]+)\\s*m(in)?$/\', $raw, $m)) {\n              return round((float)$m[1] / 60, 4);\n          }\n          // Mixed h/m: "1h 30m" or "1h30m"\n          if (preg_match(\'/([\\d.]+)\\s*h[a-z]*\\s*([\\d.]+)\\s*m/i\', $raw, $m)) {\n              return round((float)$m[1] + (float)$m[2] / 60, 4);\n          }\n          // Fractional notation: "1 1/2"\n          if (preg_match(\'/^(\\d+)\\s+(\\d+)\\/(\\d+)$/\', $raw, $m)) {\n              return round((float)$m[1] + (float)$m[2] / (float)$m[3], 4);\n          }\n          // Fraction alone: "1/2"\n          if (preg_match(\'/^(\\d+)\\/(\\d+)$/\', $raw, $m)) {\n              return round((float)$m[1] / (float)$m[2], 4);\n          }\n          // Leading numeric (covers "3h", "3.5h", "3 hours", "3", "3hrs")\n          if (preg_match(\'/^([\\d.]+)/\', $raw, $m)) {\n              return round((float)$m[1], 4);\n          }\n          return 0.0;\n      };\n\n      // ── Fetch all tasks created on this date for worked hours ──────────────\n      $workedMap = [];  // hour(int) → worked_hours(float)\n      $this->db->select(\'HOUR(task.created_date) as hr, task.EstimatedHours as est\');\n      $this->db->from(\'task_details as task\');\n      $this->db->where(\'task.e_id\', $e_id);\n\n      $has_range = false;\n      if (!empty($filters)) {\n          $has_from = !empty($filters[\'from_date\']);\n          $has_to   = !empty($filters[\'to_date\']);\n          if ($has_from && $has_to) {\n              $has_range = true;\n              $from_date = date(\'Y-m-d\', strtotime($filters[\'from_date\']));\n              $to_date   = date(\'Y-m-d\', strtotime($filters[\'to_date\']));\n              $this->db->where("DATE(task.created_date) BETWEEN " . $this->db->escape($from_date) . " AND " . $this->db->escape($to_date));\n          }\n      }\n\n      if (!$has_range) {\n          $date_val = $date ? date(\'Y-m-d\', strtotime($date)) : date(\'Y-m-d\');\n          $this->db->where(\'DATE(task.created_date)\', $date_val);\n      }\n\n      $proj = isset($filters[\'project_id\']) ? $filters[\'project_id\'] : (isset($filters[\'project_name\']) ? $filters[\'project_name\'] : \'\');\n      if ($proj !== \'0\' && $proj !== \'\' && $proj !== \'all\') {\n          $this->db->where(\'task.project_name\', $proj);\n      }\n\n      $status = isset($filters[\'status\']) ? $filters[\'status\'] : \'all\';\n      if ($status !== \'all\' && $status !== \'\') {\n          $this->db->where(\'task.status\', (int)$status);\n      }\n\n      $workedRows = $this->db->get()->result_array();\n      foreach ($workedRows as $w) {\n          $h = (int)$w[\'hr\'];\n          if (!isset($workedMap[$h])) $workedMap[$h] = 0.0;\n          $workedMap[$h] += $parseHours($w[\'est\']);\n      }\n\n      // ── Fetch completed tasks on this date for estimated + completed hours ──\n      $completedMap = [];  // hour(int) → [\'est\'=>float, \'comp\'=>float]\n      $this->db->select(\'HOUR(task.task_comp_dt) as hr, task.EstimatedHours as est, task.task_comp_time as comp\');\n      $this->db->from(\'task_details as task\');\n      $this->db->where(\'task.e_id\', $e_id);\n\n      $comp_status = 1;\n      if ($status !== \'all\' && $status !== \'\') {\n          $comp_status = (int)$status;\n      }\n      $this->db->where(\'task.status\', $comp_status);\n\n      if ($has_range) {\n          $from_date = date(\'Y-m-d\', strtotime($filters[\'from_date\']));\n          $to_date   = date(\'Y-m-d\', strtotime($filters[\'to_date\']));\n          $this->db->where("DATE(task.task_comp_dt) BETWEEN " . $this->db->escape($from_date) . " AND " . $this->db->escape($to_date));\n      } else {\n          $date_val = $date ? date(\'Y-m-d\', strtotime($date)) : date(\'Y-m-d\');\n          $this->db->where(\'DATE(task.task_comp_dt)\', $date_val);\n      }\n\n      if ($proj !== \'0\' && $proj !== \'\' && $proj !== \'all\') {\n          $this->db->where(\'task.project_name\', $proj);\n      }\n\n      $compRows = $this->db->get()->result_array();\n      foreach ($compRows as $c) {\n          $h = (int)$c[\'hr\'];\n          if (!isset($completedMap[$h])) $completedMap[$h] = [\'est\' => 0.0, \'comp\' => 0.0];\n          $completedMap[$h][\'est\']  += $parseHours($c[\'est\']);\n          $completedMap[$h][\'comp\'] += $parseHours($c[\'comp\']);\n      }\n\n      // ── Determine fixed hour range (10 AM to 10 PM) ────────────────────────\n      $allHours = array_unique(array_merge(array_keys($workedMap), array_keys($completedMap)));\n      if (empty($allHours)) {\n          // No data for this date — return empty signal\n          return [\'hours\' => [], \'completed\' => [], \'estimated\' => [], \'worked\' => [], \'hasData\' => false];\n      }\n\n      $hours = $compArr = $estArr = $workedArr = [];\n      for ($h = 10; $h <= 22; $h++) {\n          // Format 10:00 AM style\n          $amPm = $h >= 12 ? \'PM\' : \'AM\';\n          $displayH = $h > 12 ? $h - 12 : $h;\n          $displayH = $displayH == 0 ? 12 : $displayH;\n          $hours[]     = str_pad($displayH, 2, \'0\', STR_PAD_LEFT) . \':00 \' . $amPm;\n          \n          $compArr[]   = round($completedMap[$h][\'comp\'] ?? 0, 2);\n          $estArr[]    = round($completedMap[$h][\'est\']  ?? 0, 2);\n          $workedArr[] = round($workedMap[$h] ?? 0, 2);\n      }\n\n      return [\n          \'hours\'     => $hours,\n          \'completed\' => $compArr,\n          \'estimated\' => $estArr,\n          \'worked\'    => $workedArr,\n          \'hasData\'   => true,\n          \'_debug\'    => [\'e_id\' => $e_id, \'workedMap\' => $workedMap, \'completedMap\' => $completedMap]\n      ];\n  }\n\n /**\n  * Returns High/Medium/Low vs Completed/Pending/CalledOff for a given date.\n  * Used by the Priority vs Status Matrix chart.\n  */\n public function get_priority_matrix($e_id, $date = null, $filters = [])\n  {\n      // Initialize the counts\n      $matrix = [\n          \'High\'   => [\'Completed\' => 0, \'Pending\' => 0, \'CalledOff\' => 0],\n          \'Medium\' => [\'Completed\' => 0, \'Pending\' => 0, \'CalledOff\' => 0],\n          \'Low\'    => [\'Completed\' => 0, \'Pending\' => 0, \'CalledOff\' => 0]\n      ];\n\n      $this->db->select(\'priority_type, status, ticket_id, t_ticket_id\');\n      $this->db->from(\'task_details\');\n      $this->db->where(\'e_id\', $e_id);\n\n      $has_range = false;\n      if (!empty($filters)) {\n          $has_from = !empty($filters[\'from_date\']);\n          $has_to   = !empty($filters[\'to_date\']);\n          if ($has_from && $has_to) {\n              $has_range = true;\n              $from_date = date(\'Y-m-d\', strtotime($filters[\'from_date\']));\n              $to_date   = date(\'Y-m-d\', strtotime($filters[\'to_date\']));\n              $this->db->where("DATE(created_date) BETWEEN " . $this->db->escape($from_date) . " AND " . $this->db->escape($to_date));\n          }\n      }\n\n      if (!$has_range) {\n          $date_val = $date ? date(\'Y-m-d\', strtotime($date)) : date(\'Y-m-d\');\n          $this->db->where(\'DATE(created_date)\', $date_val);\n      }\n\n      $proj = isset($filters[\'project_id\']) ? $filters[\'project_id\'] : (isset($filters[\'project_name\']) ? $filters[\'project_name\'] : \'\');\n      if ($proj !== \'0\' && $proj !== \'\' && $proj !== \'all\') {\n          $this->db->where(\'project_name\', $proj);\n      }\n\n      $status = isset($filters[\'status\']) ? $filters[\'status\'] : \'all\';\n      if ($status !== \'all\' && $status !== \'\') {\n          $this->db->where(\'status\', (int)$status);\n      }\n\n      $rows = $this->db->get()->result_array();\n      foreach ($rows as $r) {\n          // Determine priority (1=High, 2=Medium, 3/other=Low)\n          $priority = \'Low\';\n          if ($r[\'priority_type\'] == \'1\') $priority = \'High\';\n          else if ($r[\'priority_type\'] == \'2\') $priority = \'Medium\';\n          \n          // Determine status (1=Completed, 2=CalledOff, 0/other=Pending)\n          $status = \'Pending\';\n          if ($r[\'status\'] == \'1\') $status = \'Completed\';\n          else if ($r[\'status\'] == \'2\') $status = \'CalledOff\';\n          \n          $matrix[$priority][$status]++;\n      }\n      \n      // Format for ApexCharts Heatmap\n      return [\n          [\'name\' => \'High\',   \'data\' => [[\'x\' => \'Completed\', \'y\' => $matrix[\'High\'][\'Completed\']],   [\'x\' => \'Pending\', \'y\' => $matrix[\'High\'][\'Pending\']],   [\'x\' => \'Called-Off\', \'y\' => $matrix[\'High\'][\'CalledOff\']]]],\n          [\'name\' => \'Medium\', \'data\' => [[\'x\' => \'Completed\', \'y\' => $matrix[\'Medium\'][\'Completed\']], [\'x\' => \'Pending\', \'y\' => $matrix[\'Medium\'][\'Pending\']], [\'x\' => \'Called-Off\', \'y\' => $matrix[\'Medium\'][\'CalledOff\']]]],\n          [\'name\' => \'Low\',    \'data\' => [[\'x\' => \'Completed\', \'y\' => $matrix[\'Low\'][\'Completed\']],    [\'x\' => \'Pending\', \'y\' => $matrix[\'Low\'][\'Pending\']],    [\'x\' => \'Called-Off\', \'y\' => $matrix[\'Low\'][\'CalledOff\']]]]\n      ];\n  }\n\n function get_all_reports($inps){\n\n \t // echo "<pre>inps"; print_r($inps); //exit;\n\tif(isset($inps) && !empty($inps)){\n\t\t\t\n\t\t\t if(empty($inps[\'emp_id\']) && empty($inps[\'dept\']) && empty($inps[\'from_date\']) && empty($inps[\'to_date\']) \n\t\t\t\t\t\t\t && empty($inps[\'project_name\']) && empty($inps[\'status\'])) {\n\t\t\t \t$cur_dt = date("Y-m-d");\n\t\t\t\t//$this->db->where(\'pcons.d_id\',$did);\n\t\t\t\t$this->db->where("DATE(task.created_date)", $cur_dt);\n\t\t\t }\n\t\t\t // Filter by date range\n\t\t\tif(!empty($inps[\'from_date\']) && !empty($inps[\'to_date\'])) {\n\t\t\t\t$from_date = date(\'Y-m-d\', strtotime($inps[\'from_date\']));\n\t\t\t\t$to_date = date(\'Y-m-d\', strtotime($inps[\'to_date\']));\n\t\t\t\t$this->db->where("DATE(task.created_date) >=", $from_date);\n\t\t\t\t$this->db->where("DATE(task.created_date) <=", $to_date);\n\t\t\t} \n\t\t\t // Filter by project name\n\t\t\tif($inps[\'project_name\'] != "0") {\n\t\t\t\t$this->db->where(\'task.project_name\', $inps[\'project_name\']);\n\t\t\t} \n\n\t\t\t if($inps[\'emp_id\'] != "0")\n\t\t\t {\n\t\t\t\t$this->db->where(\'task.e_id\',$inps[\'emp_id\']);\n\t\t\t } \n\n\t\t\t if($inps[\'dept\'] != "0")\n\t\t\t {\n\t\t\t\t$this->db->where(\'employee_det.department\',$inps[\'dept\']);\n\t\t\t } \n\n\t\t\t // Filter by status\n\t\t\tif($inps[\'status\'] != "all")\n\t\t\t{\n\t\t\t\t$this->db->where(\'task.status\',$inps[\'status\']);\n\n\t\t\t} else {\n\n\n\t\t\t}\n\n\t\t} else {\n\n\t\t\t$cur_dt = date("Y-m-d");\n\t\t\t//$this->db->where(\'pcons.d_id\',$did);\n\t\t\t$this->db->where("DATE(task.created_date)", $cur_dt);\n\t\t}\n\n \t\t$this->db->select(\'task.*\'); \n \t\t$this->db->select(\'employee_det.id,employee_det.emp_id,employee_det.emp_name,employee_det.mob_no,employee_det.email_id,employee_det.department,employee_det.designation,employee_det.report_mgr_id,employee_det.join_dt,employee_det.work_loc\');\n \t\t$this->db->select(\'dep_task.id,dep_task.department,,dep_task.task_list\'); \n \t\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t\t$this->db->select(\'activity_det.aid,activity_det.activity_list\'); \n\t\t$this->db->select(\'project_det.pid,project_det.project_name as pname\');  \n\t\t$this->db->select(\'tickets.ticket_id as t_ticket_id, tickets.title as ticket_title, tickets.description as ticket_desc\');\n \t\t//$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\');  \n \t\t$this->db->join(\'employee_det\',\'employee_det.id=task.e_id\',\'left\');\n \t\t\t$this->db->join(\'department_det\',\'department_det.id=employee_det.department\',\'left\');\n \t\t//$this->db->join(\'managers\',\'managers.mid=task.depend_name\',\'left\'); \n \t\t$this->db->join(\'dep_task\',\'dep_task.id = task.dep_task_id\',\'left\');\n \t\t\t$this->db->join(\'project_det\',\'project_det.pid=task.project_name\',\'left\');\n \t\t$this->db->join(\'activity_det\',\'activity_det.aid=task.activity_id\',\'left\');\n\t\t$this->db->join(\'tickets\',\'tickets.id=task.ticket_id\',\'left\');\n\t\t$this->db->where(\'employee_det.status\', 1); // Only active employees\n        $this->db->order_by(\'date(task.created_date)\',\'DESC\');\n \t\t$query = $this->db->get(\'task_details as task\')->result_array();\n\t\t//print_r($this->db->last_query()); exit; \n\t\treturn $query; \n }\n function getemployees_hierarchy($hid){\n\n \t\t$this->db->select(\'*\');\n\t\t$this->db->where(\'emp.status\',1);\n\t\t$this->db->where(\'emp.report_mgr_id\',$hid);\n \t\t//$this->db->group_by(\'emp.report_mgr_id\');\n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t//  print_r($this->db->last_query()); exit; \n\t\treturn $query; \n }\n\n function get_inactive_emp_reports(){\n\n \t\t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.dob,emp.work_loc\');/*emp.desg_date\');*/ \n\t\t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\n\t\t$this->db->where(\'emp.role_type\',3);\n\t\t$this->db->where(\'emp.status\',0); \n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t \t //echo $this->db->last_query(); exit;\n\t\treturn $query; \n }\n function get_inactive_mgr_reports(){\n\n \t\t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.dob,emp.work_loc\'); \n\t\t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\n\t\t$this->db->where(\'emp.role_type\',2);\n\t\t$this->db->where(\'emp.status\',0);\n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n \t\treturn $query; \n }\n\n/***********Dashboard Counts************/\nfunction getemployees_count(){\n\n\t$this->db->select("count(*) as total_emp");\n\t $this->db->where_not_in(\'employee_det.emp_id\',\'INETMASTER\');\n\t $this->db->where(\'employee_det.status\',1); \n\t$query = $this->db->get(\'employee_det\')->result_array();\n\t //echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\nfunction get_employees_export(){\n\n \t   $this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.dob,emp.work_loc\');/*emp.desg_date\');*/ \n\t\t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\n\t\t// $this->db->where(\'emp.role_type\',3);\n\t\t $this->db->where_not_in(\'emp.emp_id\',\'INETMASTER\');\n\t\t$this->db->where(\'emp.status\',1);\n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n \t // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\nfunction getdepartments_count(){\n\n\t$this->db->select("count(distinct(department_name)) as total_dep"); \n\t$query = $this->db->get(\'department_det\')->result_array();\n\t // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\nfunction get_depart_export(){\n\n\t$this->db->select("*"); \n\t\t$this->db->order_by(\'department_name\',\'ASC\');\n\t$query = $this->db->get(\'department_det\')->result_array();\n\t // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\nfunction getprojects_count(){\n\n\t$this->db->select("count(distinct(project_id)) as total_proj"); \n\t$query = $this->db->get(\'project_det\')->result_array();\n\t // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\n\nfunction get_projects_export(){\n\n\t$this->db->select("*"); \n\t\t$this->db->where(\'df\',0);\n\t\t$this->db->order_by(\'project_name\',\'ASC\');\n \t$query = $this->db->get(\'project_det\')->result_array();\n\t   // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\n\n\n\nfunction getlocation_count(){\n\n\t$this->db->select("count(distinct(work_loc)) as total_loc"); \n\t$query = $this->db->get(\'location_det\')->result_array();\n\t // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\nfunction get_branch_export(){\n\n\t$this->db->select("distinct(work_loc)"); \n\t$this->db->order_by(\'work_loc\',\'ASC\');\n\t$query = $this->db->get(\'location_det\')->result_array();\n\t // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\n\n// function get_not_submitted_export(){\n \n// \t$eid = array(\'INETMASTER\',\'INET0001\',\'INET0002\',\'INET0227\',\'INET0167\',\'INET0046\'); \n//    \t$today = $current_day = date("Y-m-d");\n// \t$this->db->select(\'DISTINCT(`task_details`.`e_id`) as logid\');\n// \t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.work_loc,emp.role_type\');/*emp.desg_date\');*/ \n// \t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n// \t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n//         $this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n// \t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\t\n// \t$this->db->join(\'task_details\',\'task_details.e_id=emp.id\',\'left\');\t\n// \t$this->db->where(\'emp.id NOT IN(SELECT task_details.e_id FROM task_details where date(task_details.created_date)="\'.$today.\'")\');     \n// \t$this->db->where_not_in(\'emp.emp_id\',$eid); \n// \t// $this->db->where_not_in(\'emp.role\',1);     \n// \t$this->db->where_in(\'emp.status\',1);     \n//  \t$query = $this->db->get(\'employee_det as emp\')->result_array();\n//  \t //echo $this->db->last_query(); exit;\n//  \treturn $query;\n// }\nfunction get_not_submitted_export($from_date = null, $to_date = null)\n{\n    $eid = array(\'INETMASTER\',\'INET0001\',\'INET0002\',\'INET0227\',\'INET0167\',\'INET0046\'); \n\n    // If no date selected → use today\n    if(empty($from_date) || empty($to_date))\n    {\n        $from_date = date("Y-m-d");\n        $to_date   = date("Y-m-d");\n    }\n\n    $this->db->select(\'DISTINCT(emp.id) as logid\');\n    $this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.work_loc,emp.role_type\'); \n    $this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n    $this->db->select(\'department_det.id,department_det.department_name as department\'); \n\n    $this->db->from(\'employee_det as emp\');\n    $this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n    $this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\n\n    // NOT SUBMITTED BETWEEN DATE RANGE\n    $this->db->where("emp.id NOT IN (\n        SELECT e_id FROM task_details \n        WHERE DATE(created_date) BETWEEN \'$from_date\' AND \'$to_date\'\n    )", null, false);\n\n    $this->db->where_not_in(\'emp.emp_id\',$eid); \n    $this->db->where(\'emp.status\',1);     \n\n    return $this->db->get()->result_array();\n}\n\nfunction get_notsubmitted_count(){\n \n\t$eid = array(\'INETMASTER\',\'INET0001\',\'INET0002\',\'INET0227\',\'INET0167\',\'INET0046\');\n    $today = $current_day = date("Y-m-d");\n \t$this->db->select(\'emp.*\');/*emp.desg_date\');*/  \n \t// $this->db->where(\'emp.id NOT IN(SELECT task_details.e_id FROM task_details where date(task_details.created_date)="\'.$today.\'")\'); \n \t // $this->db->from(\'employee_det as emp\');\n\n    // Exclude employees who submitted tasks today\n    $this->db->where("emp.id NOT IN (\n        SELECT e_id FROM task_details \n        WHERE DATE(created_date) = \'$today\'\n    )", null, false);\n\n    // Exclude employees who submitted leave/project/on-duty request today\n    $this->db->where("emp.id NOT IN (\n        SELECT emp_id FROM LeaveProjectRequest_Form \n        WHERE \'$today\' BETWEEN DATE(from_date) AND DATE(to_date)\n    )", null, false);\n\n\t$this->db->where_not_in(\'emp.emp_id\', $eid);\n\t$this->db->where_in(\'emp.status\', 1);\n \t$query = $this->db->get(\'employee_det as emp\')->num_rows();\n \t// echo $this->db->last_query(); exit;\n \treturn $query;\n}\n\n\nfunction get_leave_count()\n\t{\n\t\t$today = date("Y-m-d");\n\t\t// Only count leaves for ACTIVE employees\n\t\t$this->db->select(\'COUNT(l.slpno) as cnt\');\n\t\t$this->db->from(\'LeaveProjectRequest_Form l\');\n\t\t$this->db->join(\'employee_det e\', \'e.id = l.emp_id\');\n\t\t$this->db->where(\'l.entry_type\', 3);\n\t\t$this->db->where(\'e.status\', 1);\n\t\t$this->db->where("DATE(\'$today\') BETWEEN DATE(l.from_date) AND DATE(l.to_date)", null, false);\n\t\t$row = $this->db->get()->row_array();\n\t\treturn isset($row[\'cnt\']) ? (int)$row[\'cnt\'] : 0;\n\t}\n\nfunction get_project_count()\n\t{\n\t\t$today = date("Y-m-d");\n\t\t// Only count project requests for ACTIVE employees\n\t\t$this->db->select(\'COUNT(l.slpno) as cnt\');\n\t\t$this->db->from(\'LeaveProjectRequest_Form l\');\n\t\t$this->db->join(\'employee_det e\', \'e.id = l.emp_id\');\n\t\t$this->db->where(\'l.entry_type\', 1);\n\t\t$this->db->where(\'e.status\', 1);\n\t\t$this->db->where("DATE(\'$today\') BETWEEN DATE(l.from_date) AND DATE(l.to_date)", null, false);\n\t\t$row = $this->db->get()->row_array();\n\t\treturn isset($row[\'cnt\']) ? (int)$row[\'cnt\'] : 0;\n\t}\n\n\t\n\n\tfunction get_onduty_count() \n{\n\t$today = date("Y-m-d");\n\t// Only count on-duty for ACTIVE employees\n\t$this->db->select(\'COUNT(l.slpno) as cnt\');\n\t$this->db->from(\'LeaveProjectRequest_Form l\');\n\t$this->db->join(\'employee_det e\', \'e.id = l.emp_id\');\n\t$this->db->where(\'l.entry_type\', 2);\n\t$this->db->where(\'e.status\', 1);\n\t$this->db->where("DATE(\'$today\') BETWEEN DATE(l.from_date) AND DATE(l.to_date)", null, false);\n\t$row = $this->db->get()->row_array();\n\treturn isset($row[\'cnt\']) ? (int)$row[\'cnt\'] : 0;\n}\n\n\n\tpublic function get_notifications_id($emp_id) \n\t{\n\t\t\t// echo "<pre>emp_id"; print_r($emp_id); ;\n\t\t$this->db->select(\'*\'); \n\t\t$this->db->from(\'notification_det\');\n\t\t$this->db->where(\'receiver_id\',$emp_id);\n\t\t$this->db->where(\'is_acknownledge\',0);\n\n\t\t$result = $this->db->get()->result_array();\n\t\t// print_r($this->db->last_query()); exit;\n\t\treturn $result;\n\t}\n \n\n\t\t// 13-06-25 \n\tpublic function get_leaveproject_tasks_notifier($slpno) \n\t   {\n\t\t// echo "<pre>-------task_id"; print_r($slpno); ;\n\t\t   $this->db->select(\'*\'); \n\t\t   $this->db->from(\'LeaveProjectRequest_Form\');\n\t\t   $this->db->where(\'slpno\',$slpno);\n\t\t   $result = $this->db->get()->result_array();\n\t\t   return $result;\n\t   }\n\n\n\n\tpublic function get_employee_name_by_id($id) \n\t\t{\n\t\t\t$this->db->select(\'emp_name\'); \n\t\t\t$this->db->from(\'employee_det\');\n\t\t\t$this->db->where(\'id\', $id); // Changed from emp_name to emp_id (or your actual ID column name)\n\t\t\t$result = $this->db->get()->row_array(); // Changed to row_array() since we expect single result\n\t\t\treturn $result ? $result[\'emp_name\'] : null;\n\t\t}\n\n\n\n\n function update_notification_as_read($id)\n    \t{\n\t\t\t$this->db->where(\'nid\', $id); // use your actual PK name (e.g., `sno`)\n\t\t\treturn $this->db->update(\'notification_det\', [\'is_acknownledge\' => 1]);\n\t\t}\n\n function get_project_name_by_id($id)\n\t\t{\n\t   \t   $this->db->select(\'*\'); \n\t\t   $this->db->from(\'project_det\');\n\t\t   $this->db->where(\'pid\',$id);\n\t\t   $result = $this->db->get()->result_array();\n\t\t   return $result;\n    \t}\n\nfunction get_tot_log_export(){\n \n\t$usrs = array(\'INETMASTER\'); \n    $today = $current_day = date("Y-m-d");\n\t$this->db->select(\'DISTINCT(`login_log`.`e_id`) as logid\');/*emp.desg_date\');*/ \n\t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.work_loc\');/*emp.desg_date\');*/ \n\t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n    $this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\t\n\t$this->db->join(\'login_log\',\'login_log.e_id=emp.id\',\'left\');\t\n\t$this->db->where(\'emp.id IN(SELECT e_id FROM login_log)\');     \n\t$this->db->where(\'date(login_log.created_date)\',$today);       \n\t$this->db->where_not_in(\'emp.emp_id\',$usrs);       \n\t$this->db->where(\'emp.status\', 1); // Only active employees\n \t$query = $this->db->get(\'employee_det as emp\')->result_array();\n \t// echo $this->db->last_query(); exit;\n \treturn $query;\n}\n\n\n function get_leave_export()\n\t\t{\n\t\t\t$usrs = array(\'INETMASTER\', \'INET0001\', \'INET0002\'); \n\t\t\t$today = date("Y-m-d");\n\n\t\t\t$this->db->select(\'emp.id, emp.emp_id, emp.emp_name, emp.mob_no, emp.email_id, emp.department, emp.designation, emp.report_mgr_id, emp.join_dt, emp.work_loc\');\n\t\t\t$this->db->select(\'managers.mid, managers.emp_name as reprt_mger_name\');\n\t\t\t$this->db->select(\'department_det.id, department_det.department_name as department\');\n\t\t\t$this->db->join(\'department_det\', \'department_det.id = emp.department\', \'left\');\n\t\t\t$this->db->join(\'managers\', \'managers.mid = emp.report_mgr_id\', \'left\');\n\t\t\t$this->db->where(\'emp.id IN ( SELECT emp_id FROM LeaveProjectRequest_Form WHERE entry_type = 3 AND CURDATE() BETWEEN DATE(from_date) AND DATE(to_date))\');\n\t\t\t$this->db->where_not_in(\'emp.emp_id\', $usrs);\n\t\t\t$this->db->where(\'emp.status\', 1); // Only active employees\n\t\t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t\t  // echo $this->db->query(); exit; \n\t\t\treturn $query;\n\t\t}\n\n function get_on_duty_export($sub_type){\n \n \t// $usrs = array(\'INETMASTER\',\'INET0001\',\'INET0002\'); \n   //  $today = $current_day = date("Y-m-d");\n\t// $this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.work_loc\');/*emp.desg_date\');*/ \n\t// $this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t// $this->db->select(\'department_det.id,department_det.department_name as department\'); \n   //  $this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t// $this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\t\n\t// // $this->db->where(\'emp.id IN(SELECT task_details.`e_id` FROM task_details)\');     \n\t// $this->db->where(\'emp.id IN(SELECT task_details.e_id FROM task_details where task_details.work_type=\'.$sub_type.\' and date(task_details.created_date)="\'.$today.\'")\');     \n\t// $this->db->where_not_in(\'emp.emp_id\',$usrs);     \n \t// $query = $this->db->get(\'employee_det as emp\')->result_array();\n \t//  // echo $this->db->last_query(); exit;\n \t// return $query;\n\n \t$usrs = array(\'INETMASTER\',\'INET0001\',\'INET0002\'); \n    $today = $current_day = date("Y-m-d");\n\t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.work_loc\');/*emp.desg_date\');*/ \n\t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n    $this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\t\n\t// $this->db->where(\'emp.id IN(SELECT task_details.`e_id` FROM task_details)\');     \n\t$this->db->where("emp.id IN (SELECT LeaveProjectRequest_Form.emp_id FROM LeaveProjectRequest_Form WHERE LeaveProjectRequest_Form.entry_type = 2 AND DATE(\'$today\') BETWEEN DATE(LeaveProjectRequest_Form.from_date) AND DATE(LeaveProjectRequest_Form.to_date))", null, false); \n\t$this->db->where_not_in(\'emp.emp_id\',$usrs);\n\t$this->db->where(\'emp.status\', 1); // Only active employees\n \t$query = $this->db->get(\'employee_det as emp\')->result_array();\n \t//  echo $this->db->last_query(); exit;\n \treturn $query;\n\n}\n\nfunction get_work_count(){\n\t$today = $current_day = date("Y-m-d");\n\t$this->db->select("COUNT(DISTINCT(task_details.e_id)) as total,");\n\t$this->db->select("COUNT(DISTINCT(CASE WHEN task_details.work_type = \'1\' THEN task_details.e_id END)) AS work_type_s1,"); \n\t$this->db->select("COUNT(DISTINCT(CASE WHEN task_details.work_type = \'2\' THEN task_details.e_id END)) AS work_type_s2,"); \n\t$this->db->select("COUNT(DISTINCT(CASE WHEN task_details.work_type = \'3\' THEN task_details.e_id END)) AS work_type_s3,");\n\t// Only count tasks from ACTIVE employees\n\t$this->db->join(\'employee_det\', \'employee_det.id = task_details.e_id\');\n\t$this->db->where(\'employee_det.status\', 1);\n\t$this->db->where(\'date(task_details.created_date)\', $today);\n \t$query = $this->db->get(\'task_details\')->result_array();\n  //echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\nfunction get_empwork_count($eid){\n\t$today = $current_day = date("Y-m-d");\n\t$this->db->select("count(*) as total,");\n\t\n\t$this->db->select("sum(case when status = \'1\' then 1 else 0 end) AS work_comp_s1,"); \n\t$this->db->select("sum(case when status = \'0\' then 1 else 0 end) AS work_comp_s2,"); \n \t$this->db->where(\'e_id\',$eid);   \n \t$query = $this->db->get(\'task_details\')->result_array();\n  // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\n\n function get_employee_daily_performance($eid, $date = \'\')\n {\n\t$target_date = (!empty($date)) ? date(\'Y-m-d\', strtotime($date)) : date(\'Y-m-d\');\n\n\t$this->db->select(\'task.*, dep_task.task_list as task_title, activity_det.activity_list as activity_title, project_det.project_name as project_title, employee_det.emp_name, employee_det.emp_id as employee_code\');\n\t$this->db->join(\'dep_task\', \'dep_task.id = task.dep_task_id\', \'left\');\n\t$this->db->join(\'activity_det\', \'activity_det.aid = task.activity_id\', \'left\');\n\t$this->db->join(\'project_det\', \'project_det.pid = task.project_name\', \'left\');\n\t$this->db->join(\'employee_det\', \'employee_det.id = task.e_id\', \'left\');\n\t$this->db->where(\'task.e_id\', $eid);\n\t$this->db->where("DATE(task.created_date) =", $target_date);\n\t$this->db->order_by(\'task.id\', \'ASC\');\n\t$tasks = $this->db->get(\'task_details as task\')->result_array();\n\n\t$total_tasks = count($tasks);\n\t$completed_count = 0;\n\t$inprogress_count = 0;\n\t$pending_count = 0;\n\t$total_percentage_sum = 0;\n\t$processed_tasks = array();\n\n\tif (!empty($tasks)) {\n\t\tforeach ($tasks as $t) {\n\t\t\t$task_name = !empty($t[\'task_title\']) ? $t[\'task_title\'] : (!empty($t[\'activityDesc\']) ? $t[\'activityDesc\'] : (!empty($t[\'task_id\']) ? $t[\'task_id\'] : \'Task #\' . $t[\'id\']));\n\t\t\t$project_name = !empty($t[\'project_title\']) ? $t[\'project_title\'] : (!empty($t[\'project_name\']) ? $t[\'project_name\'] : \'General\');\n\t\t\t\n\t\t\t$comp_pct = 0;\n\t\t\t$status_label = \'Pending\';\n\t\t\t$status_badge = \'bg-danger\';\n\n\t\t\tif ($t[\'status\'] == 1 || $t[\'status\'] == \'1\') {\n\t\t\t\t$comp_pct = 100;\n\t\t\t\t$status_label = \'Completed\';\n\t\t\t\t$status_badge = \'bg-success\';\n\t\t\t\t$completed_count++;\n\t\t\t} elseif (!empty($t[\'prev_reason\']) || !empty($t[\'task_comp_time\']) || (!empty($t[\'EstimatedHours\']) && $t[\'EstimatedHours\'] > 0 && !empty($t[\'remarks\']))) {\n\t\t\t\t$comp_pct = 50;\n\t\t\t\t$status_label = \'In Progress\';\n\t\t\t\t$status_badge = \'bg-warning text-dark\';\n\t\t\t\t$inprogress_count++;\n\t\t\t} else {\n\t\t\t\t$comp_pct = 0;\n\t\t\t\t$status_label = \'Pending\';\n\t\t\t\t$status_badge = \'bg-danger\';\n\t\t\t\t$pending_count++;\n\t\t\t}\n\n\t\t\t$total_percentage_sum += $comp_pct;\n\n\t\t\t$t[\'calculated_name\'] = $task_name;\n\t\t\t$t[\'calculated_project\'] = $project_name;\n\t\t\t$t[\'calculated_percentage\'] = $comp_pct;\n\t\t\t$t[\'calculated_status\'] = $status_label;\n\t\t\t$t[\'calculated_badge\'] = $status_badge;\n\n\t\t\t$processed_tasks[] = $t;\n\t\t}\n\t}\n\n\t$overall_percentage = ($total_tasks > 0) ? round(($total_percentage_sum / $total_tasks), 1) : 0;\n\n\treturn array(\n\t\t\'date\' => $target_date,\n\t\t\'total\' => $total_tasks,\n\t\t\'completed\' => $completed_count,\n\t\t\'inprogress\' => $inprogress_count,\n\t\t\'pending\' => $pending_count,\n\t\t\'overall_percentage\' => $overall_percentage,\n\t\t\'tasks\' => $processed_tasks\n\t);\n }\n\n function get_reporting_manager_info($empdet_id)\n {\n\t$this->db->select(\'emp.report_mgr_id, mgr.mid, mgr.emp_name as manager_name, mgr.email_id as manager_email, mgr.emp_id as manager_code\');\n\t$this->db->join(\'managers as mgr\', \'mgr.mid = emp.report_mgr_id\', \'left\');\n\t$this->db->where(\'emp.id\', $empdet_id);\n\t$res = $this->db->get(\'employee_det as emp\')->row_array();\n\n\t// Fallback if manager email is not in managers table but in employee_det\n\tif (!empty($res) && empty($res[\'manager_email\']) && !empty($res[\'report_mgr_id\'])) {\n\t\t$this->db->select(\'email_id, emp_name, emp_id\');\n\t\t$this->db->where(\'id\', $res[\'report_mgr_id\']);\n\t\t$emp_mgr = $this->db->get(\'employee_det\')->row_array();\n\t\tif (!empty($emp_mgr)) {\n\t\t\t$res[\'manager_email\'] = $emp_mgr[\'email_id\'];\n\t\t\tif (empty($res[\'manager_name\'])) $res[\'manager_name\'] = $emp_mgr[\'emp_name\'];\n\t\t\tif (empty($res[\'manager_code\'])) $res[\'manager_code\'] = $emp_mgr[\'emp_id\'];\n\t\t}\n\t}\n\n\treturn $res;\n }\n\n function get_manager_team_daily_work($manager_mid, $date = \'\')\n {\n\t$target_date = (!empty($date)) ? date(\'Y-m-d\', strtotime($date)) : date(\'Y-m-d\');\n\t$team_members = $this->get_team_members($manager_mid);\n\n\t$summary = array();\n\n\tif (!empty($team_members)) {\n\t\tforeach ($team_members as $member) {\n\t\t\t$perf = $this->get_employee_daily_performance($member[\'id\'], $target_date);\n\n\t\t\t// Check verification status from notification_det (type = 10)\n\t\t\t$this->db->select(\'nid, is_acknownledge, creation_date\');\n\t\t\t$this->db->where(\'type\', 10);\n\t\t\t$this->db->where(\'initiator_id\', $member[\'id\']);\n\t\t\t$this->db->where(\'receiver_id\', $manager_mid);\n\t\t\t$this->db->where("DATE(creation_date) =", $target_date);\n\t\t\t$this->db->order_by(\'nid\', \'DESC\');\n\t\t\t$this->db->limit(1);\n\t\t\t$notif = $this->db->get(\'notification_det\')->row_array();\n\n\t\t\t$verification_status = \'Pending\';\n\t\t\t$verification_badge = \'bg-warning text-dark\';\n\t\t\t$notification_id = null;\n\n\t\t\tif ($perf[\'total\'] == 0) {\n\t\t\t\t$verification_status = \'Not Submitted\';\n\t\t\t\t$verification_badge = \'bg-secondary\';\n\t\t\t} elseif (!empty($notif)) {\n\t\t\t\t$notification_id = $notif[\'nid\'];\n\t\t\t\tif ($notif[\'is_acknownledge\'] == 1) {\n\t\t\t\t\t$verification_status = \'Approved\';\n\t\t\t\t\t$verification_badge = \'bg-success\';\n\t\t\t\t} elseif ($notif[\'is_acknownledge\'] == 2) {\n\t\t\t\t\t$verification_status = \'Returned\';\n\t\t\t\t\t$verification_badge = \'bg-danger\';\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t$summary[] = array(\n\t\t\t\t\'employee_id\' => $member[\'id\'],\n\t\t\t\t\'employee_code\' => $member[\'emp_id\'],\n\t\t\t\t\'employee_name\' => $member[\'emp_name\'],\n\t\t\t\t\'department\' => $member[\'department\'],\n\t\t\t\t\'designation\' => $member[\'designation\'],\n\t\t\t\t\'total_tasks\' => $perf[\'total\'],\n\t\t\t\t\'completed\' => $perf[\'completed\'],\n\t\t\t\t\'inprogress\' => $perf[\'inprogress\'],\n\t\t\t\t\'pending\' => $perf[\'pending\'],\n\t\t\t\t\'overall_percentage\' => $perf[\'overall_percentage\'],\n\t\t\t\t\'tasks\' => $perf[\'tasks\'],\n\t\t\t\t\'verification_status\' => $verification_status,\n\t\t\t\t\'verification_badge\' => $verification_badge,\n\t\t\t\t\'notification_id\' => $notification_id\n\t\t\t);\n\t\t}\n\t}\n\n\treturn $summary;\n }\n\n function save_manager_work_verification($manager_mid, $emp_id, $action, $remarks = \'\', $date = \'\')\n {\n\t$target_date = (!empty($date)) ? date(\'Y-m-d\', strtotime($date)) : date(\'Y-m-d\');\n\t$ack_status = ($action === \'approve\') ? 1 : 2;\n\n\t// Check existing submission notification\n\t$this->db->select(\'nid\');\n\t$this->db->where(\'type\', 10);\n\t$this->db->where(\'initiator_id\', $emp_id);\n\t$this->db->where(\'receiver_id\', $manager_mid);\n\t$this->db->where("DATE(creation_date) =", $target_date);\n\t$existing = $this->db->get(\'notification_det\')->row_array();\n\n\tif (!empty($existing)) {\n\t\t$this->db->where(\'nid\', $existing[\'nid\']);\n\t\t$this->db->update(\'notification_det\', array(\'is_acknownledge\' => $ack_status));\n\t} else {\n\t\t// Insert verification state\n\t\t$this->db->insert(\'notification_det\', array(\n\t\t\t\'type\' => 10,\n\t\t\t\'initiator_id\' => $emp_id,\n\t\t\t\'receiver_id\' => $manager_mid,\n\t\t\t\'is_acknownledge\' => $ack_status,\n\t\t\t\'from_date\' => $target_date,\n\t\t\t\'creation_date\' => date(\'Y-m-d H:i:s\')\n\t\t));\n\t}\n\n\t// Send notification back to employee (type = 11: IWork Verification Result)\n\t$this->db->insert(\'notification_det\', array(\n\t\t\'type\' => 11,\n\t\t\'initiator_id\' => $manager_mid,\n\t\t\'receiver_id\' => $emp_id,\n\t\t\'is_acknownledge\' => $ack_status,\n\t\t\'from_date\' => $target_date,\n\t\t\'creation_date\' => date(\'Y-m-d H:i:s\')\n\t));\n\n\treturn true;\n }\n\n function get_hr_performance_summary($period_type = \'currentmonth\', $filter_year = \'\', $filter_month = \'\', $dept_id = \'\', $emp_id = \'\', $mgr_id = \'\')\n {\n\t$year = (!empty($filter_year)) ? intval($filter_year) : intval(date(\'Y\'));\n\t$month = (!empty($filter_month)) ? intval($filter_month) : intval(date(\'n\'));\n\n\t// Determine date constraints\n\t$start_date = \'\';\n\t$end_date = \'\';\n\n\tswitch ($period_type) {\n\t\tcase \'today\':\n\t\t\t$start_date = date(\'Y-m-d\');\n\t\t\t$end_date = date(\'Y-m-d\');\n\t\t\tbreak;\n\t\tcase \'selectedmonth\':\n\t\tcase \'currentmonth\':\n\t\t\tif ($period_type == \'currentmonth\') {\n\t\t\t\t$year = intval(date(\'Y\'));\n\t\t\t\t$month = intval(date(\'n\'));\n\t\t\t}\n\t\t\t$start_date = sprintf(\'%04d-%02d-01\', $year, $month);\n\t\t\t$end_date = date(\'Y-m-t\', strtotime($start_date));\n\t\t\tbreak;\n\t\tcase \'last3months\':\n\t\t\t$end_date = date(\'Y-m-d\');\n\t\t\t$start_date = date(\'Y-m-d\', strtotime(\'-3 months\'));\n\t\t\tbreak;\n\t\tcase \'year\':\n\t\tcase \'selectedyear\':\n\t\t\t$start_date = sprintf(\'%04d-01-01\', $year);\n\t\t\t$end_date = sprintf(\'%04d-12-31\', $year);\n\t\t\tbreak;\n\t\tdefault:\n\t\t\t$start_date = sprintf(\'%04d-%02d-01\', $year, $month);\n\t\t\t$end_date = date(\'Y-m-t\', strtotime($start_date));\n\t\t\tbreak;\n\t}\n\n\t// 1. Fetch active employees matching filters\n\t$this->db->select(\'emp.id as employee_id, emp.emp_id as employee_code, emp.emp_name, emp.department, dept.department_name, emp.report_mgr_id, mgr.emp_name as manager_name\');\n\t$this->db->join(\'department_det as dept\', \'dept.id = emp.department\', \'left\');\n\t$this->db->join(\'managers as mgr\', \'mgr.mid = emp.report_mgr_id\', \'left\');\n\t$this->db->where(\'emp.status\', 1);\n\n\tif (!empty($dept_id) && $dept_id !== \'all\' && $dept_id !== \'0\') {\n\t\t$this->db->where(\'emp.department\', $dept_id);\n\t}\n\tif (!empty($emp_id) && $emp_id !== \'all\' && $emp_id !== \'0\') {\n\t\t$this->db->where(\'emp.id\', $emp_id);\n\t}\n\tif (!empty($mgr_id) && $mgr_id !== \'all\' && $mgr_id !== \'0\') {\n\t\t$this->db->where(\'emp.report_mgr_id\', $mgr_id);\n\t}\n\n\t$employees = $this->db->get(\'employee_det as emp\')->result_array();\n\n\t// 2. Fetch tasks in date range\n\t$this->db->select(\'task.id, task.e_id, task.status, task.prev_reason, task.task_comp_time, task.created_date, task.EstimatedHours, task.remarks\');\n\t$this->db->where("DATE(task.created_date) >=", $start_date);\n\t$this->db->where("DATE(task.created_date) <=", $end_date);\n\n\t$tasks = $this->db->get(\'task_details as task\')->result_array();\n\n\t// Index tasks by employee id\n\t$tasks_by_emp = array();\n\t$monthly_trend = array();\n\n\tif (!empty($tasks)) {\n\t\tforeach ($tasks as $t) {\n\t\t\t$tasks_by_emp[$t[\'e_id\']][] = $t;\n\t\t\t$t_month = date(\'M Y\', strtotime($t[\'created_date\']));\n\t\t\tif (!isset($monthly_trend[$t_month])) {\n\t\t\t\t$monthly_trend[$t_month] = array(\'total\' => 0, \'completed\' => 0, \'inprogress\' => 0, \'pending\' => 0, \'pct_sum\' => 0);\n\t\t\t}\n\t\t\t$monthly_trend[$t_month][\'total\']++;\n\t\t\tif ($t[\'status\'] == 1 || $t[\'status\'] == \'1\') {\n\t\t\t\t$monthly_trend[$t_month][\'completed\']++;\n\t\t\t\t$monthly_trend[$t_month][\'pct_sum\'] += 100;\n\t\t\t} elseif (!empty($t[\'prev_reason\']) || !empty($t[\'task_comp_time\'])) {\n\t\t\t\t$monthly_trend[$t_month][\'inprogress\']++;\n\t\t\t\t$monthly_trend[$t_month][\'pct_sum\'] += 50;\n\t\t\t} else {\n\t\t\t\t$monthly_trend[$t_month][\'pending\']++;\n\t\t\t}\n\t\t}\n\t}\n\n\t$overall_total_tasks = 0;\n\t$overall_completed = 0;\n\t$overall_inprogress = 0;\n\t$overall_pending = 0;\n\t$overall_pct_sum = 0;\n\t$employee_rows = array();\n\t$department_groups = array();\n\n\tif (!empty($employees)) {\n\t\tforeach ($employees as $emp) {\n\t\t\t$dept_name = !empty($emp[\'department_name\']) ? $emp[\'department_name\'] : \'General / Other\';\n\t\t\t$dept_id_key = !empty($emp[\'department\']) ? $emp[\'department\'] : 0;\n\n\t\t\tif (!isset($department_groups[$dept_name])) {\n\t\t\t\t$department_groups[$dept_name] = array(\n\t\t\t\t\t\'department_id\' => $dept_id_key,\n\t\t\t\t\t\'department_name\' => $dept_name,\n\t\t\t\t\t\'total_employees\' => 0,\n\t\t\t\t\t\'total_tasks\' => 0,\n\t\t\t\t\t\'completed\' => 0,\n\t\t\t\t\t\'inprogress\' => 0,\n\t\t\t\t\t\'pending\' => 0,\n\t\t\t\t\t\'pct_sum\' => 0\n\t\t\t\t);\n\t\t\t}\n\n\t\t\t$eid = $emp[\'employee_id\'];\n\t\t\t$emp_tasks = isset($tasks_by_emp[$eid]) ? $tasks_by_emp[$eid] : array();\n\n\t\t\t$t_count = count($emp_tasks);\n\t\t\t$c_count = 0;\n\t\t\t$i_count = 0;\n\t\t\t$p_count = 0;\n\t\t\t$pct_sum = 0;\n\n\t\t\tforeach ($emp_tasks as $t) {\n\t\t\t\tif ($t[\'status\'] == 1 || $t[\'status\'] == \'1\') {\n\t\t\t\t\t$c_count++;\n\t\t\t\t\t$pct_sum += 100;\n\t\t\t\t} elseif (!empty($t[\'prev_reason\']) || !empty($t[\'task_comp_time\'])) {\n\t\t\t\t\t$i_count++;\n\t\t\t\t\t$pct_sum += 50;\n\t\t\t\t} else {\n\t\t\t\t\t$p_count++;\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t$comp_rate = ($t_count > 0) ? round(($pct_sum / $t_count), 1) : 0;\n\n\t\t\t$department_groups[$dept_name][\'total_employees\']++;\n\t\t\t$department_groups[$dept_name][\'total_tasks\'] += $t_count;\n\t\t\t$department_groups[$dept_name][\'completed\'] += $c_count;\n\t\t\t$department_groups[$dept_name][\'inprogress\'] += $i_count;\n\t\t\t$department_groups[$dept_name][\'pending\'] += $p_count;\n\t\t\t$department_groups[$dept_name][\'pct_sum\'] += $pct_sum;\n\n\t\t\t$overall_total_tasks += $t_count;\n\t\t\t$overall_completed += $c_count;\n\t\t\t$overall_inprogress += $i_count;\n\t\t\t$overall_pending += $p_count;\n\t\t\t$overall_pct_sum += $pct_sum;\n\n\t\t\t$employee_rows[] = array(\n\t\t\t\t\'employee_id\' => $emp[\'employee_id\'],\n\t\t\t\t\'employee_code\' => $emp[\'employee_code\'],\n\t\t\t\t\'employee_name\' => $emp[\'emp_name\'],\n\t\t\t\t\'department\' => !empty($emp[\'department_name\']) ? $emp[\'department_name\'] : \'N/A\',\n\t\t\t\t\'manager\' => !empty($emp[\'manager_name\']) ? $emp[\'manager_name\'] : \'N/A\',\n\t\t\t\t\'total_tasks\' => $t_count,\n\t\t\t\t\'completed\' => $c_count,\n\t\t\t\t\'inprogress\' => $i_count,\n\t\t\t\t\'pending\' => $p_count,\n\t\t\t\t\'completion_rate\' => $comp_rate\n\t\t\t);\n\t\t}\n\t}\n\n\t$department_rows = array();\n\tforeach ($department_groups as $d_name => $d_data) {\n\t\t$d_comp_rate = ($d_data[\'total_tasks\'] > 0) ? round(($d_data[\'pct_sum\'] / $d_data[\'total_tasks\']), 1) : 0;\n\t\t$d_data[\'completion_rate\'] = $d_comp_rate;\n\t\t$department_rows[] = $d_data;\n\t}\n\n\t$overall_completion_rate = ($overall_total_tasks > 0) ? round(($overall_pct_sum / $overall_total_tasks), 1) : 0;\n\n\t// Prepare monthly trend chart labels and percentages\n\t$chart_labels = array();\n\t$chart_series = array();\n\tforeach ($monthly_trend as $m_label => $m_data) {\n\t\t$chart_labels[] = $m_label;\n\t\t$chart_series[] = ($m_data[\'total\'] > 0) ? round(($m_data[\'pct_sum\'] / $m_data[\'total\']), 1) : 0;\n\t}\n\n\treturn array(\n\t\t\'period_type\' => $period_type,\n\t\t\'start_date\' => $start_date,\n\t\t\'end_date\' => $end_date,\n\t\t\'total_employees\' => count($employees),\n\t\t\'total_tasks\' => $overall_total_tasks,\n\t\t\'completed\' => $overall_completed,\n\t\t\'inprogress\' => $overall_inprogress,\n\t\t\'pending\' => $overall_pending,\n\t\t\'overall_completion_rate\' => $overall_completion_rate,\n\t\t\'departments\' => $department_rows,\n\t\t\'employees\' => $employee_rows,\n\t\t\'chart_labels\' => $chart_labels,\n\t\t\'chart_series\' => $chart_series\n\t);\n }\n\n function get_hr_employee_drilldown($emp_id, $start_date = \'\', $end_date = \'\')\n {\n\tif (empty($start_date) || empty($end_date)) {\n\t\t$start_date = date(\'Y-m-01\');\n\t\t$end_date = date(\'Y-m-t\');\n\t}\n\n\t$this->db->select(\'emp.id as employee_id, emp.emp_id as employee_code, emp.emp_name, dept.department_name, mgr.emp_name as manager_name\');\n\t$this->db->join(\'department_det as dept\', \'dept.id = emp.department\', \'left\');\n\t$this->db->join(\'managers as mgr\', \'mgr.mid = emp.report_mgr_id\', \'left\');\n\t$this->db->where(\'emp.id\', $emp_id);\n\t$profile = $this->db->get(\'employee_det as emp\')->row_array();\n\n\t// Fetch all tasks in range\n\t$this->db->select(\'task.*, dep_task.task_list as task_title, activity_det.activity_list as activity_title, project_det.project_name as project_title\');\n\t$this->db->join(\'dep_task\', \'dep_task.id = task.dep_task_id\', \'left\');\n\t$this->db->join(\'activity_det\', \'activity_det.aid = task.activity_id\', \'left\');\n\t$this->db->join(\'project_det\', \'project_det.pid = task.project_name\', \'left\');\n\t$this->db->where(\'task.e_id\', $emp_id);\n\t$this->db->where("DATE(task.created_date) >=", $start_date);\n\t$this->db->where("DATE(task.created_date) <=", $end_date);\n\t$this->db->order_by(\'task.created_date\', \'DESC\');\n\n\t$tasks = $this->db->get(\'task_details as task\')->result_array();\n\n\t$daily_groups = array();\n\t$total_tasks = count($tasks);\n\t$total_c = 0;\n\t$total_i = 0;\n\t$total_p = 0;\n\t$total_pct_sum = 0;\n\n\tif (!empty($tasks)) {\n\t\tforeach ($tasks as $t) {\n\t\t\t$day = date(\'Y-m-d\', strtotime($t[\'created_date\']));\n\t\t\tif (!isset($daily_groups[$day])) {\n\t\t\t\t$daily_groups[$day] = array(\'date\' => $day, \'total\' => 0, \'completed\' => 0, \'inprogress\' => 0, \'pending\' => 0, \'pct_sum\' => 0, \'tasks\' => array());\n\t\t\t}\n\n\t\t\t$task_name = !empty($t[\'task_title\']) ? $t[\'task_title\'] : (!empty($t[\'activityDesc\']) ? $t[\'activityDesc\'] : $t[\'task_id\']);\n\t\t\t$project_name = !empty($t[\'project_title\']) ? $t[\'project_title\'] : (!empty($t[\'project_name\']) ? $t[\'project_name\'] : \'General\');\n\t\t\t\n\t\t\t$comp_pct = 0;\n\t\t\t$status_label = \'Pending\';\n\t\t\t$status_badge = \'bg-danger\';\n\n\t\t\tif ($t[\'status\'] == 1 || $t[\'status\'] == \'1\') {\n\t\t\t\t$comp_pct = 100;\n\t\t\t\t$status_label = \'Completed\';\n\t\t\t\t$status_badge = \'bg-success\';\n\t\t\t\t$daily_groups[$day][\'completed\']++;\n\t\t\t\t$total_c++;\n\t\t\t} elseif (!empty($t[\'prev_reason\']) || !empty($t[\'task_comp_time\'])) {\n\t\t\t\t$comp_pct = 50;\n\t\t\t\t$status_label = \'In Progress\';\n\t\t\t\t$status_badge = \'bg-warning text-dark\';\n\t\t\t\t$daily_groups[$day][\'inprogress\']++;\n\t\t\t\t$total_i++;\n\t\t\t} else {\n\t\t\t\t$comp_pct = 0;\n\t\t\t\t$status_label = \'Pending\';\n\t\t\t\t$status_badge = \'bg-danger\';\n\t\t\t\t$daily_groups[$day][\'pending\']++;\n\t\t\t\t$total_p++;\n\t\t\t}\n\n\t\t\t$daily_groups[$day][\'total\']++;\n\t\t\t$daily_groups[$day][\'pct_sum\'] += $comp_pct;\n\t\t\t$total_pct_sum += $comp_pct;\n\n\t\t\t$t[\'calculated_name\'] = $task_name;\n\t\t\t$t[\'calculated_project\'] = $project_name;\n\t\t\t$t[\'calculated_percentage\'] = $comp_pct;\n\t\t\t$t[\'calculated_status\'] = $status_label;\n\t\t\t$t[\'calculated_badge\'] = $status_badge;\n\n\t\t\t$daily_groups[$day][\'tasks\'][] = $t;\n\t\t}\n\t}\n\n\t$daily_rows = array();\n\tforeach ($daily_groups as $day => $d) {\n\t\t$d[\'completion_rate\'] = ($d[\'total\'] > 0) ? round(($d[\'pct_sum\'] / $d[\'total\']), 1) : 0;\n\t\t$daily_rows[] = $d;\n\t}\n\n\t$overall_completion_rate = ($total_tasks > 0) ? round(($total_pct_sum / $total_tasks), 1) : 0;\n\n\treturn array(\n\t\t\'profile\' => $profile,\n\t\t\'total_tasks\' => $total_tasks,\n\t\t\'completed\' => $total_c,\n\t\t\'inprogress\' => $total_i,\n\t\t\'pending\' => $total_p,\n\t\t\'overall_completion_rate\' => $overall_completion_rate,\n\t\t\'daily_records\' => $daily_rows\n\t);\n }\n\nfunction get_employee_det(){\n\t$today = $current_day = date("Y-m-d");\n\t$this->db->select("employee_det.*"); \n\t$this->db->select(\'department_det.id as did,department_det.department_name as department\'); \n\t\t$this->db->join(\'department_det\',\'department_det.id=employee_det.department\',\'left\');\n\t\t$this->db->order_by(\'emp_name\',\'ASC\');\n \t$query = $this->db->get(\'employee_det\')->result_array();\n  // echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\n\n/**\n * Get employees filtered by employment status.\n * @param int $status  1 = Active, 0 = Inactive\n * @return array\n */\nfunction get_employee_det_by_status($status = 1)\n{\n\t$this->db->select("employee_det.*");\n\t$this->db->select(\'department_det.id as did, department_det.department_name as department\');\n\t$this->db->join(\'department_det\', \'department_det.id = employee_det.department\', \'left\');\n\t$this->db->where(\'employee_det.status\', (int)$status);\n\t$this->db->where_not_in(\'employee_det.emp_id\', array(\'INETMASTER\'));\n\t$this->db->order_by(\'employee_det.emp_name\', \'ASC\');\n\treturn $this->db->get(\'employee_det\')->result_array();\n}\n\n/**\n * Return counts of active and inactive employees (excluding INETMASTER).\n * @return array  [\'active\' => int, \'inactive\' => int]\n */\nfunction get_employee_status_counts()\n{\n\t$exclude = array(\'INETMASTER\');\n\n\t$this->db->select("SUM(CASE WHEN status = 1 THEN 1 ELSE 0 END) as active_count,\n\t                   SUM(CASE WHEN status = 0 THEN 1 ELSE 0 END) as inactive_count");\n\t$this->db->where_not_in(\'emp_id\', $exclude);\n\t$row = $this->db->get(\'employee_det\')->row_array();\n\n\treturn array(\n\t\t\'active\'   => isset($row[\'active_count\'])   ? (int)$row[\'active_count\']   : 0,\n\t\t\'inactive\' => isset($row[\'inactive_count\']) ? (int)$row[\'inactive_count\'] : 0,\n\t);\n}\n\nfunction get_login_count(){\n\t$eid = array(\'1\',\'3\',\'5\');\n\t$today = $current_day = date("Y-m-d");\n\t$this->db->select("count(distinct(l.e_id)) as total_login");\n\t$this->db->from(\'login_log l\');\n\t// Only count logins from ACTIVE employees\n\t$this->db->join(\'employee_det e\', \'e.id = CAST(l.e_id AS UNSIGNED)\');\n\t$this->db->where(\'e.status\', 1);\n\t$this->db->where(\'date(l.created_date)\', $today);\n\t$this->db->where_not_in(\'l.e_id\', $eid);\n \t$query = $this->db->get()->result_array();\n    //echo $this->db->last_query(); exit;\n\tif(isset($query) && !empty($query))\n\t    {\n\t      return $query;\n\t    }\n\n}\n\nfunction getemployees_org_details($id)\n\t {\n\t \t$this->db->select("employee_det.*");\n\t \t$this->db->select(\'department_det.id as dept_id,department_det.department_name as department\'); \n\t\t$this->db->join(\'department_det\',\'department_det.id=employee_det.department\',\'left\'); \n\t \t$this->db->where(\'employee_det.id\',$id);     \n\t \t$query = $this->db->get(\'employee_det\')->result_array();\n\t  // echo $this->db->last_query(); exit;\n\t\tif(isset($query) && !empty($query))\n\t\t    {\n\t\t      return $query;\n\t\t    }\n\n\t }\t \n\n function get_members_list($emp_id)\n\n     {\n     \t//$user_det = $this->session->userdata(\'logged_in\');\n\n     \t$this->db->select(\'emp.id as eid,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.join_dt,emp.work_loc\');/*emp.desg_date\');*/ \n\t\t$this->db->select(\'managers.mid,managers.emp_id as report_mgr_id\');\n\t\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t\t//$this->db->select(\'emp.emp_id,managers.emp_id\'); \n\t\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\');\n\t\t$this->db->where(\'managers.emp_id\',$emp_id);\n\t\t$this->db->where(\'emp.status\',1);\n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t \t//echo $this->db->last_query(); exit;\n\t \t//echo"<pre>array";print_r($query);exit;\n\t\n\t\treturn $query; \n     }\n\n function get_all_team_reports($emp_id, $inps)\n  {\n  \t$user_det = $this->session->userdata(\'logged_in\');\n\n\n  \t\tif(isset($inps) && !empty($inps)){ \n\n\t\t\t\tif(empty($inps[\'from_date\']) && empty($inps[\'to_date\'])&& empty($inps[\'project_name\']) && empty($inps[\'status\']))\n\t\t\t\t{\n\t\t\t\t\t$t = time(); $cur_dt = date("Y-m-d",$t);\n\t\t\t\t\t$this->db->where("DATE_FORMAT(task.created_date,(\'%Y-%m-%d\'))",$cur_dt);\n\t\t\t\t}\n\t\t\t   \n\t\t\t\tif($inps[\'from_date\'] != "" && $inps[\'to_date\'] != "")\n\t\t\t\t{\n\t\t\t\t\t$from_date=date(\'Y-m-d\',strtotime($inps[\'from_date\']));\n\t\t\t\t\t$to_date=date(\'Y-m-d\',strtotime($inps[\'to_date\']));\n\t\t\t\t\t$this->db->where("DATE_FORMAT(task.created_date, (\'%Y-%m-%d \')) >=",$from_date);\n\t\t\t\t\t$this->db->where("DATE_FORMAT(task.created_date, (\'%Y-%m-%d \')) <=",$to_date);\n\t\t\t\t} \n\t\t \n\t\t\t\tif($inps[\'project_name\'] != "0")\n\t\t\t\t{\n\t\t\t\t\t  \n\t\t\t\t\t$this->db->where(\'task.project_name\',$inps[\'project_name\']);\n\n\t\t\t\t} \n\t\t        \n\t\t\t\tif (!empty($inps[\'Empname\']) && $inps[\'Empname\'] != "0") {\n\t\t\t\t\t\t$this->db->where(\'task.e_id\', $inps[\'Empname\']);\n\t\t\t\t\t}\n\t\t \n\t\t\t\tif($inps[\'status\'] != "all")\n\t\t\t\t{\n\t\t\t\t\t  \n\t\t\t\t\t$this->db->where(\'task.status\',$inps[\'status\']);\n\n\t\t\t\t} \n\t\t\t\n\t\t}\n  \t$this->db->select(\'task.*\');\n \t$this->db->select(\'employee_det.id,employee_det.emp_id,employee_det.emp_name,employee_det.report_mgr_id,employee_det.report_mgr_id\');\n \t$this->db->select(\'dep_task.id as taskid,dep_task.department,,dep_task.task_list\'); \n \t$this->db->select(\'managers.mid,managers.emp_id as reprt_mger_id\'); \n \t$this->db->select(\'activity_det.aid,activity_det.activity_list\'); \n \t\t$this->db->select(\'project_det.pid,project_det.project_name as pname\');  \n\t\t$this->db->join(\'project_det\',\'project_det.pid=task.project_name\',\'left\');\n \t$this->db->join(\'employee_det\',\'employee_det.id = task.e_id\',\'left\');\n \t$this->db->join(\'dep_task\',\'dep_task.id = task.dep_task_id\',\'left\');\n \t$this->db->join(\'managers\',\'managers.mid=employee_det.report_mgr_id\',\'left\');\n \t$this->db->join(\'activity_det\',\'activity_det.aid=task.activity_id\',\'left\');\n \t$this->db->where(\'managers.emp_id\',$emp_id);\n \t$this->db->where(\'dep_task.department\',$user_det[\'department\']);\n\t$this->db->where(\'employee_det.status\', 1); // Only active employees\n    $query= $this->db->get(\'task_details as task\')->result_array();\n     // print_r($this->db->last_query()); exit;\n      \t\t  //echo "<pre>array";print_r($query);exit;\n    return $query;\n \n\t}\n\n\t/**\n\t * Fetches Project Request records from LeaveProjectRequest_Form for the manager\'s team\n\t * and returns them mapped into the team reports column structure.\n\t * Only entry_type = 1 (Project Request) records are included.\n\t */\n\tpublic function get_project_requests_for_team_report($emp_id, $inps = [])\n\t{\n\t\t// Get manager\'s internal ID (mid) using emp_id\n\t\t$this->db->select(\'mid\');\n\t\t$this->db->from(\'managers\');\n\t\t$this->db->where(\'emp_id\', $emp_id);\n\t\t$mgr_query = $this->db->get()->result_array();\n\n\t\tif (empty($mgr_query)) {\n\t\t\treturn [];\n\t\t}\n\t\t$mid = $mgr_query[0][\'mid\'];\n\n\t\t// Build the project request query\n\t\t$this->db->select(\'iet.slpno, iet.emp_id, iet.from_date, iet.to_date, iet.status, iet.desc, iet.entry_type\');\n\t\t$this->db->select(\'ed.emp_name, ed.emp_id AS emp_code\');\n\t\t$this->db->select(\'ed2.emp_name AS assigned_manager_name\');\n\t\t$this->db->select(\'pd.project_name AS req_project_name\');\n\t\t$this->db->from(\'LeaveProjectRequest_Form AS iet\');\n\t\t$this->db->join(\'employee_det AS ed\', \'ed.id = iet.emp_id\', \'left\');\n\t\t$this->db->join(\'employee_det AS ed2\', \'ed2.id = iet.assigned_by\', \'left\');\n\t\t$this->db->join(\'project_det AS pd\', \'pd.pid = iet.project_name\', \'left\');\n\t\t$this->db->where(\'iet.rm_id\', $mid);\n\t\t$this->db->where(\'iet.entry_type\', 1); // Only Project Requests\n\t\t$this->db->where(\'ed.status\', 1); // Only active employees\n\n\t\t// Apply date and employee filters\n\t\tif (!empty($inps)) {\n\t\t\tif (!empty($inps[\'from_date\']) && !empty($inps[\'to_date\'])) {\n\t\t\t\t$from_date = date(\'Y-m-d\', strtotime($inps[\'from_date\']));\n\t\t\t\t$to_date   = date(\'Y-m-d\', strtotime($inps[\'to_date\']));\n\t\t\t\t// Overlap logic: show any project request whose duration intersects the selected filter range.\n\t\t\t\t// A record overlaps when: project_from_date <= selected_to_date AND project_to_date >= selected_from_date\n\t\t\t\t$this->db->where("DATE(iet.from_date) <=", $to_date);\n\t\t\t\t$this->db->where("DATE(iet.to_date) >=", $from_date);\n\t\t\t}\n\n\t\t\tif (!empty($inps[\'Empname\']) && $inps[\'Empname\'] != \'0\') {\n\t\t\t\t$this->db->where(\'iet.emp_id\', $inps[\'Empname\']);\n\t\t\t}\n\t\t}\n\n\t\t$rows = $this->db->get()->result_array();\n\n\t\t// Map each row to match the team reports column structure\n\t\t$mapped = [];\n\t\tforeach ($rows as $row) {\n\t\t\t$from_fmt = !empty($row[\'from_date\']) ? date(\'Y-m-d\', strtotime($row[\'from_date\'])) : \'\';\n\t\t\t$to_fmt   = !empty($row[\'to_date\'])   ? date(\'Y-m-d\', strtotime($row[\'to_date\']))   : \'\';\n\n\t\t\t// Status mapping: 0=Pending, 1=Approved, 2=Rejected\n\t\t\t$req_status = $row[\'status\'];\n\n\t\t\t$mapped[] = [\n\t\t\t\t// Identification flag so the view can detect this row type\n\t\t\t\t\'_is_project_request\' => true,\n\n\t\t\t\t// EMP DETAILS\n\t\t\t\t\'emp_name\'         => $row[\'emp_name\'],\n\t\t\t\t\'emp_id\'           => $row[\'emp_code\'],\n\n\t\t\t\t// WORK TYPE → "Project Request"\n\t\t\t\t\'work_type\'        => \'Project Request\',\n\t\t\t\t// Store raw for JS analytics (won\'t match entry_type codes 1/2/3, treated as \'other\')\n\t\t\t\t\'_pr_work_type_raw\'=> \'Project Request\',\n\n\t\t\t\t// SESSION → "Leave/Project"\n\t\t\t\t\'session_type\'     => \'Leave/Project\',\n\n\t\t\t\t// PROJECT NAME → Requested Project\n\t\t\t\t\'pname\'            => !empty($row[\'req_project_name\']) ? $row[\'req_project_name\'] : \'N/A\',\n\n\t\t\t\t// TASK NAME → "Project Request"\n\t\t\t\t\'task_list\'        => \'Project Request\',\n\n\t\t\t\t// ACTIVITY → "Project Allocation"\n\t\t\t\t\'activity_list\'    => \'Project Allocation\',\n\n\t\t\t\t// ACTIVITY DESCRIPTION → "Project request from [From Date] to [To Date]"\n\t\t\t\t\'activityDesc\'     => \'Project request from \' . $from_fmt . \' to \' . $to_fmt,\n\n\t\t\t\t// TASK PRIORITY → N/A\n\t\t\t\t\'priority_type\'    => \'\',\n\n\t\t\t\t// TASK DEPENDENCY → Assigned Manager\n\t\t\t\t\'depend_name\'      => \'\',\n\t\t\t\t\'_assigned_manager\'=> !empty($row[\'assigned_manager_name\']) ? $row[\'assigned_manager_name\'] : \'N/A\',\n\n\t\t\t\t// TASK REMARKS → Request Remarks (desc)\n\t\t\t\t\'remarks\'          => !empty($row[\'desc\']) ? $row[\'desc\'] : \'\',\n\n\t\t\t\t// ESTIMATED HOURS → N/A\n\t\t\t\t\'EstimatedHours\'   => \'N/A\',\n\n\t\t\t\t// COMPLETED TIME → N/A\n\t\t\t\t\'task_comp_time\'   => \'N/A\',\n\n\t\t\t\t// STATUS → Request Status (0=Pending,1=Approved,2=Rejected mapped to task convention)\n\t\t\t\t\'status\'           => $req_status, // kept as raw value; view handles display\n\n\t\t\t\t// START DATE → From Date\n\t\t\t\t\'created_date\'     => $from_fmt,\n\n\t\t\t\t// COMPLETED DATE → To Date\n\t\t\t\t\'task_comp_dt\'     => $to_fmt,\n\n\t\t\t\t// Extra fields kept blank to avoid undefined index notices\n\t\t\t\t\'task_id\'          => \'\',\n\t\t\t];\n\t\t}\n\n\t\treturn $mapped;\n\t}\n\n\tfunction get_pending_reports($id)\n\t{\n\t\t$this->db->select(\'task.*\'); \n \t\t$this->db->select(\'employee_det.id as eid,employee_det.emp_id,employee_det.emp_name,employee_det.mob_no,employee_det.email_id,employee_det.department,employee_det.designation,employee_det.report_mgr_id,employee_det.join_dt,employee_det.work_loc\');   \n \t\t$this->db->select(\'dep_task.id as taskid,dep_task.department,dep_task.task_list\');\n \t\t$this->db->select(\'activity_det.aid,activity_det.activity_list\');\n \t\t$this->db->select(\'project_det.pid,project_det.project_name as pname\');  \n\t\t$this->db->select(\'tickets.ticket_id as t_ticket_id, tickets.title as ticket_title, tickets.description as ticket_desc, tickets.user_priority as ticket_priority\');\n\t\t$this->db->join(\'tickets\',\'tickets.id=task.ticket_id\',\'left\');\n\t\t$this->db->join(\'project_det\',\'project_det.pid=task.project_name\',\'left\');\n \t\t$this->db->join(\'employee_det\',\'employee_det.id=task.e_id\',\'left\');\n \t\t$this->db->join(\'dep_task\',\'dep_task.id = task.dep_task_id\',\'left\');\n \t\t$this->db->join(\'activity_det\',\'activity_det.aid = task.activity_id\',\'left\');\n \t\t$this->db->where(\'task.status\',0);\n \t\t$this->db->where(\'task.e_id\',$id);\n        $this->db->order_by(\'date(task.created_date)\',\'DESC\');\n \t\t$query = $this->db->get(\'task_details as task\')->result_array();\n\t\treturn $query; \n\t}\n\n\tfunction get_states_list(){\n\n\t\t\t$this->db->select("*"); \n\t \t \t$query = $this->db->get(\'states\')->result_array();\n\t\t\t//echo $this->db->last_query(); exit;\n\t\t\treturn $query; \n\t}\n\n\n\tfunction get_project_reports(){\n\n\t\t\t \n\t\t$this->db->select(\'pro.*\'); \n \t\t$this->db->select(\'states.id as sid,states.state_name,states.s_name\');   \n \t\t$this->db->select(\'employee_det.id,employee_det.emp_name\'); \n \t\t// $this->db->select(\'managers.mid,managers.emp_name as username\'); \n\t\t// $this->db->join(\'managers\',\'managers.mid=pro.CreationBy\',\'left\');   \n\t\t$this->db->join(\'employee_det\',\'employee_det.id=pro.approver_id\',\'left\');   \n \t\t$this->db->join(\'states\',\'states.id=pro.sid\',\'left\');  \n      // include newly added projects in reports\n      // $this->db->where(\'pro.status\', 1);\n      $this->db->order_by(\'date(pro.CreationDate)\',\'DESC\');\n \t\t$query = $this->db->get(\'project_det as pro\')->result_array();\n\t\t // print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t}\n\nfunction approve_project_db($pid){\n    $this->db->where(\'pid\', $pid);\n\n    return $this->db->update(\'project_det\', [\n        \'approver_status\' => 1,\n        \'status\' => 1\n    ]);\n}\nfunction decline_project_db($pid){\n    $this->db->where(\'pid\', $pid);\n\n    return $this->db->update(\'project_det\', [\n        \'approver_status\' => 3,\n        \'status\' => 0\n    ]);\n}\n\tfunction get_dependency_name($did){\n\n\t\t//echo"<pre>array";print_r($did);exit;\t \n\t\t $this->db->select(\'emp.emp_name\'); \n\t\t $this->db->where(\'emp.id\',$did); \n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t  //print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t}\n\n\tfunction get_emp_details($department){\n\n\t\t// echo"<pre>array";print_r($dept);exit;\t \n\t\t$this->db->select(\'emp.id,emp.emp_name\'); \n\t\t$this->db->where(\'emp.department\',$department); \n\t\t$this->db->where(\'emp.status\',1); \n \t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t// print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\n\t}\n\n\tfunction get_all_task_list(){\n\n\t\t$this->db->select(\'distinct(task_list) as task_list,id\');\n \t\t$this->db->where(\'tas.status\',1);\n  \t\t$query = $this->db->get(\'dep_task as tas\')->result_array();\n\t\t //print_r($this->db->last_query()); exit;  \n     \t return $query; \n\t }\n\t function get_add_task_reports($emp,$inps){\n\n\t \t// echo "<pre>inps"; print_r($inps); exit;\n\t \tif(isset($inps) && !empty($inps)){ \n\n\t\t\t\tif(empty($inps[\'from_date\']) && empty($inps[\'to_date\'])&& empty($inps[\'project_name\']) && empty($inps[\'status\']))\n\t\t\t\t{\n\t\t\t\t\t$t = time(); $cur_dt = date("Y-m-d",$t);\n\t\t\t\t\t$this->db->where("DATE_FORMAT(add.created_date,(\'%Y-%m-%d\'))",$cur_dt);\n\t\t\t\t}\n\t\t\t   \n\t\t\t\tif($inps[\'from_date\'] != "" && $inps[\'to_date\'] != "")\n\t\t\t\t{\n\t\t\t\t\t$from_date=date(\'Y-m-d\',strtotime($inps[\'from_date\']));\n\t\t\t\t\t$to_date=date(\'Y-m-d\',strtotime($inps[\'to_date\']));\n\t\t\t\t\t$this->db->where("DATE_FORMAT(add.created_date, (\'%Y-%m-%d \')) >=",$from_date);\n\t\t\t\t\t$this->db->where("DATE_FORMAT(add.created_date, (\'%Y-%m-%d \')) <=",$to_date);\n\t\t\t\t} else {\n\t\t\n\t\t\n\t\t\t\t}\n\t\t \n\t\t\t\tif($inps[\'project_name\'] != "0")\n\t\t\t\t{\n\t\t\t\t \t \n\t\t\t\t\t$this->db->where(\'add.project_name\',$inps[\'project_name\']);\n\n\t\t\t\t} else {\n\t\t\n\t\t\n\t\t\t\t}\n\t\t \n\t\t\t\tif($inps[\'status\'] != "all")\n\t\t\t\t{\n\t\t\t\t \t \n\t\t\t\t\t$this->db->where(\'add.status\',$inps[\'status\']);\n\n\t\t\t\t} else {\n\t\t\n\t\t\n\t\t\t\t}  \n\t\t\t\n\t\t}\n\n\t\t$this->db->select(\'add.*\'); \n \t\t$this->db->select(\'employee_det.id as eid,employee_det.emp_id,employee_det.emp_name,employee_det.mob_no,employee_det.email_id,employee_det.department,employee_det.designation,employee_det.report_mgr_id,employee_det.join_dt,employee_det.work_loc\');   \n \t\t$this->db->select(\'dep_task.id,dep_task.department,dep_task.task_list\');\n \t\t$this->db->select(\'task_details.task_id as atask_id\');\n \t\t$this->db->select(\'project_det.pid,project_det.project_name as pname\');  \n\t\t$this->db->join(\'project_det\',\'project_det.pid=add.project_name\',\'left\');\n \t\t$this->db->join(\'employee_det\',\'employee_det.id=add.e_id\',\'left\');\n \t\t$this->db->join(\'dep_task\',\'dep_task.id = add.dep_task_id\',\'left\'); \n \t\t$this->db->select(\'activity_det.aid,activity_det.activity_list\');\n\t\t$this->db->join(\'activity_det\',\'activity_det.aid = add.activity_id\',\'left\');\n \t\t$this->db->join(\'task_details\',\'task_details.id = add.task_id\',\'left\'); \n \t\t$this->db->where(\'add.a_id\',$emp);\n        $this->db->order_by(\'date(add.created_date)\',\'DESC\');\n \t\t$query = $this->db->get(\'additional_task_details as add\')->result_array();\n\t\t // print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t }\n\n\t function get_daily_time_sheet($emp,$inps){\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t    //echo "<pre>inps"; print_r($employee_det); exit;\n\t\t \t // Set selected date\n\t\t\t$selected_date = isset($inps[\'selected_date\']) &&  !empty($inps[\'selected_date\']) \n\t\t\t\t? $inps[\'selected_date\'] \n\t\t\t\t: date("Y-m-d");\n\n\t\t\t// Set employee ID (from filter or session)\n\t\t\t$emp_id = isset($inps[\'employee_id\']) && !empty($inps[\'employee_id\']) \n\t\t\t\t? $inps[\'employee_id\'] \n\t\t\t\t: $emp;\n\n\t\t\t// 🔍 Check for leave or onduty or project entries in LeaveProjectRequest_Form\n\t\t\t$this->db->select(\'LeaveProjectRequest_Form.*, project_det.project_name as pname, ed.emp_name AS employee_name, ed2.emp_name as assigned_by_name\');\n\t\t\t$this->db->from(\'LeaveProjectRequest_Form\');\n\t\t\t$this->db->join(\'project_det\', \'project_det.pid = LeaveProjectRequest_Form.project_name\', \'left\');\n\t\t\t$this->db->join(\'employee_det AS ed\', \'ed.id = LeaveProjectRequest_Form.emp_id\', \'left\');\n\t\t\t$this->db->join(\'employee_det AS ed2\', \'ed2.id = LeaveProjectRequest_Form.assigned_by\', \'left\');\n\t\t\t// $this->db->join(\'employee_det AS ed3\', \'ed3.id = LeaveProjectRequest_Form.duty_assigned_by\', \'left\');\n        \n\t\t\t$this->db->where(\'LeaveProjectRequest_Form.emp_id\', $emp_id);\n\n\t\t\t//  Match if selected date is in any one of the ranges (leave/onduty/project)\n\t\t\t$this->db->where("(\n\t\t\t\t(\'$selected_date\' BETWEEN from_date AND to_date) \n\t\t\t)", null, false);\n\n\t\t\t$query1 = $this->db->get();\n\n\t\t\tif ($query1->num_rows() > 0) {\n\t\t\t\t  // print_r($this->db->last_query()); exit;\n\t\t\t\treturn $query1->result_array(); \n\t\t\t} else {\n\t\t\t\t// 🔁 Fallback to task_details\n\t\t\t\t$this->db->select(\'task.*,employee_det.emp_name,dep_task.task_list, activity_det.activity_list,project_det.project_name as pname\');\n\t\t\t\t$this->db->from(\'task_details as task\');\n\t\t\t\t$this->db->join(\'project_det\',\'project_det.pid = task.project_name\',\'left\');\n\t\t\t\t$this->db->join(\'employee_det\',\'employee_det.id = task.e_id\',\'left\');\n\t\t\t\t$this->db->join(\'dep_task\',\'dep_task.id = task.dep_task_id\',\'left\'); \n\t\t\t\t$this->db->join(\'activity_det\',\'activity_det.aid = task.activity_id\',\'left\');\n\n\t\t\t\t$this->db->where("DATE_FORMAT(task.created_date, \'%Y-%m-%d\') =", $selected_date);\n\n\t\t\t\tif (!empty($inps[\'employee_id\'])) {\n\t\t\t\t\t$this->db->where("task.e_id", $inps[\'employee_id\']);\n\t\t\t\t}\n\n\t\t\t\t// Restrict if not admin\n\t\t\t\tif ($employee_det[\'role_type\'] != "1") {\n\t\t\t\t\t$this->db->where(\'task.e_id\', $emp);\n\t\t\t\t}\n\n\t\t\t\t$query = $this->db->get();\n\t\t\t\t// print_r($this->db->last_query()); exit;\n\t\t\t\treturn $query->result_array();\n\t\t\t} \n\t } //Daily Time SHeet\n\t function get_add_received_reports($emp,$inps){\n\n\n\t \t// echo "<pre>inps"; print_r($inps); exit;\n\t \tif(isset($inps) && !empty($inps)){ \n\n\t\t\t\tif(empty($inps[\'from_date\']) && empty($inps[\'to_date\'])&& empty($inps[\'project_name\']) && empty($inps[\'status\']))\n\t\t\t\t{\n\t\t\t\t\t$t = time(); $cur_dt = date("Y-m-d",$t);\n\t\t\t\t\t$this->db->where("DATE_FORMAT(add.created_date,(\'%Y-%m-%d\'))",$cur_dt);\n\t\t\t\t}\n\t\t\t   \n\t\t\t\tif($inps[\'from_date\'] != "" && $inps[\'to_date\'] != "")\n\t\t\t\t{\n\t\t\t\t\t$from_date=date(\'Y-m-d\',strtotime($inps[\'from_date\']));\n\t\t\t\t\t$to_date=date(\'Y-m-d\',strtotime($inps[\'to_date\']));\n\t\t\t\t\t$this->db->where("DATE_FORMAT(add.created_date, (\'%Y-%m-%d \')) >=",$from_date);\n\t\t\t\t\t$this->db->where("DATE_FORMAT(add.created_date, (\'%Y-%m-%d \')) <=",$to_date);\n\t\t\t\t} else {\n\t\t\n\t\t\n\t\t\t\t}\n\t\t \n\t\t\t\tif($inps[\'project_name\'] != "0")\n\t\t\t\t{\n\t\t\t\t \t \n\t\t\t\t\t$this->db->where(\'add.project_name\',$inps[\'project_name\']);\n\n\t\t\t\t} else {\n\t\t\n\t\t\n\t\t\t\t}\n\t\t \n\t\t\t\tif($inps[\'status\'] != "all")\n\t\t\t\t{\n\t\t\t\t \t \n\t\t\t\t\t$this->db->where(\'add.status\',$inps[\'status\']);\n\n\t\t\t\t} else {\n\t\t\n\t\t\n\t\t\t\t}  \n\t\t\t\n\t\t}\n\n\t\t$this->db->select(\'add.*\'); \n \t\t$this->db->select(\'employee_det.id as eid,employee_det.emp_id,employee_det.emp_name,employee_det.mob_no,employee_det.email_id,employee_det.department,employee_det.designation,employee_det.report_mgr_id,employee_det.join_dt,employee_det.work_loc\');   \n \t\t$this->db->select(\'dep_task.id,dep_task.department,dep_task.task_list\');\n \t\t$this->db->select(\'task_details.task_id as atask_id\');\n \t\t$this->db->select(\'activity_det.aid,activity_det.activity_list\');  \n \t\t$this->db->select(\'project_det.pid,project_det.project_name as pname\');  \n\t\t$this->db->join(\'project_det\',\'project_det.pid=add.project_name\',\'left\');\n \t\t$this->db->join(\'employee_det\',\'employee_det.id=add.e_id\',\'left\');\n \t\t$this->db->join(\'dep_task\',\'dep_task.id = add.dep_task_id\',\'left\'); \n \t\t$this->db->join(\'activity_det\',\'activity_det.aid=add.activity_id\',\'left\');\n \t\t$this->db->join(\'task_details\',\'task_details.id = add.task_id\',\'left\'); \n \t\t$this->db->where(\'add.e_id\',$emp);\n        $this->db->order_by(\'date(add.created_date)\',\'DESC\');\n \t\t$query = $this->db->get(\'additional_task_details as add\')->result_array();\n\t\t // print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t }\n\t \nfunction get_employee_by_id($emp_id) {\n    $this->db->where(\'emp_id\', $emp_id);\n\t\n    $query = $this->db->get(\'employee_det\'); \n\n    return $query->row(); \n   }\n\nfunction get_manager_by_id($emp_id) {\n\t$this->db->where(\'emp_id\', $emp_id);\n\n\t$query = $this->db->get(\'employee_det\');\n\n\treturn $query->row();\n  }\n\n\t function get_activity_data($id){\n\n\t\t$this->db->select(\'activity_list\');\n \t\t$this->db->where(\'aid\',$id);\n  \t\t$query = $this->db->get(\'activity_det\')->result_array();\n\t\t // print_r($this->db->last_query()); exit;  \n     \t return $query[0][\'activity_list\']; \n\t }\n\n\t function get_taskname_data($id){\n\n\t\t$this->db->select(\'task_list\');\n \t\t$this->db->where(\'id\',$id);\n  \t\t$query = $this->db->get(\'dep_task\')->result_array();\n\t\t// print_r($this->db->last_query()); exit;  \n     \t return $query[0][\'task_list\']; \n\t }\n\nfunction get_employees_submitted(){\n \n\t$usrs = array(\'INETMASTER\');\n    $today = $current_day = date("Y-m-d");\n \t$this->db->select(\'DISTINCT(task.e_id)\'); \n\t$this->db->select(\'employee_det.id,employee_det.emp_id,employee_det.emp_name,employee_det.mob_no,employee_det.email_id,employee_det.department,employee_det.designation,employee_det.report_mgr_id,employee_det.join_dt,employee_det.work_loc\');\n\t$this->db->select(\'login_log.e_id as empid\');\n\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t\n\t$this->db->join(\'employee_det\',\'employee_det.id=task.e_id\',\'left\');\n\t$this->db->join(\'department_det\',\'department_det.id=employee_det.department\',\'left\');\n    $this->db->join(\'login_log\',\'login_log.e_id=employee_det.id\',\'left\');\n\t//$this->db->join(\'managers\',\'managers.mid=task.depend_name\',\'left\'); \n\t$this->db->where(\'date(task.created_date)\',$today);       \n\t$this->db->where_not_in(\'employee_det.emp_id\',$usrs);\n\t$this->db->where(\'employee_det.status\', 1); // Only active employees\n\t$this->db->where(\'task.e_id in (select distinct(e_id) from login_log where date(created_date)=\'."\'".$today."\'".\')\');      \n\t$query = $this->db->get(\'task_details as task\')->result_array();\n\t  // print_r($this->db->last_query()); exit; \n  \treturn $query;\n}\n\nfunction get_employees_notin(){\n\t\n\t$usrs = array(\'INETMASTER\');\n    $today = $current_day = date("Y-m-d");\n\t$this->db->select(\'DISTINCT(`emp`.`id`) as empid\');/*emp.desg_date\');*/ \n\t$this->db->select(\'emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.work_loc\');\n\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n  \t$this->db->join(\'login_log\',\'login_log.e_id=emp.id\',\'left\');\t\n\t$this->db->where(\'emp.id NOT IN(SELECT e_id FROM login_log where date(created_date)=\'."\'".$today."\'".\')\');    \n\t$this->db->where_not_in(\'emp.emp_id\',$usrs);\n\t$this->db->where(\'emp.status\', 1); // Only active employees\n \t$query = $this->db->get(\'employee_det as emp\')->result_array();\n \t// echo $this->db->last_query(); exit;\n \treturn $query;\n\n}\n\n/**********************\n\t * Date: 25.02.2025\n\t * Code Added by: Mr. Ananath HariHaran\n\t * Description: Adding Task in Manager Login\n\t * ***********/\nfunction get_task_type(){\n\n\t$this->db->select(\'*\');\n \t\t//$this->db->where(\'aid\',$id);\n  \t\t$query = $this->db->get(\'task_type\')->result_array();\n\t\t//  print_r($this->db->last_query()); exit;  \n     \t return $query; \n}\n\nfunction get_employee_Task($empId){\n  \n\t$this->db->select(\'*\');\n\t$this->db->where_in(\'UserTasks_Details.emp_id\',$empId);      \n\t$query = $this->db->get(\'UserTasks_Details\')->result_array();\n\t // print_r($this->db->last_query()); exit;\n\treturn $query;\t\n\n} \npublic function checkAssignedTaskType($emp_id){\n\t$this->db->select(\'*\');\n\t$this->db->where(\'emp_id\', $emp_id);\n\t$this->db->where(\'flag\', 0);\n\t$query = $this->db->get(\'UserTasks_Details\'); \n\treturn $query->result_array();\n}\n\npublic function get_task_list_by_id($taskIds) {\n    // Make sure taskIds is not empty\n    if (!empty($taskIds)) {\n        // Fetch task details where the task ID is in the provided array\n        $this->db->where_in(\'id\', $taskIds);\n        $query = $this->db->get(\'dep_task\'); // Replace \'tasks_table\' with your actual table name\n        return $query->result_array(); // Return an array of task details\n    }\n    // print_r($this->db->last_query()); exit;\n    return []; // Return an empty array if no task IDs are provided\n\n}\n\n\npublic function get_activity_list_by_id($actvityIds) {\n    // Make sure taskIds is not empty\n    if (!empty($actvityIds)) {\n        // Fetch task details where the task ID is in the provided array\n        $this->db->where_in(\'aid\', $actvityIds);\n        $query = $this->db->get(\'activity_det\'); // Replace \'tasks_table\' with your actual table name\n        return $query->result_array(); // Return an array of task details\n    }\n    return []; // Return an empty array if no task IDs are provided\n}\n\n /***************\n  * Code Added by MuthuKumar for Tickets\n  * \n  * *************/\n\n public function get_ticket_types()\n\t{\n\t\t$query = $this->db->select(\'id, description\')->from(\'ticket_types\')->where(\'status\', 1)->get();\n\t\treturn $query->result_array();\n\t}\n\tpublic function get_ticket_priority()\n\t{\n\t\t$query = $this->db->select(\'id, description\')->from(\'ticket_priority\')->where(\'status\', 1)->get();\n\t\treturn $query->result_array();\n\t}\n\tpublic function get_ticket_status()\n\t{\n\t\t$query = $this->db->select(\'id, description\')->from(\'ticket_status\')->where(\'status\', 1)->get();\n\t\treturn $query->result_array();\n\t}\n\n\tpublic function get_tickets($e_id, $status = null, $is_received = false)\n\t{\n\t\tif (empty($e_id)) {\n\t\t\treturn [];\n\t\t}\n\n\t\t$this->db->select(\'tickets.*\');\n\t\t$this->db->select(\'emp.emp_name as raised_by_name\');\n\t\t$this->db->join(\'employee_det as emp\', \'emp.id = tickets.raised_by\', \'left\');\n\n\t\tif (is_array($e_id)) {\n\t\t\tif ($is_received) {\n\t\t\t\t$this->db->where_in(\'tickets.raised_to\', $e_id);\n\t\t\t} else {\n\t\t\t\t$this->db->where_in(\'tickets.raised_by\', $e_id);\n\t\t\t}\n\t\t} else {\n\t\t\tif ($is_received) {\n\t\t\t\t$this->db->where(\'tickets.raised_to\', $e_id);\n\t\t\t} else {\n\t\t\t\t$this->db->where(\'tickets.raised_by\', $e_id);\n\t\t\t}\n\t\t}\n\n\t\tif ($status !== null) {\n\t\t\t$this->db->where(\'tickets.status\', $status);\n\t\t}\n\n\t\t$this->db->order_by(\'tickets.created_at\', \'DESC\');\n\t\t$query = $this->db->get(\'tickets as tickets\');\n\n\t\treturn $query->result_array();\n\t}\n\n\tpublic function get_team_task_performance($teamMemberIds, $employeeId = null)\n\t{\n\t\tif (empty($teamMemberIds)) {\n\t\t\treturn [\n\t\t\t\t\'completed\' => 0,\n\t\t\t\t\'pending\' => 0,\n\t\t\t\t\'calledoff\' => 0,\n\t\t\t\t\'total\' => 0\n\t\t\t];\n\t\t}\n\n\t\t$this->db->select("SUM(CASE WHEN status = \'1\' THEN 1 ELSE 0 END) AS completed");\n\t\t$this->db->select("SUM(CASE WHEN status = \'0\' THEN 1 ELSE 0 END) AS pending");\n\t\t$this->db->select("SUM(CASE WHEN status = \'2\' THEN 1 ELSE 0 END) AS calledoff");\n\t\t\n\t\tif (!empty($employeeId) && $employeeId != 0) {\n\t\t\t$this->db->where(\'e_id\', $employeeId);\n\t\t} else {\n\t\t\t$this->db->where_in(\'e_id\', $teamMemberIds);\n\t\t}\n\n\t\t$query = $this->db->get(\'task_details\')->row_array();\n\n\t\t$completed = (int)($query[\'completed\'] ?? 0);\n\t\t$pending = (int)($query[\'pending\'] ?? 0);\n\t\t$calledoff = (int)($query[\'calledoff\'] ?? 0);\n\t\t$total = $completed + $pending + $calledoff;\n\n\t\treturn [\n\t\t\t\'completed\' => $completed,\n\t\t\t\'pending\' => $pending,\n\t\t\t\'calledoff\' => $calledoff,\n\t\t\t\'total\' => $total\n\t\t];\n\t}\n\n\tpublic function get_task_details_list($e_ids, $status = null)\n\t{\n\t\tif (empty($e_ids)) {\n\t\t\treturn [];\n\t\t}\n\n\t\t$this->db->select(\'task.*\');\n\t\t$this->db->select(\'employee_det.emp_id, employee_det.emp_name, employee_det.department, employee_det.designation\');\n\t\t$this->db->select(\'department_det.department_name\');\n\t\t$this->db->select(\'dep_task.task_list\');\n\t\t$this->db->select(\'activity_det.activity_list\');\n\t\t$this->db->select(\'project_det.project_name as pname\');\n\t\t$this->db->select(\'tickets.ticket_id as t_ticket_id, tickets.title as ticket_title\');\n\n\t\t$this->db->join(\'tickets\', \'tickets.id = task.ticket_id\', \'left\');\n\t\t$this->db->join(\'project_det\', \'project_det.pid = task.project_name\', \'left\');\n\t\t$this->db->join(\'employee_det\', \'employee_det.id = task.e_id\', \'left\');\n\t\t$this->db->join(\'department_det\', \'department_det.id = employee_det.department\', \'left\');\n\t\t$this->db->join(\'dep_task\', \'dep_task.id = task.dep_task_id\', \'left\');\n\t\t$this->db->join(\'activity_det\', \'activity_det.aid = task.activity_id\', \'left\');\n\n\t\tif (is_array($e_ids)) {\n\t\t\t$this->db->where_in(\'task.e_id\', $e_ids);\n\t\t} else {\n\t\t\t$this->db->where(\'task.e_id\', $e_ids);\n\t\t}\n\n\t\tif ($status !== null) {\n\t\t\t$this->db->where(\'task.status\', $status);\n\t\t}\n\n\t\t$this->db->order_by(\'task.created_date\', \'DESC\');\n\t\treturn $this->db->get(\'task_details as task\')->result_array();\n\t}\n\tpublic function get_my_ticket_count($emp_id, $status, $today = false)\n{\n    $this->db->select("COUNT(*) AS total");\n    $this->db->where(\'raised_by\', $emp_id);\n    $this->db->where(\'status\', $status);\n\n    if ($today) {\n        $this->db->where(\'DATE(created_at)\', date(\'Y-m-d\')); // Add filter for today\'s date\n    }\n\n    $query = $this->db->get(\'tickets\')->row_array();\n\n    return isset($query[\'total\']) ? (int) $query[\'total\'] : 0;\n}\n\n\tpublic function get_received_ticket_count($emp_id, $status,$today = false)\n\t{\n\t\t$this->db->select("COUNT(*) AS total");\n\t\t$this->db->where(\'raised_to\', $emp_id);\n\t\t$this->db->where(\'status\', $status);\n\t\tif ($today) {\n\t\t\t$this->db->where(\'DATE(created_at)\', date(\'Y-m-d\')); // Add filter for today\'s date\n\t\t}\n\n\t\t$query = $this->db->get(\'tickets\')->row_array();\n\n\t\treturn isset($query[\'total\']) ? (int) $query[\'total\'] : 0;\n\t}\n\tpublic function get_employees_ticket_count($emp_id, $status,$today = false)\n\t{\n\t\t$this->db->select("COUNT(*) AS total");\n\t\t// $this->db->where(\'raised_to\', $emp_id);\n\t\t$this->db->where(\'status\', $status);\n\t\tif ($today) {\n\t\t\t$this->db->where(\'DATE(created_at)\', date(\'Y-m-d\')); // Add filter for today\'s date\n\t\t}\n\n\t\t$query = $this->db->get(\'tickets\')->row_array();\n\n\t\treturn isset($query[\'total\']) ? (int) $query[\'total\'] : 0;\n\t}\n\tpublic function get_team_ticket_count($emp_ids, $status,$today = false)\n\t{\n\t\tif (empty($emp_ids)) {\n\t\t\treturn 0; // No team members, so no tickets to count\n\t\t}\n\n\t\t$this->db->select("COUNT(*) AS total");\n\t\t$this->db->where_in(\'raised_by\', $emp_ids);\n\t\t$this->db->where(\'status\', $status);\n\n\t\tif ($today) {\n\t\t\t$this->db->where(\'DATE(created_at)\', date(\'Y-m-d\')); // Add filter for today\'s date\n\t\t}\n\t\t$query = $this->db->get(\'tickets\')->row_array();\n\n\t\treturn isset($query[\'total\']) ? (int) $query[\'total\'] : 0;\n\t}\n\n\tfunction get_all_employees()\n\t{\n\n\n\t\t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.work_loc\');/*emp.desg_date\');*/\n\t\t// $this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t\t// $this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\n\t\t$this->db->where(\'emp.status\', 1);\n\t\t$this->db->order_by(\'emp.emp_name\', \'ASC\');\n\t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t//echo $this->db->last_query(); exit;\n\t\treturn $query;\n\n\t}\n\tpublic function get_management_users()\n\t{\n\t\t$array = array(\'INETMASTER\');\n\t\t$array_dep = array(\'1\',\'21\',\'9\',\'7\');\n \t\t$this->db->where_in(\'department\', $array_dep);\n \t\t$this->db->where_not_in(\'emp_id\', $array);\n \t\t$this->db->where(\'role_type\', 1);\n \t\t$this->db->where(\'status\', 1); // Only active employees\n \t\t$query = $this->db->get(\'employee_det\')->result_array();\n\t\t// echo $this->db->last_query(); exit;\n\t\treturn $query; \n\t}\n\n\tpublic function get_management_members($department, $emp_id)\n\t{\n\t\t$this->db->where(\'department\', $department);\n\t\t$this->db->where(\'emp_id !=\', $emp_id); // Exclude the logged-in user\n\t\t$this->db->where(\'status\', 1); // Only active employees\n\t\t$query = $this->db->get(\'employee_det\'); // Replace with your table name\n\t\treturn $query->result_array();\n\t}\n\n\tpublic function get_tickets_export($status, $emp_id)\n\t{\n\t\t$this->db->select(\'ticket_id, raised_by, raised_to, ticket_type, user_priority, admin_priority, description, title, status, created_at, updated_at\');\n\t\t$this->db->where(\'status\', $status);\n\t\t$this->db->where(\'raised_to\', $emp_id);\n\t\t$query = $this->db->get(\'tickets\')->result_array();\n\n\t\treturn $query;\n\t}\n\n\n\tpublic function update_ticket_status($ticket_id, $data)\n\t{\n\t\t// Use CodeIgniter\'s Query Builder to update the ticket\n\t\t$this->db->where(\'ticket_id\', $ticket_id);\n\t\t$res = $this->db->update(\'tickets\', $data); // \'tickets\' is the table name\n\n\t\t// Auto sync ticket to pending task\n\t\t$ticket = $this->db->select(\'id\')->get_where(\'tickets\', array(\'ticket_id\' => $ticket_id))->row_array();\n\t\tif ($ticket) {\n\t\t\t$this->sync_ticket_to_pending_task($ticket[\'id\']);\n\t\t}\n\n\t\treturn $res;\n\t}\n\n\n\tfunction getempName($did)\n\t{\n\t\t$this->db->select(\'emp.emp_name\');\n\t\t$this->db->from(\'employee_det as emp\');\n\t\t$this->db->where(\'emp.id\', $did);\n\t\t$query = $this->db->get();\n\n\t\t// Log the employee ID being queried\n\t\terror_log("Querying employee name for ID: " . $did);\n\n\t\t// Return a single employee object if found\n\t\tif ($query->num_rows() > 0) {\n\t\t\t$employee = $query->row();\n\t\t\terror_log("Employee found: " . $employee->emp_name); // Log the found employee name\n\t\t\treturn $employee;\n\t\t}\n\n\t\terror_log("No employee found for ID: " . $did); // Log if no employee is found\n\t\treturn null; // Return null if no employee found\n\t}\n\tfunction getempDept($did)\n\t{\n\t\t$this->db->select(\'emp.department\');\n\t\t$this->db->from(\'employee_det as emp\');\n\t\t$this->db->where(\'emp.id\', $did);\n\t\t$query = $this->db->get();\n\n\t\t// Log the employee ID being queried\n\t\terror_log("Querying employee Department for ID: " . $did);\n\n\t\t// Return a single employee object if found\n\t\tif ($query->num_rows() > 0) {\n\t\t\t$employee = $query->row();\n\t\t\terror_log("Employee found: " . $employee->department); // Log the found employee name\n\t\t\treturn $employee;\n\t\t}\n\n\t\terror_log("No employee found for ID: " . $did); // Log if no employee is found\n\t\treturn null; // Return null if no employee found\n\t}\n\tpublic function get_manager_id_by_emp_id($emp_id)\n\t{\n\t\t$this->db->select(\'mid\'); // Select only the manager ID\n\t\t$this->db->from(\'managers\');\n\t\t$this->db->where(\'emp_id\', $emp_id); // Match with the employee ID\n\t\t$query = $this->db->get();\n\n\t\tif ($query->num_rows() > 0) {\n\t\t\treturn $query->row()->mid; // Return the manager ID\n\t\t}\n\t\treturn null; // Return null if not found\n\t}\n\tpublic function get_manager_id_by_task_id($emp_id)\n\t{\n\t\t$this->db->select(\'*\'); // Select only the manager ID\n \t\t$this->db->where(\'id\', $emp_id); // Match with the employee ID\n\t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\treturn $query;\n\t}\n\tpublic function get_team_members($managerId)\n\t{\n\t\t$this->db->select(\'emp.id, emp.emp_id, emp.emp_name, emp.mob_no, emp.email_id, emp.department, emp.designation, emp.report_mgr_id, emp.join_dt, emp.work_loc\');\n\t\t$this->db->select(\'managers.mid, managers.emp_name as reprt_mger_name\');\n\t\t$this->db->join(\'managers\', \'managers.mid = emp.report_mgr_id\', \'left\');\n\t\t$this->db->where(\'emp.role_type\', 3);\n\t\t$this->db->where(\'emp.status\', 1);\n\t\t// Filter by the provided manager ID\n\t\t$this->db->where(\'emp.report_mgr_id\', $managerId);\n\t\t$this->db->order_by(\'emp.emp_id\', \'ASC\');\n\n\t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t//print_r($this->db->last_query()); exit; \n\n\t\treturn $query;\n\t}\n\n\tpublic function ticket_counting_get_team_members($managerId)\n\t{\n\t\t// Selecting only the necessary fields to get employee IDs\n\t\t$this->db->select(\'emp.emp_id\'); // Get only emp_id for ticket counting\n\t\t$this->db->from(\'employee_det as emp\');\n\t\t$this->db->where(\'emp.role_type\', 3); // Assuming role_type 3 means normal employee\n\t\t$this->db->where(\'emp.status\', 1); // Only active employees\n\t\t$this->db->where(\'emp.report_mgr_id\', $managerId); // Filter by manager ID\n\t\t$this->db->order_by(\'emp.emp_id\', \'ASC\');\n\n\t\t$query = $this->db->get()->result_array();\n\n\t\t// Extracting emp_id into a simple array\n\t\treturn array_column($query, \'emp_id\'); // Return only emp_id for counting\n\t}\n\n\tpublic function get_all_tasks() {\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t\t// echo"<pre>array";print_r($dept);exit;\t \n\t\t$this->db->select(\'dt.*\'); \n\t\t$this->db->where(\'dt.department\',$user_det[\'department\']); \n\t\t// $this->db->where(\'dt.status\',1); \n \t\t$query = $this->db->get(\'dep_task as dt\')->result_array();\n\t\t// print_r($this->db->last_query()); exit; \n\t\treturn $query; \n\t\t \n\t}\n \n\tpublic function get_all_activity() {\n\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t\t// echo"<pre>array";print_r($dept);exit;\t \n\t\t$this->db->select(\'ad.*\'); \n\t\t$this->db->where(\'ad.department\',$user_det[\'department\']); \n\t\t// $this->db->where(\'ad.status\',1); \n \t\t$query = $this->db->get(\'activity_det as ad\')->result_array();\n\t\t// print_r($this->db->last_query()); exit; \n\t\treturn $query; \n \n\t}\n\n\tfunction get_employees_by_department($department_id)\n\t{\n\t\t// Exclude certain employee IDs, e.g., INETMASTER\n\t\t$mas = array(\'INETMASTER\');\n\t\t\n\t\t// Select distinct employees\n\t\t$this->db->distinct();\n\t\t\n\t\t// Select the necessary fields\n\t\t$this->db->select(\'emp.emp_name, emp.department as department_id, emp.id as e_id, emp.emp_id\');\n\t\t$this->db->select(\'department_det.id, department_det.department_name as department\');\n\t\t\n\t\t// Join the department table with the employee table on the correct department field\n\t\t$this->db->join(\'department_det\', \'department_det.id = emp.department\', \'left\');\n\t\t\n\t\t// Filter employees by the department ID passed to the function\n\t\t$this->db->where(\'emp.department\', $department_id);\n\n\t\t// Only active employees\n\t\t$this->db->where(\'emp.status\', 1);\n\t\t\n\t\t// Exclude specific employees (like INETMASTER)\n\t\t$this->db->where_not_in(\'emp.emp_id\', $mas);\n\t\t\n\t\t// Order the employees by their name\n\t\t$this->db->order_by(\'emp.emp_name ASC\');\n\t\t\n\t\t// Execute the query and return the results\n\t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\n\t\t\n\t\t // print_r($this->db->last_query()); exit;\n\t\treturn $query;\n\t}\n /****************\n  * 15.05.2025\n  * Ananth Hariharan\n  * Project Leave Request Form\n  * ************/\n\n\n \tfunction get_project_Approvals(){\n\n\t\t$this->db->select(\'pro.pid,pro.project_name,pro.status\');\n\t\t$this->db->where(\'pro.df\',0);\n\t\t$this->db->where(\'pro.status\',0);\n\t\t$this->db->order_by(\'pro.project_name ASC\');\n\n\t\t$query = $this->db->get(\'project_det as pro\')->result_array();\n\t\t// print_r($this->db->last_query()); exit; \n\t\t $groupedItems = [];\n\t\t if (!empty($query)) {\n            foreach ($query as $row) {\n                $groupedItems[$row[\'status\']][] = $row[\'pid\'].\'~\'.$row[\'project_name\'];\n            }\n        }\n\n        // echo "<pre>Itema"; print_r($groupedItems); exit;\n\t\treturn $groupedItems; \n\t \n      }\nfunction getmanagement_manager () {\n    $mas = array(\'INETMASTER\');\n    \n    $this->db->select(\'distinct(emp.emp_name) as emp_name, emp.department, emp.id as e_id, emp.emp_id, emp.designation\');\n    $this->db->select(\'department_det.id, department_det.department_name as department\'); \n    $this->db->join(\'department_det\', \'department_det.id = emp.department\', \'left\'); \n    $this->db->where_not_in(\'emp.emp_id\', $mas);\n    $this->db->where_in(\'emp.role_type\', array(\'1\', \'2\')); // Filter for management and manager\n    $this->db->where(\'emp.status\', 1); // Only active employees\n    $this->db->order_by(\'emp.emp_name ASC\');\n    \n    $query = $this->db->get(\'employee_det as emp\')->result_array();\n    return $query;\n}\n\npublic function get_project_task_reports($emp_id, $inps = [])\n\t{\n\t\t// Get manager\'s internal ID (mid) using emp_id\n\t\t$this->db->select(\'mid\');\n\t\t$this->db->from(\'managers\');\n\t\t$this->db->where(\'emp_id\', $emp_id);\n\t\t$query = $this->db->get()->result_array();\n\n\t\tif (empty($query)) {\n\t\t\treturn []; // Manager not found\n\t\t}\n\n\t\t$mid = $query[0][\'mid\'];\n\t\t\n\n\t\t// Now build the report query\n\t\t$this->db->select(\'iet.*, ed.emp_name AS employee_name, ed2.emp_name AS assigned_by_name, pd.project_name AS approval_projectname\');\n\t\t$this->db->from(\'LeaveProjectRequest_Form AS iet\');\n\t\t$this->db->join(\'employee_det AS ed\', \'ed.id = iet.emp_id\', \'left\');\n\t\t$this->db->join(\'employee_det AS ed2\', \'ed2.id = iet.assigned_by\', \'left\');\n\t\t// $this->db->join(\'employee_det AS ed3\', \'ed3.id = iet.assigned_by\', \'left\');\n\t\t$this->db->join(\'project_det AS pd\', \'pd.pid = iet.project_name\', \'left\');\n\t\t$this->db->where(\'iet.rm_id\', $mid);\n\t\t// $this->db->order_by(\'slpno\', \'DESC\');\n\n\t\t// Apply filters here \n\t\t\n\t\tif (!empty($inps)) {\n\n\t\t\tif (!empty($inps[\'from_date\']) && !empty($inps[\'to_date\'])) {\n\t\t\t\t$from_date = date(\'Y-m-d\', strtotime($inps[\'from_date\']));\n\t\t\t\t$to_date = date(\'Y-m-d\', strtotime($inps[\'to_date\']));\n\n\t\t\t\t// Generalized logic depending on your use-case\n\t\t\t\t$this->db->group_start(); // start ( ... OR ... OR ... )\n\t\t\t\t\t$this->db->where("DATE(iet.from_date) >=", $from_date);\n\t\t\t\t\t$this->db->where("DATE(iet.to_date) <=", $to_date);\n\t\t\t\t\t$this->db->group_end(); // \n\n\t\t\t\t// $this->db->or_group_start();\n\t\t\t\t// \t$this->db->where("DATE(iet.onduty_from_date) >=", $from_date);\n\t\t\t\t// \t$this->db->where("DATE(iet.onduty_to_date) <=", $to_date);\n\t\t\t\t// \t$this->db->group_end(); // \n\t\t\t\t// $this->db->or_group_start();\n\t\t\t\t// \t$this->db->where("DATE(iet.leave_from_date) >=", $from_date);\n\t\t\t\t// \t$this->db->where("DATE(iet.leave_to_date) \t<=", $to_date);\n\t\t\t\t// $this->db->group_end(); // end OR group\n\n\t\t\t} else {\n\n\n\t\t\t\t\t$today = date(\'Y-m-d\'); \n\t\t\t\t\t// Add current-date check group\n\t\t\t\t\t$this->db->group_start();\n\t\t\t\t\t\t$this->db->or_group_start();\n\t\t\t\t\t\t\t$this->db->where("DATE(iet.from_date) <=", $today);\n\t\t\t\t\t\t\t$this->db->where("DATE(iet.to_date) >=", $today);\n\t\t\t\t\t\t$this->db->group_end();\n\n\t\t\t\t\t// \t$this->db->or_group_start();\n\t\t\t\t\t// \t\t$this->db->where("DATE(iet.onduty_from_date) <=", $today);\n\t\t\t\t\t// \t\t$this->db->where("DATE(iet.onduty_to_date) >=", $today);\n\t\t\t\t\t// \t$this->db->group_end();\n\n\t\t\t\t\t// \t$this->db->or_group_start();\n\t\t\t\t\t// \t\t$this->db->where("DATE(iet.leave_from_date) <=", $today);\n\t\t\t\t\t// \t\t$this->db->where("DATE(iet.leave_to_date) >=", $today);\n\t\t\t\t\t// \t$this->db->group_end();\n\t\t\t\t\t// $this->db->group_end();\n\t\t\t}\n\n\t\t\tif (($inps[\'entry_type\']!="")) {\n\t\t\t\t$this->db->where(\'iet.entry_type\', $inps[\'entry_type\']);\n\t\t\t}\n\n\t\t\tif (!empty($inps[\'Empname\']) && $inps[\'Empname\'] != "0") {\n\t\t\t\t$this->db->where(\'iet.emp_id\', $inps[\'Empname\']);\n\t\t\t}\n\n\t\t\tif (isset($inps[\'status\']) && $inps[\'status\'] != \'all\') {\n\t\t\t\t$this->db->where(\'iet.status\', $inps[\'status\']);\n\t\t\t}\n\t\t}\n\n\n\t\t\t$result = $this->db->get()->result_array();\n\t\t\t //print_r($this->db->last_query()); exit;\n\t\t\treturn $result;\n\t}\n\n\n\t//get_edit_delete Function (Anantha Hariharan V)\n\tpublic function get_edit_delete($id, $inps)\n\t{\n\n\n\t\t$this->db->select(\'task.*, ed.emp_name as Emp_Name, ed1.emp_name as Assigned_By, activity_det.activity_list, dep_task.task_list, task_type.task_name\');\n\t\t$this->db->from(\'UserTasks_Details as task\');\n\n\t\t$this->db->join(\'employee_det as ed\', \'ed.id = task.emp_id\', \'left\'); // Task receiver\n\t\t$this->db->join(\'employee_det as ed1\', \'ed1.id = task.assigned_by\', \'left\'); // Assigner\n\t\t$this->db->join(\'activity_det\', \'activity_det.aid = task.activity\', \'left\');\n\t\t$this->db->join(\'dep_task\', \'dep_task.id = task.task\', \'left\');\n\t\t$this->db->join(\'task_type\', \'task_type.s_no = task.task_name\', \'left\');\n\n\t\t//  Filter only team members from same department\n\t\t $this->db->where(\'task.assigned_by\', $id);\n\n\t\t// ?? Filter by selected employee ID from filter input\n\t\tif (isset($inps) && !empty($inps)) {\n\t\t\tif ($inps == "all") {\n\t\t\t\t// No filter, fetch all tasks\n\t\t\t} else {\n\t\t\t\tif (!empty($inps[\'emp_id\']) && $inps[\'emp_id\'] != "0") {\n\t\t\t\t\t$this->db->where(\'task.emp_id\', $inps[\'emp_id\']);\n\t\t\t\t}\n\n\t\t\t\t// OPTIONAL: You can also add filter by employee name\n\t\t\t\tif (!empty($inps[\'emp_name\'])) {\n\t\t\t\t\t$this->db->like(\'employee_det.emp_name\', $inps[\'emp_name\']); // partial match\n\t\t\t\t}\n\n\t\t\t\t// OPTIONAL: If no emp_id or emp_name, you can default to today�s data\n\t\t\t\tif (empty($inps[\'emp_id\']) && empty($inps[\'emp_name\'])) {\n\t\t\t\t\t$cur_dt = date("Y-m-d");\n\t\t\t\t\t$this->db->where("DATE(task.CreationDate)", $cur_dt);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\t// Always filter by logged-in user\'s department (if needed)\n\t\t// $this->db->where(\'employee_det.department\', $user_det[\'department\']);\n\n\t\t$query = $this->db->get()->result_array();\n\t\t // print_r($this->db->last_query()); exit; \n\t\treturn $query;\n\t}\n\n\n\n\n public function get_my_request_reports($emp_id,$inps = []) {\n\n    $this->db->select(\'iet.*, ed.emp_name AS employee_name, ed2.emp_name AS assigned_by_name, pd.project_name AS approval_projectname\');\n    $this->db->from(\'LeaveProjectRequest_Form AS iet\');\n    $this->db->join(\'employee_det AS ed\', \'ed.id = iet.emp_id\', \'left\');\n    $this->db->join(\'employee_det AS ed2\', \'ed2.id = iet.assigned_by\', \'left\');\n    // $this->db->join(\'employee_det AS ed3\', \'ed3.id = iet.duty_assigned_by\', \'left\');\n    $this->db->join(\'project_det AS pd\', \'pd.pid = iet.project_name\', \'left\');\n    $this->db->where(\'iet.emp_id\',$emp_id); \n\n\n\n    \t$result = $this->db->get()->result_array(); // gets all matching rows\n    \t// print_r($this->db->last_query()); exit;\n    \treturn $result;\n\t}\n\nfunction get_team_daily_time_sheet($emp, $inps)\n\t\t\t\t{\n\t\t\t\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\n\t\t\t\t\t// Set selected date\n\t\t\t\t\t$selected_date = isset($inps[\'selected_date\']) && !empty($inps[\'selected_date\']) \n\t\t\t\t\t\t? $inps[\'selected_date\'] \n\t\t\t\t\t\t: date("Y-m-d");\n\n\t\t\t\t\t// Optional employee filter\n\t\t\t\t\tif (!empty($inps[\'employee_id\'])) {\n\t\t\t\t\t\t$this->db->where(\'LeaveProjectRequest_Form.emp_id\', $inps[\'employee_id\']);\n\t\t\t\t\t}\n\n\t\t\t\t\t// Join to get department info\n\t\t\t\t\t$this->db->select(\'LeaveProjectRequest_Form.*, project_det.project_name as pname, ed.emp_name AS employee_name, ed2.emp_name as assigned_by_name\');\n\t\t\t\t\t$this->db->from(\'LeaveProjectRequest_Form\');\n\t\t\t\t\t$this->db->join(\'project_det\', \'project_det.pid = LeaveProjectRequest_Form.project_name\', \'left\');\n\t\t\t\t\t$this->db->join(\'employee_det AS ed\', \'ed.id = LeaveProjectRequest_Form.emp_id\', \'left\');\n\t\t\t\t\t$this->db->join(\'employee_det AS ed2\', \'ed2.id = LeaveProjectRequest_Form.assigned_by\', \'left\');\n\n\t\t\t\t\t// Filter by same department — active employees only\n\t\t\t\t\t$this->db->where(\'ed.department\', $employee_det[\'department\']);\n\t\t\t\t\t$this->db->where(\'ed.role_type !=\', \'2\'); // Correct use\n\t\t\t\t\t$this->db->where(\'ed.status\', 1); // Only active employees\n\n\n\t\t\t\t\t// Date condition match for leave/onduty/project\n\t\t\t\t\t$this->db->where("(\'$selected_date\' BETWEEN LeaveProjectRequest_Form.from_date AND LeaveProjectRequest_Form.to_date)", null, false);\n\n\t\t\t\t\t$query1 = $this->db->get();\n\n\t\t\t\t\tif ($query1->num_rows() > 0) {\n\t\t\t\t\t\treturn $query1->result_array();\n\t\t\t\t\t} else {\n\t\t\t\t\t\t// Fallback to task_details if no leave/onduty/project\n\t\t\t\t\t\t$this->db->select(\'task.*, employee_det.emp_name, dep_task.task_list, activity_det.activity_list, project_det.project_name as pname\');\n\t\t\t\t\t\t$this->db->from(\'task_details as task\');\n\t\t\t\t\t\t$this->db->join(\'project_det\', \'project_det.pid = task.project_name\', \'left\');\n\t\t\t\t\t\t$this->db->join(\'employee_det\', \'employee_det.id = task.e_id\', \'left\');\n\t\t\t\t\t\t$this->db->join(\'dep_task\', \'dep_task.id = task.dep_task_id\', \'left\');\n\t\t\t\t\t\t$this->db->join(\'activity_det\', \'activity_det.aid = task.activity_id\', \'left\');\n\n\t\t\t\t\t\t$this->db->where("DATE_FORMAT(task.created_date, \'%Y-%m-%d\') =", $selected_date);\n\n\t\t\t\t\t\t// Optional employee filter\n\t\t\t\t\t\tif (!empty($inps[\'employee_id\'])) {\n\t\t\t\t\t\t\t$this->db->where("task.e_id", $inps[\'employee_id\']);\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\t// Department-based filtering — active employees only\n\t\t\t\t\t\t$this->db->where(\'employee_det.department\', $employee_det[\'department\']);\n\t\t\t\t\t\t$this->db->where(\'employee_det.role_type !=\', \'2\'); // Correct use\n\t\t\t\t\t\t$this->db->where(\'employee_det.status\', 1); // Only active employees\n\n\n\t\t\t\t\t\t$query = $this->db->get();\n\t\t\t\t\t\t// echo $this->db->$query(); exit;\n\t\t\t\t\t\treturn $query->result_array();\n\t\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t}\n\n\tfunction get_calledoff_count ()\n\t{\n\t\t$today = date("Y-m-d");\n\n\t\t $empdet_id = $this->session->userdata(\'logged_in\')[\'empdet_id\'];\n\t\t$this->db->where(\'status\',2);\n\t\t//$this->db->where("DATE(\'$today\') BETWEEN DATE(created_date) AND DATE(updated_date)", null, false);\n\t\t$this->db->where("e_id", $empdet_id);\n\t    $calledoff_count = $this->db->count_all_results(\'task_details\');\n\t\t// echo $this->db->last_query(); exit;\n        return $calledoff_count;\n\t}\n\t\t\t\n\n\tpublic function get_additional_tasks_notifier($additional_id)\n\t{\n\t\t// echo "<pre>-------task_id"; print_r($additional_id); exit;\n\t\t$this->db->select(\'*\');\n\t\t$this->db->from(\'additional_task_details\');\n\t\t$this->db->where(\'id\',$additional_id);\n\t\t$result = $this->db->get()->result_array();\t\n\t\t// print_r($this->db->last_query()); exit;\n\t\treturn $result;\n\t}\n\n\nfunction get_project_export()\n\t{\n\n\t\t$usrs = array(\'INETMASTER\',\'INET0001\',\'INET0002\'); \n\t\t$today = $current_day = date("Y-m-d");\n\t\t$this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.mob_no,emp.email_id,emp.department,emp.designation,emp.report_mgr_id,emp.join_dt,emp.work_loc\');/*emp.desg_date\');*/ \n\t\t$this->db->select(\'managers.mid,managers.emp_name as reprt_mger_name\'); \n\t\t$this->db->select(\'department_det.id,department_det.department_name as department\'); \n\t\t$this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n\t\t$this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\t     \n\t\t$this->db->where("emp.id IN (SELECT LeaveProjectRequest_Form.emp_id FROM LeaveProjectRequest_Form WHERE LeaveProjectRequest_Form.entry_type = 1 AND DATE(\'$today\') BETWEEN DATE(LeaveProjectRequest_Form.from_date) AND DATE(LeaveProjectRequest_Form.to_date))", null, false);     \n\t\t$this->db->where_not_in(\'emp.emp_id\',$usrs);\n\t\t$this->db->where(\'emp.status\', 1); // Only active employees\n\t\t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t\t// echo $this->db->last_query(); exit;\n\t\treturn $query;\n\t}\n\n \n\nfunction check_attendance_date_exists($date)\n{\n    $this->db->where(\'Date\', $date);\n    $query = $this->db->get(\'EmployeeAttendance\'); \n    return $query->num_rows() > 0;\n}\n\n public function insert_csv_data($data) {\n        // Ensure the table and column names match your DB \n\t\t\n    return $this->db->insert(\'EmployeeAttendance\', $data);\n\n    }\n\n public function get_attendance_data()\n    {\n        $this->db->order_by(\'EmployeeNo\')->order_by(\'Date\');\n        $query = $this->db->get(\'EmployeeAttendance\');\n //echo $this->db->last_query(); exit;\n\n        return $query->result_array();\n    }\n\n    public function getDistinctDates($start_date, $end_date)\n    {\n        $this->db->distinct();\n        $this->db->select(\'Date\');\n        $this->db->from(\'EmployeeAttendance\');\n        $this->db->where(\'Date >=\', $start_date);\n        $this->db->where(\'Date <=\', $end_date);\n        $this->db->order_by(\'Date\', \'ASC\');\n\n        $query = $this->db->get();\n \t//   echo $this->db->last_query(); exit;\n        return $query->result();\n    }\n/////////added by reka\nfunction get_not_submitted_by_date($date)\n{\n    $eid = array(\'INETMASTER\',\'INET0001\',\'INET0002\',\'INET0227\',\'INET0167\',\'INET0046\'); \n\n    $this->db->select(\'emp.id,emp.emp_id,emp.emp_name,emp.department,emp.designation\');\n    $this->db->select(\'department_det.department_name as department\');\n    $this->db->select(\'managers.emp_name as reprt_mger_name\');\n\n    $this->db->from(\'employee_det emp\');\n    $this->db->join(\'department_det\',\'department_det.id=emp.department\',\'left\');\n    $this->db->join(\'managers\',\'managers.mid=emp.report_mgr_id\',\'left\');\n\n    $this->db->where("emp.id NOT IN (\n        SELECT e_id FROM task_details \n        WHERE DATE(created_date) = \'$date\'\n    )", null, false);\n\n    $this->db->where_not_in(\'emp.emp_id\',$eid);\n    $this->db->where(\'emp.status\',1);\n\n    return $this->db->get()->result_array();\n}\n// public function insert_request($data)\n// {\n//     return $this->db->insert(\'requests\', $data);\n// }\npublic function insert_request($data)\n{\n    return $this->db->insert(\'req_purchase_form\', $data);\n}\n\n// public function update_stationery_summary($category, $subcategory, $quantity, $type = \'purchase\', $date = null)\n// {\n//     if(!$date) $date = date(\'Y-m-d\');\n    \n//     // Check if summary record exists for this date/category/subcategory\n//     $existing = $this->db->where(\'summary_date\', $date)\n//         ->where(\'category\', $category)\n//         ->where(\'subcategory\', $subcategory)\n//         ->get(\'stationery_summary\')\n//         ->row_array();\n    \n//     if($existing)\n//     {\n//         // Update existing record\n//         $update_data = [];\n//         if($type == \'purchase\')\n//         {\n//             $update_data[\'purchased_stock\'] = $existing[\'purchased_stock\'] + $quantity;\n//         }\n//         else if($type == \'consumption\')\n//         {\n//             $update_data[\'consumed_stock\'] = $existing[\'consumed_stock\'] + $quantity;\n//         }\n//         else if($type == \'request\')\n//         {\n//             $update_data[\'requested_stock\'] = $existing[\'requested_stock\'] + $quantity;\n//         }\n        \n//         // Recalculate closing stock\n//         $opening = $existing[\'opening_stock\'];\n//         $purchased = $update_data[\'purchased_stock\'] ?? $existing[\'purchased_stock\'];\n//         $consumed = $update_data[\'consumed_stock\'] ?? $existing[\'consumed_stock\'];\n//         $update_data[\'closing_stock\'] = $opening + $purchased - $consumed;\n        \n//         $this->db->where(\'summary_date\', $date)\n//             ->where(\'category\', $category)\n//             ->where(\'subcategory\', $subcategory)\n//             ->update(\'stationery_summary\', $update_data);\n//     }\n//     else\n//     {\n//         // Create new summary record\n//         $insert_data = [\n//             \'summary_date\' => $date,\n//             \'category\' => $category,\n//             \'subcategory\' => $subcategory,\n//             \'opening_stock\' => 0,\n//             \'requested_stock\' => ($type == \'request\') ? $quantity : 0,\n//             \'purchased_stock\' => ($type == \'purchase\') ? $quantity : 0,\n//             \'consumed_stock\' => ($type == \'consumption\') ? $quantity : 0,\n//             \'closing_stock\' => ($type == \'purchase\') ? $quantity : (($type == \'request\') ? 0 : (-$quantity)),\n//             \'created_at\' => date(\'Y-m-d H:i:s\')\n//         ];\n//         $this->db->insert(\'stationery_summary\', $insert_data);\n//     }\n// }\npublic function update_stationery_summary($category, $subcategory, $quantity, $type, $date, $biller_id = null)\n{\n    // Check if record exists for this category+subcategory+date+biller\n    $this->db->where(\'category\', $category);\n    $this->db->where(\'subcategory\', $subcategory);\n    $this->db->where(\'summary_date\', $date);\n    if($biller_id) {\n        $this->db->where(\'biller_id\', $biller_id);\n    } else {\n        $this->db->where(\'biller_id IS NULL\', null, false);\n    }\n    $existing = $this->db->get(\'stationery_summary\')->row_array();\n\n    if($existing)\n    {\n        $update = array();\n\n        if($type == \'purchase\') {\n            $new_purchased = $existing[\'purchased_stock\'] + $quantity;\n            $new_closing   = $existing[\'opening_stock\'] + $new_purchased - $existing[\'consumed_stock\'];\n            $update = array(\n                \'purchased_stock\' => $new_purchased,\n                \'closing_stock\'   => $new_closing\n            );\n        }\n        elseif($type == \'consumption\') {\n            $new_consumed = $existing[\'consumed_stock\'] + $quantity;\n            $new_closing  = $existing[\'opening_stock\'] + $existing[\'purchased_stock\'] - $new_consumed;\n            $update = array(\n                \'consumed_stock\' => $new_consumed,\n                \'closing_stock\'  => $new_closing\n            );\n        }\n\n        if(!empty($update)) {\n            $this->db->where(\'id\', $existing[\'id\']);\n            $this->db->update(\'stationery_summary\', $update);\n        }\n    }\n    else\n    {\n        // Calculate opening from existing_table base\n        $this->db->where(\'category\', $category);\n        $this->db->where(\'subcategory\', $subcategory);\n        $et = $this->db->get(\'existing_table\')->row();\n        $base_stock = $et ? $et->quantity : 0;\n\n        // Previous purchased from stationery_summary before this date\n        $this->db->select(\'SUM(purchased_stock) as total\');\n        $this->db->where(\'category\', $category);\n        $this->db->where(\'subcategory\', $subcategory);\n        $this->db->where(\'summary_date <\', $date);\n        $prev_purchased = $this->db->get(\'stationery_summary\')->row()->total;\n        $prev_purchased = $prev_purchased ? $prev_purchased : 0;\n\n        // Previous consumed from stationery_summary before this date\n        $this->db->select(\'SUM(consumed_stock) as total\');\n        $this->db->where(\'category\', $category);\n        $this->db->where(\'subcategory\', $subcategory);\n        $this->db->where(\'summary_date <\', $date);\n        $prev_consumed = $this->db->get(\'stationery_summary\')->row()->total;\n        $prev_consumed = $prev_consumed ? $prev_consumed : 0;\n\n        $opening = $base_stock + $prev_purchased - $prev_consumed;\n\n        $insert = array(\n            \'summary_date\'    => $date,\n            \'category\'        => $category,\n            \'subcategory\'     => $subcategory,\n            \'biller_id\'       => $biller_id,\n            \'opening_stock\'   => $opening,\n            \'purchased_stock\' => 0,\n            \'consumed_stock\'  => 0,\n            \'closing_stock\'   => $opening,\n            \'created_at\'      => date(\'Y-m-d H:i:s\')\n        );\n\n        if($type == \'purchase\') {\n            $insert[\'purchased_stock\'] = $quantity;\n            $insert[\'closing_stock\']   = $opening + $quantity;\n        }\n        elseif($type == \'consumption\') {\n            $insert[\'consumed_stock\'] = $quantity;\n            $insert[\'closing_stock\']  = $opening - $quantity;\n        }\n\n        $this->db->insert(\'stationery_summary\', $insert);\n    }\n}\npublic function get_stationery_categories()\n{\n    $this->db->select(\'category_name as category\');\n    $this->db->from(\'stat_category\');\n    $this->db->order_by(\'category_name\', \'ASC\');\n    return $this->db->get()->result_array();\n}\n\npublic function get_stationery_subcategories($category)\n{\n    $this->db->select(\'s.*\');\n    $this->db->from(\'stat_subcategory s\');\n    $this->db->join(\'stat_category c\', \'s.category_id = c.id\');\n    $this->db->where(\'c.category_name\', $category);\n    return $this->db->get()->result_array();\n}\n\npublic function get_all_stationery_categories()\n{\n    $this->db->select(\'c.category_name as category, s.subcategory_name as subcategory\');\n    $this->db->from(\'stat_category c\');\n    $this->db->join(\'stat_subcategory s\', \'s.category_id = c.id\', \'left\');\n    $this->db->order_by(\'c.category_name\', \'ASC\');\n    return $this->db->get()->result_array();\n}\n\npublic function get_categories()\n{\n    $this->db->select(\'id, category_name as category, hsn_code, gst_percent\');\n    $this->db->from(\'stat_category\');\n    $this->db->order_by(\'category_name\', \'ASC\');\n    return $this->db->get()->result_array();\n}\n\npublic function get_all_items()\n{\n    $this->db->select(\'c.id as cat_id, c.category_name as category, s.id as sub_id, s.subcategory_name as subcategory, c.gst_percent, c.hsn_code\');\n    $this->db->from(\'stat_category c\');\n    $this->db->join(\'stat_subcategory s\', \'s.category_id = c.id\');\n    $this->db->order_by(\'s.subcategory_name\', \'ASC\');\n    return $this->db->get()->result_array();\n}\npublic function get_global_notifications($employee_det)\n{\n    if (empty($employee_det)) {\n        return [];\n    }\n\n    $receiver_id = $employee_det[\'empdet_id\'];\n\n    if (isset($employee_det[\'role_type\']) &&\n        ($employee_det[\'role_type\'] == \'1\' || $employee_det[\'role_type\'] == \'2\'))\n    {\n        $this->db->select(\'mid\');\n        $this->db->where(\'emp_id\', $employee_det[\'emp_id\']);\n        $mgr = $this->db->get(\'managers\')->row_array();\n\n        if (!empty($mgr)) {\n            $receiver_id = $mgr[\'mid\'];\n        }\n    }\n\n    $notifications = $this->get_notifications_id($receiver_id);\n\n    $notifications_array = [];\n\n    if (!empty($notifications))\n    {\n        foreach ($notifications as $notification)\n        {\n            $notification_item = [\n                \'notification_id\'  => $notification[\'nid\'],\n                \'type\'             => $notification[\'type\'],\n                \'task_id\'          => $notification[\'task_id\'],\n                \'initiator_id\'     => $notification[\'initiator_id\'],\n                \'timestamp\'        => date(\'d-m-Y h:i A\', strtotime($notification[\'creation_date\'])),\n                \'is_acknowledged\'  => (bool)$notification[\'is_acknownledge\'],\n                \'header\'           => \'Notification\',\n                \'body\'             => \'\',\n                \'project\'          => \'\'\n            ];\n\n            $employeeName = $this->get_employee_name_by_id($notification[\'initiator_id\']);\n\n            $notification_item[\'initiator_name\'] =\n                !empty($employeeName) ? $employeeName : \'Unknown\';\n\n            switch ($notification[\'type\'])\n            {\n                case 3:\n\n                    $projectName = $this->get_project_name_by_id($notification[\'project_id\']);\n\n                    if (!empty($projectName))\n                    {\n                        $project = $projectName[0];\n\n                        $notification_item[\'header\'] =\n                            \'Project Approval Required\';\n\n                        $notification_item[\'body\'] =\n                            \'Please approve the project: <strong>\'\n                            .$project[\'project_name\'].\n                            \'</strong>\';\n\n                        $notification_item[\'project\'] =\n                            $project[\'project_name\'];\n\n                        $CI =& get_instance();\n\n                        $approve_url =\n                            $CI->config->item(\'base_url\')\n                            .\'admin/approve_project/\'\n                            .$project[\'pid\'].\'/\'\n                            .$notification[\'nid\'];\n\n                        $decline_url =\n                            $CI->config->item(\'base_url\')\n                            .\'admin/decline_project/\'\n                            .$project[\'pid\'].\'/\'\n                            .$notification[\'nid\'];\n\n                        // $notification_item[\'body\'] .=\n                        //     \'<br><a href="\'.$approve_url.\'"\n                        //     class="btn btn-sm btn-success mt-2"\n                        //     style="color:white;padding:2px 10px;margin-right:5px;">\n                        //     Approve Project</a>\';\n\n                        // $notification_item[\'body\'] .=\n                        //     \'<a href="\'.$decline_url.\'"\n                        //     class="btn btn-sm btn-danger mt-2"\n                        //     style="color:white;padding:2px 10px;">\n                        //     Decline Project</a>\';\n                    }\n\n                    break;\n\n                case 4:\n\n                    $projectName =\n                        $this->get_project_name_by_id($notification[\'project_id\']);\n\n                    if (!empty($projectName))\n                    {\n                        $project = $projectName[0];\n\n                        $notification_item[\'header\'] =\n                            \'Project Approved\';\n\n                        $notification_item[\'body\'] =\n                            \'Your project <strong>\'\n                            .$project[\'project_name\'].\n                            \'</strong> was approved.\';\n\n                        $notification_item[\'project\'] =\n                            $project[\'project_name\'];\n                    }\n\n                    break;\n\n                case 5:\n\n                    $projectName =\n                        $this->get_project_name_by_id($notification[\'project_id\']);\n\n                    if (!empty($projectName))\n                    {\n                        $project = $projectName[0];\n\n                        $notification_item[\'header\'] =\n                            \'Project Declined\';\n\n                        $notification_item[\'body\'] =\n                            \'Your project <strong>\'\n                            .$project[\'project_name\'].\n                            \'</strong> was declined.\';\n\n                        $notification_item[\'project\'] =\n                            $project[\'project_name\'];\n                    }\n\n                    break;\n\t\t\t\t\tcase 7:\n\n    $notification_item[\'header\'] =\n        \'Probation Assessment Submitted\';\n\n    $notification_item[\'body\'] =\n        $notification_item[\'initiator_name\'] .\n        \' has submitted a probation assessment.\';\n\n    break;\n            }\n\n            if (in_array($notification[\'type\'], [3,4,5,7])) {\n                $notifications_array[] = $notification_item;\n            }\n        }\n    }\n\n    return $notifications_array;\n}\n\n\tpublic function getBirthdayEmployees()\n\t{\n\t\t$this->db->select(\'emp.id, emp.emp_name, emp.designation, dept.department_name as department, emp.dob, emp.join_dt\');\n\t\t$this->db->from(\'employee_det as emp\');\n\t\t$this->db->join(\'department_det as dept\', \'dept.id = emp.department\', \'left\');\n\t\t$this->db->where(\'emp.status\', 1);\n\t\t$this->db->where(\'emp.dob IS NOT NULL\');\n\t\t$this->db->where(\'emp.dob !=\', \'0000-00-00\');\n\t\t$this->db->where(\'MONTH(emp.dob) = MONTH(CURDATE())\');\n\t\t$this->db->where(\'DAY(emp.dob) = DAY(CURDATE())\');\n\t\treturn $this->db->get()->result_array();\n\t}\n\n\tpublic function getWorkAnniversaryEmployees()\n\t{\n\t\t$date_expr = "CASE WHEN SUBSTRING(emp.join_dt, 3, 1) = \'-\' THEN STR_TO_DATE(emp.join_dt, \'%d-%m-%Y\') ELSE STR_TO_DATE(emp.join_dt, \'%Y-%m-%d\') END";\n\t\t\n\t\t$this->db->select(\'emp.id, emp.emp_name, emp.designation, dept.department_name as department, emp.dob, emp.join_dt\');\n\t\t$this->db->select("TIMESTAMPDIFF(YEAR, {$date_expr}, CURDATE()) as completed_years", FALSE);\n\t\t$this->db->from(\'employee_det as emp\');\n\t\t$this->db->join(\'department_det as dept\', \'dept.id = emp.department\', \'left\');\n\t\t$this->db->where(\'emp.status\', 1);\n\t\t$this->db->where(\'emp.join_dt IS NOT NULL\');\n\t\t$this->db->where("MONTH({$date_expr}) = MONTH(CURDATE())", NULL, FALSE);\n\t\t$this->db->where("DAY({$date_expr}) = DAY(CURDATE())", NULL, FALSE);\n\t\t$this->db->where("TIMESTAMPDIFF(YEAR, {$date_expr}, CURDATE()) >= 1", NULL, FALSE);\n\t\treturn $this->db->get()->result_array();\n\t}\n\n\tpublic function generateTodayCelebrationPosts()\n\t{\n\t\t// 1. Check today\'s birthdays\n\t\t$birthdays = $this->getBirthdayEmployees();\n\t\tforeach ($birthdays as $emp) {\n\t\t\t$this->db->where(\'employee_id\', $emp[\'id\']);\n\t\t\t$this->db->where(\'post_type\', \'birthday\');\n\t\t\t$this->db->where(\'event_date\', date(\'Y-m-d\'));\n\t\t\t$exists = $this->db->get(\'engage_posts\')->num_rows();\n\t\t\tif ($exists == 0) {\n\t\t\t\t$data = [\n\t\t\t\t\t\'employee_id\' => $emp[\'id\'],\n\t\t\t\t\t\'post_type\' => \'birthday\',\n\t\t\t\t\t\'title\' => "Happy Birthday " . $emp[\'emp_name\'] . "!",\n\t\t\t\t\t\'message\' => "Happy Birthday " . $emp[\'emp_name\'] . "!\\n\\nHave a wonderful year ahead.\\n\\nWishing you happiness, success and good health.",\n\t\t\t\t\t\'event_date\' => date(\'Y-m-d\'),\n\t\t\t\t\t\'created_by\' => \'SYSTEM\',\n\t\t\t\t\t\'status\' => 1\n\t\t\t\t];\n\t\t\t\t$this->db->insert(\'engage_posts\', $data);\n\t\t\t}\n\t\t}\n\n\t\t// 2. Check today\'s work anniversaries\n\t\t$anniversaries = $this->getWorkAnniversaryEmployees();\n\t\tforeach ($anniversaries as $emp) {\n\t\t\t$this->db->where(\'employee_id\', $emp[\'id\']);\n\t\t\t$this->db->where(\'post_type\', \'anniversary\');\n\t\t\t$this->db->where(\'event_date\', date(\'Y-m-d\'));\n\t\t\t$exists = $this->db->get(\'engage_posts\')->num_rows();\n\t\t\tif ($exists == 0) {\n\t\t\t\t$years = $emp[\'completed_years\'];\n\t\t\t\t$data = [\n\t\t\t\t\t\'employee_id\' => $emp[\'id\'],\n\t\t\t\t\t\'post_type\' => \'anniversary\',\n\t\t\t\t\t\'title\' => "Congratulations " . $emp[\'emp_name\'] . "!",\n\t\t\t\t\t\'message\' => "Congratulations " . $emp[\'emp_name\'] . "!\\n\\nCongratulations on completing " . $years . " successful year(s) with INET.\\n\\nThank you for your dedication and contribution.",\n\t\t\t\t\t\'event_date\' => date(\'Y-m-d\'),\n\t\t\t\t\t\'created_by\' => \'SYSTEM\',\n\t\t\t\t\t\'status\' => 1\n\t\t\t\t];\n\t\t\t\t$this->db->insert(\'engage_posts\', $data);\n\t\t\t}\n\t\t}\n\t}\n\n\tpublic function getEngageTimeline($current_employee_id)\n\t{\n\t\t// Fetch posts joined with dynamically pre-aggregated likes count and active-user liked status\n\t\t$this->db->select(\'p.*, e.emp_name, e.designation, d.department_name as department, COALESCE(l.likes_count, 0) as likes_count, COALESCE(ul.user_liked, 0) as user_liked\', FALSE);\n\t\t$this->db->from(\'engage_posts as p\');\n\t\t$this->db->join(\'employee_det as e\', \'e.id = p.employee_id\', \'left\');\n\t\t$this->db->join(\'department_det as d\', \'d.id = e.department\', \'left\');\n\t\t$this->db->join(\'(SELECT post_id, COUNT(*) as likes_count FROM engage_likes GROUP BY post_id) as l\', \'l.post_id = p.id\', \'left\');\n\t\t$this->db->join(\'(SELECT post_id, 1 as user_liked FROM engage_likes WHERE employee_id = \' . (int)$current_employee_id . \') as ul\', \'ul.post_id = p.id\', \'left\');\n\t\t$this->db->where(\'p.status\', 1);\n\t\t$this->db->where(\'p.event_date\', date(\'Y-m-d\'));\n\t\t$this->db->order_by(\'CASE WHEN p.post_type = \\\'birthday\\\' THEN 1 WHEN p.post_type = \\\'anniversary\\\' THEN 2 ELSE 3 END ASC, p.id DESC\', NULL, FALSE);\n\t\t\n\t\t$posts = $this->db->get()->result_array();\n\n\t\t// Future-proof display metadata configuration\n\t\t$post_meta = [\n\t\t\t\'birthday\' => [\'badge_class\' => \'bg-warning text-dark\', \'icon_class\' => \'bi-gift-fill\', \'label\' => \'Birthday\'],\n\t\t\t\'anniversary\' => [\'badge_class\' => \'bg-success text-white\', \'icon_class\' => \'bi-award-fill\', \'label\' => \'Work Anniversary\'],\n\t\t\t\'announcement\' => [\'badge_class\' => \'bg-primary text-white\', \'icon_class\' => \'bi-megaphone-fill\', \'label\' => \'Announcement\'],\n\t\t\t\'festival\' => [\'badge_class\' => \'bg-info text-dark\', \'icon_class\' => \'bi-calendar-event\', \'label\' => \'Festival Wishes\'],\n\t\t\t\'promotion\' => [\'badge_class\' => \'bg-danger text-white\', \'icon_class\' => \'bi-arrow-up-circle-fill\', \'label\' => \'Promotion\'],\n\t\t\t\'welcome\' => [\'badge_class\' => \'bg-secondary text-white\', \'icon_class\' => \'bi-person-plus-fill\', \'label\' => \'Welcome\'],\n\t\t\t\'farewell\' => [\'badge_class\' => \'bg-dark text-white\', \'icon_class\' => \'bi-person-dash-fill\', \'label\' => \'Farewell\'],\n\t\t\t\'achievement\' => [\'badge_class\' => \'bg-warning text-dark\', \'icon_class\' => \'bi-trophy-fill\', \'label\' => \'Achievement\'],\n\t\t\t\'event\' => [\'badge_class\' => \'bg-primary text-white\', \'icon_class\' => \'bi-calendar-check-fill\', \'label\' => \'Event\']\n\t\t];\n\n\t\tforeach ($posts as &$post) {\n\t\t\t$type = $post[\'post_type\'];\n\t\t\t$meta = isset($post_meta[$type]) ? $post_meta[$type] : [\'badge_class\' => \'bg-secondary text-white\', \'icon_class\' => \'bi-chat-left-text\', \'label\' => ucfirst($type)];\n\t\t\t$post[\'badge_class\'] = $meta[\'badge_class\'];\n\t\t\t$post[\'icon_class\'] = $meta[\'icon_class\'];\n\t\t\t$post[\'type_label\'] = $meta[\'label\'];\n\t\t\t$post[\'group\'] = \'Events\';\n\t\t\t$post[\'posted_date\'] = date(\'d-M-Y\', strtotime($post[\'created_at\']));\n\t\t}\n\n\t\t// Single query execution for comments (eliminates N+1 loop queries)\n\t\t$post_ids = array_column($posts, \'id\');\n\t\t$comments_by_post = [];\n\t\tif (!empty($post_ids)) {\n\t\t\t$this->db->select(\'c.*, e.emp_name\');\n\t\t\t$this->db->from(\'engage_comments as c\');\n\t\t\t$this->db->join(\'employee_det as e\', \'e.id = c.employee_id\', \'left\');\n\t\t\t$this->db->where_in(\'c.post_id\', $post_ids);\n\t\t\t$this->db->where(\'c.status\', 1);\n\t\t\t$this->db->order_by(\'c.id\', \'ASC\');\n\t\t\t$comments = $this->db->get()->result_array();\n\n\t\t\tforeach ($comments as $comment) {\n\t\t\t\t$comments_by_post[$comment[\'post_id\']][] = $comment;\n\t\t\t}\n\t\t}\n\n\t\tforeach ($posts as &$post) {\n\t\t\t$post[\'comments\'] = isset($comments_by_post[$post[\'id\']]) ? $comments_by_post[$post[\'id\']] : [];\n\t\t}\n\n\t\treturn $posts;\n\t}\n\n\tpublic function toggleLike($post_id, $employee_id)\n\t{\n\t\t$this->db->where(\'post_id\', $post_id);\n\t\t$this->db->where(\'employee_id\', $employee_id);\n\t\t$query = $this->db->get(\'engage_likes\');\n\t\tif ($query->num_rows() > 0) {\n\t\t\t$this->db->where(\'post_id\', $post_id);\n\t\t\t$this->db->where(\'employee_id\', $employee_id);\n\t\t\t$this->db->delete(\'engage_likes\');\n\t\t} else {\n\t\t\t$this->db->insert(\'engage_likes\', [\n\t\t\t\t\'post_id\' => $post_id,\n\t\t\t\t\'employee_id\' => $employee_id\n\t\t\t]);\n\t\t}\n\t}\n\n\tpublic function addComment($post_id, $employee_id, $comment)\n\t{\n\t\t$data = [\n\t\t\t\'post_id\' => $post_id,\n\t\t\t\'employee_id\' => $employee_id,\n\t\t\t\'comment\' => $comment,\n\t\t\t\'status\' => 1\n\t\t];\n\t\t$this->db->insert(\'engage_comments\', $data);\n\t}\n\n\tpublic function softDeleteComment($comment_id, $employee_id)\n\t{\n\t\t$this->db->where(\'id\', $comment_id);\n\t\t$this->db->where(\'employee_id\', $employee_id);\n\t\t$this->db->update(\'engage_comments\', [\'status\' => 0]);\n\t}\n\n\tpublic function sync_ticket_to_pending_task($ticket_id)\n\t{\n\t\t$ticket = $this->db->get_where(\'tickets\', array(\'id\' => $ticket_id))->row_array();\n\t\tif (!$ticket) return;\n\n\t\t$task = $this->db->get_where(\'task_details\', array(\'ticket_id\' => $ticket_id))->row_array();\n\n\t\t// Ticket statuses: 1 = Open, 2 = In Progress, 3 = Closed, 4 = Cancelled\n\t\t// Task status: 0 = Pending, 1 = Completed\n\t\t$task_status = in_array($ticket[\'status\'], [3, 4]) ? 1 : 0;\n\n\t\t// Ticket priority: 1 = Low, 2 = Medium, 3 = High\n\t\t// Task priority: 1 = High, 2 = Medium, 3 = Low\n\t\t$priority_map = [1 => 3, 2 => 2, 3 => 1];\n\t\t$priority = isset($priority_map[$ticket[\'user_priority\']]) ? $priority_map[$ticket[\'user_priority\']] : 2;\n\n\t\tif ($task) {\n\t\t\t// Update existing Pending Task\n\t\t\t$update_data = [\n\t\t\t\t\'e_id\' => $ticket[\'raised_to\'],\n\t\t\t\t\'priority_type\' => $priority,\n\t\t\t\t\'activityDesc\' => $ticket[\'title\'],\n\t\t\t\t\'remarks\' => $ticket[\'description\'],\n\t\t\t\t\'status\' => $task_status,\n\t\t\t\t\'updated_date\' => date(\'Y-m-d H:i:s\')\n\t\t\t];\n\t\t\tif ($task_status == 1) {\n\t\t\t\t$update_data[\'task_comp_dt\'] = date(\'Y-m-d H:i:s\');\n\t\t\t}\n\t\t\t$this->db->where(\'id\', $task[\'id\']);\n\t\t\t$this->db->update(\'task_details\', $update_data);\n\t\t} else {\n\t\t\t// Query valid default values to satisfy foreign keys\n\t\t\t$dep_task_row = $this->db->select(\'id\')->limit(1)->get(\'dep_task\')->row_array();\n\t\t\t$activity_row = $this->db->select(\'aid\')->limit(1)->get(\'activity_det\')->row_array();\n\t\t\t$s_no_row = $this->db->select(\'s_no\')->limit(1)->get(\'task_type\')->row_array();\n\n\t\t\t$dep_task_id = $dep_task_row ? $dep_task_row[\'id\'] : NULL;\n\t\t\t$activity_id = $activity_row ? $activity_row[\'aid\'] : NULL;\n\t\t\t$s_no = $s_no_row ? $s_no_row[\'s_no\'] : NULL;\n\n\t\t\t// Create new Pending Task\n\t\t\t$this->db->select(\'*\');\n\t\t\t$this->db->where(\'type_id\', \'1\');\n\t\t\t$query1 = $this->db->get(\'increment_id\')->result_array();\n\t\t\tif (!empty($query1)) {\n\t\t\t\t$new_cnt = $query1[0][\'auto_value\'] + 1;\n\t\t\t\t$tran_id = "TASK" . sprintf("%06d", $new_cnt);\n\t\t\t\t$auto_value = sprintf("%06d", $new_cnt);\n\n\t\t\t\t$this->db->set(\'auto_value\', $auto_value);\n\t\t\t\t$this->db->where(\'type_id\', \'1\');\n\t\t\t\t$this->db->update(\'increment_id\');\n\t\t\t} else {\n\t\t\t\t$tran_id = "TASK" . time();\n\t\t\t}\n\n\t\t\t$insert_data = [\n\t\t\t\t\'task_id\' => $tran_id,\n\t\t\t\t\'e_id\' => $ticket[\'raised_to\'],\n\t\t\t\t\'ticket_id\' => $ticket_id,\n\t\t\t\t\'work_type\' => \'1\',\n\t\t\t\t\'session_type\' => \'3\',\n\t\t\t\t\'permission\' => \'0\',\n\t\t\t\t\'permission_time\' => \'\',\n\t\t\t\t\'dep_task_id\' => $dep_task_id,\n\t\t\t\t\'activity_id\' => $activity_id,\n\t\t\t\t\'priority_type\' => $priority,\n\t\t\t\t\'project_name\' => \'0\',\n\t\t\t\t\'depend_name\' => \'\',\n\t\t\t\t\'activityDesc\' => $ticket[\'title\'],\n\t\t\t\t\'EstimatedHours\' => \'0\',\n\t\t\t\t\'remarks\' => $ticket[\'description\'],\n\t\t\t\t\'prev_depend_name\' => \'0\',\n\t\t\t\t\'prev_pend_task_type\' => \'\',\n\t\t\t\t\'prev_reason\' => \'\',\n\t\t\t\t\'task_comp_time\' => \'\',\n\t\t\t\t\'task_comp_dt\' => \'0000-00-00 00:00:00\',\n\t\t\t\t\'s_no\' => $s_no,\n\t\t\t\t\'task_flag\' => 0,\n\t\t\t\t\'status\' => $task_status,\n\t\t\t\t\'created_date\' => date(\'Y-m-d H:i:s\')\n\t\t\t];\n\t\t\tif ($task_status == 1) {\n\t\t\t\t$insert_data[\'task_comp_dt\'] = date(\'Y-m-d H:i:s\');\n\t\t\t}\n\t\t\t$this->db->insert(\'task_details\', $insert_data);\n\t\t}\n\t}\n\n\tpublic function sync_pending_task_to_ticket($task_id)\n\t{\n\t\t$task = $this->db->get_where(\'task_details\', array(\'id\' => $task_id))->row_array();\n\t\tif (!$task || empty($task[\'ticket_id\'])) return;\n\n\t\t$ticket = $this->db->get_where(\'tickets\', array(\'id\' => $task[\'ticket_id\']))->row_array();\n\t\tif (!$ticket) return;\n\n\t\tif ($task[\'status\'] == 1 && in_array($ticket[\'status\'], [1, 2])) {\n\t\t\t$update_data = [\n\t\t\t\t\'status\' => 3, // Closed\n\t\t\t\t\'updated_at\' => date("Y-m-d H:i:s")\n\t\t\t];\n\t\t\t$this->db->where(\'id\', $ticket[\'id\']);\n\t\t\t$this->db->update(\'tickets\', $update_data);\n\n\t\t\t// Track in ticket_track_details\n\t\t\t$track_data = [\n\t\t\t\t\'ticket_id\' => $ticket[\'id\'],\n\t\t\t\t\'logged_at\' => date("Y-m-d H:i:s"),\n\t\t\t\t\'logged_by\' => $task[\'e_id\'],\n\t\t\t\t\'status\' => 3,\n\t\t\t\t\'comments\' => \'Ticket automatically closed via Pending Task completion\'\n\t\t\t];\n\t\t\t$this->db->insert(\'ticket_track_details\', $track_data);\n\t\t}\n\t}\n\t\tpublic function get_drilldown_attendance($date) {\n\t\t$this->db->select(\'emp.emp_id, emp.emp_name, d.department_name, login_log.created_date\');\n\t\t$this->db->from(\'login_log\');\n\t\t$this->db->join(\'employee_det emp\', \'emp.id = login_log.e_id\', \'left\');\n\t\t$this->db->join(\'department_det d\', \'d.id = emp.department\', \'left\');\n\t\tif (!empty($date)) {\n\t\t\t$this->db->where(\'DATE(login_log.created_date)\', $date);\n\t\t}\n\t\t$res = $this->db->get()->result_array();\n\t\tlog_message(\'error\', \'get_drilldown_attendance: \' . $this->db->last_query());\n\t\treturn $res;\n\t}\n\n\tpublic function get_drilldown_tickets($status, $time_filter = null, $from_date = null, $to_date = null) {\n\t\t$this->db->select(\'t.ticket_id as ticket_no, t.title as subject, emp.emp_name as raised_by_name, t.user_priority as priority_name, t.created_at as created_date\');\n\t\t$this->db->from(\'tickets t\');\n\t\t$this->db->join(\'employee_det emp\', \'emp.id = t.raised_by\', \'left\');\n\t\tif (!empty($status)) {\n\t\t\t$this->db->where(\'t.status\', $status);\n\t\t}\n\t\tif (!empty($time_filter)) {\n\t\t\t$this->apply_date_filter(\'t.created_at\', $time_filter, $from_date, $to_date);\n\t\t}\n\t\t$res = $this->db->get()->result_array();\n\t\tlog_message(\'error\', \'get_drilldown_tickets: \' . $this->db->last_query());\n\t\treturn $res;\n\t}\n\n\tpublic function get_drilldown_project_tasks($project_name) {\n\t\t$this->db->select(\'t.activityDesc as title, emp.emp_name, (CASE WHEN t.status=1 THEN "Completed" WHEN t.status=2 THEN "Called Off" ELSE "Pending" END) as status_name, t.created_date as due_date\');\n\t\t$this->db->from(\'task_details t\');\n\t\t$this->db->join(\'project_det p\', \'p.pid = t.project_name\', \'left\');\n\t\t$this->db->join(\'employee_det emp\', \'emp.id = t.e_id\', \'left\');\n\t\tif (!empty($project_name)) {\n\t\t\t$this->db->where(\'p.project_name\', $project_name);\n\t\t}\n\t\t$res = $this->db->get()->result_array();\n\t\tlog_message(\'error\', \'get_drilldown_project_tasks: \' . $this->db->last_query());\n\t\treturn $res;\n\t}\n\n\tpublic function get_drilldown_department($dept_id) {\n\t\t$this->db->select("\n\t\t\temp.emp_id, \n\t\t\temp.emp_name, \n\t\t\td.department_name,\n\t\t\temp.designation as designation_name,\n\t\t\tCOUNT(t.id) as assigned,\n\t\t\tSUM(CASE WHEN t.status = 1 THEN 1 ELSE 0 END) as completed,\n\t\t\tSUM(CASE WHEN t.status = 0 THEN 1 ELSE 0 END) as pending,\n\t\t\tSUM(CASE WHEN t.status = 0 AND DATE(t.created_date) < CURDATE() THEN 1 ELSE 0 END) as overdue,\n\t\t\tCOUNT(DISTINCT CASE WHEN t.status = 0 THEN t.project_name END) as projects_count\n\t\t");\n\t\t$this->db->from(\'employee_det emp\');\n\t\t$this->db->join(\'department_det d\', \'d.id = emp.department\', \'left\');\n\t\t$this->db->join(\'task_details t\', \'t.e_id = emp.id\', \'left\');\n\t\t\n\t\tif (!empty($dept_id)) {\n\t\t\t$this->db->where(\'emp.department\', $dept_id);\n\t\t}\n\t\t\n\t\t$this->db->group_by(\'emp.id, emp.emp_id, emp.emp_name, d.department_name, emp.designation\');\n\t\t$rows = $this->db->get()->result_array();\n\n\t\t$res = [];\n\t\tforeach ($rows as $row) {\n\t\t\t$emp_id = $row[\'emp_id\'];\n\t\t\t\n\t\t\t$assigned = (int)$row[\'assigned\'];\n\t\t\t$completed = (int)$row[\'completed\'];\n\t\t\t\n\t\t\t// Adjust if there was a join matching null task columns\n\t\t\t// If there are no actual tasks, COUNT(t.id) is 0.\n\t\t\t// Let\'s calculate percentage\n\t\t\t$perf_pct = $assigned > 0 ? round(($completed / $assigned) * 100, 1) : 0;\n\n\t\t\t$active_projects = \'None\';\n\t\t\tif ((int)$row[\'projects_count\'] > 0) {\n\t\t\t\t$this->db->select("DISTINCT(p.project_name)");\n\t\t\t\t$this->db->from("task_details td");\n\t\t\t\t$this->db->join("project_det p", "p.pid = td.project_name");\n\t\t\t\t$this->db->join("employee_det e", "e.id = td.e_id");\n\t\t\t\t$this->db->where("e.emp_id", $emp_id);\n\t\t\t\t$this->db->where("td.status", 0);\n\t\t\t\t$p_rows = $this->db->get()->result_array();\n\t\t\t\tif (!empty($p_rows)) {\n\t\t\t\t\t$active_projects = implode(\', \', array_column($p_rows, \'project_name\'));\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t$res[] = [\n\t\t\t\t\'emp_id\' => $row[\'emp_id\'],\n\t\t\t\t\'emp_name\' => $row[\'emp_name\'],\n\t\t\t\t\'department_name\' => $row[\'department_name\'] ? $row[\'department_name\'] : \'N/A\',\n\t\t\t\t\'designation_name\' => $row[\'designation_name\'] ? $row[\'designation_name\'] : \'N/A\',\n\t\t\t\t\'assigned\' => $assigned,\n\t\t\t\t\'completed\' => $completed,\n\t\t\t\t\'pending\' => (int)$row[\'pending\'],\n\t\t\t\t\'overdue\' => (int)$row[\'overdue\'],\n\t\t\t\t\'perf_pct\' => $perf_pct . \'%\',\n\t\t\t\t\'projects\' => $active_projects\n\t\t\t];\n\t\t}\n\t\treturn $res;\n\t}\n\n\tpublic function get_drilldown_employee($emp_id) {\n\t\t$this->db->select(\'emp.emp_name, \n\t\t\tSUM(CASE WHEN t.status = 1 THEN 1 ELSE 0 END) as completed,\n\t\t\tSUM(CASE WHEN t.status = 0 THEN 1 ELSE 0 END) as pending,\n\t\t\t0 as working_hours,\n\t\t\tCOUNT(DISTINCT t.project_name) as projects\n\t\t\');\n\t\t$this->db->from(\'employee_det emp\');\n\t\t$this->db->join(\'task_details t\', \'t.e_id = emp.id\', \'left\');\n\t\tif (!empty($emp_id)) {\n\t\t\t$this->db->where(\'emp.emp_id\', $emp_id);\n\t\t}\n\t\t$this->db->group_by(\'emp.id\');\n\t\t$res = $this->db->get()->result_array();\n\t\tlog_message(\'error\', \'get_drilldown_employee: \' . $this->db->last_query());\n\t\treturn $res;\n\t}\n\n\tpublic function get_drilldown_month($month) {\n\t\t$this->db->select(\'t.activityDesc as title, p.project_name, emp.emp_name, (CASE WHEN t.status=1 THEN "Completed" WHEN t.status=2 THEN "Called Off" ELSE "Pending" END) as status_name, t.task_comp_dt as completed_date\');\n\t\t$this->db->from(\'task_details t\');\n\t\t$this->db->join(\'project_det p\', \'p.pid = t.project_name\', \'left\');\n\t\t$this->db->join(\'employee_det emp\', \'emp.id = t.e_id\', \'left\');\n\t\tif (!empty($month)) {\n\t\t\t$this->db->like(\'t.created_date\', $month, \'after\');\n\t\t}\n\t\t$res = $this->db->get()->result_array();\n\t\tlog_message(\'error\', \'get_drilldown_month: \' . $this->db->last_query());\n\t\treturn $res;\n\t}\n\n\tpublic function update_user_password($emp_id, $hashed_password) {\n\t\t$this->db->where(\'emp_id\', $emp_id);\n\t\treturn $this->db->update(\'employee_det\', array(\'passwd\' => $hashed_password));\n\t}\n\n\tpublic function apply_date_filter($column, $time_filter, $from_date = null, $to_date = null) {\n\t\tif (empty($time_filter)) {\n\t\t\treturn;\n\t\t}\n\t\tswitch ($time_filter) {\n\t\t\tcase \'today\':\n\t\t\t\t$this->db->where("DATE($column) = CURDATE()", NULL, FALSE);\n\t\t\t\tbreak;\n\t\t\tcase \'yesterday\':\n\t\t\t\t$this->db->where("DATE($column) = DATE_SUB(CURDATE(), INTERVAL 1 DAY)", NULL, FALSE);\n\t\t\t\tbreak;\n\t\t\tcase \'last7days\':\n\t\t\t\t$this->db->where("$column >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)", NULL, FALSE);\n\t\t\t\tbreak;\n\t\t\tcase \'currentmonth\':\n\t\t\t\t$this->db->where("MONTH($column) = MONTH(CURDATE()) AND YEAR($column) = YEAR(CURDATE())", NULL, FALSE);\n\t\t\t\tbreak;\n\t\t\tcase \'last3months\':\n\t\t\t\t$this->db->where("$column >= DATE_SUB(CURDATE(), INTERVAL 3 MONTH)", NULL, FALSE);\n\t\t\t\tbreak;\n\t\t\tcase \'last6months\':\n\t\t\t\t$this->db->where("$column >= DATE_SUB(CURDATE(), INTERVAL 6 MONTH)", NULL, FALSE);\n\t\t\t\tbreak;\n\t\t\tcase \'custom\':\n\t\t\t\tif (!empty($from_date) && !empty($to_date)) {\n\t\t\t\t\t$from = date(\'Y-m-d\', strtotime($from_date));\n\t\t\t\t\t$to = date(\'Y-m-d\', strtotime($to_date));\n\t\t\t\t\t$this->db->where("DATE($column) BETWEEN " . $this->db->escape($from) . " AND " . $this->db->escape($to), NULL, FALSE);\n\t\t\t\t} else if (!empty($from_date)) {\n\t\t\t\t\t$from = date(\'Y-m-d\', strtotime($from_date));\n\t\t\t\t\t$this->db->where("DATE($column) >= " . $this->db->escape($from), NULL, FALSE);\n\t\t\t\t} else if (!empty($to_date)) {\n\t\t\t\t\t$to = date(\'Y-m-d\', strtotime($to_date));\n\t\t\t\t\t$this->db->where("DATE($column) <= " . $this->db->escape($to), NULL, FALSE);\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t}\n\t}\n\n\tpublic function get_employee_skills($employee_id)\n\t{\n\t\t$this->db->select(\'*\');\n\t\t$this->db->from(\'employee_skill_set\');\n\t\t$this->db->where(\'employee_id\', $employee_id);\n\t\t$this->db->where(\'status\', 1);\n\t\t$this->db->order_by(\'id\', \'ASC\');\n\t\treturn $this->db->get()->result_array();\n\t}\n\n\tpublic function get_employee_skill_by_id($id)\n\t{\n\t\t$this->db->select(\'*\');\n\t\t$this->db->from(\'employee_skill_set\');\n\t\t$this->db->where(\'id\', $id);\n\t\t$this->db->where(\'status\', 1);\n\t\treturn $this->db->get()->row_array();\n\t}\n\n\tpublic function save_employee_skill($data)\n\t{\n\t\treturn $this->db->insert(\'employee_skill_set\', $data);\n\t}\n\n\tpublic function update_employee_skill($id, $data)\n\t{\n\t\t$this->db->where(\'id\', $id);\n\t\treturn $this->db->update(\'employee_skill_set\', $data);\n\t}\n\n\tpublic function delete_employee_skill($id)\n\t{\n\t\t$this->db->where(\'id\', $id);\n\t\treturn $this->db->update(\'employee_skill_set\', array(\'status\' => 0));\n\t}\n\n\t// =============================================\n\t// Avatar Helper Methods\n\t// =============================================\n\n\tpublic function update_employee_avatar($emp_db_id, $avatar_path)\n\t{\n\t\t$this->db->where(\'id\', $emp_db_id);\n\t\treturn $this->db->update(\'employee_det\', array(\n\t\t\t\'avatar\' => $avatar_path,\n\t\t\t\'update_dt\' => date(\'Y-m-d H:i:s\')\n\t\t));\n\t}\n\n\tpublic function get_employee_avatar($emp_db_id)\n\t{\n\t\t$this->db->select(\'avatar\');\n\t\t$this->db->where(\'id\', $emp_db_id);\n\t\t$result = $this->db->get(\'employee_det\')->row_array();\n\t\treturn $result ? $result[\'avatar\'] : null;\n\t}\n\n} //Main Class\n thi si smy model i want to represent something new in this project give me some ideas'
