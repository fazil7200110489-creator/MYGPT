nputs); \n\t\t\t\t$data[\'projects\'] = $this->admin_model->get_projects_export();\n\t\t\t\t$this->template->write_view(\'content\', \'admin/emp_additonal_history\', $data);\n\t\t\t\t$this->template->render();\n\t\t\t}\n\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t}\n\n\tpublic function emp_task_received(){\n\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\t$inputs = $this->input->post();\n\t\t\t// echo "<pre>"; print_r($inputs); exit;\t\n\t\t\tif (isset($inputs) && !empty($inputs)) { \n\t\t\t\t$data[\'filters\'] = $inputs; \n\t\t\t\t// echo "<pre>"; print_r($data[\'filters\']); exit;\t \t\n\t\t\t\t$data[\'add_history\'] = $this->admin_model->get_add_received_reports($user_det[\'empdet_id\'], $inputs); \n\t\t\t\t$data[\'projects\'] = $this->admin_model->get_projects_export();\n\t\t\t\t$this->template->write_view(\'content\', \'admin/emp_task_received\', $data);\n\t\t\t\t$this->template->render();\n\t\t\t} else {\n\t\t\t\t$inputs = "";\n\t\t\t\t$data[\'add_history\'] = $this->admin_model->get_add_received_reports($user_det[\'empdet_id\'], $inputs); \n\t\t\t\t$data[\'projects\'] = $this->admin_model->get_projects_export(); \n\t\t\t\t$this->template->write_view(\'content\', \'admin/emp_task_received\', $data);\n\t\t\t\t$this->template->render();\n\t\t\t}\n\n\t\t\t \n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t}\n\n\tpublic function daily_time_sheet(){\n\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\t$inputs = $this->input->post();\n\t\t\t// echo "<pre>"; print_r($inputs); exit;\t\n\t\t\tif (isset($inputs) && !empty($inputs)) { \n\t\t\t\t$data[\'filters\'] = $inputs; \n\t\t\t\t// echo "<pre>"; print_r($data[\'filters\']); exit;\t\n\t\t\t\t$data[\'emps\'] = $this->admin_model->getemployees(); \t\n\t\t\t\t$data[\'timesheet\'] = $this->admin_model->get_daily_time_sheet($user_det[\'empdet_id\'], $inputs); \n \t\t\t\t$this->template->write_view(\'content\', \'admin/daily_time_sheet_details\', $data);\n\t\t\t\t$this->template->render();\n\n\t\t\t} else {\n\t\t\t\t$inputs = "";\n\t\t\t\t$data[\'emps\'] = $this->admin_model->getemployees(); \n\t\t\t\t$data[\'timesheet\'] = $this->admin_model->get_daily_time_sheet($user_det[\'empdet_id\'], $inputs);  \n\t\t\t\t$this->template->write_view(\'content\', \'admin/daily_time_sheet_details\', $data);\n\t\t\t\t$this->template->render();\n\t\t\t}\n\n\t\t\t \n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t}\n\n\tpublic function employees_in(){\n\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\t$data[\'employees_in\'] = $this->admin_model->get_tot_log_export(); \n\t\t\t$data[\'employees_notin\'] = $this->admin_model->get_employees_notin(); \n\t\t\t$data[\'employees_submitted\'] = $this->admin_model->get_employees_submitted(); \n\t\t\t$this->template->write_view(\'content\', \'admin/employees_in\',$data);\n\t\t\t$this->template->render();\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t}\n\t// public function get_dependency_name($did){\n\n\t// \t$this->db->select(\'employee_det.*\'); \n\t// \t $this->db->where(\'employee_det.id\',$did); \n \t// \t$query = $this->db->get(\'employee_det as emp\')->result_array();\n\t// \t print_r($this->db->last_query()); exit; \n\t// \treturn $query; \n\n\t// }\n\n\t/**********************\n\t * Date: 25.02.2025\n\t * Code Added by: Mr. Ananath HariHaran\n\t * Description: Adding Task in Manager Login\n\t * ***********/\n\tpublic function add_task_form()\n\t{\n    \t\n\t\t//  echo "<pre>HI";  \n\t\t$employee_det=$this->session->userdata(\'logged_in\');\n\n\t\t//    echo "<pre>HELLO"; print_r($employee_det); exit;\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{\n\t\t\t$emp_id=$employee_det[\'emp_id\'];\n\t\t\t$data[\'activity\']     =$this->admin_model->get_activity_list($employee_det[\'department\']);\n\t\t\t$data[\'lists\'] = $this->admin_model->get_members_list($emp_id); \n\t\t\t$data[\'task_data\']     =$this->admin_model->get_task_type();\n\t\t\t$data[\'task_list\']     =$this->admin_model->get_task_list($employee_det[\'department\']); \n\t\t\n\t\t\t$this->template->write_view(\'content\', \'admin/add_task_form\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t\t else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t}\n\n\n\tpublic function insert_add_task_type(){\n\n\t\t$employee_det=$this->session->userdata(\'logged_in\');\n\n\t\t// echo "<pre>HELLO"; print_r($employee_det); exit;\n\t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{\n\t\t\t \t$inps = $this->input->post();\n\t\t\t\t  // echo "<pre>"; print_r($inps); exit;\n\t\t\t \t$selectday = explode("-", $inps[\'selected_date\']);\n\t\t\t\t$day = $selectday[2];\n\t\t\t\tif($inps[\'taskType\']=="1"){\n\n\t\t\t\t\t$tasktype ="1";\n\n\t\t\t\t} else {\n\n\t\t\t\t\t$tasktype = "0";\n\t\t\t\t}\n\t\t\t\t// echo "<pre>"; print_r($day); exit;\n\t\t\t\t$data=array(\'emp_id\' =>$inps[\'EmpID\'],\'assigned_by\'=>$employee_det[\'empdet_id\'],\'task_name\'=>$inps[\'taskType\'],\'estimated_hrs\'=>$inps[\'EstimatedHours\'],\'task\'=>$inps[\'inputTask\'],\'activity\'=>$inps[\'inputActivity\'],\'activity_desc\'=>$inps[\'ActivityDescription\'],\'daily\'=>$tasktype,\'weekly\'=>$inps[\'selected_day\'],\'monthly\'=>$day,\'quartely\'=>$inps[\'quaterly_date\'],\'s_no\'=>$inps[\'taskType\']);\n\t \t\t\t$sql_query=$this->db->insert(\'UserTasks_Details\',$data); \n\t \t\t\tif($sql_query>0){\n\n\t\t\t   \t\t\n\t\t\t   \t\t $this->session->set_flashdata(\'true\', \'Task Added Successfully\');\n\t\t\t   \t\tredirect($this->config->item(\'base_url\').\'admin/add_task_form\');\n\t\t\t   \t\t //echo"success";exit;\n\t\t\t   \t\t}\n\t\t\t   \t\telse{\n\t\t\t   \t\t\t\n\t\t\t   \t\t\t$this->session->set_flashdata(\'err\',\'something went wrong.Error!!\');\n\t\t\t   \t\t\tredirect($this->config->item(\'base_url\').\'admin/add_task_form\');\n\t\t\t   \t\t\t//echo"Failed";exit;\n\t\t\t   \t\t}\n\t\t\t\t\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n/****************\n * Date: 26.02.2025\n * Code Added by Mr. Muthu Kumaran\n * Description: Ticketing System\n * \n * *********/\n\tpublic function custom404()\n\t{\n\t\t$this->load->view(\'../../themes/\' . $this->config->item("active_template") . \'/custom404.php\');\n\t}\n\n\tpublic function create_ticket()\n\t{\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\t$inps = $this->input->post();\n\t \n\t\t\tif ($inps[\'raised_to\'] == $user_det[\'empdet_id\']) {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'You cannot create a ticket assigned to yourself.\');\n\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/emp_raise_ticket\');\n\t\t\t}\n\n\n\t\t\tif ($this->input->post()) {\n\t\t\t\t// Generate Ticket ID\n\t\t\t\t$this->db->select(\'*\');\n\t\t\t\t$this->db->where(\'type_id\', \'2\'); // Assuming type_id for tickets is 2\n\t\t\t\t$query1 = $this->db->get(\'increment_id\')->result_array();\n\n\t\t\t\tif (empty($query1)) {\n\t\t\t\t\t// Handle the case where the increment_id record does not exist\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Unable to generate ticket ID.\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/emp_raise_ticket\');\n\t\t\t\t}\n\n\t\t\t\t$new_cnt = $query1[0][\'auto_value\'] + 1;\n\t\t\t\t$ticket_id = "TICKET" . sprintf("%06d", $new_cnt);\n\t\t\t\t$auto_value = sprintf("%06d", $new_cnt);\n\n\t\t\t\t// Update the increment_id table\n\t\t\t\t$this->db->set(\'auto_value\', $auto_value);\n\t\t\t\t$this->db->where(\'type_id\', \'2\'); // Assuming type_id for tickets is 2\n\t\t\t\t$this->db->update(\'increment_id\');\n\n\t\t\t\t// Prepare data to save\n\t\t\t\t$data = array(\n\t\t\t\t\t\'ticket_id\' => $ticket_id,\n\t\t\t\t\t\'raised_by\' => $user_det[\'empdet_id\'],\n\t\t\t\t\t\'raised_to\' => $inps[\'raised_to\'],\n\t\t\t\t\t\'ticket_type\' => $inps[\'ticket_type\'],\n\t\t\t\t\t\'user_priority\' => $inps[\'priority\'],\n\t\t\t\t\t\'description\' => $inps[\'description\'],\n\t\t\t\t\t\'title\' => $inps[\'title\'],\n\t\t\t\t\t\'status\' => \'1\', // Default status\n\t\t\t\t\t\'created_at\' => date("Y-m-d H:i:s")\n\t\t\t\t);\n\n\t\t\t\t// Insert into the tickets table\n\t\t\t\t$ticket_query = $this->db->insert(\'tickets\', $data);\n\n\t\t\t\tif ($ticket_query) {\n\t\t\t\t\t// Get the last inserted ID\n\t\t\t\t\t$last_inserted_id = $this->db->insert_id();\n\t\t\t\t\t\n\t\t\t\t\t// Auto sync ticket to pending task\n\t\t\t\t\t$this->admin_model->sync_ticket_to_pending_task($last_inserted_id);\n\n\t\t\t\t\t$ticketDetails = array(\n\t\t\t\t\t\t\'ticket_id\' => $last_inserted_id, // Use the correct variable here\n\t\t\t\t\t\t\'logged_at\' => date("Y-m-d H:i:s"),\n\t\t\t\t\t\t\'logged_by\' => $user_det[\'empdet_id\'],\n\t\t\t\t\t\t\'status\' => \'1\',\n\t\t\t\t\t\t\'comments\' => \'Ticket Created\'\n\t\t\t\t\t);\n\n\t\t\t\t\t// Insert into ticket_track_details\n\t\t\t\t\t$ticket_tracker = $this->db->insert(\'ticket_track_details\', $ticketDetails);\n\n\t\t\t\t\tif ($ticket_tracker) {\n\t\t\t\t\t\t$this->session->set_flashdata(\'succ\', \'Ticket Successfully Created\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/emp_raise_ticket\');\n\t\t\t\t\t} else {\n\t\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Something went wrong while tracking the ticket.\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/emp_raise_ticket\');\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Something went wrong while creating the ticket.\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/emp_raise_ticket\');\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t\t}\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\tpublic function emp_tickets_update()\n\t{\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\t$data = json_decode(file_get_contents("php://input"), true);\n\n\t\t\t$ticket_id = isset($data[\'ticket_id\']) ? $data[\'ticket_id\'] : null;\n\t\t\t$new_status = isset($data[\'status\']) ? $data[\'status\'] : null;\n\t\t\t$comment = isset($data[\'comment\']) ? $data[\'comment\'] : \'\';\n\t\t\t$adminPriority = isset($data[\'adminPriority\']) ? $data[\'adminPriority\'] : \'\';\n\n\t\t\tif (empty($ticket_id) || !in_array($new_status, [1, 2, 3, 4])) {\n\t\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Invalid ticket ID or status.\']);\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tif (empty($comment)) {\n\t\t\t\tswitch ($new_status) {\n\t\t\t\t\tcase 1:\n\t\t\t\t\t\t$comment = \'Ticket marked as Open\';\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase 2:\n\t\t\t\t\t\t$comment = \'Ticket status updated to In Progress\';\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase 3:\n\t\t\t\t\t\t$comment = \'Ticket status updated to Closed\';\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase 4:\n\t\t\t\t\t\t$comment = \'Ticket status updated to Cancelled\';\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tdefault:\n\t\t\t\t\t\t$comment = \'Status updated\';\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t$update_data = [\n\t\t\t\t\'status\' => $new_status,\n\t\t\t\t\'updated_at\' => date("Y-m-d H:i:s"),\n\t\t\t\t\'admin_priority\' => $adminPriority\n\t\t\t];\n\n\t\t\t$update_result = $this->admin_model->update_ticket_status($ticket_id, $update_data);\n\n\t\t\tif ($update_result) {\n\t\t\t\t$this->db->select(\'id\');\n\t\t\t\t$this->db->where(\'ticket_id\', $ticket_id);\n\t\t\t\t$ticket = $this->db->get(\'tickets\')->row_array();\n\n\t\t\t\tif ($ticket) {\n\t\t\t\t\t$primary_id = $ticket[\'id\'];\n\t\t\t\t\t$track_data = [\n\t\t\t\t\t\t\'ticket_id\' => $primary_id,\n\t\t\t\t\t\t\'logged_at\' => date("Y-m-d H:i:s"),\n\t\t\t\t\t\t\'logged_by\' => $user_det[\'empdet_id\'],\n\t\t\t\t\t\t\'status\' => $new_status,\n\t\t\t\t\t\t\'comments\' => $comment\n\t\t\t\t\t];\n\n\t\t\t\t\t$track_result = $this->db->insert(\'ticket_track_details\', $track_data);\n\n\t\t\t\t\tif ($track_result) {\n\t\t\t\t\t\techo json_encode([\'status\' => \'success\', \'message\' => \'Ticket updated and tracked successfully.\']);\n\t\t\t\t\t} else {\n\t\t\t\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Ticket updated, but failed to track the update.\']);\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Failed to update ticket.\']);\n\t\t\t\t}\n\t\t\t}\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t}\n\n\tpublic function emp_raise_ticket()\n\t{\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t// Fetch employees\n\t\t$employees = $this->admin_model->getemployees();\n\n\t\t// Filter employees based on departments\n\t\t $filtered_employees = $employees;\n\t\t// $filtered_employees = array_filter($employees, function ($employee) {\n\t\t// \treturn in_array($employee[\'department\'], [\'System Admin\']);\n\t\t// \t// return in_array($employee[\'department\'], [\'HR\', \'System Admin\']);\n\t\t// });\n\n\t\t// // Sort employees, prioritizing "System Admin"\n\t\t// usort($filtered_employees, function ($a, $b) {\n\t\t// \tif ($a[\'department\'] === \'System Admin\' && $b[\'department\'] !== \'System Admin\') {\n\t\t// \t\treturn -1; // $a comes before $b\n\t\t// \t}\n\t\t// \tif ($a[\'department\'] !== \'System Admin\' && $b[\'department\'] === \'System Admin\') {\n\t\t// \t\treturn 1; // $b comes before $a\n\t\t// \t}\n\t\t// \treturn 0; // keep original order for other cases\n\t\t// });\n\n\t\t// Fetch ticket types, priorities, and statuses\n\t\t$data[\'employees\'] = $filtered_employees;\n\t\t$data[\'ticket_types\'] = $this->admin_model->get_ticket_types();  // Fetch ticket types\n\t\t$data[\'priority_levels\'] = $this->admin_model->get_ticket_priority();  // Fetch priority levels\n\t\t$data[\'ticket_statuses\'] = $this->admin_model->get_ticket_status();  // Fetch ticket statuses\n\n\t\t// Load the view\n\t\t$this->template->write_view(\'content\', \'admin/emp_raise_ticket\', $data);\n\t\t$this->template->render();\n\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function emp_my_tickets()\n\t{\n\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\t$data[\'employees\'] = $this->admin_model->getemployees();\n\t\t\t$data[\'projects\'] = $this->admin_model->get_projects();\n\t\t\t$data[\'to_do_list\'] = $this->admin_model->get_to_do_list_check($user_det[\'empdet_id\']);\n\t\t\t$data[\'task_data\'] = $this->admin_model->get_task_list($user_det[\'department\']);\n\t\t\t$data[\'activity\'] = $this->admin_model->get_activity_list($user_det[\'department\']);\n\n\t\t\t$this->template->write_view(\'content\', \'admin/emp_my_tickets\', $data);\n\t\t\t$this->template->render();\n\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\tpublic function emp_received_tickets()\n\t{\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\n\t\t// if (!($user_det[\'department\'] === \'System Admin\')) {\n\t\t// \tredirect($this->config->item(\'base_url\') . "admin/index");\n\t\t// }\n\n\n\t\t// Fetch employees if role type is valid\n\t\t$data[\'employees\'] = $this->admin_model->getemployees();\n\t\t$this->template->write_view(\'content\', \'admin/emp_received_tickets\', $data);\n\t\t$this->template->render();\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\tpublic function emp_employees_tickets()\n\t{\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\tif (!($user_det[\'department\'] === \'1\')) {\n\t\t\t\tredirect($this->config->item(\'base_url\') . "admin/index");\n\t\t\t}\n\n\n\t\t\t// Fetch employees if role type is valid\n\t\t\t$data[\'employees\'] = $this->admin_model->getemployees();\n\t\t\t$this->template->write_view(\'content\', \'admin/emp_employees_tickets\', $data);\n\t\t\t$this->template->render();\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t