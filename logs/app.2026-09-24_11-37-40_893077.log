d_by = emp_by.id\', \'left\'); // Join with employee_det for \'raised_by\' employee details\n\t\t\t$this->db->where(\'tickets.raised_by\', $user_det[\'empdet_id\']); // Filtering tickets by employee ID\n\n\t\t\t// Apply status filter if it\'s not set to \'all\'\n\t\t\tif ($status !== \'all\') {\n\t\t\t\t$this->db->where(\'tickets.status\', $status);\n\t\t\t}\n\n\t\t\t// Apply date range filter if both startDate and endDate are provided\n\t\t\tif (!empty($startDate) && !empty($endDate)) {\n\t\t\t\t$this->db->where(\'tickets.created_at >=\', $startDate . \' 00:00:00\');\n\t\t\t\t$this->db->where(\'tickets.created_at <=\', $endDate . \' 23:59:59\');\n\t\t\t}\n\n\t\t\t// Apply search filters if a search term is provided\n\t\t\tif (!empty($searchTerm)) {\n\t\t\t\t$this->db->group_start();\n\t\t\t\t$this->db->like(\'ticket_id\', $searchTerm);\n\t\t\t\t$this->db->or_like(\'title\', $searchTerm);\n\t\t\t\t$this->db->or_like(\'description\', $searchTerm);\n\t\t\t\t$this->db->or_like(\'emp_to.emp_name\', $searchTerm); // Filter by raised_to employee name\n\t\t\t\t$this->db->or_like(\'emp_by.emp_name\', $searchTerm); // Filter by raised_by employee name\n\t\t\t\t$this->db->group_end();\n\t\t\t}\n\n\t\t\t$this->db->order_by(\'updated_at\', \'DESC\');\n\t\t\t$this->db->limit($per_page, $offset); // Limit for pagination\n\n\t\t\t// Execute the query for tickets\n\t\t\t$query = $this->db->get();\n\n\t\t\t// Start the query for counting total tickets\n\t\t\t$total_count_query = $this->db->from(\'tickets\');\n\t\t\t$total_count_query->join(\'employee_det AS emp_to\', \'tickets.raised_to = emp_to.id\', \'left\');\n\t\t\t$total_count_query->join(\'employee_det AS emp_by\', \'tickets.raised_by = emp_by.id\', \'left\');\n\t\t\t$total_count_query->where(\'tickets.raised_by\', $user_det[\'empdet_id\']);\n\n\t\t\t// Apply status filter for counting only if a specific status is provided and not \'all\'\n\t\t\tif ($status !== \'all\') {\n\t\t\t\t$total_count_query->where(\'tickets.status\', $status);\n\t\t\t}\n\n\t\t\t// Apply date range filter for counting\n\t\t\tif (!empty($startDate) && !empty($endDate)) {\n\t\t\t\t$total_count_query->where(\'tickets.created_at >=\', $startDate . \' 00:00:00\');\n\t\t\t\t$total_count_query->where(\'tickets.created_at <=\', $endDate . \' 23:59:59\');\n\t\t\t}\n\n\t\t\t// Apply search conditions for counting\n\t\t\tif (!empty($searchTerm)) {\n\t\t\t\t$total_count_query->group_start();\n\t\t\t\t$total_count_query->like(\'ticket_id\', $searchTerm);\n\t\t\t\t$total_count_query->or_like(\'title\', $searchTerm);\n\t\t\t\t$total_count_query->or_like(\'description\', $searchTerm);\n\t\t\t\t$total_count_query->or_like(\'emp_to.emp_name\', $searchTerm);\n\t\t\t\t$total_count_query->or_like(\'emp_by.emp_name\', $searchTerm);\n\t\t\t\t$total_count_query->group_end();\n\t\t\t}\n\n\t\t\t// Get the total count of matching tickets\n\t\t\t$total_count = $total_count_query->count_all_results();\n\n\t\t\t// Prepare response based on query results\n\t\t\tif ($query->num_rows() > 0) {\n\t\t\t\t$tickets = $query->result_array();\n\n\t\t\t\t// Load admin model to access employee name method\n\t\t\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t\t\tforeach ($tickets as &$ticket) {\n\t\t\t\t\t// Replace IDs with "YOU" if they match the current user\'s ID\n\t\t\t\t\tif ($ticket[\'raised_to\'] === $user_det[\'empdet_id\']) {\n\t\t\t\t\t\t$ticket[\'raised_to\'] = "YOU";\n\t\t\t\t\t}\n\n\t\t\t\t\t// Fetch all tracking details for this ticket\n\t\t\t\t\t$this->db->from(\'ticket_track_details\');\n\t\t\t\t\t$this->db->where(\'ticket_id\', $ticket[\'id\']);\n\t\t\t\t\t$tracker_query = $this->db->get();\n\n\t\t\t\t\tif ($tracker_query->num_rows() > 0) {\n\t\t\t\t\t\t$trackers = $tracker_query->result_array();\n\n\t\t\t\t\t\t// Add employee name and department to each tracker\n\t\t\t\t\t\tforeach ($trackers as &$tracker) {\n\t\t\t\t\t\t\t$employeeName = $this->admin_model->getempName($tracker[\'logged_by\']);\n\t\t\t\t\t\t\t$employeeDept = $this->admin_model->getempDept($tracker[\'logged_by\']);\n\n\t\t\t\t\t\t\t$tracker[\'emp_name\'] = $employeeName ? $employeeName->emp_name : \'Unknown\';\n\t\t\t\t\t\t\t$tracker[\'department\'] = $employeeDept ? $employeeDept->department : \'Unknown\';\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\t$ticket[\'tracker\'] = $trackers;\n\t\t\t\t\t} else {\n\t\t\t\t\t\t$ticket[\'tracker\'] = []; // No tracking details found\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t// Return tickets with pagination info\n\t\t\t\techo json_encode([\n\t\t\t\t\t\'status\' => \'success\',\n\t\t\t\t\t\'data\' => $tickets,\n\t\t\t\t\t\'total_count\' => $total_count,\n\t\t\t\t\t\'per_page\' => $per_page,\n\t\t\t\t\t\'current_page\' => $page\n\t\t\t\t]);\n\t\t\t} else {\n\t\t\t\t// Return error message if no tickets found\n\t\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'No tickets found.\']);\n\t\t\t}\n\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\n\tpublic function fetch_team_tickets($status = \'all\', $page = 1)\n\t{\n\t\t// Get user details from session\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t$per_page = 30; // Tickets per page\n\t\t$offset = ($page - 1) * $per_page;\n\n\t\t// Get search term, date range, and optional team member ID if provided\n\t\t$searchTerm = $this->input->get(\'search\');\n\t\t$startDate = $this->input->get(\'start_date\');\n\t\t$endDate = $this->input->get(\'end_date\');\n\t\t$member_id = $this->input->get(\'member_id\'); // Fetch team member ID\n\n\t\t// Step 1: Fetch the manager ID based on the logged-in user\'s emp_id\n\t\t$managerId = $this->admin_model->get_manager_id_by_emp_id($user_det[\'emp_id\']);\n\n\t\t// Step 2: Fetch team members if a manager ID is found\n\t\tif ($managerId !== null) {\n\t\t\t$teamMembers = $this->admin_model->get_team_members($managerId);\n\t\t} else {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Manager not found.\']);\n\t\t\treturn;\n\t\t}\n\n\t\t// Step 3: Prepare team member IDs and filter by member_id if provided\n\t\t$teamMemberIds = array_column($teamMembers, \'id\');\n\t\t// Add the current user\'s ID to the list\n\t\t$teamMemberIds[] = $user_det[\'empdet_id\'];\n\t\tif ($member_id && in_array($member_id, $teamMemberIds)) {\n\t\t\t$teamMemberIds = [$member_id];\n\t\t}\n\n\t\t// Check if there are any team member IDs to proceed\n\t\tif (empty($teamMemberIds)) {\n\t\t\techo json_encode([\n\t\t\t\t\'status\' => \'success\',\n\t\t\t\t\'data\' => [], // Return empty data array\n\t\t\t\t\'total_count\' => 0, // No tickets available\n\t\t\t\t\'per_page\' => $per_page,\n\t\t\t\t\'current_page\' => $page\n\t\t\t]);\n\t\t\treturn; // Exit early since there\'s no team member data to fetch\n\t\t}\n\n\t\t// Step 4: Query to count total tickets with filters applied\n\t\t$this->db->select(\'COUNT(*) as total_count\');\n\t\t$this->db->from(\'tickets\');\n\t\t$this->db->where_in(\'raised_by\', $teamMemberIds); // Only tickets raised by selected team member(s)\n\n\t\t// Apply status filter if not set to \'all\'\n\t\tif ($status !== \'all\') {\n\t\t\t$this->db->where(\'status\', $status);\n\t\t}\n\n\t\t// Apply date range filter if both startDate and endDate are provided\n\t\tif (!empty($startDate) && !empty($endDate)) {\n\t\t\t$this->db->where(\'created_at >=\', $startDate . \' 00:00:00\');\n\t\t\t$this->db->where(\'created_at <=\', $endDate . \' 23:59:59\');\n\t\t}\n\n\t\t// Execute the count query\n\t\t$count_query = $this->db->get();\n\t\t$total_count = $count_query->row()->total_count;\n\n\t\t// Step 5: Query to fetch actual ticket data\n\t\t$this->db->select(\'tickets.*, \n                       emp_to.emp_name AS raised_to_name, \n                       emp_to.department AS raised_to_dept,\n                       emp_by.emp_name AS raised_by_name, \n                       emp_by.department AS raised_by_dept\');\n\t\t$this->db->from(\'tickets\');\n\t\t$this->db->join(\'employee_det AS emp_to\', \'tickets.raised_to = emp_to.id\', \'left\');\n\t\t$this->db->join(\'employee_det AS emp_by\', \'tickets.raised_by = emp_by.id\', \'left\');\n\t\t$this->db->where_in(\'tickets.raised_by\', $teamMemberIds); // Filter by team member(s)\n\n\t\t// Apply status filter if not set to \'all\'\n\t\tif ($status !== \'all\') {\n\t\t\t$this->db->where(\'tickets.status\', $status);\n\t\t}\n\n\t\t// Apply date range filter if both startDate and endDate are provided\n\t\tif (!empty($startDate) && !empty($endDate)) {\n\t\t\t$this->db->where(\'tickets.created_at >=\', $startDate . \' 00:00:00\');\n\t\t\t$this->db->where(\'tickets.created_at <=\', $endDate . \' 23:59:59\');\n\t\t}\n\n\t\t// Apply search filters if a search term is provided\n\t\tif (!empty($searchTerm)) {\n\t\t\t$this->db->group_start();\n\t\t\t$this->db->like(\'ticket_id\', $searchTerm);\n\t\t\t$this->db->or_like(\'title\', $searchTerm);\n\t\t\t$this->db->or_like(\'description\', $searchTerm);\n\t\t\t$this->db->or_like(\'emp_by.emp_name\', $searchTerm);\n\t\t\t$this->db->or_like(\'emp_to.emp_name\', $searchTerm);\n\t\t\t$this->db->group_end();\n\t\t}\n\n\t\t// Apply ordering, pagination, and execute the ticket query\n\t\t$this->db->order_by(\'updated_at\', \'DESC\');\n\t\t$this->db->limit($per_page, $offset);\n\t\t$query = $this->db->get();\n\n\t\t// Step 6: Prepare response with ticket and tracking details\n\t\tif ($query->num_rows() > 0) {\n\t\t\t$tickets = $query->result_array();\n\t\t\tforeach ($tickets as &$ticket) {\n\t\t\t\tif ($ticket[\'raised_by\'] === $user_det[\'empdet_id\']) {\n\t\t\t\t\t$ticket[\'raised_by\'] = "YOU";\n\t\t\t\t}\n\n\t\t\t\t// Fetch tracking details for this ticket\n\t\t\t\t$this->db->from(\'ticket_track_details\');\n\t\t\t\t$this->db->where(\'ticket_id\', $ticket[\'id\']);\n\t\t\t\t$tracker_query = $this->db->get();\n\n\t\t\t\tif ($tracker_query->num_rows() > 0) {\n\