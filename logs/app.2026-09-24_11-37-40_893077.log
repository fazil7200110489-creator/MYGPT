_rows() > 0) {\n\t\t\t\t$tickets = $query->result_array();\n\t\t\t\t$this->load->model(\'admin/admin_model\');\n\n\t\t\t\tforeach ($tickets as &$ticket) {\n\t\t\t\t\t// Replace IDs with "YOU" if they match the current user\'s ID\n\t\t\t\t\tif ($ticket[\'raised_by\'] === $current_user_id) {\n\t\t\t\t\t\t$ticket[\'raised_by\'] = "YOU";\n\t\t\t\t\t}\n\t\t\t\t\tif ($ticket[\'raised_to\'] === $current_user_id) {\n\t\t\t\t\t\t$ticket[\'raised_to\'] = "YOU";\n\t\t\t\t\t}\n\n\t\t\t\t\t// Fetch tracking details for this ticket\n\t\t\t\t\t$this->db->from(\'ticket_track_details\');\n\t\t\t\t\t$this->db->where(\'ticket_id\', $ticket[\'id\']);\n\t\t\t\t\t$tracker_query = $this->db->get();\n\n\t\t\t\t\tif ($tracker_query->num_rows() > 0) {\n\t\t\t\t\t\t$trackers = $tracker_query->result_array();\n\t\t\t\t\t\tforeach ($trackers as &$tracker) {\n\t\t\t\t\t\t\t$employeeName = $this->admin_model->getempName($tracker[\'logged_by\']);\n\t\t\t\t\t\t\t$employeeDept = $this->admin_model->getempDept($tracker[\'logged_by\']);\n\t\t\t\t\t\t\t$tracker[\'emp_name\'] = $employeeName ? $employeeName->emp_name : \'Unknown\';\n\t\t\t\t\t\t\t$tracker[\'department\'] = $employeeDept ? $employeeDept->department : \'Unknown\';\n\t\t\t\t\t\t}\n\t\t\t\t\t\t$ticket[\'tracker\'] = $trackers;\n\t\t\t\t\t} else {\n\t\t\t\t\t\t$ticket[\'tracker\'] = [];\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t// Return tickets with pagination info\n\t\t\t\techo json_encode([\n\t\t\t\t\t\'status\' => \'success\',\n\t\t\t\t\t\'data\' => $tickets,\n\t\t\t\t\t\'total_count\' => $total_count,\n\t\t\t\t\t\'per_page\' => $per_page,\n\t\t\t\t\t\'current_page\' => $page\n\t\t\t\t]);\n\t\t\t} else {\n\t\t\t\t// Return error message if no tickets found\n\t\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'No tickets found.\']);\n\t\t\t}\n\t\t\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\n\t}\n\nprivate function getPriority($priority_type)\n\t{\n\t\tswitch ($priority_type) {\n\t\t\tcase \'1\':\n\t\t\t\treturn [\'name\' => \'High\', \'code\' => \'1\'];\n\t\t\tcase \'2\':\n\t\t\t\treturn [\'name\' => \'Medium\', \'code\' => \'2\'];\n\t\t\tdefault:\n\t\t\t\treturn [\'name\' => \'Low\', \'code\' => \'3\'];\n\t\t}\n\t}\n\n\n\tpublic function fetch_team_members()\n\t{\n\t\t// Get user details from session\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t$user_emp_id = $user_det[\'emp_id\'];\n\t\t$user_department = $user_det[\'department\']; // Assuming \'department\' is stored in session\n\n\t\t// Fetch the manager ID based on the logged-in user\'s emp_id\n\t\t$managerId = $this->admin_model->get_manager_id_by_emp_id($user_emp_id);\n\n\t\tif ($managerId !== null && $user_department !== \'1\') {\n\t\t\t// Fetch team members under the manager if not in top-level management\n\t\t\t$teamMembers = $this->admin_model->get_team_members($managerId);\n\t\t} else {\n\t\t\t// Top-level management: Fetch all members in the \'management\' department, excluding the user\n\t\t\t$teamMembers = $this->admin_model->get_management_members(\'1\', $user_emp_id);\n\t\t}\n\n\t\tif (!empty($teamMembers)) {\n\t\t\techo json_encode([\'status\' => \'success\', \'data\' => $teamMembers]);\n\t\t} else {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'No team members found.\']);\n\t\t}\n\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\n\t}\n\n\n\tpublic function fetch_all_employees()\n\t{\n\t\t// Get current employee details from session\n\t\t$current_employee = $this->session->userdata(\'logged_in\');\n\t\tif(isset($current_employee) && !empty($current_employee))\n\t\t{\n\t\t\t$current_employee_id = (int) $current_employee[\'empdet_id\']; // Ensure integer comparison\n\n\t\t\t// Fetch all employees\n\t\t\t$employees = $this->admin_model->get_all_employees();\n\n\t\t\tif (!empty($employees)) {\n\t\t\t\t// Filter out the current employee from the list\n\t\t\t\t$filtered_employees = array_filter($employees, function ($employee) use ($current_employee_id) {\n\t\t\t\t\treturn (int) $employee[\'id\'] !== $current_employee_id;\n\t\t\t\t});\n\n\t\t\t\t// Debug: Check the output before sending it\n\t\t\t\tif (empty($filtered_employees)) {\n\t\t\t\t\tlog_message(\'debug\', \'No employees found after filtering out current employee.\');\n\t\t\t\t}\n\n\t\t\t\techo json_encode([\n\t\t\t\t\t\'status\' => \'success\',\n\t\t\t\t\t\'data\' => array_values($filtered_employees) // Reset array keys for JSON response\n\t\t\t\t]);\n\t\t\t} else {\n\t\t\t\techo json_encode([\n\t\t\t\t\t\'status\' => \'error\',\n\t\t\t\t\t\'message\' => \'No employees found\'\n\t\t\t\t]);\n\t\t\t}\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\tpublic function tickets_export($status)\n\t{\n \t\t$employee_det = $this->session->userdata(\'logged_in\');\n \t\tif(isset($employee_det) && !empty($employee_det))\n\t\t{\n\t\t\n\t\t\t$emp_id = $employee_det[\'empdet_id\'];\n\n\n\n\t\t\t$data[\'tickets\'] = $this->admin_model->get_tickets_export($status, $emp_id);\n\t\t\t$this->load->library(\'excel\');\n\n\t\t\t$this->excel->setActiveSheetIndex(0);\n\t\t\t$this->excel->getActiveSheet()->setTitle("Ticket List");\n\n\t\t\t// Set header columns for the Excel file\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'A1\', \'Ticket ID\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B1\', \'Raised By\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'C1\', \'Raised To\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D1\', \'Ticket Type\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E1\', \'User Priority\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F1\', \'Admin Priority\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G1\', \'Description\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H1\', \'Title\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I1\', \'Status\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J1\', \'Created At\');\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'K1\', \'Updated At\');\n\n\t\t\t// Set each column as bold\n\t\t\tfor ($col = \'A\'; $col <= \'K\'; $col++) {\n\t\t\t\t$this->excel->getActiveSheet()->getStyle($col . \'1\')->getFont()->setBold(true);\n\t\t\t}\n\n\t\t\t$i = 2;\n\t\t\tforeach ($data[\'tickets\'] as $ticket) {\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'A\' . $i, $ticket[\'ticket_id\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B\' . $i, $ticket[\'raised_by\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'C\' . $i, $ticket[\'raised_to\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D\' . $i, $ticket[\'ticket_type\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E\' . $i, $ticket[\'user_priority\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F\' . $i, $ticket[\'admin_priority\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G\' . $i, $ticket[\'description\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H\' . $i, $ticket[\'title\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I\' . $i, $ticket[\'status\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J\' . $i, $ticket[\'created_at\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'K\' . $i, $ticket[\'updated_at\']);\n\t\t\t\t$i++;\n\t\t\t}\n\n\t\t\t$filename = "Ticket_List_Status_" . $status . "_" . date("Y-m-d") . ".xls";\n\t\t\theader(\'Content-Type: application/vnd.ms-excel\');\n\t\t\theader(\'Content-Disposition: attachment;filename="\' . $filename . \'"\');\n\t\t\theader(\'Cache-Control: max-age=0\');\n\t\t\t$objWriter = PHPExcel_IOFactory::createWriter($this->excel, \'Excel2007\');\n\t\t\t$objWriter->save(\'php://output\');\n\t\t\texit;\n\n\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t\t}\t\n\t}\n\n\n\n\tpublic function add_activity_list(){\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$this->template->write_view(\'content\',\'admin/add_activity_list_details\');\n\t\t$this->template->render();\n\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\t\n\t}\n\t\n\tpublic function add_sliders(){\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\t$this->template->write_view(\'content\',\'admin/add_sliders\');\n\t\t\t$this->template->render();\n\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\t\n\t}\n\t\n\n\t\n\t\n      \n\npublic function insert_activity_list(){\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n \t\t$inps = $this->input->post();\n\t  \n\t\tif($this->input->post())\n\t\t{\n\t\t\t// echo"<pre>"; print_r($user_det); \n\t\t\t// echo"<pre>"; print_r($inps);exit;\n\t\n\t\t\t$this->db->select(\'*\');\n\t\t\t$this->db->where(\'department\',$user_det[\'department\']); \n\t\t\t$this->db->where(\'activity_list\',$inps[\'activity_list_name\']); \n\t\t\t$activity_details = $this->db->get(\'activity_det\')->num_rows();\n\t\t\t//echo"<pre>"; print_r($activity_details); exit;    \n\t\t\tif($activity_details > 0){\n\t\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Activity Name Already Exists..!\');\n\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/add_activity_list\');\n\t\t\t\t\n\t\t\t} else {\n\t\n\t\t\t\t$data = array(\'department\'=>$user_det[\'department\'], \'activity_list\'=>$inps[\'activity_list_name\'],\'created_by\'=>$user_det[\'empdet_id\'], \'status\'=>1);\n\t\t\t\t//$this->db->last_query();\n\t\n\t\t\t\t$sql_query = $this->db->insert(\'activity_det\', $data);\n\t\t\t\t$id = $this->db->insert_id();\n\t\t\t\t// echo"<pre>id";print_r($id);exit;\n\t\t\t\tif($sql_query > 0){\n\t\n\t\t\t\t\t$this->session->set_flashdata(\'true\', \'Activity Name Added Successfully...!\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/add_activity_list\');\n\t\t\t\t\t//echo"success";exit;\n\t\t\t\t} else {\n\t\t\t\t\t\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Something went wrong. Error!!\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/add_activity_list\');\n\t\t\t\t\t//echo"Failed";exit;\n\t\t\t\t}\n\t\t\t} \n\t\t} else {\n\t\n\t\t\t$this->template->set_master_template(\'../../themes/\'.$this->config->item("active_template").\'/landing_template_login.php\');\n\t\t\t$this->template->write_view(\'content\', \'admin/add_activity_list\');\n\t\t\t$this->template->render();\n\t\t}\n\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\t\n      \n\n\tpublic function view_task_list() {\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\t$data[\'task_list\'] = $this->admin_model->get_all_tasks($department); // Fetch tasks from the database\n\t\t\t$this->template->write_view(\'content\', \'admin/task_list\', $data); // Load view with task data\n\t\t\t$this->template->render();\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\t}\n\t\n\tpublic function view_activity_list() {\n\t\n\t\t// Get logged-in user details\n\t   $user_det = $this->session->userdata(\'logged_in\');\n\t\tif(isset($user_det) && !empty($user_det))\n\t\t{\n\t\t\n\t \n\t\t$data[\'activity\'] = $this->admin_model->get_all_activity($department);\n\t\t$this->template->write_view(\'content\', \'admin/activity_list\', $data); // Load view with activity data\n\t\t$this->template->render();\n\t\t// echo"<pre>"; print_r($user_det);exit;\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n        \t\t\n\t}\n\n\tpublic function request_form() {\n\t        \n\t $employee_det = $this->session->userdata(\'logged_in\');\n\n\t if(isset($employee_det) && !empty($employee_det))\n\t\t{\n\t\t\n\t \n\t\t\t$emp_id=$employee_det[\'emp_id\'];\n\t\t\t$data[\'groupedItems\']     =$this->admin_model->get_project_Approvals();\n\n \t\t\t$data[\'empList\'] = $this->admin_model->getmanagement_manager();\n\t\t\t$this->template->write_view(\'content\', \'admin/request_form\', $data);\n\t\t\t$this->template->render();\n\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n\n\t}\n\n\t public function insert_project_form() {\n\n\t\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\t       //    echo "<pre>"; print_r($employee_det); exit;\n\t\t\t   \n\t\t\tif (isset($employee_det) && !empty($employee_det)) {\n\n\n\t\t\t\t\t$inps = $this->input->post();\n\t\t\t\t\t// echo"<pre>"; print_r($inps); exit;\n\t\t\t\t\tif($this->input->post())\n\t\t\t\t\t{\n\n\t\t\t\t\t\t$this->db->select(\'*\');\n\t\t\t\t\t\t\t$this->db->where(\'emp_id\',$employee_det[\'empdet_id\']); \n\t\t\t\t\t\t\t$this->db->where(\'from_date\',$inps[\'from_date\']); \n\t\t\t\t\t\t\t$this->db->where(\'to_date\',$inps[\'to_date\']); \n\t\t\t\t\t\t\t//$this->db->where(\'project_name\',$inps[\'project_name\']); \n\t\t\t\t\t\t\t$this->db->where(\'entry_type\',$inps[\'entry_type\']); \n\t\t\t\t\t\t\t$project_details = $this->db->get(\'LeaveProjectRequest_Form\')->num_rows();\n\t\t\t\t\t\t\t//echo"<pre>"; print_r($project_details); exit;    \n\n\t\t\t\t\t\t\tif($project_details > 0){\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Request Already Submitted for the Selected Date..!\');\n\t\t\t\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/request_form\');\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t} else {\n\n\t\t\t\t\t\t\t // echo "<pre>"; print_r($inps); exit;\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t $data = array(\'emp_id\'=> $employee_det[\'empdet_id\'],\'rm_id\'=> $employee_det[\'report_mgr_id\'],\'entry_type\'=> $inps[\'entry_type\'],\'desc\'=> $inps[\'description\'],\'from_date\'=> $inps[\'from_date\'],\'to_date\'=> $inps[\'to_date\'],\'project_name\'=> $inps[\'project_name\'],\'assigned_by\'=> $inps[\'assigned_by_id\'],\'onduty_task\'=> $inps[\'onduty_task\'],\'leave_type\'=> $inps[\'leave_type\'],\'leave_session\'=> $inps[\'leave_session\'],\'leave_reason\'=> $inps[\'leave_reason\'],\'status\'=> 0); \n\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t $sql_query = $this->db->insert(\'LeaveProjectRequest_Form\', $data); \n\t\t\t\t\t\t\t\t $slpno = $this->db->insert_id(); //  Gets the inserted slpno\n\n\t\t\t\t\t\t\t\t$ad_task = array(\'slpno\' => $slpno ,\'type\' => 2, \'initiator_id\' => $employee_det[\'empdet_id\'], \'receiver_id\' => $employee_det[\'report_mgr_id\'], \'from_date\' => $inps[\'from_date\'],\'to_date\' => $inps[\'to_date\'] );\n\t\t\t\t\t\t\t\t  // $this->db->last_query();\n\t\t\t\t\t\t\t\t  // echo "<pre>ad_task"; print_r($ad_task); exit;\n\n\t\t\t\t\t\t\t\t$notification_query = $this->db->insert(\'notification_det\', $ad_task);\n\t\t\t\t\t\t\t\t// $slpno = $this->db->insert_id();\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tif ($sql_query > 0) {\n\n\t\t\t\t\t\t\t\t\t$this->session->set_flashdata(\'true\', \'Form Submitted Successfully\');\n\t\t\t\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/request_form\');\n\n\t\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to Submit the Form. Please Try Again..!\');\n\t\t\t\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/request_form\');\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t} else {\n\t\n\t\t\t\t\t\t$this->session->set_flashdata(\'err\', \'No Inputs received. Please Try Again..!!\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/request_form\');\n\t\t\t\t\t}\n\n\n\t\t\t  } else {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again..!!\');\n\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t\t}\n\t\t\n\t\t}\n\n\n\n\t\tpublic function request_form_reports()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\t\t// echo print_r($employee_det);exit;\n\n\t\tif (isset($employee_det) && !empty($employee_det)) {\n\t\t\t$filters = $this->input->post(); // Get filter inputs from form\n\t\t\t$data[\'filters\'] = $filters;\n\n\t\t\t$empdet_id = $employee_det[\'empdet_id\'];\n\t\t\t$emp_id = $employee_det[\'emp_id\'];\n\t\t\t$role_type = $employee_det[\'role_type\']; // Assuming this is set in session\n\n\t\t\t$data[\'role_type\'] = $role_type; // Pass role_type to view\n\n\t\t\t\t$data[\'project_tasks\'] = $this->admin_model->get_project_task_reports($emp_id, $filters);\n\t\t\t\t$data[\'lists\'] = $this->admin_model->get_members_list($emp_id); // For filter dropdown\n\n\t\t\t// if ($role_type == 1) {\n\n\t\t\t// \t$data[\'project_tasks\'] = $this->admin_model->get_project_task_reports($emp_id, $filters);\n\t\t\t// \t$data[\'lists\'] = $this->admin_model->get_members_list($emp_id); // For filter dropdown\n\t\t\t// } elseif ($role_type == 2) {\n\t\t\t// \t// Manager - show team members\' entries\n\t\t\t// \t$data[\'project_tasks\'] = $this->admin_model->get_project_task_reports($emp_id, $filters);\n\t\t\t// \t$data[\'lists\'] = $this->admin_model->get_members_list($emp_id); // For filter dropdown\n\t\t\t// } else {\n\t\t\t// \t// Employee - show only own entries\n\t\t\t// \t$data[\'project_tasks\'] = $this->admin_model->get_my_request_reports($empdet_id, $filters);\n\t\t\t// \t$data[\'lists\'] = []; // No need to show member list dropdown\n\t\t\t// }\n\n\t\t\t$this->template->write_view(\'content\', \'admin/request_form_reports\', $data);\n\t\t\t$this->template->render();\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t}\n\t}\n\n\n  public function approve_task() {\n\n  \t $employee_det = $this->session->userdata(\'logged_in\');\n\n\t if(isset($employee_det) && !empty($employee_det))\n\t {\n        $task_id = $this->input->post(\'slpno\');\n\n\t      $action = $this->input->post(\'action\');\n\n\t        if ($task_id) {\n\n\t            if ($action == \'approve\') {\n\t                // Update status to approved\n\t                $this->db->where(\'slpno\', $task_id);\n\t                $this->db->update(\'LeaveProjectRequest_Form\', [\'status\' => 1]); \n\n\t                $this->session->set_flashdata(\'success\', \'Approved Successfully.\');\n\t                redirect($this->config->item(\'base_url\') . \'admin/request_form_reports\');\n\n\t            } elseif ($action == \'reject\') {\n\t                $this->db->where(\'slpno\', $task_id);\n\t                $this->db->update(\'LeaveProjectRequest_Form\', [\'status\' => 2]);\n\t                $this->session->set_flashdata(\'error\', \'Task rejected.\');\n\t                 redirect($this->config->item(\'base_url\') . \'admin/request_form_reports\');\n\t            }\n\n\t        } else {\n\n\t            $this->session->set_flashdata(\'error\', \'Task ID missing.\');\n\t             redirect($this->config->item(\'base_url\') . \'admin/request_form_reports\');\n\t        }\n\n\t       \t\t // redirect(\'admin/request_form_reports\');  // Adjust to your route\n\n        } else {\n\t\t\t$this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\').\'admin/index\');\n\t\t}\n    }\n\n\n    \n\n\n\t// //Edit_delete_task 21-05-2025 (Anantha Hariharan V)\n\tpublic function edit_delete_task()\n\t{\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\t\t//  echo print_r($user_det);exit; \n\n\t\tif (isset($user_det) && !empty($user_det)) {\n\t\t\t$inputs = $this->input->post();\n\n\t\t\t$emp_id = $user_det[\'emp_id\'];\n  $empdet_id = $user_det[\'empdet_id\'];\n\t\t\t$department = $user_det[\'department\'];\n\n\t\t\t//  Use model functions\n\t\t\t$data[\'edit_reports\'] = $this->admin_model->get_edit_delete($empdet_id, $inputs);\n\t\t\t$data[\'projects\'] = $this->admin_model->get_projects_export();\n\t\t\t$data[\'lists\'] = $this->admin_model->get_members_list($emp_id);\n\n\t\t\t$this->template->write_view(\'content\', \'admin/edit_delete\', $data);\n\t\t\t$this->template->render();\n\t\t} else {\n\t\t\tredirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again..!!\');\n\t\t}\n\t}\n\n\tpublic function my_request_form()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\n\t\t//  echo print_r($employee_det);exit;\n\n\t\tif (isset($employee_det) && !empty($employee_det)) {\n\n\t\t\t$emp_id = $employee_det[\'empdet_id\'];\n\t\t\t$data[\'reports\'] = $this->admin_model->get_my_request_reports($emp_id);\n\t\t\t$this->template->write_view(\'content\', \'admin/my_request_form\', $data);\n\t\t\t$this->template->render();\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t}\n\t}\n\n\tpublic function update_to_date_form()\n\t{\n\t\t$employee_det = $this->session->userdata(\'logged_in\');\n\n\t\tif (isset($employee_det) && !empty($employee_det)) {\n\n\t\t\t$sno = $this->input->post(\'slpno\');\n\t\t\t$new_to_date = $this->input->post(\'new_to_date\');\n\n\t\t\tif (!empty($sno) && !empty($new_to_date)) {\n\n\t\t\t\t// Get the existing status from DB\n\t\t\t\t$this->db->where(\'slpno\', $sno);\n\t\t\t\t$existing_data = $this->db->get(\'LeaveProjectRequest_Form\')->row_array();\n\n\t\t\t\tif ($existing_data) {\n\t\t\t\t\tif ($existing_data[\'status\'] == 1) {\n\t\t\t\t\t\t// If status is Approved, don\'t allow update\n\t\t\t\t\t\t$this->session->set_flashdata(\'error\', \'Failed to update End Date. Request already Approved!\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/my_request_form\');\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\n\t\t\t\t\t// Allow update if not approved\n\t\t\t\t\t$this->db->where(\'slpno\', $sno);\n\t\t\t\t\t$this->db->update(\'LeaveProjectRequest_Form\', [\'to_date\' => $new_to_date, \'status\' => 0]);\n\n\t\t\t\t\t$this->session->set_flashdata(\'success\', \'Project End Date Updated Successfully!\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/my_request_form\');\n\t\t\t\t} else {\n\t\t\t\t\t$this->session->set_flashdata(\'error\', \'Request not found.\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/my_request_form\');\n\t\t\t\t}\n\n\t\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'error\', \'Invalid Input. Please Try Again\');\n\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/my_request_form\');\n\t\t\t}\n\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again.\');\n\t\t\tredirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t}\n\t}\n\n\npublic function team_time_sheet()\n{\n    $user_det = $this->session->userdata(\'logged_in\');\n\n    if (isset($user_det) && !empty($user_det)) {\n        $inputs = $this->input->post();\n        $emp_id = $user_det[\'id\']; // Use ID, not emp_id here\n\t\t$emp_id = $user_det[\'emp_id\'];\n\n        if (isset($inputs) && !empty($inputs)) {\n            $data[\'filters\'] = $inputs;\n            $data[\'lists\'] = $this->admin_model->get_members_list($emp_id);\n            $data[\'team_time_sheet\'] = $this->admin_model->get_team_daily_time_sheet($emp_id, $inputs);\n        } else {\n            $inputs = "";\n            $data[\'lists\'] = $this->admin_model->get_members_list($emp_id);\n            $data[\'team_time_sheet\'] = $this->admin_model->get_team_daily_time_sheet($emp_id, $inputs);\n        }\n\n        $this->template->write_view(\'content\',\'admin/team_members_time_sheet\', $data);\n        $this->template->render();\n\n    } else {\n        $this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\') . \'admin/index\');\n    }\n}\n\tpublic function mark_notification_read()\n\t{\n\t\t$input = json_decode(file_get_contents("php://input"), true);\n\n\t\tif (!isset($input[\'notificationId\'])) {\n\t\t\techo json_encode([\'status\' => \'error\', \'message\' => \'Invalid ID\']);\n\t\t\treturn;\n\t\t}\n\t\t$updated = $this->admin_model->update_notification_as_read($input[\'notificationId\']);\n\n\t\tif ($updated) {\n\t\t\techo json_encode([\'status\' => \'success\']);\n\t\t} else {\n\t\t\techo json_encode([\'status\' => \'error\']);\n\t\t}\n\t}\nprotected function format_notification_date($date)\n\t{\n\t\tif (empty($date) || $date === \'0000-00-00 00:00:00.000000\') {\n\t\t\treturn \'Just now\';\n\t\t}\n\n\t\t$timestamp = strtotime($date);\n\t\t$now = time();\n\t\t$diff = $now - $timestamp;\n\n\t\tif ($diff < 60)\n\t\t\treturn \'Just now\';\n\t\tif ($diff < 3600)\n\t\t\treturn floor($diff / 60) . \' minutes ago\';\n\t\tif ($diff < 86400)\n\t\t\treturn floor($diff / 3600) . \' hours ago\';\n\n\t\treturn date(\'M j, Y g:i A\', $timestamp);\n\t}\n\n\t/**\n\t * Formats due date for display\n\t */\n\tprotected function format_due_date($date)\n\t{\n\t\tif (empty($date) || $date === \'0000-00-00\') {\n\t\t\treturn \'No due date\';\n\t\t}\n\n\t\treturn date(\'M j, Y\', strtotime($date));\n\t}\n\n\tpublic function leave_export() \n\t  {\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\n\t\t// echo "<pre>HELLO"; print_r($usersess_det); exit;\n\n\t\tif (isset($usersess_det) && !empty($usersess_det)) {\n\t\t\t$data[\'leave\'] = $this->admin_model->get_leave_export();\n\t\t\t// echo "<pre>HELLO"; print_r( $data[\'leave\']); exit;\n\t\t\t$this->load->library(\'excel\');\n\n\t\t\t$this->excel->setActiveSheetIndex(0);\n\t\t\t$this->excel->getActiveSheet()->setTitle("Employee Submitted List");\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'A1\', \'S.No\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'A1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B1\', \'Employee Id\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'B1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'C1\', \'Name\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'C1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D1\', \'Phone No\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'D1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E1\', \'E-mail ID\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'E1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F1\', \'Department\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'F1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G1\', \'Designation\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'G1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H1\', \'DOJ\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'H1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I1\', \'Work Location\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'I1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J1\', \'Reporting Manager\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'J1\')->getFont()->setBold(true);\n\n\t\t\t$i = 2;\n\t\t\tforeach ($data[\'leave\'] as $val) {\n\t\t\t\t$sn = $i - 1;\n\t\t\t\t\t// $emp_name = $this->admin_model->get_employee_name_by_id($val[\'emp_id\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'A\' . $i, $sn);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B\' . $i, $val[\'emp_id\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'C\' . $i, $val[\'emp_name\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D\' . $i, $val[\'mob_no\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E\' . $i, $val[\'email_id\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F\' . $i, $val[\'department\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G\' . $i, $val[\'designation\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H\' . $i, $val[\'join_dt\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I\' . $i, $val[\'work_loc\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J\' . $i, $val[\'reprt_mger_name\']);\n\n\t\t\t\t$i++;\n\n\t\t\t}\n\n\t\t\t$filename = "Leave List Export_" . date("Y-m-d") . ".xls";\n\t\t\theader(\'Content-Type: application/vnd.ms-excel\');\n\t\t\theader(\'Content-Disposition: attachment;filename="\' . $filename . \'"\');\n\t\t\theader(\'Cache-Control: max-age=0\');\n\t\t\t$objWriter = PHPExcel_IOFactory::createWriter($this->excel, \'Excel2007\');\n\t\t\t$objWriter->save(\'php://output\');\n\t\t\texit;\n\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t}\n\n\n\t  }\n\n\n\t  \n\tpublic function project_export()\n\t{\n\t\t$usersess_det = $this->session->userdata(\'logged_in\');\n\n\t\t// echo "<pre>HELLO"; print_r($usersess_det); exit;\n\t\tif (isset($usersess_det) && !empty($usersess_det)) {\n\t\t\t$data[\'project\'] = $this->admin_model-> get_project_export();\n\t\t\t$this->load->library(\'excel\');\n\n\t\t\t$this->excel->setActiveSheetIndex(0);\n\t\t\t$this->excel->getActiveSheet()->setTitle("Employee Submitted List");\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'A1\', \'S.No\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'A1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B1\', \'Employee Id\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'B1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'C1\', \'Name\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'C1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D1\', \'Phone No\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'D1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E1\', \'E-mail ID\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'E1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F1\', \'Department\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'F1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G1\', \'Designation\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'G1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H1\', \'DOJ\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'H1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I1\', \'Work Location\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'I1\')->getFont()->setBold(true);\n\n\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J1\', \'Reporting Manager\');\n\t\t\t$this->excel->getActiveSheet()->getStyle(\'J1\')->getFont()->setBold(true);\n\n\t\t\t$i = 2;\n\t\t\tforeach ($data[\'project\'] as $val) {\n\t\t\t\t$sn = $i - 1;\n\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'A\' . $i, $sn);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'B\' . $i, $val[\'emp_id\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'C\' . $i, $val[\'emp_name\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'D\' . $i, $val[\'mob_no\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'E\' . $i, $val[\'email_id\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'F\' . $i, $val[\'department\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'G\' . $i, $val[\'designation\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'H\' . $i, $val[\'join_dt\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'I\' . $i, $val[\'work_loc\']);\n\t\t\t\t$this->excel->getActiveSheet()->setCellValue(\'J\' . $i, $val[\'reprt_mger_name\']);\n\n\t\t\t\t$i++;\n\n\t\t\t}\n\n\t\t\t$filename = "Employee Submitted List Export_" . date("Y-m-d") . ".xls";\n\t\t\theader(\'Content-Type: application/vnd.ms-excel\');\n\t\t\theader(\'Content-Disposition: attachment;filename="\' . $filename . \'"\');\n\t\t\theader(\'Cache-Control: max-age=0\');\n\t\t\t$objWriter = PHPExcel_IOFactory::createWriter($this->excel, \'Excel2007\');\n\t\t\t$objWriter->save(\'php://output\');\n\t\t\texit;\n\n\t\t} else {\n\t\t\t$this->session->set_flashdata(\'err\', \'Invalid Session.Please Login Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t}\n\n\n\t}\npublic function get_employee_name()\n\t{\n\t\t$emp_id = $this->input->post(\'emp_id\');\n\t\t$this->load->model(\'admin/admin_model\');\n\t\t$employee = $this->admin_model->get_employee_by_id($emp_id);\n\n\t\tif ($employee) {\n\t\t\techo json_encode([\'status\' => \'success\', \'name\' => $employee->emp_name, \'id\' => $employee->id, \'mgr_id\' => $employee->report_mgr_id]);\n\t\t} else {\n\t\t\techo json_encode([\'status\' => \'not_found\']);\n\t\t}\n\t}\n\npublic function Employee_Request_form()\n\t{\n\n\t\t$data[\'groupedItems\'] = $this->admin_model->get_project_Approvals();\n\t\t$data[\'empList\'] = $this->admin_model->getmanagement_manager();\n\t\t// $data[\'lists\'] = $this->admin_model->get_all_employees();\n\t\t$this->template->set_master_template(\'../../themes/\' . $this->config->item("active_template") . \'/landing_template_login.php\');\n\n\t\t$this->template->write_view(\'content\', \'user/user_request_form\', $data);\n\t\t$this->template->render();\n\n\t}\n\n\tpublic function user_project_form()\n\t{\n\t\t$inps = $this->input->post();\n\t\t//  echo print_r($inps);exit;\n\n\n\n\t\t// if ($inps) {\n\n\n\n\t\t// \t$data = array(\'emp_id\' => $inps[\'emp_primary_id\'], \'rm_id\' => $inps[\'reporting_manager_id\'],\'entry_type\'=> $inps[\'entry_type\'],\'desc\'=> $inps[\'description\'],\'from_date\'=> $inps[\'from_date\'],\'to_date\'=> $inps[\'to_date\'],\'project_name\'=> $inps[\'project_name\'],\'assigned_by\'=> $inps[\'assigned_by_id\'],\'onduty_task\'=> $inps[\'onduty_task\'],\'leave_type\'=> $inps[\'leave_type\'],\'leave_session\'=> $inps[\'leave_session\'],\'leave_reason\'=> $inps[\'leave_reason\'],\'status\'=> 0);\t\t\t\t\t\t\t\t \n\n\t\t// \t$sql_query = $this->db->insert(\'LeaveProjectRequest_Form\', $data);\n\t\t// \t$slpno = $this->db->insert_id(); //  Gets the inserted slpno\n\n\t\t// \t$ad_task = array(\'slpno\' => $slpno ,\'type\' => 2, \'initiator_id\' => $employee_det[\'empdet_id\'], \'receiver_id\' => $inps[\'reporting_manager_id\'], \'from_date\' => $inps[\'from_date\'],\'to_date\' => $inps[\'to_date\'] );\n\t\t// \t\t\t\t\t  // $this->db->last_query();\n\t\t// \t\t\t\t\t  // echo "<pre>ad_task"; print_r($ad_task); exit;\n\n\t\t// \t$notification_query = $this->db->insert(\'notification_det\', $ad_task);\n\n\n\t\t// \tif ($sql_query) {\n\t\t// \t\t$this->session->set_flashdata(\'true\', \'User Form Submitted Successfully\');\n\t\t// \t} else {\n\t\t// \t\t$this->session->set_flashdata(\'err\', \'Failed to Submit the Form. Please Try Again..!\');\n\t\t// \t}\n\n\t\t// \tredirect($this->config->item(\'base_url\') . \'admin/user_request_form\');\n\t\t// } else {\n\t\t// \t$this->session->set_flashdata(\'err\', \'No data received.\');\n\t\t// \tredirect($this->config->item(\'base_url\') . \'admin/user_request_form\');\n\t\t// }\n\n\t\tif($this->input->post())\n\t\t{\n\t\t\t\t \n\t\t\t\t$this->db->select(\'*\');\n\t\t\t\t$this->db->where(\'emp_id\',$inps[\'emp_primary_id\']); \n\t\t\t\t$this->db->where(\'from_date\',$inps[\'from_date\']); \n\t\t\t\t$this->db->where(\'to_date\',$inps[\'to_date\']); \n\t\t\t\t//$this->db->where(\'project_name\',$inps[\'project_name\']); \n\t\t\t\t$this->db->where(\'entry_type\',$inps[\'entry_type\']); \n\t\t\t\t$project_details = $this->db->get(\'LeaveProjectRequest_Form\')->num_rows();\n\t\t\t\t//echo"<pre>"; print_r($project_details); exit;    \n\n\t\t\t\tif($project_details > 0){\n\t\t\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Request Already Submitted for the Selected Date..!\');\n\t\t\t\t\tredirect($this->config->item(\'base_url\').\'admin/Employee_Request_form\');\n\t\t\t\t\t\n\t\t\t\t} else {\n\n\t\t\t\t // echo "<pre>"; print_r($inps); exit;\n\t\t\t\n\t\t\t\t\t $data = array(\'emp_id\'=> $inps[\'emp_primary_id\'],\'rm_id\'=> $inps[\'reporting_manager_id\'],\'entry_type\'=> $inps[\'entry_type\'],\'desc\'=> $inps[\'description\'],\'from_date\'=> $inps[\'from_date\'],\'to_date\'=> $inps[\'to_date\'],\'project_name\'=> $inps[\'project_name\'],\'assigned_by\'=> $inps[\'assigned_by_id\'],\'onduty_task\'=> $inps[\'onduty_task\'],\'leave_type\'=> $inps[\'leave_type\'],\'leave_session\'=> $inps[\'leave_session\'],\'leave_reason\'=> $inps[\'leave_reason\'],\'status\'=> 0); \n\t\t\t\t\t \n\t\t\t\t\t $sql_query = $this->db->insert(\'LeaveProjectRequest_Form\', $data); \n\n\n\t\t\t\t\t$slpno = $this->db->insert_id(); //  Gets the inserted slpno\n\n\t\t\t\t\tif($inps[\'entry_type\']!="3"){\n\n\t\t\t\t\t\t$ad_task = array(\'slpno\' => $slpno ,\'type\' => 2, \'initiator_id\' => $inps[\'emp_primary_id\'], \'receiver_id\' => $inps[\'reporting_manager_id\'], \'from_date\' => $inps[\'from_date\'],\'to_date\' => $inps[\'to_date\'] );\n\t\t\t\t\t\t// $this->db->last_query();\n\n\t\t\t\t\t\t$sql_query = $this->db->insert(\'notification_det\', $ad_task);\n\t\t\t\t\t\t// $slpno = $this->db->insert_id();\n\n\t\t\t\t\t} else {\n\n\n\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\n\t\t\t\t\tif ($sql_query > 0) {\n\n\t\t\t\t\t\t$this->session->set_flashdata(\'true\', \'Form Submitted Successfully\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/Employee_Request_form\');\n\n\t\t\t\t\t} else {\n\t\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to Submit the Form. Please Try Again..!\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/Employee_Request_form\');\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t} else {\n\n\t\t\t$this->session->set_flashdata(\'err\', \'No Inputs received. Please Try Again..!!\');\n\t\t\tredirect($this->config->item(\'base_url\') . \'admin/Employee_Request_form\');\n\t\t}\n\n\n\t}\t\n\n\npublic function show_attendance_report()\n    {\n        $this->load->model(\'admin_model\');\n\n        //  Get attendance data\n        $records = $this->admin_model->get_attendance_data(); \n\n        if (!is_array($records) || empty($records)) {\n\n            $records = [];\n        }\n\n        $grouped = [];\n        $departments = [];\n\n        foreach ($records as $row) {\n\t\t// echo "<pre>"; print_r($records); exit;\n\n            $emp_no = $row[\'EmployeeNo\'];\n            $name = $row[\'EmployeeName\'];\n            $date = $row[\'Date\'];\n            $dept = $row[\'Department\'];\n\t\t$status = $row[\'Status\'];\n\n\n            $departments[$dept] = $dept;\n\n            if (!isset($grouped[$dept])) {\n                $grouped[$dept] = [];\n            }\n\n            if (!isset($grouped[$dept][$emp_no])) {\n                $grouped[$dept][$emp_no] = [\n                    \'emp_no\' => $emp_no,\n                    \'name\' => $name,\n                    \'shift_name\' => $row[\'ShiftName\'],\n                    \'dates\' => [],\n                    \'department\' => $dept\n                ];\n            }\n\n            $grouped[$dept][$emp_no][\'dates\'][$date] = [\n\t\t\t\t\n\t\t \'LateIn\' => $row[\'LateinHours\'] ?? \'00:00:00\',\n                \'InTime\' => $row[\'InTime\'] ?? \'--:--:--\',\n                \'OutTime\' => $row[\'OutTime\'] ?? \'--:--:--\',\n                \'Status\' => $row[\'Status\'] ?? \'N/A\'\n            ];\n\t\t\t// echo "<pre>";print_r($grouped[$dept][$emp_no][\'dates\']); exit;\n        }\n\n        // Set date range (from 26 of last month to 25 of current month)\n        $today = new DateTime();\n\t\t// echo $today->format(\'Y-m-d\');exit;\n\n        $currentYear = $today->format(\'Y\');\n        $currentMonth = $today->format(\'m\');\n\n        $start = new DateTime("$currentYear-$currentMonth-26");\n        $start->modify(\'-1 month\');\n\n        $end = new DateTime("$currentYear-$currentMonth-25");\n        $end->modify(\'+1 day\'); // Include 25th\n\n        $startDate = $start->format(\'Y-m-d\');\n        $endDate = $end->format(\'Y-m-d\');\n\n        // Get distinct dates\n        $dates_result = $this->admin_model->getDistinctDates($startDate, $endDate);\n\n        $distinctDates = [];\n        foreach ($dates_result as $obj) {\n            $distinctDates[] = $obj->Date;\n        }\n \t// echo "<pre>"; print_r($dates_result); exit;\n\n        //  Prepare flattened employees array\n        $all_employees = [];\n        foreach ($grouped as $dept => $emps) {\n            foreach ($emps as $emp) {\n                $all_employees[] = $emp;\n            }\n        }\n\n        //  Send data to view\n        $data[\'distinctDates\'] = $distinctDates;\n        $data[\'departments\'] = $departments;\n        $data[\'grouped_employees\'] = $grouped;\n        $data[\'all_employees\'] = $all_employees;\n//echo "<pre>"; print_r($data[\'all_employees\']); exit;\n\n\n        $this->template->write_view(\'content\', \'admin/attendance_report_view\', $data);\n        $this->template->render();\n    }\n\n\tpublic function newsletter()\n\t{\n    \t  \t$this->template->set_master_template(\'../../themes/\' . $this->config->item("active_template") . \'/landing_template_login.php\');\n\n\t\t$this->template->write_view(\'content\', \'user/newsletter\', $data);\n\t\t$this->template->render();\n\t\t  \n\t\t \n\t}\n\n\tpublic function save_newsletter(){\n\n\n\t\t$inps = $this->input->post();\n\t\t//  echo print_r($inps);exit;\n\n \n\t\tif($this->input->post())\n\t\t{\n\t\t\t // Save data to DB\n\t\t        $data = array(\n\t\t            \'satisfaction\'        => $this->input->post(\'satisfaction\'),\n\t\t            \'sections\'            => implode(", ", (array) $this->input->post(\'sections\')),\n\t\t            \'sections_other\'      => $this->input->post(\'sections_other\'),\n\t\t            \'future_suggestions\'  => $this->input->post(\'future_suggestions\'),\n\t\t            \'design\'              => $this->input->post(\'design\'),\n\t\t            \'personal_connection\' => $this->input->post(\'personal_connection\'),\n\t\t            \'contribute\'          => $this->input->post(\'contribute\'),\n\t\t            \'read_frequency\'      => $this->input->post(\'read_frequency\'),\n\t\t            \'format\'              => $this->input->post(\'format\'),\n\t\t            \'additional_content\'  => implode(", ", (array) $this->input->post(\'additional_content\')),\n\t\t            \'additional_other\'    => $this->input->post(\'additional_other\'),\n\t\t            \'recommend\'           => $this->input->post(\'recommend\'),\n\t\t            \'employee_id\'           => $this->input->post(\'employee_id\'),\n\t\t        );\n\n\t\t        $this->db->insert(\'newsletter_feedback\', $data);\n\n\t\t\t\t$slpno = $this->db->insert_id(); //  Gets the inserted slpno \n\t\t\t\t\t\n\t\t\t\n\t\t\t\t\tif ($slpno > 0) {\n\n\t\t\t\t\t\t$this->session->set_flashdata(\'true\', \'Form Submitted Successfully\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/newsletter\');\n\n\t\t\t\t\t} else {\n\t\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to Submit the Form. Please Try Again..!\');\n\t\t\t\t\t\tredirect($this->config->item(\'base_url\') . \'admin/newsletter\');\n\t\t\t\t\t}\n\n\t\t} else {\n\n\t\t\t\t$this->session->set_flashdata(\'err\', \'No Inputs Received. Please Try Again..!\');\n\t\t   \t\t $this->template->set_master_template(\'../../themes/\'.$this->config->item("active_template").\'/landing_template_login.php\');\n\t\t\t\t$this->template->write_view(\'content\', \'admin/newsletter\');\n\t\t\t\t$this->template->render();\n\t\t   \t}\n\n\t}\n\n\n\tpublic function upload_sheet() {\n\t\t\n\t\t$user_det = $this->session->userdata(\'logged_in\');\n\n\t\tif (isset($user_det) && !empty($user_det)) {\n\t\t\n\t\t$this->template->write_view(\'content\', \'admin/upload_sheet\');\n\t\t$this->template->render();\n\t\t$this->session->set_flashdata(\'err\', \'Invalid Session.Please Login Again..!!\');\n\t   \n\t   } else {\n       \t\t $this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again..!!\');\n       \t\t redirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t}\n\t}\n\n\n public function upload_csv()\n    {\n\t$user_det = $this->session->userdata(\'logged_in\');\n\n\tif (isset($user_det) && !empty($user_det)) {\n\n\t\t  $selected_date = $this->input->post(\'date\'); \n\t\t//   $selected_date = date(\'Y-m-d\', strtotime($selected_date));\n\n            // ?? Check if data for this date already exists\n    \t\t$existing = $this->admin_model->check_attendance_date_exists($selected_date);\n\n\t\t\tif ($existing) {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Attendance for this date already uploaded!\');\n\t\t\t\tredirect(\'admin/upload_sheet\'); // redirect to same page\n\t\t\t\treturn;\n\t\t\t}\n\n\n   \t\t  // $today = date(\'Y-m-d\'); // Current date\n\t\t  // echo $selected_date; exit;\n        if (!empty($_FILES[\'attendance_file\'][\'name\'])) {\n            $file = $_FILES[\'attendance_file\'][\'tmp_name\'];\n            $handle = fopen($file, "r");\n\n            $header = fgetcsv($handle); // skip the header row \n\n            while (($row = fgetcsv($handle, 1000, ",")) !== FALSE) {\n\t\t\t\t\n                $data = array(\n                    \'EmployeeNo\'           => $row[0],\n                    \'EmployeeName\'         => $row[1],\n                    \'Location\'              => $row[2],\n                    \'Department\'            => $row[3],\n                    \'Designation\'           => $row[4],\n                    \'ShiftName\'            => $row[5],\n                    \'Date\'                  => $selected_date,\n                    \'Status\'                => $row[7],\n                    \'InTime\'               => $row[8],\n                    \'OutTime\'              => $row[9],\n                    \'WorkHours\'            => $row[10],\n                    \'ActualWorkHours\'     => $row[11],\n                    \'WorkHoursInShift\'   => $row[12],\n                    \'LateinHours\'          => $row[13],\n                    \'EarlyoutHours\'        => $row[14],\n                    \'Shortfall\'             => $row[15],\n                    \'ExcessHours\'          => $row[16],\n                    \'BreakHours\'           => $row[17]\n                );\n\n                $this->admin_model->insert_csv_data($data);\n\t\t    \t\t// echo "<pre>HELLO"; print_r($row);  exit;\n\n\n            }\n\n             if (true)\n\t\t\t{\n\t\t\t\t$this->session->set_flashdata(\'true\', \'CSV File imported successfully!\');\n\t\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to import CSV. Check file contents.\');\n        \t}\n\t    }  else \n\t\t   {\n\t\t\t$this->session->set_flashdata(\'err\', \'No file selected.\');\n\t\t   }\n\n\t\t$this->template->write_view(\'content\', \'admin/upload_sheet\');\n\t\t$this->template->render();\n\t  } else {\n       \t\t $this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again..!!\');\n       \t\t redirect($this->config->item(\'base_url\') . \'admin/index\');\n\t\t}\n\n\n    }\n\n\t///added by reka on 25-02-2026\n\n// public function get_not_submitted_by_date()\n// {\n//     $date = $this->input->post(\'filter_date\');\n\n//     $this->load->model(\'admin/admin_model\');\n//     $data[\'notsub\'] = $this->admin_model->get_not_submitted_by_date($date);\n\n//     echo \'<table class="table table-bordered">\n//             <tr>\n//                 <th>Emp ID</th>\n//                 <th>Name</th>\n//                 <th>Department</th>\n//                 <th>Designation</th>\n//                 <th>Manager</th>\n//             </tr>\';\n\n//     foreach($data[\'notsub\'] as $row)\n//     {\n//         echo \'<tr>\n//                 <td>\'.$row[\'emp_id\'].\'</td>\n//                 <td>\'.$row[\'emp_name\'].\'</td>\n//                 <td>\'.$row[\'department\'].\'</td>\n//                 <td>\'.$row[\'designation\'].\'</td>\n//                 <td>\'.$row[\'reprt_mger_name\'].\'</td>\n//               </tr>\';\n//     }\n\n//     echo \'</table>\';\n// }\n\npublic function get_not_submitted_by_date()\n{\n    $date = $this->input->post(\'filter_date\');\n\n    $this->load->model(\'admin/admin_model\');\n    $data[\'notsub\'] = $this->admin_model->get_not_submitted_by_date($date);\n\n    // Count of filtered employees\n    $count = count($data[\'notsub\']);\n\n    // Show count\n    echo \'<div class="mb-3">\n            <h6><strong>Not Submitted Employees : \'.$count.\'</strong></h6>\n          </div>\';\n\n    // Table\n    echo \'<table class="table table-bordered table-striped">\n            <thead>\n                <tr>\n                    <th>Emp ID</th>\n                    <th>Name</th>\n                    <th>Department</th>\n                    <th>Designation</th>\n                    <th>Manager</th>\n                </tr>\n            </thead>\n            <tbody>\';\n\n    if (!empty($data[\'notsub\']))\n    {\n        foreach ($data[\'notsub\'] as $row)\n        {\n            echo \'<tr>\n                    <td>\'.$row[\'emp_id\'].\'</td>\n                    <td>\'.$row[\'emp_name\'].\'</td>\n                    <td>\'.$row[\'department\'].\'</td>\n                    <td>\'.$row[\'designation\'].\'</td>\n                    <td>\'.$row[\'reprt_mger_name\'].\'</td>\n                  </tr>\';\n        }\n    }\n    else\n    {\n        echo \'<tr>\n                <td colspan="5" class="text-center">\n                    No Records Found\n                </td>\n              </tr>\';\n    }\n\n    echo \'</tbody></table>\';\n}\n////25 forslider\n\n\n//  public function insert_sliders_list()\n// {\n//     $inps = $this->input->post();\n\n//     $config[\'upload_path\'] = \'./slide/\';\n//     $config[\'allowed_types\'] = \'*\';\n//     $config[\'max_size\']      = 5000;\n//     $config[\'remove_spaces\'] = TRUE;\n//     $config[\'encrypt_name\']  = TRUE;\n\n//     $this->load->library(\'upload\');\n//     $this->upload->initialize($config);\n\n//     if(!$this->upload->do_upload(\'formFile\'))\n//     {\n//         echo $this->upload->display_errors();\n//         exit;\n//     }\n//     else\n//     {\n//         $fileData = $this->upload->data();\n//         $fileName = $fileData[\'file_name\'];\n\n//         $data = array(\n//             \'slide_file\'  => $fileName,\n//             \'expiry_date\' => $inps[\'expiry_date\'],\n//             \'status\'      => 1\n//         );\n\n//         $this->db->insert(\'sliders\', $data);\n\n//         redirect(\'admin/view_sliders\');\n//     }\n// }\npublic function insert_sliders_list()\n{\n    $user_det = $this->session->userdata(\'logged_in\');\n    \n    if (!isset($user_det) || empty($user_det)) {\n        $this->session->set_flashdata(\'err\', \'Invalid Session. Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\') . \'admin/index\');\n        return;\n    }\n\n    $inps = $this->input->post();\n\n    $config[\'upload_path\']   = \'./slide/\';\n    $config[\'allowed_types\'] = \'*\';\n    $config[\'max_size\']      = 5000;\n    $config[\'remove_spaces\'] = TRUE;\n    $config[\'encrypt_name\']  = TRUE;\n\n    $this->load->library(\'upload\');\n    $this->upload->initialize($config);\n\n    if (!$this->upload->do_upload(\'formFile\')) {\n        $this->session->set_flashdata(\'err\', $this->upload->display_errors());\n        redirect($this->config->item(\'base_url\') . \'admin/add_sliders\');\n        return;\n    }\n\n    $fileData = $this->upload->data();\n    $fileName = $fileData[\'file_name\'];\n\n    // Default values — 0 instead of null to avoid DB error\n    $categoryId = 0;\n    $category   = \'\';\n\n    // Only parse category when flyerType is 3 (General)\n    if ($inps[\'flyerType\'] == \'3\' && !empty($inps[\'SliderCategory\']) && $inps[\'SliderCategory\'] != \'0~Others\') {\n        $SliderCategory = explode(\'~\', $inps[\'SliderCategory\']);\n        $categoryId     = $SliderCategory[0];\n        $category       = isset($SliderCategory[1]) ? $SliderCategory[1] : \'\';\n    }\n\n    $data = array(\n        \'slide_file\'    => $fileName,\n        \'slide_date\'    => $inps[\'expiry_date\'],\n        \'expiry_date\'   => $inps[\'expiry_date\'],\n        \'flyer_type\'    => $inps[\'flyerType\'],\n        \'concept_id\'    => $categoryId,\n        \'slide_concept\' => $category,\n        \'CreationBy\'    => $user_det[\'empdet_id\'],\n        \'status\'        => 1\n    );\n\n    $this->db->insert(\'sliders\', $data);\n\n    if ($this->db->affected_rows() > 0) {\n        $this->session->set_flashdata(\'true\', \'Slider Added Successfully!\');\n    } else {\n        $this->session->set_flashdata(\'err\', \'Failed to add slider. Please try again.\');\n    }\n\n    redirect($this->config->item(\'base_url\') . \'admin/view_sliders\');\n}public function add_flash()\n{\n    $usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n        $this->template->write_view(\'content\', \'admin/add_flash\');\n        $this->template->render();\n    }\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\npublic function insert_flash()\n{\n    $usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n        $inps = $this->input->post();\n\n        $data = array(\n            \'flash_type\'  => $inps[\'flash_type\'],\n            \'description\' => $inps[\'description\'],\n            \'expiry_date\' => $inps[\'expiry_date\'],\n            \'status\'      => 1,\n            \'created_by\'  => $this->session->userdata(\'logged_in\')[\'empdet_id\']\n        );\n\n        $this->db->insert(\'flash_messages\', $data);\n\n        $this->session->set_flashdata(\'true\', \'Flash Message Added Successfully\');\n        redirect(\'admin/add_flash\');\n    }\n    else\n    {\n        redirect(\'admin/index\');\n    }\n}\n\npublic function flash_history()\n{\n    $usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n        $this->db->order_by(\'fid\', \'DESC\');\n        $data[\'flash_messages\'] = $this->db->get(\'flash_messages\')->result_array();\n\n        $this->template->write_view(\'content\', \'admin/flash_history\', $data);\n        $this->template->render();\n    }\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n\npublic function delete_flash()\n{\n    $usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n        $fid = $this->input->post(\'fid\');\n\n        if(empty($fid))\n        {\n            echo json_encode(array(\'status\' => false, \'message\' => \'Unable to delete flash message.\'));\n            return;\n        }\n\n        $this->db->where(\'fid\', $fid);\n        $exists = $this->db->get(\'flash_messages\')->row_array();\n\n        if(empty($exists))\n        {\n            echo json_encode(array(\'status\' => false, \'message\' => \'Unable to delete flash message.\'));\n            return;\n        }\n\n        $this->db->where(\'fid\', $fid);\n        $deleted = $this->db->delete(\'flash_messages\');\n\n        if($deleted)\n        {\n            echo json_encode(array(\'status\' => true, \'message\' => \'Flash message deleted successfully.\'));\n        }\n        else\n        {\n            $last_query = $this->db->last_query();\n            $db_error   = $this->db->error();\n            log_message(\'error\', \'delete_flash() failed. Query: \' . $last_query . \' | Error: \' . json_encode($db_error));\n            echo json_encode(array(\'status\' => false, \'message\' => \'Unable to delete flash message.\'));\n        }\n    }\n    else\n    {\n        echo json_encode(array(\'status\' => false, \'message\' => \'Unable to delete flash message.\'));\n    }\n}\n\npublic function add_request()\n{\n    $usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n        $data[\'categories\'] = $this->admin_model->get_categories();\n        $data[\'all_items\'] = $this->admin_model->get_all_items();\n\n        // Load request history for the current user\n        $this->db->select(\'rp.*, c.category_name, s.subcategory_name\');\n        $this->db->from(\'req_purchase_form rp\');\n        $this->db->join(\'stat_category c\', \'rp.category = c.id\', \'left\');\n        $this->db->join(\'stat_subcategory s\', \'rp.subcategory = s.id\', \'left\');\n        $this->db->where(\'rp.requested_by\', $usersess_det[\'empdet_id\']);\n        $this->db->order_by(\'rp.creation_date\', \'DESC\');\n        $data[\'history\'] = $this->db->get()->result_array();\n\n        $this->template->write_view(\'content\', \'admin/add_request\', $data);\n        $this->template->render();\n    }\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n} \n \npublic function save_request()\n{\n    $usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n        $categories    = $this->input->post(\'category\');\n        $subcategories = $this->input->post(\'subcategory\');\n        $quantities    = $this->input->post(\'quantity\');\n\n        if(!empty($categories))\n        {\n            for($i = 0; $i < count($categories); $i++)\n            {\n                $data = array(\n                    \'category\'           => $categories[$i],\n                    \'subcategory\'        => $subcategories[$i],\n                    \'requested_quantity\' => $quantities[$i],\n                    \'requested_by\'       => $usersess_det[\'empdet_id\'],\n                    \'requested_to\'       => 57, // Default to Meenakshi\n                    \'status\'             => 0,\n                    \'requested_flag\'     => 0, // requested\n                    \'creation_date\'      => date(\'Y-m-d H:i:s\'),\n                    \'updation_date\'      => date(\'Y-m-d H:i:s\')\n                );\n\n                $this->db->insert(\'req_purchase_form\', $data);\n                \n                // Update stationery_summary table for requested stock\n                $this->admin_model->update_stationery_summary(\n                    $categories[$i],\n                    $subcategories[$i],\n                    $quantities[$i],\n                    \'request\',\n                    date(\'Y-m-d\')\n                );\n                \n                // // Keep inserting into request_form for backward compatibility if needed\n                // // But I\'ll prioritize req_purchase_form as requested\n                // $old_data = array(\n                //     \'category\'    => $categories[$i],\n                //     \'subcategory\' => $subcategories[$i],\n                //     \'quantity\'    => $quantities[$i],\n                //     \'created_by\'  => $usersess_det[\'empdet_id\'],\n                //     \'status\'      => 0,\n                //     \'created_at\'  => date(\'Y-m-d H:i:s\')\n                // );\n                // $this->db->insert(\'req_purchase_form\', $old_data);\n            }\n\n            $this->session->set_flashdata(\'success\', \'Request Submitted Successfully!\');\n        }\n        else\n        {\n            $this->session->set_flashdata(\'error\', \'Please add at least one request!\');\n        }\n\n        redirect($this->config->item(\'base_url\').\'admin/add_request\');\n    }\n    else\n    {\n        $this->session->set_flashdata(\'error\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n \npublic function stationery_request()\n{\n    $usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n        $category_filter = $this->input->post(\'category\') !== NULL ? $this->input->post(\'category\') : $this->input->get(\'category\');\n        $subcategory_filter = $this->input->post(\'subcategory\') !== NULL ? $this->input->post(\'subcategory\') : $this->input->get(\'subcategory\');\n        $requester_filter = $this->input->post(\'requested_by\') !== NULL ? $this->input->post(\'requested_by\') : $this->input->get(\'requested_by\');\n        $date_filter = $this->input->post(\'date\') !== NULL ? $this->input->post(\'date\') : $this->input->get(\'date\');\n\n        $data[\'selected_category\'] = $category_filter;\n        $data[\'selected_subcategory\'] = $subcategory_filter;\n        $data[\'selected_requested_by\'] = $requester_filter;\n        $data[\'selected_date\'] = $date_filter;\n\n        // Set default date to today if no filters are applied\n        $data[\'is_default_view\'] = false;\n        if(empty($date_filter) && empty($category_filter) && empty($subcategory_filter) && empty($requester_filter)) {\n            $date_filter = date(\'Y-m-d\');\n            $data[\'is_default_view\'] = true;\n            $data[\'selected_date\'] = $date_filter;\n        }\n\n        // Get Requests\n        $this->db->select(\'rp.*, e.emp_name as requester_name, c.category_name, s.subcategory_name\');\n        $this->db->from(\'req_purchase_form rp\');\n        $this->db->join(\'employee_det e\', \'rp.requested_by = e.id\', \'left\');\n        $this->db->join(\'stat_category c\', \'rp.category = c.id\', \'left\');\n        $this->db->join(\'stat_subcategory s\', \'rp.subcategory = s.id\', \'left\');\n        \n        // Only show items that were actually requested by someone (exclude direct purchases without requests)\n        $this->db->where(\'rp.requested_by >\', 0);\n\n        if(!empty($category_filter)) {\n            $this->db->where(\'rp.category\', $category_filter);\n        }\n        if(!empty($subcategory_filter)) {\n            $this->db->where(\'rp.subcategory\', $subcategory_filter);\n        }\n        if(!empty($requester_filter)) {\n            $this->db->where(\'rp.requested_by\', $requester_filter);\n        }\n        if(!empty($date_filter)) {\n            $this->db->where(\'DATE(rp.creation_date)\', $date_filter);\n        }\n\n        $this->db->order_by(\'rp.id\', \'DESC\');\n        $data[\'requests\'] = $this->db->get()->result_array();\n\n        // Get Masters for Filters\n        $data[\'categories\'] = $this->admin_model->get_categories();\n        $data[\'subcategories\'] = $this->db->get(\'stat_subcategory\')->result_array();\n        $data[\'employees\'] = $this->db->select(\'id, emp_name, emp_id\')->where(\'status\', 1)->get(\'employee_det\')->result_array();\n\n        $this->template->write_view(\'content\', \'admin/stationery_request\', $data);\n        $this->template->render();\n    }\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n\n\n\npublic function save_stationery_request()\n{\n \t$usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n\t\t$ids = $this->input->post(\'req_id\');\n\t\t$price = $this->input->post(\'price\');\n\n\t\tfor($i=0; $i<count($ids); $i++)\n\t\t{\n\t\t\t$this->db->where(\'id\', $ids[$i]);\n\t\t\t$this->db->update(\'request_form\', array(\n\t\t\t\t\'price\' => $price[$i],\n\t\t\t\t\'status\' => 1\n\t\t\t));\n\t\t}\n\n\t\t$this->session->set_flashdata(\'true\',\'Item Purchased Successfully\');\n\t\tredirect($this->config->item(\'base_url\').\'admin/stationery_request\');\n\t}\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\npublic function update_request()\n{\n\t$usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n    $id = $this->input->post(\'id\');\n    $category = $this->input->post(\'category\');\n    $subcategory = $this->input->post(\'subcategory\');\n    $quantity = $this->input->post(\'quantity\');\n\n    $this->db->where(\'id\', $id);\n    $this->db->update(\'request_form\', array(\n        \'category\' => $category,\n        \'subcategory\' => $subcategory,\n        \'quantity\' => $quantity\n    ));\n\n    $this->session->set_flashdata(\'true\',\'Request Updated\');\n    redirect(\'admin/stationery_request\');\n\t}\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\npublic function delete_request()\n{\n\t$usersess_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($usersess_det) && !empty($usersess_det))\n    {\n\t\t$id = $this->input->post(\'id\');\n\n\t\t$this->db->where(\'id\', $id);\n\t\t$this->db->delete(\'request_form\');\n\n\t\t$this->session->set_flashdata(\'true\',\'Request Deleted\');\n\t\tredirect(\'admin/stationery_request\');\n\t}\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n public function stationery_stock()\n{\n    $employee_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($employee_det) && !empty($employee_det))\n    {\n\n        // CATEGORY LIST\n        $data[\'categories\'] = $this->db\n            ->get(\'stat_category\')\n            ->result_array();\n\n        // SUBCATEGORY LIST\n        $data[\'subcategories\'] = $this->db\n            ->get(\'stat_subcategory\')\n            ->result_array();\n\n        $month = $this->input->post(\'month\') !== NULL ? $this->input->post(\'month\') : $this->input->get(\'month\');\n        $data[\'selected_month\'] = $month;\n\n        // STOCK QUERY - Combining data from existing_table, req_purchase_form, and stationery_summary\n        $month_filter     = \'\';\n        $month_filter_req = \'\';\n        $month_filter_sum = \'\';\n        if(!empty($month))\n        {\n            $month_filter     = " AND DATE_FORMAT(e.date, \'%Y-%m\') = \'".$month."\'";\n            $month_filter_req = " AND DATE_FORMAT(r.creation_date, \'%Y-%m\') = \'".$month."\'";\n            $month_filter_sum = " AND DATE_FORMAT(ss.summary_date, \'%Y-%m\') = \'".$month."\'";\n        }\n\n        $sql = "\n            SELECT\n                COALESCE(c.category_name, combined.category) AS category,\n                COALESCE(s.subcategory_name, combined.subcategory) AS subcategory,\n                SUM(CASE WHEN combined.source = \'existing\'  THEN IFNULL(combined.opening_stock,   0) ELSE 0 END) AS opening_stock,\n                SUM(CASE WHEN combined.source = \'request\'   THEN IFNULL(combined.total_requested, 0) ELSE 0 END) AS total_requested,\n                SUM(CASE WHEN combined.source = \'purchase\'  THEN IFNULL(combined.total_purchased, 0) ELSE 0 END) AS total_purchased,\n                SUM(CASE WHEN combined.source = \'consumed\'  THEN IFNULL(combined.total_consumed,  0) ELSE 0 END) AS total_consumed,\n                SUM(IFNULL(combined.total_qty, 0)) AS total_qty\n            FROM (\n\n                /* ---- Opening stock from existing_table ---- */\n                SELECT\n                    CAST(e.category AS CHAR)    AS category,\n                    CAST(e.subcategory AS CHAR)  AS subcategory,\n                    IFNULL(e.quantity, 0)        AS opening_stock,\n                    0 AS total_requested,\n                    0 AS total_purchased,\n                    0 AS total_consumed,\n                    IFNULL(e.quantity, 0)        AS total_qty,\n                    \'existing\' AS source\n                FROM existing_table e\n                WHERE 1=1 {$month_filter}\n\n                UNION ALL\n\n                /* ---- Requested stock from req_purchase_form ---- */\n                SELECT\n                    CAST(r.category AS CHAR)            AS category,\n                    CAST(r.subcategory AS CHAR)          AS subcategory,\n                    0                                    AS opening_stock,\n                    IFNULL(r.requested_quantity, 0)      AS total_requested,\n                    0 AS total_purchased,\n                    0 AS total_consumed,\n                    -IFNULL(r.requested_quantity, 0)     AS total_qty,\n                    \'request\' AS source\n                FROM req_purchase_form r\n                WHERE r.requested_flag = 1 {$month_filter_req}\n\n                UNION ALL\n\n                /* ---- Purchased stock from stationery_summary ---- */\n                SELECT\n                    CAST(ss.category AS CHAR)           AS category,\n                    CAST(ss.subcategory AS CHAR)         AS subcategory,\n                    0                                    AS opening_stock,\n                    0 AS total_requested,\n                    IFNULL(ss.purchased_stock, 0)        AS total_purchased,\n                    0 AS total_consumed,\n                    IFNULL(ss.purchased_stock, 0)        AS total_qty,\n                    \'purchase\' AS source\n                FROM stationery_summary ss\n                WHERE ss.purchased_stock > 0 {$month_filter_sum}\n\n                UNION ALL\n\n                /* ---- Consumed stock from stationery_summary ---- */\n                SELECT\n                    CAST(ss.category AS CHAR)           AS category,\n                    CAST(ss.subcategory AS CHAR)         AS subcategory,\n                    0                                    AS opening_stock,\n                    0 AS total_requested,\n                    0 AS total_purchased,\n                    IFNULL(ss.consumed_stock, 0)         AS total_consumed,\n                    -IFNULL(ss.consumed_stock, 0)        AS total_qty,\n                    \'consumed\' AS source\n                FROM stationery_summary ss\n                WHERE ss.consumed_stock > 0 {$month_filter_sum}\n\n            ) combined\n            LEFT JOIN stat_category c\n                ON (c.id = combined.category OR c.category_name = combined.category)\n            LEFT JOIN stat_subcategory s\n                ON (s.id = combined.subcategory OR s.subcategory_name = combined.subcategory)\n            GROUP BY combined.category, combined.subcategory\n        ";\n\n        // RESULT\n        $data[\'stock\'] = $this->db->query($sql)->result_array();\n\n        $data[\'overall_stock\'] = $data[\'stock\'];\n\n        // LOAD VIEW\n        $this->template->write_view(\n            \'content\',\n            \'admin/stationery_stock\',\n            $data\n        );\n\n        $this->template->render();\n\n    }\n    else\n    {\n        $this->session->set_flashdata(\n            \'err\',\n            \'Invalid Session.Please Login Again..!!\'\n        );\n\n        redirect(\n            $this->config->item(\'base_url\').\'admin/index\'\n        );\n    }\n}\n \n\npublic function stationery_consumed()\n{\n    $employee_det = $this->session->userdata(\'logged_in\');\n\n    if(isset($employee_det) && !empty($employee_det))\n    {\n        // Departments & Employees\n        $data[\'departments\'] = $this->db->get(\'department_det\')->result_array();\n        $data[\'employees\']   = $this->db->where(\'status\', 1)->get(\'employee_det\')->result_array();\n\n        // Get Master Categories for dropdown\n        $data[\'categories\'] = $this->db->get(\'stat_category\')->result_array();\n        $data[\'stock_items\'] = $this->admin_model->get_all_items();\n\n        // MONTH FILTER\n        $month = $this->input->post(\'month\') !== NULL ? $this->input->post(\'month\') : $this->input->get(\'month\');\n        $data[\'selected_month\'] = $month;\n\n        $this->db->select(\'sc.*, e.emp_name, d.department_name, c.category_name, s.subcategory_name, rp.requested_quantity, rp.purchased_quantity\');\n        $this->db->from(\'stationery_consumed sc\');\n        $this->db->join(\'employee_det e\', "sc.consumed_to = e.id AND sc.consumed_type = \'Individual\'", \'left\');\n        $this->db->join(\'department_det d\', "sc.consumed_to = d.id AND sc.consumed_type = \'Department\'", \'left\');\n        $this->db->join(\'stat_category c\', \'sc.category = c.id\', \'left\');\n        $this->db->join(\'stat_subcategory s\', \'sc.subcategory = s.id\', \'left\');\n        $this->db->join(\'req_purchase_form rp\', \'sc.request_id = rp.id\', \'left\');\n        \n        if(!empty($month)){\n            $this->db->where("DATE_FORMAT(sc.consumed_date, \'%Y-%m\') =", $month);\n        }\n        \n        $this->db->order_by(\'sc.id\', \'DESC\');\n        $data[\'consumed\'] = $this->db->get()->result_array();\n\n        $this->template->write_view(\'content\', \'admin/consumed_stock\', $data);\n        $this->template->render();\n    }\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n\npublic function save_consumed_stock()\n{\n    $employee_det = $this->session->userdata(\'logged_in\');\n    \n    if(isset($employee_det) && !empty($employee_det))\n    {\n        $category = $this->input->post(\'category\');\n        $subcategory = $this->input->post(\'subcategory\');\n        $quantity = (int)$this->input->post(\'quantity\');\n        $remarks = $this->input->post(\'remarks\');\n\n        if(empty($remarks)) {\n            $this->session->set_flashdata(\'err\',\'Remarks are required.\');\n            redirect($this->config->item(\'base_url\').\'admin/stationery_consumed\');\n        }\n\n        // STOCK AVAILABILITY CHECK\n        // 1. Total Purchased\n        $this->db->select(\'SUM(purchased_quantity) as total_p\');\n        $this->db->where(\'category\', $category);\n        $this->db->where(\'subcategory\', $subcategory);\n        $this->db->where(\'requested_flag\', 1);\n        $total_purchased = $this->db->get(\'req_purchase_form\')->row()->total_p;\n        $total_purchased = $total_purchased ? $total_purchased : 0;\n\n        // 2. Total Consumed\n        $this->db->select(\'SUM(quantity) as total_c\');\n        $this->db->where(\'category\', $category);\n        $this->db->where(\'subcategory\', $subcategory);\n        $total_consumed = $this->db->get(\'stationery_consumed\')->row()->total_c;\n        $total_consumed = $total_consumed ? $total_consumed : 0;\n\n        $available_stock = $total_purchased - $total_consumed;\n\n        if($available_stock < $quantity) {\n            $this->session->set_flashdata(\'err\',\'No stock available. Current stock: \' . $available_stock);\n            redirect($this->config->item(\'base_url\').\'admin/stationery_consumed\');\n        }\n\n        // Find the oldest matching purchased but not consumed item\n        $this->db->where(\'category\', $category);\n        $this->db->where(\'subcategory\', $subcategory);\n        $this->db->where(\'requested_flag\', 1);\n        $this->db->where(\'status\', 0);\n        $this->db->order_by(\'creation_date\', \'ASC\');\n        $this->db->limit(1);\n        $request = $this->db->get(\'req_purchase_form\')->row_array();\n\n        $request_id = null;\n        if($request) {\n            $request_id = $request[\'id\'];\n            // Update status in req_purchase_form\n            $this->db->where(\'id\', $request_id);\n            $this->db->update(\'req_purchase_form\', array(\'status\' => 1));\n        }\n\n        $data = array(\n            \'consumed_type\'   => $this->input->post(\'type\'),\n            \'consumed_to\'     => $this->input->post(\'consumed_to\'),\n            \'category\'        => $category,\n            \'subcategory\'     => $subcategory,\n            \'request_id\'      => $request_id,\n            \'quantity\'        => $quantity,\n            \'date\'            => $this->input->post(\'date\'),\n            \'remarks\'         => $remarks,\n            \'creation_date\'   => date(\'Y-m-d H:i:s\'),\n            \'updation_date\'   => date(\'Y-m-d H:i:s\'),\n            \'consumed_date\'   => $this->input->post(\'date\'),\n\t\t\t\'created_by\'     => $employee_det[\'empdet_id\']\n        );\n\n        $this->db->insert(\'stationery_consumed\', $data);\n        \n        // Update stationery_summary table\n        $this->admin_model->update_stationery_summary(\n            $category,\n            $subcategory,\n            $quantity,\n            \'consumption\',\n            $this->input->post(\'date\')\n        );\n\n        $this->session->set_flashdata(\'true\',\'Stock Consumed Successfully\');\n        redirect($this->config->item(\'base_url\').\'admin/stationery_consumed\');\n    }\n    else\n    {\n        $this->session->set_flashdata(\'err\',\'Invalid Session.Please Login Again..!!\');\n        redirect($this->config->item(\'base_url\').\'admin/index\');\n    }\n}\n\n// public function stationery_summary()\n// {\n//     $employee_det = $this->session->userdata(\'logged_in\');\n\n//     if(isset($employee_det) && !empty($employee_det))\n//     {\n//         $from_date = $this->input->get(\'from_date\');\n// $to_date   = $this->input->get(\'to_date\');\n//         $biller = $this->input->get(\'biller\');\n//         $cat    = $this->input->get(\'category\');\n//         $subcat = $this->input->get(\'subcategory\');\n\n//         // Fetch lists for filters\n//         $data[\'billers\']       = $this->db->select(\'company_name\')->distinct()->get(\'stationery_bill\')->result_array();\n//         $data[\'categories\']    = $this->db->select(\'id, category_name as category\')->get(\'stat_category\')->result_array();\n//         $data[\'subcategories\'] = $this->db->select(\'id, category_id, subcategory_name as subcategory\')->get(\'stat_subcategory\')->result_array();\n\n//         // =============================================\n//         // SUMMARY TOTALS\n//         // =============================================\n\n//         // Base stock from existing_table\n//         $et_sql = "SELECT COALESCE(SUM(quantity), 0) as total FROM existing_table WHERE 1=1";\n//         if(!empty($cat))    $et_sql .= " AND category = " . (int)$cat;\n//         if(!empty($subcat)) $et_sql .= " AND subcategory = " . (int)$subcat;\n//         $base_stock = $this->db->query($et_sql)->row()->total;\n//         $base_stock = $base_stock ? $base_stock : 0;\n\n//         // Build stationery_summary query with biller join\n//         $this->db->select(\'\n//             COALESCE(SUM(ss.purchased_stock), 0) as purchased,\n//             COALESCE(SUM(ss.consumed_stock), 0) as consumed\n//         \');\n//         $this->db->from(\'stationery_summary ss\');\n\n//         // Join stationery_bill for biller filter\n//         if(!empty($biller)) {\n//             $this->db->join(\'stationery_bill sb\', \'ss.biller_id = sb.id\', \'left\');\n//             $this->db->where(\'sb.company_name\', $biller);\n//         }\n\n//         if(!empty($month))  $this->db->where("DATE_FORMAT(ss.summary_date, \'%Y-%m\') =", $month);\n//         if(!empty($cat))    $this->db->where(\'ss.category\', $cat);\n//         if(!empty($subcat)) $this->db->where(\'ss.subcategory\', $subcat);\n\n//         $summary = $this->db->get()->row();\n//         $total_purchased = $summary->purchased ? $summary->purchased : 0;\n//         $total_consumed  = $summary->consumed  ? $summary->consumed  : 0;\n\n//         // Calculate opening\n//         if(!empty($month)) {\n//             // Get purchased and consumed BEFORE this month\n//             $this->db->select(\'\n//                 COALESCE(SUM(ss.purchased_stock), 0) as purchased,\n//                 COALESCE(SUM(ss.consumed_stock), 0) as consumed\n//             \');\n//             $this->db->from(\'stationery_summary ss\');\n//             if(!empty($biller)) {\n//                 $this->db->join(\'stationery_bill sb\', \'ss.biller_id = sb.id\', \'left\');\n//                 $this->db->where(\'sb.company_name\', $biller);\n//             }\n//             $this->db->where("DATE_FORMAT(ss.summary_date, \'%Y-%m\') <", $month);\n//             if(!empty($cat))    $this->db->where(\'ss.category\', $cat);\n//             if(!empty($subcat)) $this->db->where(\'ss.subcategory\', $subcat);\n//             $before = $this->db->get()->row();\n//             $opening = $base_stock \n//                        + ($before->purchased ? $before->purchased : 0) \n//                        - ($before->consumed  ? $before->consumed  : 0);\n//         } else {\n//             $opening = $base_stock;\n//         }\n\n//         $purchased = $total_purchased;\n//         $consumed  = $total_consumed;\n//         $closing   = $opening + $purchased - $consumed;\n\n// \t\t// =============================================\n// // DAILY TABLE - Group by CATEGORY (default) OR SUBCATEGORY (when filter applied)\n// // =============================================\n\n// if(!empty($subcat)) {\n//     // ── SUBCATEGORY MODE: subcategory filter applied ──\n//     $this->db->select(\'\n// \t ss.summary_date,\n//         ss.category,\n//         ss.subcategory,\n//         c.category_name,\n//         s.subcategory_name,\n//         COALESCE(SUM(ss.purchased_stock), 0) as purchased,\n//         COALESCE(SUM(ss.consumed_stock), 0) as consumed\n//     \');\n//     $this->db->from(\'stationery_summary ss\');\n//     $this->db->join(\'stat_category c\',    \'ss.category = c.id\',    \'left\');\n//     $this->db->join(\'stat_subcategory s\', \'ss.subcategory = s.id\', \'left\');\n\n//     if(!empty($biller)) {\n//         $this->db->join(\'stationery_bill sb\', \'ss.biller_id = sb.id\', \'left\');\n//         $this->db->where(\'sb.company_name\', $biller);\n//     }\n//     if(!empty($month))  $this->db->where("DATE_FORMAT(ss.summary_date, \'%Y-%m\') =", $month);\n//     if(!empty($cat))    $this->db->where(\'ss.category\', $cat);\n//     $this->db->where(\'ss.subcategory\