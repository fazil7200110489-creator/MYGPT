n\tpublic function forgot_password()\n\t{\n\t\t// Load model\n\t\t$this->load->model(\'admin_model\');\n\n\t\t// If form submitted\n\t\tif ($this->input->post(\'email_id\')) {\n\t\t\t$email = $this->input->post(\'email_id\');\n\n\t\t\t// Check if email exists\n\t\t\t$user = $this->admin_model->get_user_by_email($email);\n\n\t\t\tif ($user) {\n\t\t\t\t// Email exists, show reset password form\n\t\t\t\t$data[\'user_email\'] = $email; // Pass email to form as hidden input\n\t\t\t\t$this->load->view(\'reset_password\', $data);\n\t\t\t} else {\n\t\t\t\t// Email not found\n\t\t\t\t$data[\'error\'] = "Email not found!";\n\t\t\t\t$this->load->view(\'forgot_password\', $data);\n\t\t\t}\n\t\t} else {\n\t\t\t// First time load, just show the forgot password form\n\t\t\t$this->load->view(\'forgot_password\');\n\t\t}\n\t}\n\n\tpublic function set_new_password()\n\t{\n\t\tif ($this->input->post()) {\n\t\t\t$email = $this->input->post(\'email_id\');\n\t\t\t$new_password = $this->input->post(\'passwd\');\n\t\t\t$hashed_password = md5($new_password);\n\n\t\t\t$this->admin_model->update_password($email, $hashed_password);\n\n\t\t\t// Set flashdata and redirect\n\t\t\t$this->session->set_flashdata(\'true\', \'Password updated successfully!\');\n\t\t\t$this->load->view(\'reset_password\');\n\t\t\t// the next request will show the message\n\t\t}\n\t}\n\n\n\npublic function dashboard()\n{\n    $user_det = $this->check_login();\n\n    $data[\'cur_view\'] = \'dashboard\';\n\n    // Top summary metrics\n    $data[\'project_metrics\'] = $this->admin_model->get_dashboard_project_metrics();\n\n    // Projects requiring pricing attention\n    $data[\'projects_attention\'] = $this->admin_model->get_projects_requiring_attention();\n\n    // Required materials awaiting OEM price quotes\n    $data[\'pending_materials\'] = $this->admin_model->get_pending_materials_dashboard(10);\n\n    // Latest 5 pricing updates\n    $data[\'recent_price_entries\'] = $this->admin_model->get_recent_price_entries_dashboard(5);\n\n    // OEM supplier overview\n    $data[\'oem_supply_summary\'] = $this->admin_model->get_oem_supply_summary_dashboard(6);\n\n    // Load dashboard view\n    $this->template->write_view(\n        \'content\',\n        \'admin/dashboard\',\n        $data\n    );\n\n    $this->template->render();\n}\n\n\tpublic function add_category()\n\t{\n\t\t\n\t\t$user_det = $this->check_login();\n\n\t\n\t\tif ($this->input->post(\'category_name\')) {\n\t\t\t$category_name = trim($this->input->post(\'category_name\'));\n\n\t\t\n\t\t\t$this->db->where(\'category_list\', $category_name);\n\t\t\t$existing = $this->db->get(\'category\')->row();\n\n\t\t\tif ($existing) {\n\t\t\t\tif ($existing->status == 0) {\n\t\t\t\t\t// Reactivate the inactive category\n\t\t\t\t\t$this->db->where(\'c_id\', $existing->c_id);\n\t\t\t\t\t$update_data = [\'status\' => 1];\n\t\t\t\t\tif ($this->db->update(\'category\', $update_data)) {\n\t\t\t\t\t\t$this->session->set_flashdata(\'true\', \'Category reactivated successfully!\');\n\t\t\t\t\t} else {\n\t\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to reactivate category. Try again.\');\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\t// Category already active, prevent duplicate\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Category already exists!\');\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\t// Insert new category\n\t\t\t\t$data = [\n\t\t\t\t\t\'category_list\' => $category_name,\n\t\t\t\t\t\'status\' => 1\n\t\t\t\t];\n\n\t\t\t\tif ($this->db->insert(\'category\', $data)) {\n\t\t\t\t\t$this->session->set_flashdata(\'true\', \'Category added successfully!\');\n\t\t\t\t} else {\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to add category. Try again.\');\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tredirect(base_url(\'admin/add_category\'));\n\t\t}\n\n\t\t// Load categories for the view\n\t\t// $data[\'categories\'] = $this->admin_model->get_category();\n\t\t$data[\'categories\'] = $this->db\n    ->order_by(\'c_id\', \'ASC\')\n    ->get(\'category\')\n    ->result_array();\n\t\t$this->template->write_view(\'content\', \'admin/add_category\', $data);\n\t\t$this->template->render();\n\t}\n\n\n\n\tpublic function add_product()\n\t{\n\t\t\n\t\t$user_det = $this->check_login();\n\n\t\tif ($this->input->post()) {\n\t\t\t$inps = $this->input->post();\n\t\t\t$product_name = trim($inps[\'product_name\']);\n\t\t\t$category_id = $inps[\'category_name\']; \n\t\t\t$oem_id = $inps[\'oem_name\']; \n\t\t\t// Check if product already exists in the same category\n\t\t\t$this->db->where(\'product_list\', $product_name);\n\t\t\t$this->db->where(\'category_id\', $category_id);\n\t\t\t$this->db->where(\'oem_id\', $oem_id);\n\t\t\t$exists = $this->db->get(\'product\')->row();\n\n\t\t\tif ($exists) {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Product already exists!\');\n\t\t\t} else {\n\t\t\t\t$data = array(\n\t\t\t\t\t\'product_list\' => $product_name,\n\t\t\t\t\t\'category_id\' => $category_id,\n\t\t\t\t\t\'oem_id\' => $inps[\'oem_name\'],\n\t\t\t\t\t\'status\' => 1,\n\t\t\t\t\t\'created_at\' => date(\'Y-m-d H:i:s\')\n\t\t\t\t);\n\n\t\t\t\tif ($this->db->insert(\'product\', $data)) {\n\t\t\t\t\t$this->session->set_flashdata(\'true\', \'Product added successfully!\');\n\t\t\t\t} else {\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to add product. Try again.\');\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tredirect(base_url(\'admin/add_product\'));\n\t\t} else {\n\t\t\t$data[\'categories\'] = $this->admin_model->get_category();\n\t\t\t$data[\'oems\'] = [];\n\t\t\tif (method_exists($this->admin_model, \'get_oem\')) {\n\t\t\t\t$data[\'oems\'] = $this->admin_model->get_oem();\n\t\t\t}\n\t\t\t$data[\'products\'] = $this->admin_model->get_products();\n\n\t\t\t\n\t\t\t$this->template->write_view(\'content\', \'admin/add_product\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t}\n\n\n\n\tpublic function add_user()\n\t{\n\t\t$user_det = $this->check_login();\n\n\t\tif ($this->input->post()) {\n\t\t\t$inps = $this->input->post();\n\n\t\t\t\n\t\t\t$this->db->from(\'users\');\n\t\t\t$this->db->where(\'username\', $inps[\'username\']);\n\t\t\t$this->db->or_where(\'email_id\', $inps[\'email\']);\n\t\t\t$existing = $this->db->get()->row();\n\n\t\t\tif ($existing) {\n\t\t\t\t\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Username or Email already exists!\');\n\t\t\t\tredirect(base_url(\'admin/add_user\'));\n\t\t\t} else {\n\t\t\t\t\n\t\t\t\t$data = array(\n\t\t\t\t\t\'username\' => $inps[\'username\'],\n\t\t\t\t\t\'password\' => md5($inps[\'password\']),\n\t\t\t\t\t\'email_id\' => $inps[\'email\'],\n\t\t\t\t\t\'role\' => $inps[\'role\'],\n\t\t\t\t\t\'status\' => 1\n\t\t\t\t);\n\n\t\t\t\t// Insert into database\n\t\t\t\tif ($this->db->insert(\'users\', $data)) {\n\t\t\t\t\t$this->session->set_flashdata(\'true\', \'User added successfully!\');\n\t\t\t\t} else {\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to add user. Try again.\');\n\t\t\t\t}\n\t\t\t\tredirect(base_url(\'admin/add_user\'));\n\t\t\t}\n\t\t} else {\n\t\t\t$data[\'existing_user\'] = $this->admin_model->get_existing_user();\n\t\t\t$this->template->write_view(\'content\', \'admin/add_user\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t}\n\n\n\n\tpublic function add_oem()\n\t{\n\t\t$user_det = $this->check_login(); // protect page\n\n\t\tif ($this->input->post()) {\n\t\t\t$inps = $this->input->post();\n\n\t\t\t$data = array(\n\t\t\t\t\'oem_name\' => $inps[\'oem_name\'],\n\t\t\t\t\'mobile_number\' => $inps[\'contact_number\'],\n\t\t\t\t\'email_id\' => $inps[\'email\'],\n\t\t\t\t\'address\' => $inps[\'address\'],\n\t\t\t\t\'status\' => $inps[\'status\']\n\t\t\t);\n\n\t\t\t// Check if email already exists\n\t\t\t$this->db->where(\'email_id\', $inps[\'email\']);\n\t\t\t$query = $this->db->get(\'oem_table\');\n\n\t\t\tif ($query->num_rows() > 0) {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Email already exists! Please use another email.\');\n\t\t\t} else {\n\t\t\t\tif ($this->db->insert(\'oem_table\', $data)) {\n\t\t\t\t\t$this->session->set_flashdata(\'true\', \'OEM added successfully!\');\n\t\t\t\t} else {\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to add OEM. Try again.\');\n\t\t\t\t}\n\t\t\t}\n\t\t\tredirect(base_url(\'admin/add_oem\'));\n\t\t} else {\n\t\t\t$data[\'categories\'] = $this->admin_model->get_category();\n\t\t\t$data[\'oems\'] = $this->admin_model->get_oem();\n\t\t\t$data[\'all_oems\'] = $this->admin_model->get_oem();\n\t\t\t$this->template->write_view(\'content\', \'admin/add_oem\', $data);\n\t\t\t$this->template->render();\n\t\t}\n\t}\n\n\n\tpublic function oem_database()\n\t{\n\t\t$user_det = $this->check_login(); \n\n\t\t$inputs = $this->input->post();\n\t\t$data[\'filters\'] = $inputs;\n\n\t\t$data[\'oems\'] = $this->admin_model->get_oem($inputs);\n\t\t$data[\'all_oems\'] = $this->admin_model->get_oem();\n\t\t$data[\'categories\'] = $this->admin_model->get_category();\n\t\t$data[\'active_tab\'] = \'database\';\n\n\t\t$this->template->write_view(\'content\', \'admin/add_oem\', $data);\n\t\t$this->template->render();\n\t}\n\n\n\n\tpublic function existing_user()\n\t{\n$this->check_login();\n\t\t$data[\'existing_user\'] = $this->admin_model->get_existing_user();\n\t\t$this->template->write_view(\'content\', \'admin/existing_users\', $data);\n\t\t$this->template->render();\n\t}\n\n\tpublic function update_user()\n\t{\n\t\t$this->check_login();\n\t\t$s_no = $this->input->post(\'s_no\');\n\t\t$status = $this->input->post(\'status\');\n\t\tif ($s_no) {\n\t\t\t$this->db->where(\'s_no\', $s_no);\n\t\t\tif ($status == 0) {\n\n\t\t\t\t$this->db->update(\'users\', [\'status\' => 1]); // assuming 0 = Inactive\n\t\t\t} else {\n\n\t\t\t\t$this->db->update(\'users\', [\'status\' => 0]); // assuming 0 = Inactive\n\t\t\t}\n\t\t\techo json_encode([\'success\' => true]);\n\t\t} else {\n\t\t\techo json_encode([\'success\' => false, \'message\' => \'No user id found\']);\n\t\t}\n\t}\n\tpublic function update_oem()\n\t{\n\t\t$this->check_login();\n\t\t$s_no = $this->input->post(\'s_no\');\n\t\t$status = $this->input->post(\'status\');\n\t\tif ($s_no) {\n\t\t\t$this->db->where(\'s_no\', $s_no);\n\t\t\tif ($status == 0) {\n\n\t\t\t\t$this->db->update(\'oem_table\', [\'status\' => 1]); // assuming 1 = active\n\t\t\t} else {\n\n\t\t\t\t$this->db->update(\'oem_table\', [\'status\' => 0]); // assuming 0 = Inactive\n\t\t\t}\n\t\t\techo json_encode([\'success\' => true]);\n\t\t} else {\n\t\t\techo json_encode([\'success\' => false, \'message\' => \'No user id found\']);\n\t\t}\n\t}\n\n\n\tpublic function add_project()\n\t{\n\t\t$user_det = $this->check_login();\n\n\t\tif ($this->input->post()) {\n\t\t\t$input = $this->input->post();\n\n\t\t\t$data = array(\n\t\t\t\t\'state\' => $input[\'state\'],\n\t\t\t\t\'department\' => $input[\'department\'],\n\t\t\t\t\'project_name\' => $input[\'project_name\'],\n\t\t\t\t\'tender_number\' => $input[\'tender_number\'],\n\t\t\t\t\'portal_link\' => $input[\'portal_link\'],\n\t\t\t\t\'service_bid/oem\' => $input[\'service_bid\'],\n\t\t\t\t\'rfb_published_date\' => $input[\'rfb_published_date\'],\n\t\t\t\t\'rfb_submission_date\' => $input[\'rfb_submission_date\'],\n\t\t\t\t\'status\' => $input[\'status\'],\n\t\t\t\t\'project_awarded\' => $input[\'project_awarded\']\n\t\t\t);\n\n\t\t\tif ($this->db->insert(\'project_table\', $data)) {\n\t\t\t\t$project_id = $this->db->insert_id();\n\n\t\t\t\t// Save required materials if specified\n\t\t\t\t$material_products = $this->input->post(\'material_product\');\n\t\t\t\t$material_quantities = $this->input->post(\'material_quantity\');\n\t\t\t\t$material_units = $this->input->post(\'material_unit\');\n\n\t\t\t\tif (!empty($material_products) && is_array($material_products)) {\n\t\t\t\t\t$materials_batch = [];\n\t\t\t\t\t$seen_products = [];\n\t\t\t\t\tfor ($i = 0; $i < count($material_products); $i++) {\n\t\t\t\t\t\t$p_id = intval($material_products[$i]);\n\t\t\t\t\t\tif ($p_id > 0 && !isset($seen_products[$p_id])) {\n\t\t\t\t\t\t\t$seen_products[$p_id] = true;\n\t\t\t\t\t\t\t$qty = !empty($material_quantities[$i]) ? floatval($material_quantities[$i]) : 1;\n\t\t\t\t\t\t\t$unit = !empty($material_units[$i]) ? trim($material_units[$i]) : \'Nos\';\n\n\t\t\t\t\t\t\t$materials_batch[] = [\n\t\t\t\t\t\t\t\t\'project_id\' => $project_id,\n\t\t\t\t\t\t\t\t\'p_id\'       => $p_id,\n\t\t\t\t\t\t\t\t\'quantity\'   => $qty,\n\t\t\t\t\t\t\t\t\'unit\'       => $unit\n\t\t\t\t\t\t\t];\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif (!empty($materials_batch)) {\n\t\t\t\t\t\t$this->db->insert_batch(\'project_materials\', $materials_batch);\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t$this->session->set_flashdata(\'true\', \'Project added successfully!\');\n\t\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Fail to add project. Try again.\');\n\t\t\t}\n\t\t\tredirect(base_url(\'admin/add_project\'));\n\t\t}\n\t\t$data[\'projects\'] = $this->admin_model->get_projects();\n\t\t$data[\'products\'] = $this->admin_model->get_products();\n\n\t\t$this->template->write_view(\'content\', \'admin/add_project\',$data);\n\t\t$this->template->render();\n\t}\n\n\tpublic function update_project()\n\t{\n\t\t$this->check_login();\n\n\t\tif ($this->input->post()) {\n\t\t\t$input = $this->input->post();\n\t\t\t$project_id = !empty($input[\'s_no\']) ? intval($input[\'s_no\']) : 0;\n\n\t\t\tif (!empty($project_id)) {\n\t\t\t\t$data = array(\n\t\t\t\t\t\'state\' => $input[\'state\'],\n\t\t\t\t\t\'department\' => $input[\'department\'],\n\t\t\t\t\t\'project_name\' => $input[\'project_name\'],\n\t\t\t\t\t\'tender_number\' => $input[\'tender_number\'],\n\t\t\t\t\t\'portal_link\' => $input[\'portal_link\'],\n\t\t\t\t\t\'service_bid/oem\' => $input[\'service_bid\'],\n\t\t\t\t\t\'rfb_published_date\' => $input[\'rfb_published_date\'],\n\t\t\t\t\t\'rfb_submission_date\' => $input[\'rfb_submission_date\'],\n\t\t\t\t\t\'status\' => $input[\'status\'],\n\t\t\t\t\t\'project_awarded\' => $input[\'project_awarded\']\n\t\t\t\t);\n\n\t\t\t\t$this->db->where(\'s_no\', $project_id);\n\t\t\t\t$updated = $this->db->update(\'project_table\', $data);\n\n\t\t\t\t// Update required materials: delete existing and insert new batch\n\t\t\t\t$this->db->where(\'project_id\', $project_id)->delete(\'project_materials\');\n\n\t\t\t\t$material_products = $this->input->post(\'material_product\');\n\t\t\t\t$material_quantities = $this->input->post(\'material_quantity\');\n\t\t\t\t$material_units = $this->input->post(\'material_unit\');\n\n\t\t\t\tif (!empty($material_products) && is_array($material_products)) {\n\t\t\t\t\t$materials_batch = [];\n\t\t\t\t\t$seen_products = [];\n\t\t\t\t\tfor ($i = 0; $i < count($material_products); $i++) {\n\t\t\t\t\t\t$p_id = intval($material_products[$i]);\n\t\t\t\t\t\tif ($p_id > 0 && !isset($seen_products[$p_id])) {\n\t\t\t\t\t\t\t$seen_products[$p_id] = true;\n\t\t\t\t\t\t\t$qty = !empty($material_quantities[$i]) ? floatval($material_quantities[$i]) : 1;\n\t\t\t\t\t\t\t$unit = !empty($material_units[$i]) ? trim($material_units[$i]) : \'Nos\';\n\n\t\t\t\t\t\t\t$materials_batch[] = [\n\t\t\t\t\t\t\t\t\'project_id\' => $project_id,\n\t\t\t\t\t\t\t\t\'p_id\'       => $p_id,\n\t\t\t\t\t\t\t\t\'quantity\'   => $qty,\n\t\t\t\t\t\t\t\t\'unit\'       => $unit\n\t\t\t\t\t\t\t];\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif (!empty($materials_batch)) {\n\t\t\t\t\t\t$this->db->insert_batch(\'project_materials\', $materials_batch);\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t$this->session->set_flashdata(\'true\', \'Project updated successfully!\');\n\t\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Invalid project record.\');\n\t\t\t}\n\t\t\tredirect(base_url(\'admin/add_project\'));\n\t\t}\n\t}\n\n\tpublic function get_project_materials()\n\t{\n\t\t$this->check_login();\n\t\t$project_id = $this->input->post(\'project_id\');\n\t\t$materials = $this->admin_model->get_project_materials($project_id);\n\t\techo json_encode($materials);\n\t}\n\n\tpublic function project_details($project_id = null)\n\t{\n\t\t$user_det = $this->check_login();\n\n\t\tif (empty($project_id)) {\n\t\t\t$this->session->set_flashdata(\'err\', \'Project ID is required.\');\n\t\t\tredirect(base_url(\'admin/add_project\'));\n\t\t\treturn;\n\t\t}\n\n\t\t$project = $this->db->get_where(\'project_table\', [\'s_no\' => $project_id])->row_array();\n\t\tif (empty($project)) {\n\t\t\t$this->session->set_flashdata(\'err\', \'Project record not found.\');\n\t\t\tredirect(base_url(\'admin/add_project\'));\n\t\t\treturn;\n\t\t}\n\n\t\t$data[\'project\'] = $project;\n\t\t$data[\'materials\'] = $this->admin_model->get_project_materials($project_id);\n\n\t\t// Fetch all OEM pricing records for this project\n\t\t$this->db->select(\'pm.s_no, pm.project_id, pm.t_id, pm.c_id, pm.p_id, pm.oem_id, pm.price, pm.unit, pm.change_reason, pm.created_at, c.category_list, p.product_list, o.oem_name\')\n\t\t\t->from(\'price_entries pm\')\n\t\t\t->join(\'category c\', \'c.c_id = pm.c_id\', \'left\')\n\t\t\t->join(\'product p\', \'p.p_id = pm.p_id\', \'left\')\n\t\t\t->join(\'oem_table o\', \'o.s_no = pm.oem_id\', \'left\')\n\t\t\t->where(\'pm.project_id\', $project_id)\n\t\t\t->order_by(\'pm.price\', \'ASC\');\n\t\t$data[\'price_entries\'] = $this->db->get()->result_array();\n\n\t\t$this->template->write_view(\'content\', \'admin/project_details\', $data);\n\t\t$this->template->render();\n\t}\n\n\n\tpublic function price_management()\n\t{\n\t\t$user_det = $this->check_login(); \n\n\t\tif ($this->input->post()) {\n\t\t\t$proj_id = $this->input->post(\'project_name\');\n\t\t\t$categories = $this->input->post(\'inputCategory\');\n\t\t\t$products = $this->input->post(\'inputProduct\');\n\t\t\t$oems = $this->input->post(\'inputOEM\');\n\t\t\t$prices = $this->input->post(\'inputPrice\');\n\t\t\t$units = $this->input->post(\'inputUnit\');\n\t\t\t$change_reason = $this->input->post(\'inputchange_reason\');\n\n\t\t\t// Check for duplicates before insertion\n\t\t\tfor ($i = 0; $i < count($categories); $i++) {\n\t\t\t\t$exists = $this->db->where(\'project_id\', $proj_id)\n\t\t\t\t\t->where(\'oem_id\', $oems[$i])\n\t\t\t\t\t->where(\'price\', $prices[$i])\n\t\t\t\t\t->get(\'price_entries\')\n\t\t\t\t\t->row();\n\n\t\t\t\tif ($exists) {\n\t\t\t\t\t$this->session->set_flashdata(\'err\', \'Project, Oem and Price are Already Exists \');\n\t\t\t\t\tredirect(base_url(\'admin/price_management\'));\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// No duplicates, proceed with insertion\n\t\t\t$data_to_insert = [];\n\t\t\tfor ($i = 0; $i < count($categories); $i++) {\n\t\t\t\t$data_to_insert[] = [\n\t\t\t\t\t\'project_id\' => $proj_id,\n\t\t\t\t\t\'t_id\' => $this->input->post(\'tender_number\'),\n\t\t\t\t\t\'c_id\' => $categories[$i],\n\t\t\t\t\t\'p_id\' => $products[$i],\n\t\t\t\t\t\'oem_id\' => $oems[$i],\n\t\t\t\t\t\'price\' => $prices[$i],\n\t\t\t\t\t\'change_reason\' => $change_reason[$i],\n\t\t\t\t\t\'unit\' => $units[$i]\n\t\t\t\t];\n\t\t\t}\n\t\t\t\n\n\t\t\tif ($this->db->insert_batch(\'price_entries\', $data_to_insert)) {\n\t\t\t\t$this->session->set_flashdata(\'true\', \'Price entries added successfully!\');\n\t\t\t} else {\n\t\t\t\t$this->session->set_flashdata(\'err\', \'Failed to add price entries. Please try again.\');\n\t\t\t}\n\t\t\tredirect(base_url(\'admin/price_management\'));\n\t\t}\n\n\t\t// Load data for dropdowns\n\n\t\t$data[\'projects\'] = $this->admin_model->get_projects();\n\t\t$data[\'categories\'] = $this->admin_model->get_category();\n\t\t$data[\'products\'] = $this->admin_model->get_products();\n\t\t$data[\'oems\'] = $this->admin_model->get_oem();\n\n\t\t// Load the view\n\t\t$this->template->write_view(\'content\', \'admin/price_management\', $data);\n\t\t$this->template->render();\n\t}\n\n  \n// \tpublic function price_management()\n// {\n//     $user_det = $this->check_login(); // Protect page\n\n//     if ($this->input->post()) {\n//         $proj_id = $this->input->post(\'project_name\');\n//         $tender_id = $this->input->post(\'tender_number\');\n//         $categories = $this->input->post(\'inputCategory\');\n//         $products = $this->input->post(\'inputProduct\');\n//         $oems = $this->input->post(\'inputOEM\');\n//         $prices = $this->input->post(\'inputPrice\');\n//         $units = $this->input->post(\'inputUnit\');\n//         $change_reason = $this->input->post(\'inputchange_reason\');\n//         // $s_no = $this->input->post(\'entry_id\'); // important for updates\n\n// // \t\techo "<pre>";\n// // print_r($this->input->post());\n// // exit;\n\n\n//         for ($i = 0; $i < count($categories); $i++) {\n//             $data = [\n//                 \'project_id\'    => $proj_id,\n//                 \'t_id\'          => $tender_id,\n//                 \'c_id\'          => $categories[$i],\n//                 \'p_id\'          => $products[$i],\n//                 \'oem_id\'        => $oems[$i],\n//                 \'price\'         => $prices[$i],\n//                 \'change_reason\' => $change_reason[$i],\n//                 \'unit\'          => $units[$i]\n//             ];\n\n         \n//         }\n\n//         $this->session->set_flashdata(\'true\', \'Price entries updated successfully!\');\n//         redirect(base_url(\'admin/price_management\'));\n//     }\n\n//     // Load dropdown data\n//     $data[\'projects\'] = $this->admin_model->get_projects();\n//     $data[\'categories\'] = $this->admin_model->get_category();\n//     $data[\'products\'] = $this->admin_model->get_products();\n//     $data[\'oems\'] = $this->admin_model->get_oem();\n\n//     $this->template->write_view(\'content\', \'admin/price_management\', $data);\n//     $this->template->render();\n// }\n\n\t\n\t\n\tpublic function get_project_name()\n\t{\n\t\t$this->check_login();\n\t\t$tender_number = $this->input->post(\'tender_number\');\n\t\t// echo $tender_number;\n\t\t// echo "<pre>"; print_r($tender_number);exit;\t\n\t\t$project_names = $this->admin_model->get_project_names_by_id($tender_number);\n\t\techo json_encode($project_names);\n\t}\n\n\tpublic function get_products_by_category()\n\t{\n\t\t$this->check_login();\n\t\t$category_id = $this->input->post(\'category_id\');\n\t\t// echo "<pre>"; print_r($category_id);exit;\n\t\t$products = $this->admin_model->getProductsByCategory($category_id);\n\n\t\techo json_encode($products);\n\t}\n\n\n\tpublic function price_history()\n\t{\n\t\t$user_det = $this->check_login(); \n\n\t\t$inputs = $this->input->post();\n\t\t$data[\'filters\'] = $inputs;\n\n\t\t$data[\'products\'] = $this->admin_model->get_products();\n\t\t$data[\'oems\']     = $this->admin_model->get_oem();\n\t\t$data[\'prices\']   = $this->admin_model->get_price_entries($inputs);\n\n\t\t$this->template->write_view(\'content\', \'admin/price_history\', $data);\n\t\t$this->template->render();\n\t}\n\n\n\tpublic function price_comparison()\n\t{\n\t\t$user_det = $this->check_login(); // protect page\n\n\t\t$data[\'projects\']   = $this->admin_model->get_projects();\n\t\t$data[\'categories\'] = $this->admin_model->get_category();\n\t\t$data[\'products\']   = $this->admin_model->get_products();\n\n\t\t$data[\'comparison_rows\'] = [];\n\t\t$data[\'p1_info\']         = null;\n\t\t$data[\'p2_info\']         = null;\n\n\t\tif ($this->input->post()) {\n\t\t\t$project1 = $this->input->post(\'project1\');\n\t\t\t$project2 = $this->input->post(\'project2\');\n\n\t\t\tif (!empty($project1) && !empty($project2) && $project1 !== $project2) {\n\t\t\t\t// Fetch project records\n\t\t\t\t$p1_record = $this->db->get_where(\'project_table\', [\'s_no\' => $project1])->row_array();\n\t\t\t\t$p2_record = $this->db->get_where(\'project_table\', [\'s_no\' => $project2])->row_array();\n\t\t\t\t$data[\'p1_info\'] = $p1_record;\n\t\t\t\t$data[\'p2_info\'] = $p2_record;\n\n\t\t\t\t// Fetch all material price entries for both projects\n\t\t\t\t$p1_entries = $this->admin_model->get_project_material_prices($project1);\n\t\t\t\t$p2_entries = $this->admin_model->get_project_material_prices($project2);\n\n\t\t\t\t// Group entries by product ID (p_id).\n\t\t\t\t// Since query is ordered by price ASC, the first item encountered for each product is the lowest/best OEM quote.\n\t\t\t\t$p1_by_product = [];\n\t\t\t\tforeach ($p1_entries as $row) {\n\t\t\t\t\t$pid = $row[\'p_id\'];\n\t\t\t\t\tif (!isset($p1_by_product[$pid])) {\n\t\t\t\t\t\t$p1_by_product[$pid] = $row;\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t$p2_by_product = [];\n\t\t\t\tforeach ($p2_entries as $row) {\n\t\t\t\t\t$pid = $row[\'p_id\'];\n\t\t\t\t\tif (!isset($p2_by_product[$pid])) {\n\t\t\t\t\t\t$p2_by_product[$pid] = $row;\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\t// Collect all unique product IDs across both projects\n\t\t\t\t$all_pids = array_unique(array_merge(array_keys($p1_by_product), array_keys($p2_by_product)));\n\n\t\t\t\t// Unit formatting helper closure\n\t\t\t\t$format_unit_str = function($u) {\n\t\t\t\t\t$u_str = trim((string)$u);\n\t\t\t\t\tif ($u_str === \'1\') return "Per Unit";\n\t\t\t\t\tif ($u_str === \'2\') return "Per KG";\n\t\t\t\t\tif ($u_str === \'3\') return "Per Meter";\n\t\t\t\t\tif ($u_str === \'4\') return "Per Set";\n\t\t\t\t\treturn $u_str !== \'\' ? $u_str : "Nos";\n\t\t\t\t};\n\n\t\t\t\t$comparison_rows = [];\n\n\t\t\t\tforeach ($all_pids as $pid) {\n\t\t\t\t\t$has_p1 = isset($p1_by_product[$pid]);\n\t\t\t\t\t$has_p2 = isset($p2_by_product[$pid]);\n\n\t\t\t\t\t$p1_row = $has_p1 ? $p1_by_product[$pid] : null;\n\t\t\t\t\t$p2_row = $has_p2 ? $p2_by_product[$pid] : null;\n\n\t\t\t\t\t$product_name  = $p1_row[\'product_list\'] ?? ($p2_row[\'product_list\'] ?? \'Product #\' . $pid);\n\t\t\t\t\t$category_name = $p1_row[\'category_list\'] ?? ($p2_row[\'category_list\'] ?? \'-\');\n\n\t\t\t\t\t$p1_oem   = $p1_row ? ($p1_row[\'oem_name\'] ?: \'OEM\') : null;\n\t\t\t\t\t$p1_price = $p1_row ? floatval($p1_row[\'price\']) : null;\n\t\t\t\t\t$p1_unit  = $p1_row ? $format_unit_str($p1_row[\'unit\']) : null;\n\n\t\t\t\t\t$p2_oem   = $p2_row ? ($p2_row[\'oem_name\'] ?: \'OEM\') : null;\n\t\t\t\t\t$p2_price = $p2_row ? floatval($p2_row[\'price\']) : null;\n\t\t\t\t\t$p2_unit  = $p2_row ? $format_unit_str($p2_row[\'unit\']) : null;\n\n\t\t\t\t\tif ($has_p1 && $has_p2) {\n\t\t\t\t\t\t// Both projects have this material -> check units\n\t\t\t\t\t\t$units_match = (strcasecmp($p1_unit, $p2_unit) === 0);\n\n\t\t\t\t\t\tif ($units_match) {\n\t\t\t\t\t\t\t$diff = $p2_price - $p1_price;\n\t\t\t\t\t\t\t$abs_diff = abs($diff);\n\t\t\t\t\t\t\t$pct = ($p1_price > 0) ? round(($abs_diff / $p1_price) * 100, 1) : 0;\n\n\t\t\t\t\t\t\tif ($diff < 0) {\n\t\t\t\t\t\t\t\t$status_type = \'p2_lower\';\n\t\t\t\t\t\t\t\t$status_text = \'Project B is ₹\' . number_format($abs_diff, 2) . \' (\' . $pct . \'%) lower\';\n\t\t\t\t\t\t\t\t$diff_display = \'-₹\' . number_format($abs_diff, 2);\n\t\t\t\t\t\t\t} elseif ($diff > 0) {\n\t\t\t\t\t\t\t\t$status_type = \'p2_higher\';\n\t\t\t\t\t\t\t\t$status_text = \'Project B is ₹\' . number_format($abs_diff, 2) . \' (\' . $pct . \'%) higher\';\n\t\t\t\t\t\t\t\t$diff_display = \'+₹\' . number_format($abs_diff, 2);\n\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\t$status_type = \'equal\';\n\t\t\t\t\t\t\t\t$status_text = \'Equal Price\';\n\t\t\t\t\t\t\t\t$diff_display = \'₹0.00\';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t// Different units\n\t\t\t\t\t\t\t$status_type = \'diff_units\';\n\t\t\t\t\t\t\t$status_text = \'Different Units — Comparison Not Available\';\n\t\t\t\t\t\t\t$diff_display = \'—\';\n\t\t\t\t\t\t}\n\t\t\t\t\t} elseif ($has_p1) {\n\t\t\t\t\t\t// Only in Project A\n\t\t\t\t\t\t$status_type = \'only_p1\';\n\t\t\t\t\t\t$status_text = \'Only in Project A\';\n\t\t\t\t\t\t$diff_display = \'—\';\n\t\t\t\t\t} else {\n\t\t\t\t\t\t// Only in Project B\n\t\t\t\t\t\t$status_type = \'only_p2\';\n\t\t\t\t\t\t$status_text = \'Only in Project B\';\n\t\t\t\t\t\t$diff_display = \'—\';\n\t\t\t\t\t}\n\n\t\t\t\t\t$comparison_rows[] = [\n\t\t\t\t\t\t\'p_id\'          => $pid,\n\t\t\t\t\t\t\'product_name\'  => $product_name,\n\t\t\t\t\t\t\'category_name\' => $category_name,\n\t\t\t\t\t\t\'has_p1\'        => $has_p1,\n\t\t\t\t\t\t\'p1_oem\'        => $p1_oem,\n\t\t\t\t\t\t\'p1_price\'      => $p1_price,\n\t\t\t\t\t\t\'p1_unit\'       => $p1_unit,\n\t\t\t\t\t\t\'has_p2\'        => $has_p2,\n\t\t\t\t\t\t\'p2_oem\'        => $p2_oem,\n\t\t\t\t\t\t\'p2_price\'      => $p2_price,\n\t\t\t\t\t\t\'p2_unit\'       => $p2_unit,\n\t\t\t\t\t\t\'status_type\'   => $status_type,\n\t\t\t\t\t\t\'status_text\'   => $status_text,\n\t\t\t\t\t\t\'diff_display\'  => $diff_display,\n\t\t\t\t\t];\n\t\t\t\t}\n\n\t\t\t\t// Sort comparison rows alphabetically by product name\n\t\t\t\tusort($comparison_rows, function($a, $b) {\n\t\t\t\t\treturn strcasecmp($a[\'product_name\'], $b[\'product_name\']);\n\t\t\t\t});\n\n\t\t\t\t$data[\'comparison_rows\'] = $comparison_rows;\n\t\t\t}\n\t\t}\n\n\t\t$this->template->write_view(\'content\', \'admin/price_comparison\', $data);\n\t\t$this->template->render();\n\t}\n\n\tpublic function get_products_by_categorys()\n{\n    $this->check_login();\n\n    $category_id = $this->input->post(\'category_id\');\n    $oem_id      = $this->input->post(\'oem_id\');\n    $status      = $this->input->post(\'status\');\n    $product     = $this->input->post(\'product\');\n\n    $this->db->select(\'\n        product.p_id,\n        product.product_list,\n        product.category_id,\n        product.oem_id,\n        product.status,\n        product.created_at,\n        category.category_list,\n        oem_table.oem_name\n    \');\n\n    $this->db->from(\'product\');\n\n    $this->db->join(\n        \'category\',\n        \'category.c_id = product.category_id\',\n        \'left\'\n    );\n\n    $this->db->join(\n        \'oem_table\',\n        \'oem_table.s_no = product.oem_id\',\n        \'left\'\n    );\n\n    /*\n     * Category filter\n     */\n    if (!empty($category_id)) {\n        $this->db->where(\n            \'product.category_id\',\n            $category_id\n        );\n    }\n\n    /*\n     * OEM filter\n     */\n    if (!empty($oem_id)) {\n        $this->db->where(\n            \'product.oem_id\',\n            $oem_id\n        );\n    }\n\n    /*\n     * Status filter\n     */\n    if ($status !== \'\' && $status !== null) {\n        $this->db->where(\n            \'product.status\',\n            $status\n        );\n    }\n\n    /*\n     * Product search\n     */\n    if (!empty($product)) {\n\n        $this->db->like(\n            \'product.product_list\',\n            $product\n        );\n\n    }\n\n    $this->db->order_by(\n        \'product.p_id\',\n        \'DESC\'\n    );\n\n    $result = $this->db\n                    ->get()\n                    ->result_array();\n\n    echo json_encode($result);\n}\npublic function get_filtered_products()\n{\n    $this->check_login();\n\n    $category_id = $this->input->post(\'category_id\');\n    $oem_id      = $this->input->post(\'oem_id\');\n    $status      = $this->input->post(\'status\');\n    $product     = trim($this->input->post(\'product\'));\n\n    $this->db->select(\'\n        product.p_id,\n        product.product_list,\n        product.category_id,\n        product.oem_id,\n        product.status,\n        product.created_at,\n        category.category_list,\n        oem_table.oem_name\n    \');\n\n    $this->db->from(\'product\');\n\n    $this->db->join(\n        \'category\',\n        \'category.c_id = product.category_id\',\n        \'left\'\n    );\n\n    $this->db->join(\n        \'oem_table\',\n        \'oem_table.s_no = product.oem_id\',\n        \'left\'\n    );\n\n    if ($category_id !== \'\' && $category_id !== null) {\n        $this->db->where(\'product.category_id\', $category_id);\n    }\n\n    if ($oem_id !== \'\' && $oem_id !== null) {\n        $this->db->where(\'product.oem_id\', $oem_id);\n    }\n\n    if ($status !== \'\' && $status !== null) {\n        $this->db->where(\'product.status\', $status);\n    }\n\n    if ($product !== \'\') {\n        $this->db->like(\'product.product_list\', $product);\n    }\n\n    $this->db->order_by(\'product.p_id\', \'DESC\');\n\n    $result = $this->db->get()->result_array();\n\n    echo json_encode($result);\n}\n\n\t\npublic function inactive_category()\n{\n    $this->check_login();\n\n    $c_id = $this->input->post(\'c_id\', TRUE);\n\n    if (empty($c_id)) {\n\n        $response = [\n            \'success\' => false,\n            \'message\' => \'Category ID is required\'\n        ];\n\n        return $this->output\n            ->set_content_type(\'application/json\')\n            ->set_output(json_encode($response));\n    }\n\n\n    $this->db->where(\'c_id\', $c_id);\n\n    $updated = $this->db->update(\'category\', [\n        \'status\' => 0\n    ]);\n\n\n    if ($updated) {\n\n        $response = [\n            \'success\' => true,\n            \'message\' => \'Category moved to inactive successfully\'\n        ];\n\n    } else {\n\n        $response = [\n            \'success\' => false,\n            \'message\' => \'Failed to inactivate category\'\n        ];\n    }\n\n\n    return $this->output\n        ->set_content_type(\'application/json\')\n        ->set_output(json_encode($response));\n}\n\n\n\n\npublic function activate_category()\n{\n    $this->check_login();\n\n    $c_id = $this->input->post(\'c_id\', TRUE);\n\n    if (empty($c_id)) {\n\n        $response = [\n            \'success\' => false,\n            \'message\' => \'Category ID is required\'\n        ];\n\n        return $this->output\n            ->set_content_type(\'application/json\')\n            ->set_output(json_encode($response));\n    }\n\n\n    $this->db->where(\'c_id\', $c_id);\n\n    $updated = $this->db->update(\'category\', [\n        \'status\' => 1\n    ]);\n\n\n    if ($updated) {\n\n        $response = [\n            \'success\' => true,\n            \'message\' => \'Category activated successfully\'\n        ];\n\n    } else {\n\n        $response = [\n            \'success\' => false,\n            \'message\' => \'Failed to activate category\'\n        ];\n    }\n\n\n    return $this->output\n        ->set_content_type(\'application/json\')\n        ->set_output(json_encode($response));\n}\n\t// To inactive the product\npublic function inactive_product()\n{\n    $this->check_login();\n\n    $id = $this->input->post(\'p_id\', TRUE);\n\n    if (empty($id)) {\n\n        return $this->output\n            ->set_content_type(\'application/json\')\n            ->set_output(json_encode([\n                \'success\' => false,\n                \'message\' => \'Product ID is required\'\n            ]));\n    }\n\n    $this->db->where(\'p_id\', $id);\n\n    $updated = $this->db->update(\'product\', [\n        \'status\' => 0\n    ]);\n\n    if ($updated) {\n\n        $response = [\n            \'success\' => true,\n            \'message\' => \'Product inactivated successfully\'\n        ];\n\n    } else {\n\n        $response = [\n            \'success\' => false,\n            \'message\' => \'Failed to inactivate product\'\n        ];\n    }\n\n    return $this->output\n        ->set_content_type(\'application/json\')\n        ->set_output(json_encode($response));\n}\npublic function activate_product()\n{\n    $this->check_login();\n\n    $id = $this->input->post(\'p_id\');\n\n    if ($id) {\n\n        $updated = $this->db\n            ->where(\'p_id\', $id)\n            ->update(\'product\', [\'status\' => 1]);\n\n        if ($updated) {\n\n            echo json_encode([\n                \'success\' => true,\n                \'message\' => \'Product activated successfully.\'\n            ]);\n\n        } else {\n\n            echo json_encode([\n                \'success\' => false,\n                \'message\' => \'Unable to activate product.\'\n            ]);\n\n        }\n\n    } else {\n\n        echo json_encode([\n            \'success\' => false,\n            \'message\' => \'Invalid product.\'\n        ]);\n\n    }\n}\n\n\tpublic function get_existing_price_entries()\n\t{\n\t\t$this->check_login();\n\t\t$tender_no = $this->input->post(\'tender_no\');\n\t\t$project_id = $this->input->post(\'project_id\');\n\n\t\t$this->db->select(\'pm.c_id, pm.p_id, pm.oem_id, pm.price, pm.unit, pm.change_reason, pm.created_at, c.category_list, p.product_list, o.oem_name, pm.s_no\')\n\t\t\t->from(\'price_entries pm\')\n\t\t\t->join(\'category c\', \'c.c_id = pm.c_id\', \'left\')\n\t\t\t->join(\'product p\', \'p.p_id = pm.p_id\', \'left\')\n\t\t\t->join(\'oem_table o\', \'o.s_no = pm.oem_id\', \'left\');\n\n\t\tif (!empty($project_id)) {\n\t\t\t$this->db->where(\'pm.project_id\', $project_id);\n\t\t} elseif (!empty($tender_no)) {\n\t\t\t$this->db->where(\'pm.t_id\', $tender_no);\n\t\t}\n\n\t\t$entries = $this->db->get()->result_array();\n\t\techo json_encode($entries);\n\t}\n\n  \n\t\n\npublic function update_price_entry() {\n\t$this->check_login();\n    $s_no = $this->input->post(\'s_no\');\n    $new_price = $this->input->post(\'price\');\n    $change_reason = $this->input->post(\'change_reason\');\n\n    if(empty($s_no) || empty($new_price) || empty($change_reason)) {\n        echo json_encode([\'success\'=>false, \'message\'=>\'Missing required fields\']);\n        return;\n    }\n\n    $row = $this->db->get_where(\'price_entries\', [\'s_no\'=>$s_no])->row();\n    if(!$row){\n        echo json_encode([\'success\'=>false, \'message\'=>\'Price entry not found\']);\n        return;\n    }\n\n    $this->db->where(\'s_no\', $s_no)->update(\'price_entries\', [\n        \'price\' => $new_price,\n        \'change_reason\' => $change_reason\n    ]);\n\n   \n    $this->session->set_flashdata(\'true\', \'Price updated successfully\');\n\n    echo json_encode([\'success\'=>true]);\n}\n\n\n\n}//Main Class  tell  me is ther any errors in this controler'
