    def __init__(self):
        self.head = None

    def append(self, data):
        """Adds a new node to the end of the list."""
        new_node = Node(data)
        if not self.head:
            self.head = new_node
            return
        last = self.head
        while last.next:
            last = last.next
        last.next = new_node

