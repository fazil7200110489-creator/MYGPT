asks).filter(Boolean).length} / {rd.checklist?.length || 0} Completed\n                </span>\n              </div>\n\n              <p className="text-xs text-slate-600">\n                {rd.timeline_summary || \'Follow this step-by-step preparation checklist from pre-bid queries through final envelope upload:\'}\n              </p>\n\n              {rd.checklist && rd.checklist.length > 0 ? (\n                <div className="space-y-2 text-xs">\n                  {rd.checklist.map((item: any, idx: number) => {\n                    const isChecked = !!checkedTasks[item.step_number || idx + 1]\n                    return (\n                      <div\n                        key={idx}\n                        onClick={() => toggleTask(item.step_number || idx + 1)}\n                        className={`p-3 rounded-lg border transition-all cursor-pointer flex items-start gap-2.5 ${\n                          isChecked\n                            ? \'bg-slate-50 border-slate-200 text-slate-400\'\n                            : \'bg-white border-slate-200 hover:border-slate-300 text-slate-800 shadow-2xs\'\n                        }`}\n                      >\n                        <input\n                          type="checkbox"\n                          checked={isChecked}\n                          onChange={() => {}}\n                          className="mt-0.5 rounded text-blue-600 focus:ring-blue-500 h-4 w-4 shrink-0 pointer-events-none"\n                        />\n                        <div className="flex-1 min-w-0">\n                          <div className="flex flex-wrap items-center justify-between gap-1">\n                            <span className={`font-bold ${isChecked ? \'line-through text-slate-400\' : \'text-slate-900\'}`}>\n                              Step {item.step_number || idx + 1}: {item.activity}\n                            </span>\n                            {item.relevant_tender_page && (\n                              <button\n  