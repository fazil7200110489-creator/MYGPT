Analyze this CodeIgniter 3 controller and check for any issues:

<?php
defined('BASEPATH') OR exit('No direct script access allowed');

class Admin extends CI_Controller {

    public function __construct() {
        parent::__construct();
        $this->load->database();
        $this->load->library('session');
        $this->load->helper(array('url', 'form'));
    }

    public function index() {
        if (!$this->session->userdata('user_id')) {
            redirect('admin/login');
        }
        $data['title'] = 'Dashboard';
        $this->load->view('admin/dashboard', $data);
    }

    public function add_user() {
        if (!$this->session->userdata('user_id')) {
            redirect('admin/login');
        }

        $inps = $this->input->post();
        if ($inps) {
            $this->db->where('username', $inps['username']);
            $this->db->or_where('email_id', $inps['email']);
            $check = $this->db->get('users');

            if ($check->num_rows() > 0) {
                $this->session->set_flashdata('err', 'Username or email already exists');
                redirect('admin/add_user');
            } else {
                $userData = array(
                    'username'   => $inps['username'],
                    'email_id'   => $inps['email'],
                    'password'   => password_hash($inps['password'], PASSWORD_DEFAULT),
                    'status'     => 1,
                    'created_at' => date('Y-m-d H:i:s')
                );
                $this->db->insert('users', $userData);
                $this->session->set_flashdata('success', 'User added successfully');
                redirect('admin/users');
            }
        }

        $data['title'] = 'Add User';
        $this->load->view('admin/add_user', $data);
    }

    public function edit_user($id = null) {
        if (!$this->session->userdata('user_id') || !$id) {
            redirect('admin/users');
        }
        $this->db->where('id', $id);
        $data['user'] = $this->db->get('users')->row_array();
        $this->load->view('admin/edit_user', $data);
    }

    public function delete_user($id = null) {
        if (!$this->session->userdata('user_id') || !$id) {
            redirect('admin/users');
        }
        $this->db->where('id', $id);
        $this->db->delete('users');
        $this->session->set_flashdata('success', 'User deleted');
        redirect('admin/users');
    }
}

