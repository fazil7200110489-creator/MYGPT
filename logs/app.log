class Admin extends MX_Controller {
    public function __construct() {
        parent::__construct();
        $this->load->library('session');
        $this->load->database();
        $this->load->model('admin/admin_model');
    }

    private function check_login() {
        $user_det = $this->session->userdata('logged_in');
        if (!isset($user_det) || empty($user_det)) {
            $this->session->set_flashdata('err', 'Please login to access this page.');
            redirect(base_url('admin/index'));
        }
        return $user_det;
    }

    public function add_user() {
        $user_det = $this->check_login();
        if ($this->input->post()) {
            $inps = $this->input->post();
            $this->db->from('users');
            $this->db->where('username', $inps['username']);
            $this->db->or_where('email_id', $inps['email']);
            $existing = $this->db->get()->row();
            if ($existing) {
                $this->session->set_flashdata('err', 'Username or Email already exists!');
                redirect(base_url('admin/add_user'));
            } else {
                $data = array(
                    'username' => $inps['username'],
                    'password' => md5($inps['password']),
                    'email_id' => $inps['email'],
                    'role' => $inps['role'],
                    'status' => 1
                );
                if ($this->db->insert('users', $data)) {
